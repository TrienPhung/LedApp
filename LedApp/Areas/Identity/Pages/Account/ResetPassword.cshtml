@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<style>
    .auth-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .auth-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        width: 100%;
        max-width: 420px;
    }

    .auth-card-header {
        padding: 24px 28px 20px;
        border-bottom: 1px solid #f3f4f6;
    }

    .auth-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 4px;
    }

    .auth-card-sub {
        font-size: 0.82rem;
        color: #6b7280;
        margin: 0;
    }

    .auth-card-body {
        padding: 24px 28px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
    }

    .pw-wrap {
        position: relative;
    }

    .field-input {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #111827;
        font-size: 0.875rem;
        padding: 9px 14px;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        width: 100%;
        box-sizing: border-box;
    }

        .field-input:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 3px rgba(22,163,74,.1);
        }

        .field-input::placeholder {
            color: #9ca3af;
        }

    .pw-wrap .field-input {
        padding-right: 42px;
    }

    .pw-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #9ca3af;
        font-size: 16px;
        line-height: 1;
    }

        .pw-eye:hover {
            color: #6b7280;
        }

    .field-error {
        font-size: 0.78rem;
        color: #ef4444;
    }

    .btn-save {
        width: 100%;
        background: #16a34a;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-save:hover {
            background: #15803d;
        }

    .auth-footer {
        padding: 16px 28px;
        border-top: 1px solid #f3f4f6;
        text-align: center;
        font-size: 0.82rem;
        color: #6b7280;
    }

        .auth-footer a {
            color: #16a34a;
            font-weight: 600;
            text-decoration: none;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-card-header">
            <p class="auth-card-title">Reset password</p>
            <p class="auth-card-sub">Nhập mật khẩu mới cho tài khoản của bạn</p>
        </div>
        <div class="auth-card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="field-error" style="margin-bottom:8px;"></div>
                <input asp-for="Input.Code" type="hidden" />

                <div class="field-group" style="margin-bottom:4px;">
                    <label class="field-label" asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="field-input"
                           autocomplete="username" aria-required="true"
                           placeholder="Nhập email..." />
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="field-group" style="margin-bottom:4px;">
                    <label class="field-label" asp-for="Input.Password">Mật khẩu mới</label>
                    <div class="pw-wrap">
                        <input asp-for="Input.Password" class="field-input" id="newPw"
                               autocomplete="new-password" aria-required="true"
                               placeholder="Nhập mật khẩu mới..." />
                        <span class="pw-eye mdi mdi-eye" onclick="togglePw('newPw',this)"></span>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>

                <div class="field-group" style="margin-bottom:16px;">
                    <label class="field-label" asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                    <div class="pw-wrap">
                        <input asp-for="Input.ConfirmPassword" class="field-input" id="confirmPw"
                               autocomplete="new-password" aria-required="true"
                               placeholder="Nhập lại mật khẩu mới..." />
                        <span class="pw-eye mdi mdi-eye" onclick="togglePw('confirmPw',this)"></span>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn-save">Reset password</button>
            </form>
        </div>
        <div class="auth-footer">
            <a asp-page="./Login">Quay lại đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePw(id, icon) {
            const inp = document.getElementById(id);
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.classList.replace('mdi-eye', 'mdi-eye-off');
            } else {
                inp.type = 'password';
                icon.classList.replace('mdi-eye-off', 'mdi-eye');
            }
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
