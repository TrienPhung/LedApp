@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<style>
    .auth-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .auth-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        width: 100%;
        max-width: 420px;
        text-align: center;
    }

    .auth-card-body {
        padding: 40px 28px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

    .success-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #16a34a;
        font-size: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .success-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .status-msg {
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        width: 100%;
    }

        .status-msg.success {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #16a34a;
        }

        .status-msg.error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 20px;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        background: #16a34a;
        color: #fff;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-back:hover {
            background: #15803d;
            color: #fff;
        }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-card-body">
            <div class="success-icon">
                <i class="bi bi-envelope-check"></i>
            </div>
            <p class="success-title">Confirm email</p>
            <partial name="_StatusMessage" model="Model.StatusMessage" />
            <a asp-page="./Login" class="btn-back">
                <i class="bi bi-box-arrow-in-right"></i>
                Đăng nhập
            </a>
        </div>
    </div>
</div>
