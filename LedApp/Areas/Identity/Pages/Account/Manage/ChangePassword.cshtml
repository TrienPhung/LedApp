@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    .manage-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .manage-card-header {
        padding: 20px 24px 16px;
        border-bottom: 1px solid #f3f4f6;
    }

    .manage-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 2px;
    }

    .manage-card-sub {
        font-size: 0.82rem;
        color: #6b7280;
        margin: 0;
    }

    .manage-card-body {
        padding: 24px;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 16px;
    }

    .field-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
    }

    .pw-wrap {
        position: relative;
    }

    .field-input {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #111827;
        font-size: 0.875rem;
        padding: 9px 14px;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        width: 100%;
    }

        .field-input:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 3px rgba(22,163,74,.1);
        }

        .field-input::placeholder {
            color: #9ca3af;
        }

    .pw-wrap .field-input {
        padding-right: 42px;
    }

    .pw-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #9ca3af;
        font-size: 16px;
        line-height: 1;
    }

        .pw-eye:hover {
            color: #6b7280;
        }

    .field-error {
        font-size: 0.78rem;
        color: #ef4444;
    }

    .status-msg {
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 16px;
    }

        .status-msg.success {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #16a34a;
        }

        .status-msg.error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
        }

    .manage-footer {
        display: flex;
        justify-content: flex-end;
        padding-top: 4px;
    }

    .btn-save {
        background: #16a34a;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-save:hover {
            background: #15803d;
        }

    .pw-hint {
        font-size: 0.75rem;
        color: #9ca3af;
        margin-top: 2px;
    }

    body.dark-mode .manage-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .manage-card-header {
        border-color: #2e3248 !important;
    }

    body.dark-mode .manage-card-title {
        color: #e2e8f0 !important;
    }

    body.dark-mode .field-label {
        color: #d1d5db !important;
    }

    body.dark-mode .field-input {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }
</style>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="manage-card">
    <div class="manage-card-header">
        <p class="manage-card-title">Change password</p>
        <p class="manage-card-sub">Update your password to keep your account secure</p>
    </div>
    <div class="manage-card-body">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="field-error" style="margin-bottom:12px;"></div>

            <div class="field-group">
                <label class="field-label" asp-for="Input.OldPassword">Current password</label>
                <div class="pw-wrap">
                    <input asp-for="Input.OldPassword" class="field-input" id="oldPw"
                           placeholder="Nhập mật khẩu hiện tại..."
                           autocomplete="current-password" aria-required="true" />
                    <span class="pw-eye mdi mdi-eye" onclick="togglePw('oldPw',this)"></span>
                </div>
                <span asp-validation-for="Input.OldPassword" class="field-error"></span>
            </div>

            <div class="field-group">
                <label class="field-label" asp-for="Input.NewPassword">New password</label>
                <div class="pw-wrap">
                    <input asp-for="Input.NewPassword" class="field-input" id="newPw"
                           placeholder="Nhập mật khẩu mới..."
                           autocomplete="new-password" aria-required="true" />
                    <span class="pw-eye mdi mdi-eye" onclick="togglePw('newPw',this)"></span>
                </div>
                <span asp-validation-for="Input.NewPassword" class="field-error"></span>
                <span class="pw-hint">Tối thiểu 6 ký tự</span>
            </div>

            <div class="field-group">
                <label class="field-label" asp-for="Input.ConfirmPassword">Confirm new password</label>
                <div class="pw-wrap">
                    <input asp-for="Input.ConfirmPassword" class="field-input" id="confirmPw"
                           placeholder="Nhập lại mật khẩu mới..."
                           autocomplete="new-password" aria-required="true" />
                    <span class="pw-eye mdi mdi-eye" onclick="togglePw('confirmPw',this)"></span>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>

            <div class="manage-footer">
                <button type="submit" class="btn-save">Update password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function togglePw(id, icon) {
            const inp = document.getElementById(id);
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.classList.replace('mdi-eye', 'mdi-eye-off');
            } else {
                inp.type = 'password';
                icon.classList.replace('mdi-eye-off', 'mdi-eye');
            }
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
