@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Manage your external logins";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<style>
    .manage-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .manage-card-header {
        padding: 20px 24px 16px;
        border-bottom: 1px solid #f3f4f6;
    }

    .manage-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 2px;
    }

    .manage-card-sub {
        font-size: 0.82rem;
        color: #6b7280;
        margin: 0;
    }

    .manage-card-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .section-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: #374151;
        margin: 0 0 10px;
    }

    .login-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .login-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #f9fafb;
    }

    .login-provider {
        font-size: 0.875rem;
        font-weight: 500;
        color: #111827;
    }

    .btn-remove {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        background: #ef4444;
        color: #fff;
        transition: background .15s;
    }

        .btn-remove:hover {
            background: #dc2626;
        }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        background: #16a34a;
        color: #fff;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #15803d;
        }

    .btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    body.dark-mode .manage-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .manage-card-header {
        border-color: #2e3248 !important;
    }

    body.dark-mode .manage-card-title {
        color: #e2e8f0 !important;
    }

    body.dark-mode .login-item {
        background: #22263a !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .login-provider {
        color: #e2e8f0 !important;
    }

    body.dark-mode .section-title {
        color: #d1d5db !important;
    }
</style>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="manage-card">
    <div class="manage-card-header">
        <p class="manage-card-title">External logins</p>
        <p class="manage-card-sub">Manage your linked external login providers</p>
    </div>
    <div class="manage-card-body">
        @if (Model.CurrentLogins?.Count > 0)
        {
            <div>
                <p class="section-title">Registered logins</p>
                <div class="login-list">
                    @foreach (var login in Model.CurrentLogins)
                    {
                        <div class="login-item">
                            <span class="login-provider">@login.ProviderDisplayName</span>
                            @if (Model.ShowRemoveButton)
                            {
                                <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                    <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                    <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                    <button type="submit" class="btn-remove">
                                        <i class="bi bi-trash3"></i>
                                        Remove
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.OtherLogins?.Count > 0)
        {
            <div>
                <p class="section-title">Add another service to log in</p>
                <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
                    <div class="btn-group">
                        @foreach (var provider in Model.OtherLogins)
                        {
                            <button id="@($"link-login-button-{provider.Name}")" type="submit"
                                    class="btn-add" name="provider" value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }
                    </div>
                </form>
            </div>
        }
    </div>
</div>
