@using LedApp.Models;
@inject SignInManager<AppUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<a class="manage-tab @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">Profile</a>
<a class="manage-tab @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email">Email</a>
<a class="manage-tab @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">Password</a>
@if (hasExternalLogins)
{
    <a class="manage-tab @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">External logins</a>
}
<a class="manage-tab @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" asp-page="./TwoFactorAuthentication">Two-factor</a>
<a class="manage-tab @ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData">Personal data</a>