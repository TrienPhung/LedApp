@model LedApp.Models.ChitietNhap

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Xóa dữ liệu</h1>

<h3>Bạn có chắc chắn muốn xóa dữ liệu này không?</h3>
<div>
    <h4>Chi tiết dữ liệu xóa</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Soluong)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Soluong)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.donvi)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.donvi)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Trở về danh sách</a>
    </form>
</div>
