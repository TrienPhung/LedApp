@model LedApp.Models.ChitietNhap
@{
    ViewData["Title"] = "Chi tiết nhập";
    Layout = "~/Views/Shared/_Layout1.cshtml";

    long total = (Model?.ChuaBG ?? 0) + (Model?.DaBG ?? 0);
    int pct = total > 0 ? (int)Math.Round((Model?.DaBG ?? 0) * 100.0 / total) : 0;
    string statusClass = pct >= 100 ? "bp-hoan-thanh" : pct > 0 ? "bp-ban-giao" : "bp-phan-cong";
    string statusLabel = pct >= 100 ? "Hoàn thành" : pct > 0 ? "Đang bàn giao" : "Chưa bàn giao";
}

<style>
    .page-wrapper > .container-fluid {
        padding: 0 !important;
    }

    .dx-page {
        padding: 24px 24px 80px;
    }

    .dx-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 12px;
        line-height: 1;
    }

        .dx-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

            .dx-breadcrumb a:hover {
                color: #111827;
            }

        .dx-breadcrumb .sep {
            display: inline-flex;
            align-items: center;
            color: #9ca3af;
        }

            .dx-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
                display: block;
            }

        .dx-breadcrumb .cur {
            color: #111827;
            font-weight: 600;
        }

    .dx-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .dx-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 4px;
            line-height: 1.2;
        }

        .dx-header p {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

    .dx-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all .15s;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }

        .btn-edit:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
            text-decoration: none;
        }

        .btn-edit svg {
            width: 14px;
            height: 14px;
        }

    .btn-delete {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border: none;
        border-radius: 8px;
        background: #ef4444;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-delete:hover {
            background: #dc2626;
        }

        .btn-delete svg {
            width: 14px;
            height: 14px;
        }

    .dx-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 16px;
        align-items: stretch;
    }
    @@media(max - width:900px) {
        .dx-grid

    {
        grid-template-columns: 1fr;
    }

    }

    .dx-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .dx-card-header {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 18px 20px 14px;
        border-bottom: 1px solid #f3f4f6;
        flex-shrink: 0;
    }

    .dx-card-header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #f0fdf4;
        color: #16a34a;
        flex-shrink: 0;
    }

        .dx-card-header-icon svg {
            width: 16px;
            height: 16px;
        }

    .dx-card-header-text h3 {
        font-size: 0.875rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 2px;
    }

    .dx-card-header-text p {
        font-size: 0.78rem;
        color: #9ca3af;
        margin: 0;
    }

    .dx-card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .dx-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 20px;
        border-bottom: 1px solid #f3f4f6;
    }

        .dx-row:last-child {
            border-bottom: none;
        }

    .dx-row-label {
        font-size: 0.82rem;
        color: #6b7280;
        font-weight: 500;
    }

    .dx-row-value {
        font-size: 0.875rem;
        color: #111827;
        font-weight: 600;
        text-align: right;
    }

    .dx-progress-row {
        display: flex;
        align-items: center;
        padding: 13px 20px;
        border-bottom: 1px solid #f3f4f6;
        gap: 12px;
    }

        .dx-progress-row:last-child {
            border-bottom: none;
        }

    .dx-progress-label {
        font-size: 0.82rem;
        color: #6b7280;
        font-weight: 500;
        flex-shrink: 0;
    }

    .dx-progress-inner {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
    }

    .dx-progress-bg {
        flex: 1;
        height: 6px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }

    .dx-progress-fill {
        height: 100%;
        background: #16a34a;
        border-radius: 999px;
    }

    .dx-progress-pct {
        font-size: 0.75rem;
        color: #6b7280;
        font-weight: 600;
        white-space: nowrap;
        min-width: 28px;
        text-align: right;
    }

    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 600;
    }

        .badge-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

    .bp-phan-cong {
        background: #f1f5f9;
        color: #64748b;
    }

        .bp-phan-cong::before {
            background: #94a3b8;
        }

    .bp-ban-giao {
        background: #eff6ff;
        color: #3b82f6;
    }

        .bp-ban-giao::before {
            background: #3b82f6;
        }

    .bp-hoan-thanh {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-hoan-thanh::before {
            background: #16a34a;
        }

    .dx-entity {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px;
    }

    .dx-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #dcfce7;
        color: #16a34a;
        font-size: 0.875rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .dx-entity .ename {
        font-size: 0.875rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 2px;
    }

    .dx-entity .esub {
        font-size: 0.78rem;
        color: #9ca3af;
        margin: 0;
    }

    .num-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 3px 12px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .num-chua {
        background: #fff7ed;
        color: #ea580c;
    }

    .num-da {
        background: #f0fdf4;
        color: #16a34a;
    }
    /* Modal */
    .del-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.4);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .del-overlay.open {
            display: flex;
        }

    .del-modal {
        background: #fff;
        border-radius: 12px;
        padding: 28px 28px 22px;
        max-width: 420px;
        width: 92%;
        box-shadow: 0 20px 60px rgba(0,0,0,.18);
        position: relative;
    }

    .del-modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 1.2rem;
        line-height: 1;
        padding: 4px;
        border-radius: 6px;
        transition: all .15s;
    }

        .del-modal-close:hover {
            background: #f3f4f6;
            color: #374151;
        }

    .del-modal-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 10px;
        padding-right: 24px;
    }

    .del-modal-body {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .del-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-mc {
        padding: 9px 20px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-mc:hover {
            background: #f9fafb;
            border-color: #d1d5db;
        }

    .btn-md {
        padding: 9px 20px;
        border-radius: 8px;
        border: none;
        background: #ef4444;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-md:hover {
            background: #dc2626;
        }

    body.modal-open {
        overflow: hidden;
    }

    body.dark-mode .dx-header h1 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .dx-header p {
        color: #9ca3af !important;
    }

    body.dark-mode .dx-breadcrumb, body.dark-mode .dx-breadcrumb a {
        color: #9ca3af !important;
    }

    body.dark-mode .dx-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .dx-card-header {
        border-color: #2e3248 !important;
    }

    body.dark-mode .dx-card-header-icon {
        background: #052e16 !important;
        color: #4ade80 !important;
    }

    body.dark-mode .dx-card-header-text h3 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .dx-card-header-text p {
        color: #6b7280 !important;
    }

    body.dark-mode .dx-row {
        border-color: #2e3248 !important;
    }

    body.dark-mode .dx-row-label {
        color: #9ca3af !important;
    }

    body.dark-mode .dx-row-value {
        color: #e2e8f0 !important;
    }

    body.dark-mode .dx-progress-row {
        border-color: #2e3248 !important;
    }

    body.dark-mode .dx-progress-bg {
        background: #2e3248 !important;
    }

    body.dark-mode .dx-progress-label, body.dark-mode .dx-progress-pct {
        color: #9ca3af !important;
    }

    body.dark-mode .btn-edit {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .dx-entity .ename {
        color: #e2e8f0 !important;
    }

    body.dark-mode .del-modal {
        background: #1a1d27 !important;
    }

    body.dark-mode .del-modal-title {
        color: #e2e8f0 !important;
    }

    body.dark-mode .del-modal-body {
        color: #9ca3af !important;
    }

    body.dark-mode .btn-mc {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    .num-total {
        background: #f1f5f9;
        color: #374151;
    }
</style>

<div class="dx-page">
    <div class="dx-breadcrumb">
        <a href="/">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <a asp-controller="ChitietNhaps" asp-action="Index">Chi tiết nhập</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">#@Model?.Id</span>
    </div>

    <div class="dx-header">
        <div>
            <h1>Chi tiết nhập #@Model?.Id</h1>
            <p>Phiếu nhập #@Model?.NhapId &mdash; @Model?.DonVi</p>
        </div>
        <div class="dx-header-actions">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-edit">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" /></svg>
                Edit
            </a>
            <button type="button" class="btn-delete" onclick="openDel()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                Delete
            </button>
        </div>
    </div>

    <div class="dx-grid">
        <!-- Card 1: Thông tin -->
        <div class="dx-card">
            <div class="dx-card-header">
                <div class="dx-card-header-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z" /></svg>
                </div>
                <div class="dx-card-header-text">
                    <h3>Chi tiết nhập</h3>
                    <p>Thông tin cơ bản</p>
                </div>
            </div>
            <div class="dx-card-body">
                <div class="dx-row">
                    <span class="dx-row-label">ID</span>
                    <span class="dx-row-value">#@Model?.Id</span>
                </div>
                <div class="dx-row">
                    <span class="dx-row-label">Phiếu nhập</span>
                    <span class="dx-row-value">#@Model?.NhapId</span>
                </div>
                <div class="dx-row">
                    <span class="dx-row-label">Biển số xe</span>
                    <span class="dx-row-value" style="font-family:monospace;">@(Model?.Nhap?.BienSoXe ?? "—")</span>
                </div>
                <div class="dx-row">
                    <span class="dx-row-label">Cửa nhập</span>
                    <span class="dx-row-value">@(Model?.Nhap?.CuaNhap?.Ten ?? "—")</span>
                </div>
                <div class="dx-row">
                    <span class="dx-row-label">Trạng thái</span>
                    <span class="dx-row-value"><span class="badge-pill @statusClass">@statusLabel</span></span>
                </div>
                <div class="dx-progress-row">
                    <span class="dx-progress-label">Tiến độ</span>
                    <div class="dx-progress-inner">
                        <div class="dx-progress-bg"><div class="dx-progress-fill" style="width:@pct%"></div></div>
                        <span class="dx-progress-pct">@pct%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Đơn vị -->
        <div class="dx-card">
            <div class="dx-card-header">
                <div class="dx-card-header-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" /></svg>
                </div>
                <div class="dx-card-header-text">
                    <h3>Đơn vị hàng</h3>
                    <p>Loại hàng hóa bàn giao</p>
                </div>
            </div>
            <div class="dx-card-body">
                <div class="dx-entity">
                    <div class="dx-avatar">@(Model?.DonVi?.Length > 0 ? Model.DonVi.Substring(0, 1).ToUpper() : "?")</div>
                    <div>
                        <p class="ename">@(Model?.DonVi ?? "—")</p>
                        <p class="esub">Phiếu nhập #@Model?.NhapId</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Số lượng -->
        <div class="dx-card">
            <div class="dx-card-header">
                <div class="dx-card-header-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3" /></svg>
                </div>
                <div class="dx-card-header-text">
                    <h3>Số lượng</h3>
                    <p>Chi tiết bàn giao hàng</p>
                </div>
            </div>
            <div class="dx-card-body">
                <div class="dx-row">
                    <span class="dx-row-label">Chưa bàn giao</span>
                    <span class="dx-row-value"><span class="num-pill num-chua">@Model?.ChuaBG</span></span>
                </div>
                <div class="dx-row">
                    <span class="dx-row-label">Đã bàn giao</span>
                    <span class="dx-row-value"><span class="num-pill num-da">@Model?.DaBG</span></span>
                </div>
                <div class="dx-row">
                    <span class="dx-row-label">Tổng cộng</span>
                    <span class="dx-row-value"><span class="num-pill num-total">@total</span></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="del-overlay" id="delOverlay">
    <div class="del-modal">
        <button class="del-modal-close" onclick="closeDel()">×</button>
        <div class="del-modal-title">Xóa chi tiết nhập</div>
        <div class="del-modal-body">Bạn có chắc chắn muốn xóa chi tiết nhập <strong>#@Model?.Id</strong>? Hành động này không thể hoàn tác.</div>
        <div class="del-modal-footer">
            <button class="btn-mc" onclick="closeDel()">Cancel</button>
            <form asp-action="Delete" asp-route-id="@Model?.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-md">Delete</button>
            </form>
        </div>
    </div>
</div>

<script>
    function openDel() { document.getElementById('delOverlay').classList.add('open'); document.body.classList.add('modal-open'); }
    function closeDel() { document.getElementById('delOverlay').classList.remove('open'); document.body.classList.remove('modal-open'); }
    document.getElementById('delOverlay').addEventListener('click', function(e) { if (e.target === this) closeDel(); });
</script>
