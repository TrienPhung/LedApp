@model LedApp.Models.ChitietNhap

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Thêm mới dữ liệu cho cổng nhập</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NhapId" class="control-label"></label>
                <select asp-for="NhapId" class ="form-control" asp-items="ViewBag.NhapId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Soluong" class="control-label"></label>
                <input asp-for="Soluong" class="form-control" />
                <span asp-validation-for="Soluong" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="donvi" class="control-label"></label>
                <input asp-for="donvi" class="form-control" />
                <span asp-validation-for="donvi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu dữ liệu" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Trở về</a>
</div>

