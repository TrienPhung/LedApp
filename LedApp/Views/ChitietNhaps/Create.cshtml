@model LedApp.Models.ChitietNhap
@{
    ViewData["Title"] = "Thêm chi tiết nhập";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Thêm chi tiết nhập hàng</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="NhapId" class="control-label"></label>
                <select asp-for="NhapId" class="form-control" asp-items="ViewBag.NhapId"></select>
                <span asp-validation-for="NhapId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DonVi" class="control-label"></label>
                <input asp-for="DonVi" class="form-control" placeholder="VD: Tải, Kiện, ĐH..." />
                <span asp-validation-for="DonVi" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ChuaBG" class="control-label"></label>
                <input asp-for="ChuaBG" class="form-control" type="number" min="0" />
                <span asp-validation-for="ChuaBG" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DaBG" class="control-label"></label>
                <input asp-for="DaBG" class="form-control" type="number" min="0" />
                <span asp-validation-for="DaBG" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu dữ liệu" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Trở về</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}