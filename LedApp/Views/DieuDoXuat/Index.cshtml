@{
    ViewData["Title"] = "Điều độ phân cửa xuất";
    Layout = "~/Views/Shared/_LayoutApi.cshtml";
    var cuaXuats = ViewBag.CuaXuats as List<LedApp.Models.CuaXuat> ?? new();
    var xeTrongBai = ViewBag.XeTrongBai as List<LedApp.Models.DanhSachXe> ?? new();
    var nhanViens = ViewBag.NhanViens as List<LedApp.Models.nguoiDungs> ?? new();
}

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --bg: #080d18;
        --surface: #0d1525;
        --surface2: #111d30;
        --border: #1a2d4a;
        --border2: #243b5e;
        --gold: #f59e0b;
        --gold2: #fbbf24;
        --green: #22c55e;
        --red: #ef4444;
        --orange: #f97316;
        --blue: #0ea5e9;
        --blue2: #38bdf8;
        --purple: #a855f7;
        --text: #cbd5e1;
        --text-dim: #475569;
        --text-bright: #f1f5f9;
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Courier New', monospace;
        min-height: 100vh;
        overflow-x: hidden;
    }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: linear-gradient(rgba(245,158,11,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(245,158,11,.03) 1px,transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
            z-index: 0;
        }

    .screen {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 12px;
        gap: 10px;
    }

    .topbar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-top: 2px solid var(--gold);
        border-radius: 6px;
        padding: 10px 20px;
        flex-shrink: 0;
    }

    .tb-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .tb-logo {
        width: 36px;
        height: 36px;
        background: var(--gold);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .tb-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-bright);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .tb-sub {
        font-size: 10px;
        color: var(--text-dim);
        letter-spacing: 1px;
        margin-top: 1px;
    }

    .tb-clock {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 4px;
        font-variant-numeric: tabular-nums;
    }

    .tb-date {
        font-size: 10px;
        color: var(--text-dim);
        text-align: center;
        letter-spacing: 1px;
        margin-top: 2px;
    }

    .tb-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .stat-pill {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 6px 12px;
        text-align: center;
        min-width: 65px;
    }

        .stat-pill .num {
            font-size: 18px;
            font-weight: 700;
        }

        .stat-pill .lbl {
            font-size: 9px;
            color: var(--text-dim);
            letter-spacing: 1px;
            margin-top: 1px;
            text-transform: uppercase;
        }

    .signal-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 6px 10px;
        font-size: 10px;
        color: var(--text-dim);
    }

    .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--text-dim);
        flex-shrink: 0;
    }

        .dot.on {
            background: var(--green);
            box-shadow: 0 0 6px var(--green);
            animation: blink 2s infinite;
        }

        .dot.err {
            background: var(--red);
        }

    @@keyframes blink {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .4
        }
    }

    .main {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 10px;
        overflow: hidden;
    }

    .left-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
        min-height: 0;
    }

        .left-col::-webkit-scrollbar {
            width: 4px;
        }

        .left-col::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 2px;
        }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
    }

    .panel-title {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--gold);
    }

    .panel-body {
        padding: 14px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        margin-bottom: 12px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .form-label {
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text-dim);
    }

    .form-control {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 8px 10px;
        color: var(--text-bright);
        font-size: 12px;
        font-family: inherit;
        outline: none;
        width: 100%;
        transition: border-color .15s;
    }

        .form-control:focus {
            border-color: var(--gold);
        }

    .xe-info-box {
        background: rgba(245,158,11,.06);
        border: 1px solid rgba(245,158,11,.2);
        border-radius: 4px;
        padding: 8px 10px;
        margin-top: 5px;
        display: none;
    }

        .xe-info-box.show {
            display: block;
        }

    .xi-row {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        margin-bottom: 2px;
    }

    .xi-lbl {
        color: var(--text-dim);
    }

    .xi-val {
        color: var(--gold2);
        font-weight: 700;
    }

    .hang-section {
        border-top: 1px solid var(--border);
        padding-top: 12px;
        margin-top: 4px;
    }

    .hang-section-title {
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text-dim);
        margin-bottom: 8px;
    }

    .hang-row {
        display: grid;
        grid-template-columns: 1fr 110px 30px;
        gap: 6px;
        align-items: center;
        margin-bottom: 6px;
    }

    .hang-input {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 7px 8px;
        color: var(--text-bright);
        font-size: 12px;
        font-family: inherit;
        outline: none;
        width: 100%;
    }

        .hang-input:focus {
            border-color: var(--gold);
        }

    .btn-remove {
        background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.2);
        border-radius: 4px;
        width: 28px;
        height: 28px;
        color: var(--red);
        cursor: pointer;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: inherit;
    }

    .btn-add-hang {
        background: rgba(34,197,94,.08);
        border: 1px solid rgba(34,197,94,.2);
        border-radius: 4px;
        padding: 6px 12px;
        color: var(--green);
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        margin-top: 2px;
    }

        .btn-add-hang:hover {
            background: rgba(34,197,94,.15);
        }

    .form-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 14px;
        border-top: 1px solid var(--border);
        padding-top: 12px;
    }

    .btn-reset {
        background: transparent;
        border: 1px solid var(--border2);
        color: var(--text-dim);
        padding: 8px 16px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-reset:hover {
            border-color: var(--text-dim);
            color: var(--text);
        }

    .btn-submit {
        background: var(--gold);
        color: #0a0e18;
        border: none;
        padding: 8px 22px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        letter-spacing: .5px;
    }

        .btn-submit:hover {
            background: var(--gold2);
        }

        .btn-submit:disabled {
            background: #1e293b;
            color: #334155;
            cursor: not-allowed;
        }

    .filter-tabs {
        display: flex;
        gap: 4px;
        padding: 8px 16px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .ftab {
        padding: 4px 10px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        cursor: pointer;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-dim);
        font-family: inherit;
    }

        .ftab:hover {
            border-color: var(--border2);
            color: var(--text);
        }

        .ftab.active {
            background: var(--gold);
            border-color: var(--gold);
            color: #0a0e18;
        }

    .table-wrap {
        overflow-x: auto;
    }

    .xe-table {
        width: 100%;
        border-collapse: collapse;
    }

        .xe-table thead th {
            padding: 8px 12px;
            font-size: 9px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--text-dim);
            border-bottom: 1px solid var(--border);
            text-align: left;
            background: var(--surface);
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .xe-table tbody tr {
            border-bottom: 1px solid var(--border);
        }

            .xe-table tbody tr:hover {
                background: var(--surface2);
            }

        .xe-table td {
            padding: 9px 12px;
            font-size: 12px;
            vertical-align: middle;
        }

    .sbadge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .tt-0 {
        background: rgba(100,116,139,.15);
        color: #94a3b8;
        border: 1px solid #334155;
    }

    .tt-1 {
        background: rgba(245,158,11,.15);
        color: var(--gold);
        border: 1px solid rgba(245,158,11,.3);
    }

    .tt-2 {
        background: rgba(239,68,68,.15);
        color: var(--red);
        border: 1px solid rgba(239,68,68,.3);
    }

    .tt-3 {
        background: rgba(34,197,94,.15);
        color: var(--green);
        border: 1px solid rgba(34,197,94,.3);
    }

    .tt-4 {
        background: rgba(168,85,247,.15);
        color: var(--purple);
        border: 1px solid rgba(168,85,247,.3);
    }

    .xe-tt-0 {
        background: rgba(34,197,94,.12);
        color: var(--green);
        border: 1px solid rgba(34,197,94,.25);
    }

    .xe-tt-1 {
        background: rgba(245,158,11,.12);
        color: var(--gold);
        border: 1px solid rgba(245,158,11,.25);
    }

    .xe-tt-2 {
        background: rgba(168,85,247,.12);
        color: var(--purple);
        border: 1px solid rgba(168,85,247,.25);
    }

    .xe-tt-3 {
        background: rgba(239,68,68,.12);
        color: var(--red);
        border: 1px solid rgba(239,68,68,.25);
    }

    .btn-huy {
        background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.2);
        border-radius: 3px;
        padding: 4px 10px;
        color: var(--red);
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-huy:hover {
            background: rgba(239,68,68,.2);
        }

    .btn-chitiet {
        background: rgba(14,165,233,.1);
        border: 1px solid rgba(14,165,233,.2);
        border-radius: 3px;
        padding: 4px 10px;
        color: var(--blue);
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        margin-right: 4px;
    }

    .sidebar {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .stabs {
        display: flex;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .stab {
        flex: 1;
        padding: 10px 6px;
        text-align: center;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        color: var(--text-dim);
        border-bottom: 2px solid transparent;
        font-family: inherit;
        background: transparent;
        border-top: none;
        border-left: none;
        border-right: none;
    }

        .stab.active {
            color: var(--gold);
            border-bottom-color: var(--gold);
            background: rgba(245,158,11,.05);
        }

    .sidebar-body {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
    }

        .sidebar-body::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 2px;
        }

    .cua-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-left: 3px solid var(--border2);
        border-radius: 5px;
        padding: 10px 12px;
        margin-bottom: 7px;
    }

        .cua-card.has-xe {
            border-left-color: var(--orange);
        }

        .cua-card.is-over {
            border-left-color: var(--red);
        }

    .cua-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-bright);
        margin-bottom: 3px;
    }

    .cua-xe {
        font-size: 11px;
        color: var(--gold);
    }

    .cua-empty {
        font-size: 10px;
        color: var(--text-dim);
        font-style: italic;
    }

    .cua-hang {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 5px;
    }

    .cua-hang-tag {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 3px;
        padding: 2px 6px;
        font-size: 10px;
        color: var(--gold2);
    }

    .cua-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 6px;
    }

    .xe-filter {
        display: flex;
        gap: 4px;
        margin-bottom: 8px;
        flex-wrap: wrap;
    }

    .xf-btn {
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 3px 9px;
        font-size: 10px;
        font-weight: 700;
        color: var(--text-dim);
        cursor: pointer;
        font-family: inherit;
    }

        .xf-btn.active {
            background: rgba(34,197,94,.1);
            border-color: rgba(34,197,94,.3);
            color: var(--green);
        }

    .xe-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 10px 12px;
        margin-bottom: 7px;
    }

    .xe-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    .xe-bienso {
        font-size: 13px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 1px;
    }

    .xe-meta {
        font-size: 10px;
        color: var(--text-dim);
        margin-top: 2px;
    }

    .footer {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 6px 16px;
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        color: var(--text-dim);
        flex-shrink: 0;
        letter-spacing: .5px;
    }

    .empty-cell {
        text-align: center;
        padding: 30px;
        color: var(--text-dim);
        font-style: italic;
        font-size: 12px;
    }

    .hang-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 3px;
    }

    .htag {
        background: var(--surface2);
        border: 1px solid var(--border);
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 10px;
        color: var(--gold2);
    }
</style>

<div class="screen">
    <div class="topbar">
        <div class="tb-left">
            <div class="tb-logo">🚛</div>
            <div>
                <div class="tb-title">Điều độ phân cửa xuất</div>
                <div class="tb-sub">Warehouse Control Center — Outbound Gate Assignment</div>
            </div>
        </div>
        <div>
            <div class="tb-clock" id="clock">--:--:--</div>
            <div class="tb-date" id="date-str"></div>
        </div>
        <div class="tb-right">
            <div class="stat-pill"><div class="num" id="stat-tong" style="color:var(--blue);">0</div><div class="lbl">Tổng xe</div></div>
            <div class="stat-pill"><div class="num" id="stat-cho" style="color:#94a3b8;">0</div><div class="lbl">Chờ xuất</div></div>
            <div class="stat-pill"><div class="num" id="stat-dang" style="color:var(--gold);">0</div><div class="lbl">Đang xuất</div></div>
            <div class="stat-pill"><div class="num" id="stat-xong" style="color:var(--green);">0</div><div class="lbl">Đã rời kho</div></div>
            <div class="signal-badge"><span class="dot" id="sig-dot"></span><span id="sig-text">Kết nối...</span></div>
        </div>
    </div>

    <div class="main">
        <div class="left-col">
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">▪ Tạo phiếu xuất mới</span>
                    <span style="font-size:10px;color:var(--text-dim);" id="form-status"></span>
                </div>
                <div class="panel-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Chọn xe (trong bãi)</label>
                            <select class="form-control" id="sel-xe" onchange="onXeChange()">
                                <option value="">-- Chọn xe --</option>
                                @foreach (var xe in xeTrongBai)
                                {
                                    <option value="@xe.Id"
                                            data-loai="@xe.LoaiXe"
                                            data-tai="@xe.TaiTrong"
                                            data-taixe="@(xe.TaiXe != null ? xe.TaiXe.Name : "Chưa có tài xế")"
                                            data-tel="@(xe.TaiXe != null ? xe.TaiXe.Tels : "--")">
                                        @xe.BienSoXe
                                    </option>
                                }
                            </select>
                            <div class="xe-info-box" id="xe-info">
                                <div class="xi-row"><span class="xi-lbl">Loại xe</span><span class="xi-val" id="xi-loai">--</span></div>
                                <div class="xi-row"><span class="xi-lbl">Tải trọng</span><span class="xi-val" id="xi-tai">--</span></div>
                                <div class="xi-row"><span class="xi-lbl">Tài xế</span><span class="xi-val" id="xi-taixe">--</span></div>
                                <div class="xi-row"><span class="xi-lbl">SĐT</span><span class="xi-val" id="xi-tel">--</span></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cửa xuất</label>
                            <select class="form-control" id="sel-cua">
                                <option value="">-- Chọn cửa --</option>
                                @foreach (var cua in cuaXuats)
                                {
                                    <option value="@cua.Id">@cua.Ten</option>
                                }
                            </select>
                            <div style="margin-top:8px;">
                                <label class="form-label">Nhân viên xác nhận</label>
                                <select class="form-control" id="sel-nv" style="margin-top:5px;">
                                    <option value="">-- Chọn nhân viên --</option>
                                    @foreach (var nv in nhanViens)
                                    {
                                        <option value="@nv.Id">@nv.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Thời gian phân công</label>
                            <input type="datetime-local" class="form-control" id="inp-tgpc" />
                            <div style="margin-top:8px;">
                                <label class="form-label">Ghi chú</label>
                                <input type="text" class="form-control" id="inp-ghichu" placeholder="Ghi chú thêm..." style="margin-top:5px;" />
                            </div>
                        </div>
                    </div>
                    <div class="hang-section">
                        <div class="hang-section-title">Hàng hóa xuất</div>
                        <div id="hang-list">
                            <div class="hang-row">
                                <input class="hang-input" placeholder="Đơn vị (VD: Tải, Kiện, ĐH...)" />
                                <input class="hang-input" type="number" placeholder="Số lượng" min="0" />
                                <button class="btn-remove" onclick="removeHang(this)" type="button">×</button>
                            </div>
                        </div>
                        <button class="btn-add-hang" onclick="addHang()" type="button">+ Thêm hàng hóa</button>
                    </div>
                    <div class="form-actions">
                        <button class="btn-reset" onclick="resetForm()" type="button">⟳ Làm mới</button>
                        <button class="btn-submit" id="btn-submit" onclick="submitForm()" type="button">✔ Tạo phiếu xuất</button>
                    </div>
                </div>
            </div>

            <div class="panel" style="flex:1;min-height:400px;display:flex;flex-direction:column;overflow:hidden;">
                <div class="panel-header">
                    <span class="panel-title">▪ Danh sách phiếu xuất hôm nay</span>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-size:10px;color:var(--text-dim);" id="phieu-count">0 phiếu</span>
                        <button onclick="loadPhieu()" style="background:var(--surface2);border:1px solid var(--border);color:var(--gold);padding:4px 10px;border-radius:3px;font-size:10px;cursor:pointer;font-family:inherit;">⟳ Làm mới</button>
                    </div>
                </div>
                <div class="filter-tabs">
                    <button class="ftab active" onclick="setFilter('all',this)">Tất cả</button>
                    <button class="ftab" onclick="setFilter(0,this)">Chờ xuất</button>
                    <button class="ftab" onclick="setFilter(1,this)">Đang xuất</button>
                    <button class="ftab" onclick="setFilter(2,this)">Quá giờ</button>
                    <button class="ftab" onclick="setFilter(3,this)">Hoàn thành</button>
                    <button class="ftab" onclick="setFilter(4,this)">Đã rời kho</button>
                </div>
                <div style="flex:1;min-height:300px;overflow-y:auto;">
                    <div class="table-wrap">
                        <table class="xe-table">
                            <thead>
                                <tr>
                                    <th style="width:60px;">Cửa</th>
                                    <th style="width:150px;">Xe / Tài xế</th>
                                    <th style="width:180px;">Hàng hóa</th>
                                    <th style="width:100px;">Trạng thái</th>
                                    <th style="width:75px;">Giờ vào</th>
                                    <th style="width:80px;">Còn lại</th>
                                    <th style="width:110px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="phieu-tbody">
                                <tr><td colspan="7" class="empty-cell">Đang tải...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="sidebar">
            <div class="stabs">
                <button class="stab active" id="stab-cua" onclick="switchTab('cua')" type="button">Cửa xuất</button>
                <button class="stab" id="stab-xe" onclick="switchTab('xe')" type="button">Danh sách xe</button>
            </div>
            <div class="sidebar-body">
                <div id="panel-cua">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <span style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--gold);text-transform:uppercase;">Cửa xuất</span>
                        <span style="font-size:10px;color:var(--text-dim);">@cuaXuats.Count cửa</span>
                    </div>
                    <div id="cua-list">
                        @foreach (var cua in cuaXuats)
                        {
                            <div class="cua-card" id="cua-card-@cua.Id" data-cua-id="@cua.Id">
                                <div class="cua-name">@cua.Ten</div>
                                <div class="cua-empty" id="cua-status-@cua.Id">— Trống —</div>
                            </div>
                        }
                    </div>
                </div>
                <div id="panel-xe" style="display:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <span style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--blue2);text-transform:uppercase;">Danh sách xe</span>
                        <span style="font-size:10px;color:var(--text-dim);" id="xe-sidebar-count"></span>
                    </div>
                    <div class="xe-filter">
                        <button class="xf-btn active" onclick="filterXe(this,'all')" type="button">Tất cả</button>
                        <button class="xf-btn" onclick="filterXe(this,0)" type="button">Trong bãi</button>
                        <button class="xf-btn" onclick="filterXe(this,1)" type="button">Phân công</button>
                        <button class="xf-btn" onclick="filterXe(this,2)" type="button">Vận chuyển</button>
                        <button class="xf-btn" onclick="filterXe(this,3)" type="button">Bảo trì</button>
                    </div>
                    <div id="xe-list"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="footer">
        <span>© Hệ thống quản lý kho — Điều độ xuất</span>
        <span id="footer-time"></span>
    </div>
</div>

@section Scripts {
    <script>
        var phieuData = [], xeData = [], cuaData = [];
        var curFilter = 'all', curXeFilter = 'all';
        var ttLabels = ['Chờ xuất','Đang xuất','Quá giờ','Hoàn thành','Đã rời kho'];
        var xeTtLabels = ['Trong bãi','Đang phân công','Đang vận chuyển','Bảo trì'];

        // ── ĐỒNG HỒ ──
        function tick() {
            var n = new Date();
            document.getElementById('clock').textContent = n.toLocaleTimeString('vi-VN',{hour12:false});
            document.getElementById('date-str').textContent = n.toLocaleDateString('vi-VN',{weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'});
            document.getElementById('footer-time').textContent = 'Cập nhật: ' + n.toLocaleTimeString('vi-VN');
        }
        setInterval(tick,1000); tick();

        var pad = s => String(s).padStart(2,'0');
        function nowLocal(addMin) {
            var d = new Date(Date.now()+(addMin||0)*60000);
            return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
        }
        document.getElementById('inp-tgpc').value = nowLocal(0);

        // ── SIGNALR ──
        var conn = new signalR.HubConnectionBuilder().withUrl('/signalserver').withAutomaticReconnect().build();

        // ── 1. Reload dropdown xe TrongBai sau mỗi thay đổi ──
        async function reloadXeDropdown() {
            try {
                var res = await fetch('@Url.Action("GetXeTrongBai", "DieuDoXuat")');
                if (!res.ok) return;
                var xes = await res.json();

                var sel = document.getElementById('sel-xe');
                var curVal = sel.value;
                sel.innerHTML = '<option value="">-- Chọn xe --</option>';

                xes.forEach(x => {
                    var bienSo   = x.bienSoXe  ?? x.BienSoXe  ?? '--';
                    var loai     = x.loaiXe    ?? x.LoaiXe    ?? '--';
                    var tai      = x.taiTrong  ?? x.TaiTrong  ?? 0;
                    var tenTaiXe = x.tenTaiXe  ?? x.TenTaiXe  ?? 'Chưa có tài xế';
                    var tel      = x.telTaiXe  ?? x.TelTaiXe  ?? '--';
                    var id       = x.id        ?? x.Id;

                    var opt = document.createElement('option');
                    opt.value = id;
                    opt.textContent = bienSo;
                    opt.dataset.loai   = loai;
                    opt.dataset.tai    = tai;
                    opt.dataset.taixe  = tenTaiXe;
                    opt.dataset.tel    = tel;
                    sel.appendChild(opt);
                });

                // Nếu xe đang chọn không còn trong danh sách rảnh → reset
                var stillValid = Array.from(sel.options).some(o => o.value === curVal);
                if (curVal && !stillValid) {
                    sel.value = '';
                    document.getElementById('xe-info').classList.remove('show');
                }
            } catch(e) { console.error('reloadXeDropdown:', e); }
        }

        // ── 2. Reload dropdown cửa trống sau mỗi thay đổi ──
        async function reloadCuaDropdown() {
            try {
                var res = await fetch('@Url.Action("GetCuaTrong", "DieuDoXuat")');
                if (!res.ok) return;
                var cuas = await res.json();

                var sel = document.getElementById('sel-cua');
                var curVal = sel.value;
                sel.innerHTML = '<option value="">-- Chọn cửa --</option>';

                cuas.forEach(c => {
                    var id  = c.id  ?? c.Id;
                    var ten = c.ten ?? c.Ten ?? '--';
                    var opt = document.createElement('option');
                    opt.value = id;
                    opt.textContent = ten;
                    sel.appendChild(opt);
                });

                // Nếu cửa đang chọn không còn trống → reset
                var stillValid = Array.from(sel.options).some(o => o.value === curVal);
                if (curVal && !stillValid) {
                    sel.value = '';
                }
            } catch(e) { console.error('reloadCuaDropdown:', e); }
        }

        // ── 3. Hàm tổng reload tất cả sau mỗi thay đổi ──
        var _reloading = false;
        async function reloadAll() {
            if (_reloading) return;
            _reloading = true;
            try {
                await loadPhieu();

                // Chỉ reload dropdown nếu người dùng KHÔNG đang chọn dở
                var dangChonXe  = document.getElementById('sel-xe').value;
                var dangChonCua = document.getElementById('sel-cua').value;

                if (!dangChonXe)  await reloadXeDropdown();
                if (!dangChonCua) await reloadCuaDropdown();

                if (document.getElementById('panel-xe').style.display !== 'none') {
                    await loadXeSidebar();
                }
            } finally {
                _reloading = false;
            }
        }

        // ── SignalR — dùng reloadAll thay vì chỉ loadPhieu ──
        conn.on('UpdateBangTongHopXuat', function() {
           loadPhieu();
        });

        conn.start().then(function() {
            document.getElementById('sig-dot').classList.add('on');
            document.getElementById('sig-text').textContent = 'Realtime';
        }).catch(function() {
            document.getElementById('sig-dot').classList.add('err');
            document.getElementById('sig-text').textContent = 'Mất kết nối';
        });

        // ── LOAD DATA ──
        async function loadPhieu() {
            try {
                var res = await fetch('@Url.Action("GetPhieuHomNay", "DieuDoXuat")');
                if (!res.ok) return;
                phieuData = await res.json();
                renderTable(); updateStats(); updateCuaFromPhieu();
            } catch(e) { console.error('loadPhieu:', e); }
        }

        async function loadXeSidebar() {
            try {
                var res = await fetch('@Url.Action("GetDanhSachXe", "DieuDoXuat")');
                if (!res.ok) return;
                xeData = await res.json();
                renderXeSidebar();
            } catch(e) { console.error('loadXe:', e); }
        }

        // ── RENDER TABLE ──
        function renderTable() {
            var filtered = curFilter === 'all' ? phieuData : phieuData.filter(p => (p.trangThai ?? p.TrangThai) == curFilter);
            document.getElementById('phieu-count').textContent = filtered.length + ' phiếu';
            var tbody = document.getElementById('phieu-tbody');
            if (!filtered.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="empty-cell">Chưa có phiếu xuất hôm nay</td></tr>';
                return;
            }
            tbody.innerHTML = filtered.map(p => {
                var id         = p.id         ?? p.Id;
                var tenCua     = p.tenCua     ?? p.TenCua     ?? '--';
                var bienSoXe   = p.bienSoXe   ?? p.BienSoXe   ?? '--';
                var tenTaiXe   = p.tenTaiXe   ?? p.TenTaiXe   ?? '--';
                var trangThai  = p.trangThai  ?? p.TrangThai  ?? 0;
                var vaoCua     = p.thoiGianVaoCua  ?? p.ThoiGianVaoCua;
                var gioiHan    = p.thoiGianGioiHan ?? p.ThoiGianGioiHan;
                var hangHoas   = p.hangHoas   ?? p.HangHoas   ?? [];

                var hangStr = hangHoas.length
                    ? hangHoas.map(h => {
                        var dv    = h.donVi  ?? h.DonVi  ?? '--';
                        var chua  = h.chuaBG ?? h.ChuaBG ?? 0;
                        var da    = h.daBG   ?? h.DaBG   ?? 0;
                        return '<span class="htag"><span style="color:var(--gold2);">'+chua+'</span>/'+da+' '+dv+'</span>';
                      }).join('')
                    : '<span style="color:var(--text-dim);">--</span>';

                var gioVao = vaoCua ? new Date(vaoCua).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}) : '--:--';
                var conLai = '—';
                if (trangThai === 3 || trangThai === 4) {
                    // Hoàn thành hoặc đã rời kho → không hiện còn lại
                    conLai = '—';
                } else if (gioiHan && trangThai < 3) {
                    var diff = Math.round((new Date(gioiHan) - new Date()) / 60000);
                    conLai = diff > 0 ? diff + ' ph' : '<span style="color:var(--red);font-weight:700;">Quá hạn</span>';
                }
                return '<tr>' +
                    '<td style="color:var(--gold);font-weight:700;">' + tenCua + '</td>' +
                    '<td><div style="color:var(--text-bright);font-weight:700;">' + bienSoXe + '</div>' +
                        '<div style="font-size:10px;color:var(--text-dim);">' + tenTaiXe + '</div></td>' +
                    '<td><div class="hang-tags">' + hangStr + '</div></td>' +
                    '<td><span class="sbadge tt-' + trangThai + '">' + (ttLabels[trangThai] || '--') + '</span></td>' +
                    '<td style="color:var(--text-dim);">' + gioVao + '</td>' +
                    '<td>' + conLai + '</td>' +
                    '<td>' +
                        '<button class="btn-chitiet" onclick="xemChiTiet('+id+')">Chi tiết</button>' +
                        (trangThai <= 1 ? '<button class="btn-huy" onclick="huyPhieu('+id+')">Hủy</button>' : '') +
                    '</td></tr>';
            }).join('');
        }

        function updateStats() {
            document.getElementById('stat-tong').textContent = phieuData.length;
            document.getElementById('stat-cho').textContent  = phieuData.filter(p => (p.trangThai??p.TrangThai) === 0).length;
            document.getElementById('stat-dang').textContent = phieuData.filter(p => { var t=p.trangThai??p.TrangThai; return t>=1&&t<=3; }).length;
            document.getElementById('stat-xong').textContent = phieuData.filter(p => (p.trangThai??p.TrangThai) === 4).length;
        }

        function setFilter(val, btn) {
            curFilter = val;
            document.querySelectorAll('.filter-tabs .ftab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderTable();
        }

        // ── CỬA SIDEBAR ──
        function updateCuaFromPhieu() {
            document.querySelectorAll('.cua-card').forEach(c => {
                c.className = 'cua-card';
                var cuaId = c.dataset.cuaId;
                document.getElementById('cua-status-' + cuaId).innerHTML = '— Trống —';
                document.getElementById('cua-status-' + cuaId).className = 'cua-empty';
            });
                phieuData.filter(p => {
                    var tt = p.trangThai ?? p.TrangThai ?? 0;
                    return tt === 0 || tt === 1 || tt === 2; // Chỉ hiện khi DaPhanCong, DangBanGiao, QuaThoiGian
                }).
                forEach(p => {
                var cuaId    = p.cuaXuatId ?? p.CuaXuatId;
                var tt       = p.trangThai ?? p.TrangThai ?? 0;
                var bienSo   = p.bienSoXe  ?? p.BienSoXe  ?? '--';
                var taiXe    = p.tenTaiXe  ?? p.TenTaiXe  ?? '--';
                var hangHoas = p.hangHoas  ?? p.HangHoas  ?? [];
                var vaoCua   = p.thoiGianVaoCua ?? p.ThoiGianVaoCua;

                var card   = document.getElementById('cua-card-' + cuaId);
                var status = document.getElementById('cua-status-' + cuaId);
                if (!card || !status) return;
                card.className = 'cua-card ' + (tt === 2 ? 'is-over' : 'has-xe');
                var hangHtml = hangHoas.length
                    ? '<div class="cua-hang">' + hangHoas.map(h => {
                        var dv = h.donVi??h.DonVi??'--';
                        var cb = h.chuaBG??h.ChuaBG??0;
                        var db = h.daBG??h.DaBG??0;
                        return '<span class="cua-hang-tag">'+cb+'/'+db+' '+dv+'</span>';
                      }).join('') + '</div>' : '';
                status.className = '';
                status.innerHTML = '<div class="cua-xe">' + bienSo + ' — ' + taiXe + '</div>' +
                    hangHtml +
                    '<div class="cua-footer">' +
                        '<span class="sbadge tt-' + tt + '" style="font-size:9px;">' + (ttLabels[tt]||'--') + '</span>' +
                        (vaoCua ? '<span style="font-size:10px;color:var(--text-dim);">' + new Date(vaoCua).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}) + '</span>' : '') +
                    '</div>';
            });
        }

        function renderXeSidebar() {
            var filtered = curXeFilter === 'all' ? xeData : xeData.filter(x => (x.trangThai??x.TrangThai) == curXeFilter);
            document.getElementById('xe-sidebar-count').textContent = filtered.length + ' xe';
            var el = document.getElementById('xe-list');
            if (!filtered.length) {
                el.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-dim);font-size:11px;font-style:italic;">Không có xe</div>';
                return;
            }
            el.innerHTML = filtered.map(x => {
                var bienSo   = x.bienSoXe  ?? x.BienSoXe  ?? '--';
                var loaiXe   = x.loaiXe    ?? x.LoaiXe    ?? '--';
                var taiTrong = x.taiTrong  ?? x.TaiTrong  ?? 0;
                var tt       = x.trangThai ?? x.TrangThai  ?? 0;
                var tenTaiXe = x.tenTaiXe  ?? x.TenTaiXe  ?? '--';
                var telTaiXe = x.telTaiXe  ?? x.TelTaiXe  ?? '--';
                return '<div class="xe-card">' +
                    '<div class="xe-card-top">' +
                        '<span class="xe-bienso">' + bienSo + '</span>' +
                        '<span class="sbadge xe-tt-' + tt + '" style="font-size:9px;">' + (xeTtLabels[tt]||'--') + '</span>' +
                    '</div>' +
                    '<div class="xe-meta">' + loaiXe + ' — ' + Number(taiTrong).toLocaleString() + ' kg</div>' +
                    '<div class="xe-meta" style="color:var(--blue2);margin-top:2px;">' + tenTaiXe + ' | ' + telTaiXe + '</div>' +
                    '</div>';
            }).join('');
        }

        function filterXe(btn, val) {
            document.querySelectorAll('.xf-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            curXeFilter = val;
            renderXeSidebar();
        }

        function switchTab(tab) {
            document.getElementById('stab-cua').classList.toggle('active', tab === 'cua');
            document.getElementById('stab-xe').classList.toggle('active', tab === 'xe');
            document.getElementById('panel-cua').style.display = tab === 'cua' ? 'block' : 'none';
            document.getElementById('panel-xe').style.display  = tab === 'xe'  ? 'block' : 'none';
            if (tab === 'xe') loadXeSidebar();
        }

        // ── FORM ──
        function onXeChange() {
            var sel = document.getElementById('sel-xe');
            var opt = sel.options[sel.selectedIndex];
            var info = document.getElementById('xe-info');
            if (!sel.value) { info.classList.remove('show'); return; }
            document.getElementById('xi-loai').textContent  = opt.dataset.loai  || '--';
            document.getElementById('xi-tai').textContent   = Number(opt.dataset.tai || 0).toLocaleString() + ' kg';
            document.getElementById('xi-taixe').textContent = opt.dataset.taixe || 'Chưa có tài xế';
            document.getElementById('xi-tel').textContent   = opt.dataset.tel   || '--';
            info.classList.add('show');
        }

        function addHang() {
            var list = document.getElementById('hang-list');
            var row = document.createElement('div');
            row.className = 'hang-row';
            row.innerHTML = '<input class="hang-input" placeholder="Đơn vị..."/><input class="hang-input" type="number" placeholder="Số lượng" min="0"/><button class="btn-remove" onclick="removeHang(this)" type="button">×</button>';
            list.appendChild(row);
        }

        function removeHang(btn) {
            var rows = document.querySelectorAll('#hang-list .hang-row');
            if (rows.length > 1) btn.parentElement.remove();
        }

        function resetForm() {
            document.getElementById('sel-xe').value = '';
            document.getElementById('sel-cua').value = '';
            document.getElementById('sel-nv').value = '';
            document.getElementById('xe-info').classList.remove('show');
            document.getElementById('inp-tgpc').value = nowLocal(0);
            document.getElementById('inp-ghichu').value = '';
            document.getElementById('hang-list').innerHTML = '<div class="hang-row"><input class="hang-input" placeholder="Đơn vị..."/><input class="hang-input" type="number" placeholder="Số lượng" min="0"/><button class="btn-remove" onclick="removeHang(this)" type="button">×</button></div>';
            document.getElementById('form-status').textContent = '';
        }

        // ── submitForm — bỏ location.reload(), dùng reloadAll() ──
        async function submitForm() {
            var xeSel  = document.getElementById('sel-xe');
            var cuaSel = document.getElementById('sel-cua');
            if (!xeSel.value || !cuaSel.value) { alert('Vui lòng chọn xe và cửa xuất!'); return; }

            var hangRows = document.querySelectorAll('#hang-list .hang-row');
            var hangs = [];
            hangRows.forEach(r => {
                var inputs = r.querySelectorAll('input');
                var dv = inputs[0].value.trim();
                var sl = parseInt(inputs[1].value) || 0;
                if (dv && sl > 0) hangs.push({ donVi: dv, soLuong: sl });
            });

            var payload = {
                xeId:              parseInt(xeSel.value),
                cuaXuatId:         parseInt(cuaSel.value),
                nhanVienXacNhanId: parseInt(document.getElementById('sel-nv').value) || null,
                thoiGianPhanCong:  document.getElementById('inp-tgpc').value || null,
                ghiChu:            document.getElementById('inp-ghichu').value || null,
                hangHoas:          hangs
            };

            var btn = document.getElementById('btn-submit');
            btn.disabled = true; btn.textContent = '⏳ Đang tạo...';
            try {
                var res = await fetch('@Url.Action("TaoPhanCong", "DieuDoXuat")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                var data = await res.json();
                if (res.ok) {
                    document.getElementById('form-status').textContent = '✔ Tạo phiếu thành công!';
                    setTimeout(() => {
                        document.getElementById('form-status').textContent = '';
                    }, 5000);
                    resetForm();
                    await reloadAll();
                
                } else {
                    alert('❌ ' + (data.message || 'Lỗi tạo phiếu!') + (data.inner ? '\n' + data.inner : ''));
                }
            } catch(e) {
                alert('❌ Lỗi kết nối server');
            } finally {
                btn.disabled = false; btn.textContent = '✔ Tạo phiếu xuất';
            }
        }

        function xemChiTiet(id) {
            var p = phieuData.find(x => (x.id??x.Id) === id);
            if (!p) return;
            var tt  = p.trangThai ?? p.TrangThai ?? 0;
            var msg = '=== Chi tiết phiếu #' + id + ' ===\n' +
                'Cửa: '       + (p.tenCua??p.TenCua??'--') +
                '\nXe: '       + (p.bienSoXe??p.BienSoXe??'--') +
                '\nTài xế: '   + (p.tenTaiXe??p.TenTaiXe??'--') +
                '\nNV XN: '    + (p.tenNhanVien??p.TenNhanVien??'--') +
                '\nTrạng thái: '+ (ttLabels[tt]||'--') +
                '\nGiờ phân công: ' + (p.thoiGianPhanCong??p.ThoiGianPhanCong ? new Date(p.thoiGianPhanCong??p.ThoiGianPhanCong).toLocaleString('vi-VN') : '--') +
                '\nGiờ vào cửa: '  + (p.thoiGianVaoCua??p.ThoiGianVaoCua   ? new Date(p.thoiGianVaoCua??p.ThoiGianVaoCua).toLocaleString('vi-VN')   : '--') +
                '\nGiờ giới hạn: ' + (p.thoiGianGioiHan??p.ThoiGianGioiHan ? new Date(p.thoiGianGioiHan??p.ThoiGianGioiHan).toLocaleString('vi-VN') : '--') +
                '\nHàng hóa: ' + (p.hangHoas??p.HangHoas??[]).map(h => (h.chuaBG??h.ChuaBG??0)+'/'+(h.daBG??h.DaBG??0)+' '+(h.donVi??h.DonVi??'--')).join(', ');
            alert(msg);
        }

        // ── huyPhieu — dùng reloadAll() thay vì chỉ loadPhieu() ──
        async function huyPhieu(id) {
            if (!confirm('Xác nhận hủy phiếu này? Xe sẽ trở về Trong bãi.')) return;
            try {
                var res = await fetch('@Url.Action("HuyPhanCong", "DieuDoXuat")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ xuatId: id })
                });
                var data = await res.json();
                if (res.ok) {
                    // Reload tất cả — không cần reload trang
                    await reloadAll();
                } else {
                    alert('❌ ' + (data.message || 'Lỗi hủy!'));
                }
            } catch(e) { alert('❌ Lỗi kết nối'); }
        }
        // ── Khởi động — dùng reloadAll thay vì chỉ loadPhieu ──
        reloadAll();
        setInterval(reloadAll, 30000);
    </script>
}
