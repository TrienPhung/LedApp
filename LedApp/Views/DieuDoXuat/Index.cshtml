@{
    ViewData["Title"] = "Điều độ phân cửa xuất";
    Layout = "~/Views/Shared/_LayoutApi.cshtml";
    var cuaXuats = ViewBag.CuaXuats as List<LedApp.Models.CuaXuat> ?? new();
    var xeTrongBai = ViewBag.XeTrongBai as List<LedApp.Models.DanhSachXe> ?? new();
    var nhanViens = ViewBag.NhanViens as List<LedApp.Models.nguoiDungs> ?? new();

    var userName = ViewBag.UserName as string ?? User.Identity?.Name ?? "User";
    var userEmail = ViewBag.UserEmail as string ?? "";
    var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[^1][0]}"
        : userName.Length >= 2 ? userName[..2] : userName;
    initials = initials.ToUpper();
}

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --bg: #080d18;
        --surface: #0d1525;
        --surface2: #111d30;
        --border: #1a2d4a;
        --border2: #243b5e;
        --gold: #f59e0b;
        --gold2: #fbbf24;
        --green: #22c55e;
        --red: #ef4444;
        --orange: #f97316;
        --blue: #0ea5e9;
        --blue2: #38bdf8;
        --purple: #a855f7;
        --text: #cbd5e1;
        --text-dim: #475569;
        --text-bright: #f1f5f9;
        --dropdown-bg: #0d1525;
        --dropdown-border: #243b5e;
        --dropdown-hover: rgba(245,158,11,.08);
        --divider: rgba(255,255,255,.07);
    }

    body.light-mode {
        --bg: #f0f4f8;
        --surface: #ffffff;
        --surface2: #f8fafc;
        --border: #e2e8f0;
        --border2: #cbd5e1;
        --gold: #d97706;
        --gold2: #f59e0b;
        --green: #16a34a;
        --red: #dc2626;
        --orange: #ea580c;
        --blue: #0284c7;
        --blue2: #0ea5e9;
        --purple: #9333ea;
        --text: #334155;
        --text-dim: #94a3b8;
        --text-bright: #0f172a;
        --dropdown-bg: #ffffff;
        --dropdown-border: #e2e8f0;
        --dropdown-hover: rgba(217,119,6,.06);
        --divider: rgba(0,0,0,.08);
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Courier New', monospace;
        min-height: 100vh;
        overflow-x: hidden;
        transition: background .3s, color .3s;
    }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: linear-gradient(rgba(245,158,11,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(245,158,11,.03) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
            z-index: 0;
            transition: opacity .3s;
        }

        body.light-mode::before {
            opacity: 0.4;
        }

    .screen {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 12px;
        gap: 10px;
    }

    /* ── TOPBAR ── */
    .topbar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--border);
    
        border-radius: 6px;
        padding: 10px 20px;
        flex-shrink: 0;
        transition: background .3s, border-color .3s;
    }

    .tb-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .tb-logo {
        width: 36px;
        height: 36px;
        background: var(--gold);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .tb-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-bright);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .tb-sub {
        font-size: 10px;
        color: var(--text-dim);
        letter-spacing: 1px;
        margin-top: 1px;
    }

    .tb-clock {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 4px;
        font-variant-numeric: tabular-nums;
    }

    .tb-date {
        font-size: 10px;
        color: var(--text-dim);
        text-align: center;
        letter-spacing: 1px;
        margin-top: 2px;
    }

    .tb-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .stat-pill {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 6px 12px;
        text-align: center;
        min-width: 65px;
        transition: background .3s;
    }

        .stat-pill .num {
            font-size: 18px;
            font-weight: 700;
        }

        .stat-pill .lbl {
            font-size: 9px;
            color: var(--text-dim);
            letter-spacing: 1px;
            margin-top: 1px;
            text-transform: uppercase;
        }

    .signal-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 6px 10px;
        font-size: 10px;
        color: var(--text-dim);
        transition: background .3s;
    }

    .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--text-dim);
        flex-shrink: 0;
    }

        .dot.on {
            background: var(--green);
            box-shadow: 0 0 6px var(--green);
            animation: blink 2s infinite;
        }

        .dot.err {
            background: var(--red);
        }

    @@keyframes blink {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .4
        }
    }

    /* ── DIVIDER ── */
    .tb-divider {
        width: 1px;
        height: 28px;
        background: var(--divider);
        border-radius: 1px;
        flex-shrink: 0;
    }

    /* ── THEME TOGGLE ── */
    .theme-toggle {
        width: 34px;
        height: 34px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
        transition: background .2s, border-color .2s;
        flex-shrink: 0;
        color: var(--text-dim);
    }

    .theme-toggle:hover {
         border-color: var(--gold);
         background: rgba(245,158,11,.08);
         color: var(--gold);
    }

    /* ── USER AVATAR BUTTON ── */
    .user-btn {
        position: relative;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, var(--gold), var(--orange));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        color: #0a0e18;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color .2s, transform .15s;
        letter-spacing: .5px;
        font-family: inherit;
        flex-shrink: 0;
        user-select: none;
    }

        .user-avatar:hover {
            border-color: var(--gold);
            transform: scale(1.05);
        }

        .user-avatar.open {
            border-color: var(--gold);
        }

    /* ── DROPDOWN ── */
    .user-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 10px);
        width: 220px;
        background: var(--dropdown-bg);
        border: 1px solid var(--dropdown-border);
        border-radius: 10px;
        z-index: 999;
        box-shadow: 0 16px 40px rgba(0,0,0,.5);
        overflow: hidden;
        animation: dropIn .15s ease;
        transition: background .3s;
    }

        .user-dropdown.show {
            display: block;
        }

    @@keyframes dropIn {
        from {
            opacity: 0;
            transform: translateY(-6px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .ud-header {
        padding: 14px 16px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ud-avatar-lg {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--gold), var(--orange));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 800;
        color: #0a0e18;
        flex-shrink: 0;
    }

    .ud-info .ud-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-bright);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 130px;
    }

    .ud-info .ud-role {
        font-size: 10px;
        color: var(--text-dim);
        margin-top: 2px;
        letter-spacing: .5px;
    }

    .ud-divider {
        height: 1px;
        background: var(--divider);
        margin: 0 12px;
    }

    .ud-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text);
        cursor: pointer;
        transition: background .15s, color .15s;
        text-decoration: none;
        font-family: inherit;
        background: transparent;
        border: none;
        width: 100%;
        text-align: left;
        letter-spacing: .3px;
    }

        .ud-item:hover {
            background: var(--dropdown-hover);
            color: var(--gold);
        }

        .ud-item.danger {
            color: var(--red);
        }

            .ud-item.danger:hover {
                background: rgba(239,68,68,.08);
                color: var(--red);
            }

    .ud-item-icon {
        font-size: 14px;
        width: 18px;
        text-align: center;
        flex-shrink: 0;
    }

    /* ── MAIN LAYOUT ── */
    .main {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 10px;
        overflow: hidden;
    }

    .left-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
        min-height: 0;
    }

        .left-col::-webkit-scrollbar {
            width: 4px;
        }

        .left-col::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 2px;
        }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        transition: background .3s, border-color .3s;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
    }

    .panel-title {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--gold);
    }

    .panel-body {
        padding: 14px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        margin-bottom: 12px;
        align-items: start;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .form-label {
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text-dim);
    }

    .form-control {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 8px 10px;
        color: var(--text-bright);
        font-size: 12px;
        font-family: inherit;
        outline: none;
        width: 100%;
        transition: border-color .15s, background .3s;
    }

        .form-control:focus {
            border-color: var(--gold);
        }

    .xe-info-box {
        background: rgba(245,158,11,.06);
        border: 1px solid rgba(245,158,11,.2);
        border-radius: 4px;
        padding: 8px 10px;
        margin-top: 5px;
        display: none;
    }

        .xe-info-box.show {
            display: block;
        }

    .xi-row {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        margin-bottom: 2px;
    }

    .xi-lbl {
        color: var(--text-dim);
    }

    .xi-val {
        color: var(--gold2);
        font-weight: 700;
    }

    .hang-section {
        border-top: 1px solid var(--border);
        padding-top: 12px;
        margin-top: 4px;
    }

    .hang-section-title {
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text-dim);
        margin-bottom: 8px;
    }

    .hang-row {
        display: grid;
        grid-template-columns: 1fr 110px 30px;
        gap: 6px;
        align-items: center;
        margin-bottom: 6px;
    }

    .hang-input {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 7px 8px;
        color: var(--text-bright);
        font-size: 12px;
        font-family: inherit;
        outline: none;
        width: 100%;
        transition: border-color .15s;
    }

        .hang-input:focus {
            border-color: var(--gold);
        }

    .btn-remove {
        background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.2);
        border-radius: 4px;
        width: 28px;
        height: 28px;
        color: var(--red);
        cursor: pointer;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: inherit;
    }

    .btn-add-hang {
        background: rgba(34,197,94,.08);
        border: 1px solid rgba(34,197,94,.2);
        border-radius: 4px;
        padding: 6px 12px;
        color: var(--green);
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        margin-top: 2px;
    }

        .btn-add-hang:hover {
            background: rgba(34,197,94,.15);
        }

    .form-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 14px;
        border-top: 1px solid var(--border);
        padding-top: 12px;
    }

    .btn-reset {
        background: transparent;
        border: 1px solid var(--border2);
        color: var(--text-dim);
        padding: 8px 16px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-reset:hover {
            border-color: var(--text-dim);
            color: var(--text);
        }

    .btn-submit {
        background: var(--gold);
        color: #0a0e18;
        border: none;
        padding: 8px 22px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        letter-spacing: .5px;
    }

        .btn-submit:hover {
            background: var(--gold2);
        }

        .btn-submit:disabled {
            background: #1e293b;
            color: #334155;
            cursor: not-allowed;
        }

    .filter-tabs {
        display: flex;
        gap: 4px;
        padding: 8px 16px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .ftab {
        padding: 4px 10px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        cursor: pointer;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-dim);
        font-family: inherit;
    }

        .ftab:hover {
            border-color: var(--border2);
            color: var(--text);
        }

        .ftab.active {
            background: var(--gold);
            border-color: var(--gold);
            color: #0a0e18;
        }

    .table-wrap {
        overflow-x: auto;
    }

    .xe-table {
        width: 100%;
        border-collapse: collapse;
    }

        .xe-table thead th {
            padding: 8px 12px;
            font-size: 9px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--text-dim);
            border-bottom: 1px solid var(--border);
            text-align: left;
            background: var(--surface);
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .xe-table tbody tr {
            border-bottom: 1px solid var(--border);
        }

            .xe-table tbody tr:hover {
                background: var(--surface2);
            }

        .xe-table td {
            padding: 9px 12px;
            font-size: 12px;
            vertical-align: middle;
        }

    .sbadge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .tt-0 {
        background: rgba(100,116,139,.15);
        color: #94a3b8;
        border: 1px solid #334155;
    }

    .tt-1 {
        background: rgba(245,158,11,.15);
        color: var(--gold);
        border: 1px solid rgba(245,158,11,.3);
    }

    .tt-2 {
        background: rgba(239,68,68,.15);
        color: var(--red);
        border: 1px solid rgba(239,68,68,.3);
    }

    .tt-3 {
        background: rgba(34,197,94,.15);
        color: var(--green);
        border: 1px solid rgba(34,197,94,.3);
    }

    .tt-4 {
        background: rgba(168,85,247,.15);
        color: var(--purple);
        border: 1px solid rgba(168,85,247,.3);
    }

    .xe-tt-0 {
        background: rgba(34,197,94,.12);
        color: var(--green);
        border: 1px solid rgba(34,197,94,.25);
    }

    .xe-tt-1 {
        background: rgba(245,158,11,.12);
        color: var(--gold);
        border: 1px solid rgba(245,158,11,.25);
    }

    .xe-tt-2 {
        background: rgba(168,85,247,.12);
        color: var(--purple);
        border: 1px solid rgba(168,85,247,.25);
    }

    .xe-tt-3 {
        background: rgba(239,68,68,.12);
        color: var(--red);
        border: 1px solid rgba(239,68,68,.25);
    }

    .btn-huy {
        background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.2);
        border-radius: 3px;
        padding: 4px 10px;
        color: var(--red);
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-huy:hover {
            background: rgba(239,68,68,.2);
        }

    .btn-chitiet {
        background: rgba(14,165,233,.1);
        border: 1px solid rgba(14,165,233,.2);
        border-radius: 3px;
        padding: 4px 10px;
        color: var(--blue);
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        margin-right: 4px;
    }

    .sidebar {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: background .3s;
    }

    .stabs {
        display: flex;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .stab {
        flex: 1;
        padding: 10px 6px;
        text-align: center;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        color: var(--text-dim);
        border-bottom: 2px solid transparent;
        font-family: inherit;
        background: transparent;
        border-top: none;
        border-left: none;
        border-right: none;
    }

        .stab.active {
            color: var(--gold);
            border-bottom-color: var(--gold);
            background: rgba(245,158,11,.05);
        }

    .sidebar-body {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
    }

        .sidebar-body::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 2px;
        }

    .cua-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-left: 3px solid var(--border2);
        border-radius: 5px;
        padding: 10px 12px;
        margin-bottom: 7px;
    }

        .cua-card.has-xe {
            border-left-color: var(--orange);
        }

        .cua-card.is-over {
            border-left-color: var(--red);
        }

    .cua-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-bright);
        margin-bottom: 3px;
    }

    .cua-xe {
        font-size: 11px;
        color: var(--gold);
    }

    .cua-empty {
        font-size: 10px;
        color: var(--text-dim);
        font-style: italic;
    }

    .cua-hang {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 5px;
    }

    .cua-hang-tag {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 3px;
        padding: 2px 6px;
        font-size: 10px;
        color: var(--gold2);
    }

    .cua-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 6px;
    }

    .xe-filter {
        display: flex;
        gap: 4px;
        margin-bottom: 8px;
        flex-wrap: wrap;
    }

    .xf-btn {
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 3px 9px;
        font-size: 10px;
        font-weight: 700;
        color: var(--text-dim);
        cursor: pointer;
        font-family: inherit;
    }

        .xf-btn.active {
            background: rgba(34,197,94,.1);
            border-color: rgba(34,197,94,.3);
            color: var(--green);
        }

    .xe-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 10px 12px;
        margin-bottom: 7px;
    }

    .xe-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

