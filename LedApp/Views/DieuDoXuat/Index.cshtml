@{
    ViewData["Title"] = "Điều độ phân cửa xuất";
    Layout = "~/Views/Shared/_LayoutApi.cshtml";
    var cuaXuats = ViewBag.CuaXuats as List<LedApp.Models.CuaXuat> ?? new();
    var xeTrongBai = ViewBag.XeTrongBai as List<LedApp.Models.DanhSachXe> ?? new();
    var nhanViens = ViewBag.NhanViens as List<LedApp.Models.nguoiDungs> ?? new();

    var userName = ViewBag.UserName as string ?? User.Identity?.Name ?? "User";
    var userEmail = ViewBag.UserEmail as string ?? "";
    var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[^1][0]}"
        : userName.Length >= 2 ? userName[..2] : userName;
    initials = initials.ToUpper();
}

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --bg: #080d18;
        --surface: #0d1525;
        --surface2: #111d30;
        --border: #1a2d4a;
        --border2: #243b5e;
        --gold: #f59e0b;
        --gold2: #fbbf24;
        --green: #22c55e;
        --red: #ef4444;
        --orange: #f97316;
        --blue: #0ea5e9;
        --blue2: #38bdf8;
        --purple: #a855f7;
        --text: #cbd5e1;
        --text-dim: #475569;
        --text-bright: #f1f5f9;
        --dropdown-bg: #0d1525;
        --dropdown-border: #243b5e;
        --dropdown-hover: rgba(245,158,11,.08);
        --divider: rgba(255,255,255,.07);
    }

    body.light-mode {
        --bg: #f0f4f8;
        --surface: #ffffff;
        --surface2: #f8fafc;
        --border: #e2e8f0;
        --border2: #cbd5e1;
        --gold: #d97706;
        --gold2: #f59e0b;
        --green: #16a34a;
        --red: #dc2626;
        --orange: #ea580c;
        --blue: #0284c7;
        --blue2: #0ea5e9;
        --purple: #9333ea;
        --text: #334155;
        --text-dim: #94a3b8;
        --text-bright: #0f172a;
        --dropdown-bg: #ffffff;
        --dropdown-border: #e2e8f0;
        --dropdown-hover: rgba(217,119,6,.06);
        --divider: rgba(0,0,0,.08);
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Courier New', monospace;
        min-height: 100vh;
        overflow-x: hidden;
        transition: background .3s, color .3s;
    }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: linear-gradient(rgba(245,158,11,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(245,158,11,.03) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
            z-index: 0;
            transition: opacity .3s;
        }

        body.light-mode::before {
            opacity: 0.4;
        }

    .screen {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 12px;
        gap: 10px;
    }

    /* ── TOPBAR ── */
    .topbar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-top: 2px solid var(--gold);
        border-radius: 6px;
        padding: 10px 20px;
        flex-shrink: 0;
        transition: background .3s, border-color .3s;
    }

    .tb-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .tb-logo {
        width: 36px;
        height: 36px;
        background: var(--gold);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .tb-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-bright);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .tb-sub {
        font-size: 10px;
        color: var(--text-dim);
        letter-spacing: 1px;
        margin-top: 1px;
    }

    .tb-clock {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 4px;
        font-variant-numeric: tabular-nums;
    }

    .tb-date {
        font-size: 10px;
        color: var(--text-dim);
        text-align: center;
        letter-spacing: 1px;
        margin-top: 2px;
    }

    .tb-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .stat-pill {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 6px 12px;
        text-align: center;
        min-width: 65px;
        transition: background .3s;
    }

        .stat-pill .num {
            font-size: 18px;
            font-weight: 700;
        }

        .stat-pill .lbl {
            font-size: 9px;
            color: var(--text-dim);
            letter-spacing: 1px;
            margin-top: 1px;
            text-transform: uppercase;
        }

    .signal-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 6px 10px;
        font-size: 10px;
        color: var(--text-dim);
        transition: background .3s;
    }

    .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--text-dim);
        flex-shrink: 0;
    }

        .dot.on {
            background: var(--green);
            box-shadow: 0 0 6px var(--green);
            animation: blink 2s infinite;
        }

        .dot.err {
            background: var(--red);
        }

    @@keyframes blink {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .4
        }
    }

    /* ── DIVIDER ── */
    .tb-divider {
        width: 1px;
        height: 28px;
        background: var(--divider);
        border-radius: 1px;
        flex-shrink: 0;
    }

    /* ── THEME TOGGLE ── */
    .theme-toggle {
        width: 34px;
        height: 34px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
        transition: background .2s, border-color .2s;
        flex-shrink: 0;
    }

        .theme-toggle:hover {
            border-color: var(--gold);
            background: rgba(245,158,11,.08);
        }

    /* ── USER AVATAR BUTTON ── */
    .user-btn {
        position: relative;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, var(--gold), var(--orange));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        color: #0a0e18;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color .2s, transform .15s;
        letter-spacing: .5px;
        font-family: inherit;
        flex-shrink: 0;
        user-select: none;
    }

        .user-avatar:hover {
            border-color: var(--gold);
            transform: scale(1.05);
        }

        .user-avatar.open {
            border-color: var(--gold);
        }

    /* ── DROPDOWN ── */
    .user-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 10px);
        width: 220px;
        background: var(--dropdown-bg);
        border: 1px solid var(--dropdown-border);
        border-radius: 10px;
        z-index: 999;
        box-shadow: 0 16px 40px rgba(0,0,0,.5);
        overflow: hidden;
        animation: dropIn .15s ease;
        transition: background .3s;
    }

        .user-dropdown.show {
            display: block;
        }

    @@keyframes dropIn {
        from {
            opacity: 0;
            transform: translateY(-6px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .ud-header {
        padding: 14px 16px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ud-avatar-lg {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--gold), var(--orange));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 800;
        color: #0a0e18;
        flex-shrink: 0;
    }

    .ud-info .ud-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-bright);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 130px;
    }

    .ud-info .ud-role {
        font-size: 10px;
        color: var(--text-dim);
        margin-top: 2px;
        letter-spacing: .5px;
    }

    .ud-divider {
        height: 1px;
        background: var(--divider);
        margin: 0 12px;
    }

    .ud-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text);
        cursor: pointer;
        transition: background .15s, color .15s;
        text-decoration: none;
        font-family: inherit;
        background: transparent;
        border: none;
        width: 100%;
        text-align: left;
        letter-spacing: .3px;
    }

        .ud-item:hover {
            background: var(--dropdown-hover);
            color: var(--gold);
        }

        .ud-item.danger {
            color: var(--red);
        }

            .ud-item.danger:hover {
                background: rgba(239,68,68,.08);
                color: var(--red);
            }

    .ud-item-icon {
        font-size: 14px;
        width: 18px;
        text-align: center;
        flex-shrink: 0;
    }

    /* ── MAIN LAYOUT ── */
    .main {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 10px;
        overflow: hidden;
    }

    .left-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
        min-height: 0;
    }

        .left-col::-webkit-scrollbar {
            width: 4px;
        }

        .left-col::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 2px;
        }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        transition: background .3s, border-color .3s;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
    }

    .panel-title {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--gold);
    }

    .panel-body {
        padding: 14px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        margin-bottom: 12px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .form-label {
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text-dim);
    }

    .form-control {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 8px 10px;
        color: var(--text-bright);
        font-size: 12px;
        font-family: inherit;
        outline: none;
        width: 100%;
        transition: border-color .15s, background .3s;
    }

        .form-control:focus {
            border-color: var(--gold);
        }

    .xe-info-box {
        background: rgba(245,158,11,.06);
        border: 1px solid rgba(245,158,11,.2);
        border-radius: 4px;
        padding: 8px 10px;
        margin-top: 5px;
        display: none;
    }

        .xe-info-box.show {
            display: block;
        }

    .xi-row {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        margin-bottom: 2px;
    }

    .xi-lbl {
        color: var(--text-dim);
    }

    .xi-val {
        color: var(--gold2);
        font-weight: 700;
    }

    .hang-section {
        border-top: 1px solid var(--border);
        padding-top: 12px;
        margin-top: 4px;
    }

    .hang-section-title {
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text-dim);
        margin-bottom: 8px;
    }

    .hang-row {
        display: grid;
        grid-template-columns: 1fr 110px 30px;
        gap: 6px;
        align-items: center;
        margin-bottom: 6px;
    }

    .hang-input {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 7px 8px;
        color: var(--text-bright);
        font-size: 12px;
        font-family: inherit;
        outline: none;
        width: 100%;
        transition: border-color .15s;
    }

        .hang-input:focus {
            border-color: var(--gold);
        }

    .btn-remove {
        background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.2);
        border-radius: 4px;
        width: 28px;
        height: 28px;
        color: var(--red);
        cursor: pointer;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: inherit;
    }

    .btn-add-hang {
        background: rgba(34,197,94,.08);
        border: 1px solid rgba(34,197,94,.2);
        border-radius: 4px;
        padding: 6px 12px;
        color: var(--green);
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        margin-top: 2px;
    }

        .btn-add-hang:hover {
            background: rgba(34,197,94,.15);
        }

    .form-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 14px;
        border-top: 1px solid var(--border);
        padding-top: 12px;
    }

    .btn-reset {
        background: transparent;
        border: 1px solid var(--border2);
        color: var(--text-dim);
        padding: 8px 16px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-reset:hover {
            border-color: var(--text-dim);
            color: var(--text);
        }

    .btn-submit {
        background: var(--gold);
        color: #0a0e18;
        border: none;
        padding: 8px 22px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        letter-spacing: .5px;
    }

        .btn-submit:hover {
            background: var(--gold2);
        }

        .btn-submit:disabled {
            background: #1e293b;
            color: #334155;
            cursor: not-allowed;
        }

    .filter-tabs {
        display: flex;
        gap: 4px;
        padding: 8px 16px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .ftab {
        padding: 4px 10px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        cursor: pointer;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-dim);
        font-family: inherit;
    }

        .ftab:hover {
            border-color: var(--border2);
            color: var(--text);
        }

        .ftab.active {
            background: var(--gold);
            border-color: var(--gold);
            color: #0a0e18;
        }

    .table-wrap {
        overflow-x: auto;
    }

    .xe-table {
        width: 100%;
        border-collapse: collapse;
    }

        .xe-table thead th {
            padding: 8px 12px;
            font-size: 9px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--text-dim);
            border-bottom: 1px solid var(--border);
            text-align: left;
            background: var(--surface);
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .xe-table tbody tr {
            border-bottom: 1px solid var(--border);
        }

            .xe-table tbody tr:hover {
                background: var(--surface2);
            }

        .xe-table td {
            padding: 9px 12px;
            font-size: 12px;
            vertical-align: middle;
        }

    .sbadge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .tt-0 {
        background: rgba(100,116,139,.15);
        color: #94a3b8;
        border: 1px solid #334155;
    }

    .tt-1 {
        background: rgba(245,158,11,.15);
        color: var(--gold);
        border: 1px solid rgba(245,158,11,.3);
    }

    .tt-2 {
        background: rgba(239,68,68,.15);
        color: var(--red);
        border: 1px solid rgba(239,68,68,.3);
    }

    .tt-3 {
        background: rgba(34,197,94,.15);
        color: var(--green);
        border: 1px solid rgba(34,197,94,.3);
    }

    .tt-4 {
        background: rgba(168,85,247,.15);
        color: var(--purple);
        border: 1px solid rgba(168,85,247,.3);
    }

    .xe-tt-0 {
        background: rgba(34,197,94,.12);
        color: var(--green);
        border: 1px solid rgba(34,197,94,.25);
    }

    .xe-tt-1 {
        background: rgba(245,158,11,.12);
        color: var(--gold);
        border: 1px solid rgba(245,158,11,.25);
    }

    .xe-tt-2 {
        background: rgba(168,85,247,.12);
        color: var(--purple);
        border: 1px solid rgba(168,85,247,.25);
    }

    .xe-tt-3 {
        background: rgba(239,68,68,.12);
        color: var(--red);
        border: 1px solid rgba(239,68,68,.25);
    }

    .btn-huy {
        background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.2);
        border-radius: 3px;
        padding: 4px 10px;
        color: var(--red);
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-huy:hover {
            background: rgba(239,68,68,.2);
        }

    .btn-chitiet {
        background: rgba(14,165,233,.1);
        border: 1px solid rgba(14,165,233,.2);
        border-radius: 3px;
        padding: 4px 10px;
        color: var(--blue);
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        margin-right: 4px;
    }

    .sidebar {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: background .3s;
    }

    .stabs {
        display: flex;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .stab {
        flex: 1;
        padding: 10px 6px;
        text-align: center;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        color: var(--text-dim);
        border-bottom: 2px solid transparent;
        font-family: inherit;
        background: transparent;
        border-top: none;
        border-left: none;
        border-right: none;
    }

        .stab.active {
            color: var(--gold);
            border-bottom-color: var(--gold);
            background: rgba(245,158,11,.05);
        }

    .sidebar-body {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
    }

        .sidebar-body::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 2px;
        }

    .cua-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-left: 3px solid var(--border2);
        border-radius: 5px;
        padding: 10px 12px;
        margin-bottom: 7px;
    }

        .cua-card.has-xe {
            border-left-color: var(--orange);
        }

        .cua-card.is-over {
            border-left-color: var(--red);
        }

    .cua-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-bright);
        margin-bottom: 3px;
    }

    .cua-xe {
        font-size: 11px;
        color: var(--gold);
    }

    .cua-empty {
        font-size: 10px;
        color: var(--text-dim);
        font-style: italic;
    }

    .cua-hang {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 5px;
    }

    .cua-hang-tag {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 3px;
        padding: 2px 6px;
        font-size: 10px;
        color: var(--gold2);
    }

    .cua-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 6px;
    }

    .xe-filter {
        display: flex;
        gap: 4px;
        margin-bottom: 8px;
        flex-wrap: wrap;
    }

    .xf-btn {
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 3px 9px;
        font-size: 10px;
        font-weight: 700;
        color: var(--text-dim);
        cursor: pointer;
        font-family: inherit;
    }

        .xf-btn.active {
            background: rgba(34,197,94,.1);
            border-color: rgba(34,197,94,.3);
            color: var(--green);
        }

    .xe-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 10px 12px;
        margin-bottom: 7px;
    }

    .xe-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    .xe-bienso {
        font-size: 13px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 1px;
    }

    .xe-meta {
        font-size: 10px;
        color: var(--text-dim);
        margin-top: 2px;
    }

    .footer {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 6px 16px;
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        color: var(--text-dim);
        flex-shrink: 0;
        letter-spacing: .5px;
        transition: background .3s;
    }

    .empty-cell {
        text-align: center;
        padding: 30px;
        color: var(--text-dim);
        font-style: italic;
        font-size: 12px;
    }

    .hang-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 3px;
    }

    .htag {
        background: var(--surface2);
        border: 1px solid var(--border);
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 10px;
        color: var(--gold2);
    }

    .ud-badge {
        margin-left: auto;
        background: var(--green);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 20px;
        min-width: 20px;
        text-align: center;
    }

    .ud-item-icon {
        font-size: 15px;
        width: 18px;
        text-align: center;
        flex-shrink: 0;
    }
</style>

<div class="screen">
    <div class="topbar">
        <div class="tb-left">
            <div class="tb-logo">🚛</div>
            <div>
                <div class="tb-title">Điều độ phân cửa xuất</div>
                <div class="tb-sub">Warehouse Control Center — Outbound Gate Assignment</div>
            </div>
        </div>
        <div>
            <div class="tb-clock" id="clock">--:--:--</div>
            <div class="tb-date" id="date-str"></div>
        </div>
        <div class="tb-right">
            <div class="stat-pill"><div class="num" id="stat-tong" style="color:var(--blue);">0</div><div class="lbl">Tổng xe</div></div>
            <div class="stat-pill"><div class="num" id="stat-cho" style="color:#94a3b8;">0</div><div class="lbl">Chờ xuất</div></div>
            <div class="stat-pill"><div class="num" id="stat-dang" style="color:var(--gold);">0</div><div class="lbl">Đang xuất</div></div>
            <div class="stat-pill"><div class="num" id="stat-xong" style="color:var(--green);">0</div><div class="lbl">Đã rời kho</div></div>
            <div class="signal-badge"><span class="dot" id="sig-dot"></span><span id="sig-text">Kết nối...</span></div>

           
            <div class="tb-divider"></div>

            
            <button class="theme-toggle" id="theme-toggle" onclick="toggleTheme()" title="Chế độ sáng/tối">
                🌙
            </button>

            <div class="user-btn" id="user-btn">
                <div class="user-avatar" id="user-avatar" onclick="toggleUserMenu()">
                    @initials
                </div>
                <div class="user-dropdown" id="user-dropdown">
                    <div class="ud-header">
                        <div class="ud-avatar-lg">@initials</div>
                        <div class="ud-info">
                            <div class="ud-name">@userName</div>
                            <div class="ud-role">@userEmail</div>
                        </div>
                    </div>
                    <div class="ud-divider"></div>
                    <a href="#" class="ud-item">
                        <i class="bi bi-gear ud-item-icon"></i>
                        Settings
                    </a>
                    <a href="#" class="ud-item">
                        <i class="bi bi-bell ud-item-icon"></i>
                        Notifications
                        <span class="ud-badge">4</span>
                    </a>
                    <div class="ud-divider"></div>
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index","DieuDoXuat")" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ud-item danger">
                            <i class="bi bi-box-arrow-right ud-item-icon"></i>
                            Log out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="main">
        <div class="left-col">
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">▪ Tạo phiếu xuất mới</span>
                    <span style="font-size:10px;color:var(--text-dim);" id="form-status"></span>
                </div>
                <div class="panel-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Chọn xe (trong bãi)</label>
                            <select class="form-control" id="sel-xe" onchange="onXeChange()">
                                <option value="">-- Chọn xe --</option>
                                @foreach (var xe in xeTrongBai)
                                {
                                    <option value="@xe.Id"
                                            data-loai="@xe.LoaiXe"
                                            data-tai="@xe.TaiTrong"
                                            data-taixe="@(xe.TaiXe != null ? xe.TaiXe.FullName : "Chưa có tài xế")"
                                            data-tel="@(xe.TaiXe != null ? xe.TaiXe.SoDienThoai : "--")">
                                        @xe.BienSoXe
                                    </option>
                                }
                            </select>
                            <div class="xe-info-box" id="xe-info">
                                <div class="xi-row"><span class="xi-lbl">Loại xe</span><span class="xi-val" id="xi-loai">--</span></div>
                                <div class="xi-row"><span class="xi-lbl">Tải trọng</span><span class="xi-val" id="xi-tai">--</span></div>
                                <div class="xi-row"><span class="xi-lbl">Tài xế</span><span class="xi-val" id="xi-taixe">--</span></div>
                                <div class="xi-row"><span class="xi-lbl">SĐT</span><span class="xi-val" id="xi-tel">--</span></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cửa xuất</label>
                            <select class="form-control" id="sel-cua">
                                <option value="">-- Chọn cửa --</option>
                                @foreach (var cua in cuaXuats)
                                {
                                    <option value="@cua.Id">@cua.Ten</option>
                                }
                            </select>
                            <div style="margin-top:8px;">
                                <label class="form-label">Nhân viên xác nhận</label>
                                <div class="form-control"
                                     style="margin-top:5px; color:var(--gold); font-weight:700; cursor:default; user-select:none;">
                                    <i class="bi bi-lock-fill" style="margin-right:6px;"></i>@ViewBag.NguoiDungHienTaiTen
                                </div>
                                <input type="hidden" id="sel-nv" value="@ViewBag.NguoiDungHienTaiId" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Thời gian phân công</label>
                            <input type="datetime-local" class="form-control" id="inp-tgpc" />
                            <div style="margin-top:8px;">
                                <label class="form-label">Ghi chú</label>
                                <input type="text" class="form-control" id="inp-ghichu" placeholder="Ghi chú thêm..." style="margin-top:5px;" />
                            </div>
                        </div>
                    </div>
                    <div class="hang-section">
                        <div class="hang-section-title">Hàng hóa xuất</div>
                        <div id="hang-list">
                            <div class="hang-row">
                                <input class="hang-input" placeholder="Đơn vị (VD: Tải, Kiện, ĐH...)" />
                                <input class="hang-input" type="number" placeholder="Số lượng" min="0" />
                                <button class="btn-remove" onclick="removeHang(this)" type="button">×</button>
                            </div>
                        </div>
                        <button class="btn-add-hang" onclick="addHang()" type="button">+ Thêm hàng hóa</button>
                    </div>
                    <div class="form-actions">
                        <button class="btn-reset" onclick="resetForm()" type="button">⟳ Làm mới</button>
                        <button class="btn-submit" id="btn-submit" onclick="submitForm()" type="button">✔ Tạo phiếu xuất</button>
                    </div>
                </div>
            </div>

            <div class="panel" style="flex:1;min-height:400px;display:flex;flex-direction:column;overflow:hidden;">
                <div class="panel-header">
                    <span class="panel-title">▪ Danh sách phiếu xuất hôm nay</span>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-size:10px;color:var(--text-dim);" id="phieu-count">0 phiếu</span>
                        <button onclick="loadPhieu()" style="background:var(--surface2);border:1px solid var(--border);color:var(--gold);padding:4px 10px;border-radius:3px;font-size:10px;cursor:pointer;font-family:inherit;">⟳ Làm mới</button>
                    </div>
                </div>
                <div class="filter-tabs">
                    <button class="ftab active" onclick="setFilter('all',this)">Tất cả</button>
                    <button class="ftab" onclick="setFilter(0,this)">Chờ xuất</button>
                    <button class="ftab" onclick="setFilter(1,this)">Đang xuất</button>
                    <button class="ftab" onclick="setFilter(2,this)">Quá giờ</button>
                    <button class="ftab" onclick="setFilter(3,this)">Hoàn thành</button>
                    <button class="ftab" onclick="setFilter(4,this)">Đã rời kho</button>
                </div>
                <div style="flex:1;min-height:300px;overflow-y:auto;">
                    <div class="table-wrap">
                        <table class="xe-table">
                            <thead>
                                <tr>
                                    <th style="width:60px;">Cửa</th>
                                    <th style="width:150px;">Xe / Tài xế</th>
                                    <th style="width:180px;">Hàng hóa</th>
                                    <th style="width:100px;">Trạng thái</th>
                                    <th style="width:75px;">Giờ vào</th>
                                    <th style="width:80px;">Còn lại</th>
                                    <th style="width:110px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="phieu-tbody">
                                <tr><td colspan="7" class="empty-cell">Đang tải...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="sidebar">
            <div class="stabs">
                <button class="stab active" id="stab-cua" onclick="switchTab('cua')" type="button">Cửa xuất</button>
                <button class="stab" id="stab-xe" onclick="switchTab('xe')" type="button">Danh sách xe</button>
            </div>
            <div class="sidebar-body">
                <div id="panel-cua">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <span style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--gold);text-transform:uppercase;">Cửa xuất</span>
                        <span style="font-size:10px;color:var(--text-dim);">@cuaXuats.Count cửa</span>
                    </div>
                    <div style="display:flex;gap:4px;margin-bottom:8px;">
                        <button class="xf-btn active" onclick="filterCua(this,'all')" type="button">Tất cả</button>
                        <button class="xf-btn" onclick="filterCua(this,'active')" type="button">
                            <i class="bi bi-door-open"></i> Hoạt động
                        </button>
                        <button class="xf-btn" onclick="filterCua(this,'locked')" type="button">
                            <i class="bi bi-lock-fill"></i> Đã khóa
                        </button>
                    </div>

                    <div id="cua-list">
                        @foreach (var cua in cuaXuats)
                        {
                            <div class="cua-card"
                                 id="cua-card-@cua.Id"
                                 data-cua-id="@cua.Id"
                                 data-active="@cua.IsActive.ToString().ToLower()">
                                <div style="display:flex;justify-content:space-between;align-items:center;">
                                    <div class="cua-name">@cua.Ten</div>
                                    @if (!cua.IsActive)
                                    {
                                        <span style="font-size:10px;color:var(--red);">
                                            <i class="bi bi-lock-fill"></i> Khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-size:10px;color:var(--green);">
                                            <i class="bi bi-door-open"></i> Mở
                                        </span>
                                    }
                                </div>
                                <div class="cua-empty" id="cua-status-@cua.Id">— Trống —</div>
                            </div>
                        }
                    </div>
                </div>
                <div id="panel-xe" style="display:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <span style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--blue2);text-transform:uppercase;">Danh sách xe</span>
                        <span style="font-size:10px;color:var(--text-dim);" id="xe-sidebar-count"></span>
                    </div>
                    <div class="xe-filter">
                        <button class="xf-btn active" onclick="filterXe(this,'all')" type="button">Tất cả</button>
                        <button class="xf-btn" onclick="filterXe(this,0)" type="button">Trong bãi</button>
                        <button class="xf-btn" onclick="filterXe(this,1)" type="button">Phân công</button>
                        <button class="xf-btn" onclick="filterXe(this,2)" type="button">Vận chuyển</button>
                        <button class="xf-btn" onclick="filterXe(this,3)" type="button">Bảo trì</button>
                    </div>
                    <div id="xe-list"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="footer">
        <span>© Hệ thống quản lý kho — Điều độ xuất</span>
        <span id="footer-time"></span>
    </div>
</div>

@section Scripts {
    <script>
        var phieuData = [], xeData = [], cuaData = [];
        var curFilter = 'all', curXeFilter = 'all';
        var ttLabels = ['Chờ xuất','Đang xuất','Quá giờ','Hoàn thành','Đã rời kho'];
        var xeTtLabels = ['Trong bãi','Đang phân công','Đang vận chuyển','Bảo trì'];

        // ── THEME ──
        var isLight = localStorage.getItem('theme') === 'light';
        function applyTheme() {
            document.body.classList.toggle('light-mode', isLight);
            document.getElementById('theme-toggle').textContent = isLight ? '🌙' : '☀️';
        }
        function toggleTheme() {
            isLight = !isLight;
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            applyTheme();
        }
        applyTheme();

        // ── USER MENU ──
        function toggleUserMenu() {
            var dd = document.getElementById('user-dropdown');
            var av = document.getElementById('user-avatar');
            var isOpen = dd.classList.contains('show');
            dd.classList.toggle('show', !isOpen);
            av.classList.toggle('open', !isOpen);
        }
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#user-btn')) {
                document.getElementById('user-dropdown').classList.remove('show');
                document.getElementById('user-avatar').classList.remove('open');
            }
        });

        // ── ĐỒNG HỒ ──
        function tick() {
            var n = new Date();
            document.getElementById('clock').textContent = n.toLocaleTimeString('vi-VN',{hour12:false});
            document.getElementById('date-str').textContent = n.toLocaleDateString('vi-VN',{weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'});
            document.getElementById('footer-time').textContent = 'Cập nhật: ' + n.toLocaleTimeString('vi-VN');
        }
        setInterval(tick,1000); tick();

        var pad = s => String(s).padStart(2,'0');
        function nowLocal(addMin) {
            var d = new Date(Date.now()+(addMin||0)*60000);
            return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
        }
        document.getElementById('inp-tgpc').value = nowLocal(0);

        // ── SIGNALR ──
        var conn = new signalR.HubConnectionBuilder().withUrl('/signalserver').withAutomaticReconnect().build();

        async function reloadXeDropdown() {
            try {
                var res = await fetch('@Url.Action("GetXeTrongBai", "DieuDoXuat")');
                if (!res.ok) return;
                var xes = await res.json();
                var sel = document.getElementById('sel-xe');
                var curVal = sel.value;
                sel.innerHTML = '<option value="">-- Chọn xe --</option>';
                xes.forEach(x => {
                    var opt = document.createElement('option');
                    opt.value = x.id ?? x.Id;
                    opt.textContent = x.bienSoXe ?? x.BienSoXe ?? '--';
                    opt.dataset.loai  = x.loaiXe   ?? x.LoaiXe   ?? '--';
                    opt.dataset.tai   = x.taiTrong  ?? x.TaiTrong  ?? 0;
                    opt.dataset.taixe = x.tenTaiXe  ?? x.TenTaiXe  ?? 'Chưa có tài xế';
                    opt.dataset.tel   = x.telTaiXe  ?? x.TelTaiXe  ?? '--';
                    sel.appendChild(opt);
                });
                var stillValid = Array.from(sel.options).some(o => o.value === curVal);
                if (curVal && !stillValid) { sel.value = ''; document.getElementById('xe-info').classList.remove('show'); }
            } catch(e) {}
        }

        async function reloadCuaDropdown() {
            try {
                var res = await fetch('@Url.Action("GetCuaTrong", "DieuDoXuat")');
                if (!res.ok) return;
                var cuas = await res.json();
                var sel = document.getElementById('sel-cua');
                var curVal = sel.value;
                sel.innerHTML = '<option value="">-- Chọn cửa --</option>';
                cuas.forEach(c => {
                    var opt = document.createElement('option');
                    opt.value = c.id ?? c.Id;
                    opt.textContent = c.ten ?? c.Ten ?? '--';
                    sel.appendChild(opt);
                });
                var stillValid = Array.from(sel.options).some(o => o.value === curVal);
                if (curVal && !stillValid) sel.value = '';
            } catch(e) {}
        }

        var _reloading = false;
        async function reloadAll() {
            if (_reloading) return;
            _reloading = true;
            try {
                await loadPhieu();
                var dangChonXe  = document.getElementById('sel-xe').value;
                var dangChonCua = document.getElementById('sel-cua').value;
                if (!dangChonXe)  await reloadXeDropdown();
                if (!dangChonCua) await reloadCuaDropdown();
                if (document.getElementById('panel-xe').style.display !== 'none') await loadXeSidebar();
            } finally { _reloading = false; }
        }

        conn.on('UpdateBangTongHopXuat', function() { loadPhieu(); });
        conn.start().then(function() {
            document.getElementById('sig-dot').classList.add('on');
            document.getElementById('sig-text').textContent = 'Realtime';
        }).catch(function() {
            document.getElementById('sig-dot').classList.add('err');
            document.getElementById('sig-text').textContent = 'Mất kết nối';
        });

        async function loadPhieu() {
            try {
                var res = await fetch('@Url.Action("GetPhieuHomNay", "DieuDoXuat")');
                if (!res.ok) return;
                phieuData = await res.json();
                renderTable(); updateStats(); updateCuaFromPhieu();
            } catch(e) {}
        }

        async function loadXeSidebar() {
            try {
                var res = await fetch('@Url.Action("GetDanhSachXe", "DieuDoXuat")');
                if (!res.ok) return;
                xeData = await res.json();
                renderXeSidebar();
            } catch(e) {}
        }

        function renderTable() {
            var filtered = curFilter === 'all' ? phieuData : phieuData.filter(p => (p.trangThai ?? p.TrangThai) == curFilter);
            document.getElementById('phieu-count').textContent = filtered.length + ' phiếu';
            var tbody = document.getElementById('phieu-tbody');
            if (!filtered.length) { tbody.innerHTML = '<tr><td colspan="7" class="empty-cell">Chưa có phiếu xuất hôm nay</td></tr>'; return; }
            tbody.innerHTML = filtered.map(p => {
                var id        = p.id         ?? p.Id;
                var tenCua    = p.tenCua     ?? p.TenCua     ?? '--';
                var bienSoXe  = p.bienSoXe   ?? p.BienSoXe   ?? '--';
                var tenTaiXe  = p.tenTaiXe   ?? p.TenTaiXe   ?? '--';
                var trangThai = p.trangThai  ?? p.TrangThai  ?? 0;
                var vaoCua    = p.thoiGianVaoCua  ?? p.ThoiGianVaoCua;
                var gioiHan   = p.thoiGianGioiHan ?? p.ThoiGianGioiHan;
                var hangHoas  = p.hangHoas   ?? p.HangHoas   ?? [];
                var hangStr = hangHoas.length
                    ? hangHoas.map(h => '<span class="htag"><span style="color:var(--gold2);">'+(h.chuaBG??h.ChuaBG??0)+'</span>/'+(h.daBG??h.DaBG??0)+' '+(h.donVi??h.DonVi??'--')+'</span>').join('')
                    : '<span style="color:var(--text-dim);">--</span>';
                var gioVao = vaoCua ? new Date(vaoCua).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}) : '--:--';
                var conLai = '—';
                if (trangThai < 3 && gioiHan) {
                    var diff = Math.round((new Date(gioiHan) - new Date()) / 60000);
                    conLai = diff > 0 ? diff + ' ph' : '<span style="color:var(--red);font-weight:700;">Quá hạn</span>';
                }
                return '<tr>' +
                    '<td style="color:var(--gold);font-weight:700;">'+tenCua+'</td>' +
                    '<td><div style="color:var(--text-bright);font-weight:700;">'+bienSoXe+'</div><div style="font-size:10px;color:var(--text-dim);">'+tenTaiXe+'</div></td>' +
                    '<td><div class="hang-tags">'+hangStr+'</div></td>' +
                    '<td><span class="sbadge tt-'+trangThai+'">'+(ttLabels[trangThai]||'--')+'</span></td>' +
                    '<td style="color:var(--text-dim);">'+gioVao+'</td>' +
                    '<td>'+conLai+'</td>' +
                    '<td><button class="btn-chitiet" onclick="xemChiTiet('+id+')">Chi tiết</button>'+(trangThai<=1?'<button class="btn-huy" onclick="huyPhieu('+id+')">Hủy</button>':'')+'</td>' +
                    '</tr>';
            }).join('');
        }

        function updateStats() {
            document.getElementById('stat-tong').textContent = phieuData.length;
            document.getElementById('stat-cho').textContent  = phieuData.filter(p=>(p.trangThai??p.TrangThai)===0).length;
            document.getElementById('stat-dang').textContent = phieuData.filter(p=>{var t=p.trangThai??p.TrangThai;return t>=1&&t<=3;}).length;
            document.getElementById('stat-xong').textContent = phieuData.filter(p=>(p.trangThai??p.TrangThai)===4).length;
        }

        function setFilter(val,btn) {
            curFilter=val;
            document.querySelectorAll('.filter-tabs .ftab').forEach(b=>b.classList.remove('active'));
            btn.classList.add('active'); renderTable();
        }

        function updateCuaFromPhieu() {
            document.querySelectorAll('.cua-card').forEach(c => {
                c.className='cua-card';
                var cid=c.dataset.cuaId;
                document.getElementById('cua-status-'+cid).innerHTML='— Trống —';
                document.getElementById('cua-status-'+cid).className='cua-empty';
            });
            phieuData.filter(p=>{var tt=p.trangThai??p.TrangThai??0;return tt===0||tt===1||tt===2;}).forEach(p=>{
                var cuaId=p.cuaXuatId??p.CuaXuatId;
                var tt=p.trangThai??p.TrangThai??0;
                var bienSo=p.bienSoXe??p.BienSoXe??'--';
                var taiXe=p.tenTaiXe??p.TenTaiXe??'--';
                var hangHoas=p.hangHoas??p.HangHoas??[];
                var vaoCua=p.thoiGianVaoCua??p.ThoiGianVaoCua;
                var card=document.getElementById('cua-card-'+cuaId);
                var status=document.getElementById('cua-status-'+cuaId);
                if(!card||!status)return;
                card.className='cua-card '+(tt===2?'is-over':'has-xe');
                var hangHtml=hangHoas.length?'<div class="cua-hang">'+hangHoas.map(h=>'<span class="cua-hang-tag">'+(h.chuaBG??h.ChuaBG??0)+'/'+(h.daBG??h.DaBG??0)+' '+(h.donVi??h.DonVi??'--')+'</span>').join('')+'</div>':'';
                status.className='';
                status.innerHTML='<div class="cua-xe">'+bienSo+' — '+taiXe+'</div>'+hangHtml+'<div class="cua-footer"><span class="sbadge tt-'+tt+'" style="font-size:9px;">'+(ttLabels[tt]||'--')+'</span>'+(vaoCua?'<span style="font-size:10px;color:var(--text-dim);">'+new Date(vaoCua).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'})+'</span>':'')+'</div>';
            });
        }

        function renderXeSidebar() {
            var filtered=curXeFilter==='all'?xeData:xeData.filter(x=>(x.trangThai??x.TrangThai)==curXeFilter);
            document.getElementById('xe-sidebar-count').textContent=filtered.length+' xe';
            var el=document.getElementById('xe-list');
            if(!filtered.length){el.innerHTML='<div style="text-align:center;padding:20px;color:var(--text-dim);font-size:11px;font-style:italic;">Không có xe</div>';return;}
            el.innerHTML=filtered.map(x=>{
                var bienSo=x.bienSoXe??x.BienSoXe??'--';
                var loaiXe=x.loaiXe??x.LoaiXe??'--';
                var taiTrong=x.taiTrong??x.TaiTrong??0;
                var tt=x.trangThai??x.TrangThai??0;
                var tenTaiXe=x.tenTaiXe??x.TenTaiXe??'--';
                var telTaiXe=x.telTaiXe??x.TelTaiXe??'--';
                return '<div class="xe-card"><div class="xe-card-top"><span class="xe-bienso">'+bienSo+'</span><span class="sbadge xe-tt-'+tt+'" style="font-size:9px;">'+(xeTtLabels[tt]||'--')+'</span></div><div class="xe-meta">'+loaiXe+' — '+Number(taiTrong).toLocaleString()+' kg</div><div class="xe-meta" style="color:var(--blue2);margin-top:2px;">'+tenTaiXe+' | '+telTaiXe+'</div></div>';
            }).join('');
        }

        function filterXe(btn,val){document.querySelectorAll('.xf-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');curXeFilter=val;renderXeSidebar();}

        function switchTab(tab){
            document.getElementById('stab-cua').classList.toggle('active',tab==='cua');
            document.getElementById('stab-xe').classList.toggle('active',tab==='xe');
            document.getElementById('panel-cua').style.display=tab==='cua'?'block':'none';
            document.getElementById('panel-xe').style.display=tab==='xe'?'block':'none';
            if(tab==='xe')loadXeSidebar();
        }

        function onXeChange(){
            var sel=document.getElementById('sel-xe');
            var opt=sel.options[sel.selectedIndex];
            var info=document.getElementById('xe-info');
            if(!sel.value){info.classList.remove('show');return;}
            document.getElementById('xi-loai').textContent=opt.dataset.loai||'--';
            document.getElementById('xi-tai').textContent=Number(opt.dataset.tai||0).toLocaleString()+' kg';
            document.getElementById('xi-taixe').textContent=opt.dataset.taixe||'Chưa có tài xế';
            document.getElementById('xi-tel').textContent=opt.dataset.tel||'--';
            info.classList.add('show');
        }

        function addHang(){var list=document.getElementById('hang-list');var row=document.createElement('div');row.className='hang-row';row.innerHTML='<input class="hang-input" placeholder="Đơn vị..."/><input class="hang-input" type="number" placeholder="Số lượng" min="0"/><button class="btn-remove" onclick="removeHang(this)" type="button">×</button>';list.appendChild(row);}
        function removeHang(btn){var rows=document.querySelectorAll('#hang-list .hang-row');if(rows.length>1)btn.parentElement.remove();}

        function resetForm(){
            document.getElementById('sel-xe').value='';
            document.getElementById('sel-cua').value='';
            document.getElementById('sel-nv').value='';
            document.getElementById('xe-info').classList.remove('show');
            document.getElementById('inp-tgpc').value=nowLocal(0);
            document.getElementById('inp-ghichu').value='';
            document.getElementById('hang-list').innerHTML='<div class="hang-row"><input class="hang-input" placeholder="Đơn vị..."/><input class="hang-input" type="number" placeholder="Số lượng" min="0"/><button class="btn-remove" onclick="removeHang(this)" type="button">×</button></div>';
            document.getElementById('form-status').textContent='';
        }

        async function submitForm(){
            var xeSel=document.getElementById('sel-xe');
            var cuaSel=document.getElementById('sel-cua');
            if(!xeSel.value||!cuaSel.value){alert('Vui lòng chọn xe và cửa xuất!');return;}
            var hangs=[];
            document.querySelectorAll('#hang-list .hang-row').forEach(r=>{
                var inputs=r.querySelectorAll('input');
                var dv=inputs[0].value.trim();var sl=parseInt(inputs[1].value)||0;
                if(dv&&sl>0)hangs.push({donVi:dv,soLuong:sl});
            });
            var payload={xeId:parseInt(xeSel.value),cuaXuatId:parseInt(cuaSel.value),nhanVienXacNhanId:parseInt(document.getElementById('sel-nv').value)||null,thoiGianPhanCong:document.getElementById('inp-tgpc').value||null,ghiChu:document.getElementById('inp-ghichu').value||null,hangHoas:hangs};
            var btn=document.getElementById('btn-submit');
            btn.disabled=true;btn.textContent='⏳ Đang tạo...';
            try{
                var res=await fetch('@Url.Action("TaoPhanCong", "DieuDoXuat")',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                var data=await res.json();
                if(res.ok){document.getElementById('form-status').textContent='✔ Tạo phiếu thành công!';setTimeout(()=>{document.getElementById('form-status').textContent='';},5000);resetForm();await reloadAll();}
                else{alert('❌ '+(data.message||'Lỗi tạo phiếu!')+(data.inner?'\n'+data.inner:''));}
            }catch(e){alert('❌ Lỗi kết nối server');}
            finally{btn.disabled=false;btn.textContent='✔ Tạo phiếu xuất';}
        }

        function xemChiTiet(id){
            var p=phieuData.find(x=>(x.id??x.Id)===id);if(!p)return;
            var tt=p.trangThai??p.TrangThai??0;
            alert('=== Chi tiết phiếu #'+id+' ===\nCửa: '+(p.tenCua??p.TenCua??'--')+'\nXe: '+(p.bienSoXe??p.BienSoXe??'--')+'\nTài xế: '+(p.tenTaiXe??p.TenTaiXe??'--')+'\nNV XN: '+(p.tenNhanVien??p.TenNhanVien??'--')+'\nTrạng thái: '+(ttLabels[tt]||'--')+'\nGiờ phân công: '+(p.thoiGianPhanCong??p.ThoiGianPhanCong?new Date(p.thoiGianPhanCong??p.ThoiGianPhanCong).toLocaleString('vi-VN'):'--')+'\nGiờ vào cửa: '+(p.thoiGianVaoCua??p.ThoiGianVaoCua?new Date(p.thoiGianVaoCua??p.ThoiGianVaoCua).toLocaleString('vi-VN'):'--')+'\nGiờ giới hạn: '+(p.thoiGianGioiHan??p.ThoiGianGioiHan?new Date(p.thoiGianGioiHan??p.ThoiGianGioiHan).toLocaleString('vi-VN'):'--')+'\nHàng hóa: '+(p.hangHoas??p.HangHoas??[]).map(h=>(h.chuaBG??h.ChuaBG??0)+'/'+(h.daBG??h.DaBG??0)+' '+(h.donVi??h.DonVi??'--')).join(', '));
        }

        async function huyPhieu(id){
            if(!confirm('Xác nhận hủy phiếu này? Xe sẽ trở về Trong bãi.'))return;
            try{
                var res=await fetch('@Url.Action("HuyPhanCong", "DieuDoXuat")',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({xuatId:id})});
                var data=await res.json();
                if(res.ok){await reloadAll();}else{alert('❌ '+(data.message||'Lỗi hủy!'));}
            }catch(e){alert('❌ Lỗi kết nối');}
        }
        function filterCua(btn, val) {
            document.querySelectorAll('#panel-cua .xf-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('#cua-list .cua-card').forEach(card => {
                var isActive = card.dataset.active === 'true';
                if (val === 'all') {
                    card.style.display = '';
                } else if (val === 'active') {
                    card.style.display = isActive ? '' : 'none';
                } else if (val === 'locked') {
                    card.style.display = !isActive ? '' : 'none';
                }
            });
        }
        reloadAll();
        setInterval(reloadAll,30000);
    </script>
}
