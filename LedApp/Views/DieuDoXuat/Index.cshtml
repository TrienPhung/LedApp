                <div id="panel-xe" style="display:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <span style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--blue2);text-transform:uppercase;">Danh sách xe</span>
                        <span style="font-size:10px;color:var(--text-dim);" id="xe-sidebar-count"></span>
                    </div>
                    <div class="xe-filter">
                        <button class="xf-btn active" onclick="filterXe(this,'all')" type="button">Tất cả</button>
                        <button class="xf-btn" onclick="filterXe(this,0)" type="button">Trong bãi</button>
                        <button class="xf-btn" onclick="filterXe(this,1)" type="button">Phân công</button>
                        <button class="xf-btn" onclick="filterXe(this,2)" type="button">Vận chuyển</button>
                        <button class="xf-btn" onclick="filterXe(this,3)" type="button">Bảo trì</button>
                    </div>
                    <div id="xe-list"></div>
                </div>
            </div>
        </div>
    </div>
    <!-- MODAL CHI TIẾT / SỬA -->
    <div id="modal-overlay" onclick="closeModal()"
         style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;"></div>
    <div id="modal-box"
         style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
            width:520px;background:var(--surface);border:1px solid var(--border2);
            border-radius:8px;z-index:1001;padding:20px;font-family:'Courier New',monospace;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;border-bottom:1px solid var(--border);padding-bottom:10px;">
            <span style="font-size:11px;font-weight:700;letter-spacing:2px;color:var(--gold);" id="modal-title">CHI TIẾT PHIẾU</span>
            <button onclick="closeModal()" style="background:transparent;border:none;color:var(--text-dim);font-size:18px;cursor:pointer;">×</button>
        </div>
        <div id="modal-body"></div>
    </div>
    <div class="footer">
        <span>© Hệ thống quản lý kho — Điều độ xuất</span>
        <span id="footer-time"></span>
    </div>
</div>

@section Scripts {
    <script>
                // ── DiaDiem Dropdown ──
        function toggleDiaDiem() {
            var dd = document.getElementById('diaDiemDropdown');
            var isOpen = dd.style.display === 'block';
            if (isOpen) { closeDiaDiem(); }
            else {
                dd.style.display = 'block';
                document.getElementById('diaDiemTrigger').style.borderColor = 'var(--gold)';
                document.getElementById('diaDiemSearch').focus();
            }
        }
        function closeDiaDiem() {
            document.getElementById('diaDiemDropdown').style.display = 'none';
            document.getElementById('diaDiemTrigger').style.borderColor = 'var(--border)';
            document.getElementById('diaDiemSearch').value = '';
            filterDiaDiem('');
        }
        function selectDiaDiem(el) {
            var value = el.dataset.value;
            document.getElementById('hdDiaDiemGiao').value = value;
            document.getElementById('diaDiemLabel').textContent = value;
            document.getElementById('diaDiemLabel').style.color = 'var(--text-bright)';
            document.getElementById('diaDiemClearBtn').style.display = 'inline';
            document.querySelectorAll('#diaDiemList .dd-opt')
                .forEach(o => o.classList.toggle('selected', o.dataset.value === value));
            closeDiaDiem();
        }
        function clearDiaDiem(e) {
            e.stopPropagation();
            document.getElementById('hdDiaDiemGiao').value = '';
            document.getElementById('diaDiemLabel').textContent = '— Chọn điểm giao —';
            document.getElementById('diaDiemLabel').style.color = 'var(--text-dim)';
            document.getElementById('diaDiemClearBtn').style.display = 'none';
            document.querySelectorAll('#diaDiemList .dd-opt').forEach(o => o.classList.remove('selected'));
        }
        function filterDiaDiem(kw) {
            kw = kw.toLowerCase();
            var opts = document.querySelectorAll('#diaDiemList .dd-opt');
            var groups = document.querySelectorAll('#diaDiemList .dd-group');
            var found = false;
            opts.forEach(o => {
                var match = o.dataset.value.toLowerCase().includes(kw);
                o.style.display = match ? 'block' : 'none';
                if (match) found = true;
            });
            groups.forEach(g => {
                var next = g.nextElementSibling;
                var hasVisible = false;
                while (next && !next.classList.contains('dd-group')) {
                    if (next.style.display !== 'none') hasVisible = true;
                    next = next.nextElementSibling;
                }
                g.style.display = hasVisible ? 'block' : 'none';
            });
            var noResult = document.getElementById('ddNoResult');
            if (!found) {
                if (!noResult) {
                    var div = document.createElement('div');
                    div.id = 'ddNoResult';
                    div.style.cssText = 'padding:10px;text-align:center;color:var(--text-dim);font-size:11px;';
                    div.textContent = 'Không tìm thấy bưu cục';
                    document.getElementById('diaDiemList').appendChild(div);
                }
            } else { if (noResult) noResult.remove(); }
        }
        document.addEventListener('click', function(e) {
            if (!document.getElementById('diaDiemSelect').contains(e.target)) closeDiaDiem();
        });
                // ← THÊM VÀO ĐÂY
        document.querySelectorAll('#diaDiemList .dd-opt').forEach(function(el) {
            el.addEventListener('click', function(e) {
                e.stopPropagation();
                selectDiaDiem(this);
            });
        });



        var phieuData = [], xeData = [], cuaData = [];
        var curFilter = 'all', curXeFilter = 'all';
        var ttLabels = ['Chờ xuất','Đang xuất','Quá giờ','Hoàn thành','Đã rời kho'];
        var xeTtLabels = ['Trong bãi','Đang phân công','Đang vận chuyển','Bảo trì'];

        // ── THEME ──
        var isLight = localStorage.getItem('theme') === 'light';
        function applyTheme() {
            document.body.classList.toggle('light-mode', isLight);
            document.getElementById('theme-ico').className = isLight ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
        }
        function toggleTheme() {
            isLight = !isLight;
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            applyTheme();
        }
        applyTheme();

        // ── USER MENU ──
        function toggleUserMenu() {
            var dd = document.getElementById('user-dropdown');
            var av = document.getElementById('user-avatar');
            var isOpen = dd.classList.contains('show');
            dd.classList.toggle('show', !isOpen);
            av.classList.toggle('open', !isOpen);
        }
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#user-btn')) {
                document.getElementById('user-dropdown').classList.remove('show');
                document.getElementById('user-avatar').classList.remove('open');
            }
        });

        // ── ĐỒNG HỒ ──
        function tick() {
            var n = new Date();
            document.getElementById('clock').textContent = n.toLocaleTimeString('vi-VN',{hour12:false});
            document.getElementById('date-str').textContent = n.toLocaleDateString('vi-VN',{weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'});
            document.getElementById('footer-time').textContent = 'Cập nhật: ' + n.toLocaleTimeString('vi-VN');
        }
        setInterval(tick,1000); tick();

        var pad = s => String(s).padStart(2,'0');
        function nowLocal(addMin) {
            var d = new Date(Date.now()+(addMin||0)*60000);
            return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
        }
        document.getElementById('inp-tgpc').value = nowLocal(0);

        // ── SIGNALR ──
        var conn = new signalR.HubConnectionBuilder().withUrl('/signalserver').withAutomaticReconnect().build();

        async function reloadXeDropdown() {
            try {
                var res = await fetch('@Url.Action("GetXeTrongBai", "DieuDoXuat")');
                if (!res.ok) return;
                var xes = await res.json();
                var sel = document.getElementById('sel-xe');
                var curVal = sel.value;
                sel.innerHTML = '<option value="">-- Chọn xe --</option>';
                xes.forEach(x => {
                    var opt = document.createElement('option');
                    opt.value = x.id ?? x.Id;
                    opt.textContent = x.bienSoXe ?? x.BienSoXe ?? '--';
                    opt.dataset.loai  = x.loaiXe   ?? x.LoaiXe   ?? '--';
                    opt.dataset.tai   = x.taiTrong  ?? x.TaiTrong  ?? 0;
                    opt.dataset.taixe = x.tenTaiXe  ?? x.TenTaiXe  ?? 'Chưa có tài xế';
                    opt.dataset.tel   = x.telTaiXe  ?? x.TelTaiXe  ?? '--';
                    sel.appendChild(opt);
                });
                var stillValid = Array.from(sel.options).some(o => o.value === curVal);
                if (curVal && !stillValid) { sel.value = ''; document.getElementById('xe-info').classList.remove('show'); }
            } catch(e) {}
        }

        async function reloadCuaDropdown() {
            try {
                var res = await fetch('@Url.Action("GetCuaTrong", "DieuDoXuat")');
                if (!res.ok) return;
                var cuas = await res.json();
                var sel = document.getElementById('sel-cua');
                var curVal = sel.value;
                sel.innerHTML = '<option value="">-- Chọn cửa --</option>';
                cuas.forEach(c => {
                    var opt = document.createElement('option');
                    opt.value = c.id ?? c.Id;
                    opt.textContent = c.ten ?? c.Ten ?? '--';
                    sel.appendChild(opt);
                });
                var stillValid = Array.from(sel.options).some(o => o.value === curVal);
                if (curVal && !stillValid) sel.value = '';
            } catch(e) {}
        }

        var _reloading = false;
        async function reloadAll() {
            if (_reloading) return;
            _reloading = true;
            try {
                await loadPhieu();
                var dangChonXe  = document.getElementById('sel-xe').value;
                var dangChonCua = document.getElementById('sel-cua').value;
                if (!dangChonXe)  await reloadXeDropdown();
                if (!dangChonCua) await reloadCuaDropdown();
                if (document.getElementById('panel-xe').style.display !== 'none') await loadXeSidebar();
            } finally { _reloading = false; }
        }

        conn.on('UpdateBangTongHopXuat', function() { loadPhieu(); });
        conn.on('ReceivedChitietXuat', function() { loadPhieu(); });
        conn.on('Receivedxuat', function() { reloadAll(); });
        conn.on('ReceivedXuat', function() { reloadAll(); });
        conn.start().then(function() {
            document.getElementById('sig-dot').classList.add('on');
            document.getElementById('sig-text').textContent = 'Realtime';
        }).catch(function() {
            document.getElementById('sig-dot').classList.add('err');
            document.getElementById('sig-text').textContent = 'Mất kết nối';
        });

        async function loadPhieu() {
            try {
                var res = await fetch('@Url.Action("GetPhieuHomNay", "DieuDoXuat")');
                if (!res.ok) return;
                phieuData = await res.json();
                renderTable(); updateStats(); updateCuaFromPhieu();
            } catch(e) {}
        }

        async function loadXeSidebar() {
            try {
                var res = await fetch('@Url.Action("GetDanhSachXe", "DieuDoXuat")');
                if (!res.ok) return;
                xeData = await res.json();
                renderXeSidebar();
            } catch(e) {}
        }

        // ── PHÂN TRANG ──
        let currentPageXuat = 1;
        let rowsPerPageXuat = 10;
        let filteredDataXuat = [];

        function renderTable() {
            let filtered = curFilter === 'all' ? phieuData : phieuData.filter(p => (p.trangThai ?? p.TrangThai) == curFilter);
            const keyword = document.getElementById('search-input')?.value?.trim().toLowerCase() ?? '';
            if (keyword) filtered = filtered.filter(p => (p.bienSoXe ?? p.BienSoXe ?? '').toLowerCase().includes(keyword));
            const sort = document.getElementById('sort-select')?.value ?? 'none';
            if (sort === 'newest') {
                filtered = [...filtered].sort((a, b) => new Date(b.thoiGianPhanCong??b.ThoiGianPhanCong??0) - new Date(a.thoiGianPhanCong??a.ThoiGianPhanCong??0));
            } else if (sort === 'oldest') {
                filtered = [...filtered].sort((a, b) => new Date(a.thoiGianPhanCong??a.ThoiGianPhanCong??0) - new Date(b.thoiGianPhanCong??b.ThoiGianPhanCong??0));
            }
            filteredDataXuat = filtered;
            currentPageXuat = Math.min(currentPageXuat, Math.max(1, Math.ceil(filtered.length / rowsPerPageXuat)));
            renderTablePage();
            renderPaginationXuat();
        }

        function renderTablePage() {
            const filtered = filteredDataXuat;
            const start = (currentPageXuat - 1) * rowsPerPageXuat;
            const paged = filtered.slice(start, start + rowsPerPageXuat);
            document.getElementById('phieu-count').textContent = filtered.length + ' phiếu';
            const tbody = document.getElementById('phieu-tbody');
            if (!paged.length) { tbody.innerHTML = '<tr><td colspan="7" class="empty-cell">Chưa có phiếu xuất hôm nay</td></tr>'; return; }
            tbody.innerHTML = paged.map(p => {
                const id        = p.id         ?? p.Id;
                const tenCua    = p.tenCua     ?? p.TenCua     ?? '--';
                const bienSoXe  = p.bienSoXe   ?? p.BienSoXe   ?? '--';
                const tenTaiXe  = p.tenTaiXe   ?? p.TenTaiXe   ?? '--';
                const trangThai = p.trangThai  ?? p.TrangThai  ?? 0;
                const vaoCua    = p.thoiGianVaoCua  ?? p.ThoiGianVaoCua;
                const gioiHan   = p.thoiGianGioiHan ?? p.ThoiGianGioiHan;
                const hangHoas  = p.hangHoas   ?? p.HangHoas   ?? [];
                const hangStr = hangHoas.length
                    ? hangHoas.map(h => '<span class="htag"><span style="color:var(--gold2);">'+(h.chuaBG??h.ChuaBG??0)+'</span>/'+(h.daBG??h.DaBG??0)+' '+(h.donVi??h.DonVi??'--')+'</span>').join('')
                    : '<span style="color:var(--text-dim);">--</span>';
                const gioVao = vaoCua ? new Date(vaoCua).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}) : '--:--';
                let conLai = '—';
                if (trangThai < 3 && gioiHan) {
                    const diff = Math.round((new Date(gioiHan) - new Date()) / 60000);
                    conLai = diff > 0 ? diff + ' ph' : '<span style="color:var(--red);font-weight:700;">Quá hạn</span>';
                }
                return '<tr>' +
                    '<td style="color:var(--gold);font-weight:700;">'+tenCua+'</td>' +
                    '<td><div style="color:var(--text-bright);font-weight:700;">'+bienSoXe+'</div><div style="font-size:10px;color:var(--text-dim);">'+tenTaiXe+'</div></td>' +
                    '<td><div class="hang-tags">'+hangStr+'</div></td>' +
                    '<td><span class="sbadge tt-'+trangThai+'">'+(ttLabels[trangThai]||'--')+'</span></td>' +
                    '<td style="color:var(--text-dim);">'+gioVao+'</td>' +
                    '<td>'+conLai+'</td>' +
                    '<td>' +
                    '<button class="btn-chitiet" onclick="xemChiTiet('+id+')">Chi tiết</button>' +
                    (trangThai<=2?'<button class="btn-sua" onclick="suaPhieu('+id+')">Sửa</button>':'') +
                    (trangThai<=1?'<button class="btn-huy" onclick="huyPhieu('+id+')">Hủy</button>':'') +
                    '</td>' +
                    '</tr>';
            }).join('');
        }

        function renderPaginationXuat() {
            const total = filteredDataXuat.length;
            const totalPages = Math.max(1, Math.ceil(total / rowsPerPageXuat));
            const start = (currentPageXuat - 1) * rowsPerPageXuat + 1;
            const end = Math.min(currentPageXuat * rowsPerPageXuat, total);
            let el = document.getElementById('pg-xuat');
            if (!el) {
                el = document.createElement('div');
                el.id = 'pg-xuat';
                el.style.cssText = 'display:flex;justify-content:space-between;align-items:center;padding:8px 16px;border-top:1px solid var(--border);font-size:11px;color:var(--text-dim);';
                document.getElementById('phieu-tbody').closest('table').parentElement.after(el);
            }
            el.innerHTML = `
                <span>${total > 0 ? `${start}–${end} / ${total} phiếu` : '0 phiếu'}</span>
                <div style="display:flex;align-items:center;gap:6px;">
                    <span style="font-size:10px;">Hàng/trang:</span>
                    <select onchange="rowsPerPageXuat=parseInt(this.value);currentPageXuat=1;renderTablePage();renderPaginationXuat();"
                        style="background:var(--surface2);border:1px solid var(--border);border-radius:3px;padding:3px 6px;color:var(--text-bright);font-size:10px;font-family:inherit;outline:none;cursor:pointer;">
                        ${[10,20,50].map(n=>`<option value="${n}"${n===rowsPerPageXuat?' selected':''}>${n}</option>`).join('')}
                    </select>
                    <button onclick="if(currentPageXuat>1){currentPageXuat--;renderTablePage();renderPaginationXuat();}"
                        style="background:var(--surface2);border:1px solid var(--border);border-radius:3px;padding:3px 8px;color:var(--text-dim);font-size:11px;cursor:pointer;font-family:inherit;"
                        ${currentPageXuat<=1?'disabled':''}>‹</button>
                    ${pageRangeXuat(currentPageXuat, totalPages).map(p =>
                        p === '...' ? `<span style="color:var(--text-dim);padding:0 2px;">…</span>`
                        : `<button onclick="currentPageXuat=${p};renderTablePage();renderPaginationXuat();"
                            style="background:${p===currentPageXuat?'var(--gold)':'var(--surface2)'};border:1px solid ${p===currentPageXuat?'var(--gold)':'var(--border)'};border-radius:3px;padding:3px 8px;color:${p===currentPageXuat?'#0a0e18':'var(--text-bright)'};font-size:11px;cursor:pointer;font-family:inherit;font-weight:${p===currentPageXuat?'700':'400'};">${p}</button>`
                    ).join('')}
                    <button onclick="if(currentPageXuat<${totalPages}){currentPageXuat++;renderTablePage();renderPaginationXuat();}"
                        style="background:var(--surface2);border:1px solid var(--border);border-radius:3px;padding:3px 8px;color:var(--text-dim);font-size:11px;cursor:pointer;font-family:inherit;"
                        ${currentPageXuat>=totalPages?'disabled':''}>›</button>
                </div>`;
        }

        function pageRangeXuat(cur, total) {
            if (total <= 7) return Array.from({length: total}, (_, i) => i + 1);
            if (cur <= 4) return [1, 2, 3, 4, 5, '...', total];
            if (cur >= total - 3) return [1, '...', total-4, total-3, total-2, total-1, total];
            return [1, '...', cur-1, cur, cur+1, '...', total];
        }

        function updateStats() {
            document.getElementById('stat-tong').textContent = phieuData.length;
            document.getElementById('stat-cho').textContent  = phieuData.filter(p=>(p.trangThai??p.TrangThai)===0).length;
            document.getElementById('stat-dang').textContent = phieuData.filter(p=>{var t=p.trangThai??p.TrangThai;return t>=1&&t<=3;}).length;
            document.getElementById('stat-xong').textContent = phieuData.filter(p=>(p.trangThai??p.TrangThai)===4).length;
        }

        function setFilter(val,btn) {
            curFilter=val;
            currentPageXuat=1;
            document.querySelectorAll('.filter-tabs .ftab').forEach(b=>b.classList.remove('active'));
            btn.classList.add('active');
            renderTable();
            updateResetBtnXuat();
        }
        function updateResetBtnXuat() {
            const hasSearch = document.getElementById('search-input').value.trim().length > 0;
            const hasSort = document.getElementById('sort-select').value !== 'none';
            const hasFilter = curFilter !== 'all';
            const btn = document.getElementById('btn-reset-xuat');
            btn.style.display = (hasSearch || hasSort || hasFilter) ? 'inline-flex' : 'none';
        }

        function resetFilterXuat() {
            document.getElementById('search-input').value = '';
            document.getElementById('sort-select').value = 'none';
            curFilter = 'all';
            currentPageXuat = 1;
            document.querySelectorAll('.filter-tabs .ftab').forEach(b => b.classList.remove('active'));
            document.querySelector('.ftab[onclick="setFilter(\'all\',this)"]').classList.add('active');
            document.getElementById('btn-reset-xuat').style.display = 'none';
            renderTable();
        }
        function updateCuaFromPhieu() {
            document.querySelectorAll('.cua-card').forEach(c => {
                c.className='cua-card';
                var cid=c.dataset.cuaId;
                document.getElementById('cua-status-'+cid).innerHTML='— Trống —';
                document.getElementById('cua-status-'+cid).className='cua-empty';
            });
            phieuData.filter(p=>{var tt=p.trangThai??p.TrangThai??0;return tt===0||tt===1||tt===2;}).forEach(p=>{
                var cuaId=p.cuaXuatId??p.CuaXuatId;
                var tt=p.trangThai??p.TrangThai??0;
                var bienSo=p.bienSoXe??p.BienSoXe??'--';
                var taiXe=p.tenTaiXe??p.TenTaiXe??'--';
                var hangHoas=p.hangHoas??p.HangHoas??[];
                var vaoCua=p.thoiGianVaoCua??p.ThoiGianVaoCua;
                var card=document.getElementById('cua-card-'+cuaId);
                var status=document.getElementById('cua-status-'+cuaId);
                if(!card||!status)return;
                card.className='cua-card '+(tt===2?'is-over':'has-xe');
                var hangHtml=hangHoas.length?'<div class="cua-hang">'+hangHoas.map(h=>'<span class="cua-hang-tag">'+(h.chuaBG??h.ChuaBG??0)+'/'+(h.daBG??h.DaBG??0)+' '+(h.donVi??h.DonVi??'--')+'</span>').join('')+'</div>':'';
                status.className='';
                status.innerHTML='<div class="cua-xe">'+bienSo+' — '+taiXe+'</div>'+hangHtml+'<div class="cua-footer"><span class="sbadge tt-'+tt+'" style="font-size:9px;">'+(ttLabels[tt]||'--')+'</span>'+(vaoCua?'<span style="font-size:10px;color:var(--text-dim);">'+new Date(vaoCua).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'})+'</span>':'')+'</div>';
            });
        }

        function renderXeSidebar() {
            var filtered=curXeFilter==='all'?xeData:xeData.filter(x=>(x.trangThai??x.TrangThai)==curXeFilter);
            document.getElementById('xe-sidebar-count').textContent=filtered.length+' xe';
            var el=document.getElementById('xe-list');
            if(!filtered.length){el.innerHTML='<div style="text-align:center;padding:20px;color:var(--text-dim);font-size:11px;font-style:italic;">Không có xe</div>';return;}
            el.innerHTML=filtered.map(x=>{
                var bienSo=x.bienSoXe??x.BienSoXe??'--';
                var loaiXe=x.loaiXe??x.LoaiXe??'--';
                var taiTrong=x.taiTrong??x.TaiTrong??0;
                var tt=x.trangThai??x.TrangThai??0;
                var tenTaiXe=x.tenTaiXe??x.TenTaiXe??'--';
                var telTaiXe=x.telTaiXe??x.TelTaiXe??'--';
                return '<div class="xe-card"><div class="xe-card-top"><span class="xe-bienso">'+bienSo+'</span><span class="sbadge xe-tt-'+tt+'" style="font-size:9px;">'+(xeTtLabels[tt]||'--')+'</span></div><div class="xe-meta">'+loaiXe+' — '+Number(taiTrong).toLocaleString()+' kg</div><div class="xe-meta" style="color:var(--blue2);margin-top:2px;">'+tenTaiXe+' | '+telTaiXe+'</div></div>';
            }).join('');
        }

        function filterXe(btn,val){document.querySelectorAll('.xf-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');curXeFilter=val;renderXeSidebar();}

        function switchTab(tab){
            document.getElementById('stab-cua').classList.toggle('active',tab==='cua');
            document.getElementById('stab-xe').classList.toggle('active',tab==='xe');
            document.getElementById('panel-cua').style.display=tab==='cua'?'block':'none';
            document.getElementById('panel-xe').style.display=tab==='xe'?'block':'none';
            if(tab==='xe')loadXeSidebar();
        }

        function onXeChange(){
            var sel=document.getElementById('sel-xe');
            var opt=sel.options[sel.selectedIndex];
            var info=document.getElementById('xe-info');
            if(!sel.value){info.classList.remove('show');return;}
            document.getElementById('xi-loai').textContent=opt.dataset.loai||'--';
            document.getElementById('xi-tai').textContent=Number(opt.dataset.tai||0).toLocaleString()+' kg';
            document.getElementById('xi-taixe').textContent=opt.dataset.taixe||'Chưa có tài xế';
            document.getElementById('xi-tel').textContent=opt.dataset.tel||'--';
            info.classList.add('show');
        }

        function addHang(){var list=document.getElementById('hang-list');var row=document.createElement('div');row.className='hang-row';row.innerHTML='<input class="hang-input" placeholder="Đơn vị..."/><input class="hang-input" type="number" placeholder="Số lượng" min="0"/><button class="btn-remove" onclick="removeHang(this)" type="button">×</button>';list.appendChild(row);}
        function removeHang(btn){var rows=document.querySelectorAll('#hang-list .hang-row');if(rows.length>1)btn.parentElement.remove();}

        function resetForm(){
            document.getElementById('sel-xe').value='';
            document.getElementById('sel-cua').value='';
            document.getElementById('sel-nv').value='';
            document.getElementById('xe-info').classList.remove('show');
            document.getElementById('inp-tgpc').value=nowLocal(0);
            document.getElementById('inp-ghichu').value='';
            document.getElementById('hang-list').innerHTML='<div class="hang-row"><input class="hang-input" placeholder="Đơn vị..."/><input class="hang-input" type="number" placeholder="Số lượng" min="0"/><button class="btn-remove" onclick="removeHang(this)" type="button">×</button></div>';
            document.getElementById('form-status').textContent='';
            clearDiaDiem({stopPropagation:()=>{}});
        }

        async function submitForm(){
            var xeSel=document.getElementById('sel-xe');
            var cuaSel=document.getElementById('sel-cua');
            if(!xeSel.value||!cuaSel.value){alert('Vui lòng chọn xe và cửa xuất!');return;}
            var hangs=[];
            document.querySelectorAll('#hang-list .hang-row').forEach(r=>{
                var inputs=r.querySelectorAll('input');
                var dv=inputs[0].value.trim();var sl=parseInt(inputs[1].value)||0;
                if(dv&&sl>0)hangs.push({donVi:dv,soLuong:sl});
            });
            var payload={xeId:parseInt(xeSel.value),cuaXuatId:parseInt(cuaSel.value),nhanVienXacNhanId:parseInt(document.getElementById('sel-nv').value)||null,thoiGianPhanCong:document.getElementById('inp-tgpc').value||null,ghiChu:document.getElementById('inp-ghichu').value||null, diaDiemGiao: document.getElementById('hdDiaDiemGiao').value || null,hangHoas:hangs};
            var btn=document.getElementById('btn-submit');
            btn.disabled=true;btn.textContent='⏳ Đang tạo...';
            try{
                var res=await fetch('@Url.Action("TaoPhanCong", "DieuDoXuat")',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                var data=await res.json();
                if(res.ok){document.getElementById('form-status').textContent='✔ Tạo phiếu thành công!';setTimeout(()=>{document.getElementById('form-status').textContent='';},5000);resetForm();await reloadAll();}
                else{alert('❌ '+(data.message||'Lỗi tạo phiếu!')+(data.inner?'\n'+data.inner:''));}
            }catch(e){alert('❌ Lỗi kết nối server');}
            finally{btn.disabled=false;btn.textContent='✔ Tạo phiếu xuất';}
        }

        function closeModal() {
            document.getElementById('modal-overlay').style.display = 'none';
            document.getElementById('modal-box').style.display = 'none';
        }

        function xemChiTiet(id) {
            var p = phieuData.find(x => (x.id ?? x.Id) === id); if (!p) return;
            var tt = p.trangThai ?? p.TrangThai ?? 0;
            var hangHoas = p.hangHoas ?? p.HangHoas ?? [];
            document.getElementById('modal-title').textContent = 'CHI TIẾT PHIẾU #' + id;
            document.getElementById('modal-body').innerHTML =
                '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px;">' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;">CỬA XUẤT</div><div style="color:var(--gold);font-weight:700;margin-top:3px;">'+(p.tenCua??p.TenCua??'--')+'</div></div>' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;">XE</div><div style="color:var(--text-bright);font-weight:700;margin-top:3px;">'+(p.bienSoXe??p.BienSoXe??'--')+'</div></div>' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;">TÀI XẾ</div><div style="color:var(--text-bright);margin-top:3px;">'+(p.tenTaiXe??p.TenTaiXe??'--')+'</div></div>' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;">NHÂN VIÊN XN</div><div style="color:var(--text-bright);margin-top:3px;">'+(p.tenNhanVien??p.TenNhanVien??'--')+'</div></div>' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;">TRẠNG THÁI</div><div style="margin-top:3px;"><span class="sbadge tt-'+tt+'">'+(ttLabels[tt]||'--')+'</span></div></div>' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;">GHI CHÚ</div><div style="color:var(--text-bright);margin-top:3px;">'+(p.ghiChu??p.GhiChu??'--')+'</div></div>' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;">GIỜ PHÂN CÔNG</div><div style="color:var(--text-dim);margin-top:3px;">'+(p.thoiGianPhanCong??p.ThoiGianPhanCong?new Date(p.thoiGianPhanCong??p.ThoiGianPhanCong).toLocaleString('vi-VN'):'--')+'</div></div>' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;">GIỜ VÀO CỬA</div><div style="color:var(--text-dim);margin-top:3px;">'+(p.thoiGianVaoCua??p.ThoiGianVaoCua?new Date(p.thoiGianVaoCua??p.ThoiGianVaoCua).toLocaleString('vi-VN'):'--')+'</div></div>' +
                '</div>' +
                '<div style="border-top:1px solid var(--border);padding-top:10px;">' +
                    '<div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;margin-bottom:8px;">HÀNG HÓA</div>' +
                    (hangHoas.length ? hangHoas.map(h =>
                        '<div style="display:flex;justify-content:space-between;padding:6px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:4px;margin-bottom:4px;">' +
                        '<span style="color:var(--text-bright);">'+(h.donVi??h.DonVi??'--')+'</span>' +
                        '<span><span style="color:var(--gold2);font-weight:700;">'+(h.chuaBG??h.ChuaBG??0)+'</span><span style="color:var(--text-dim);"> / '+(h.daBG??h.DaBG??0)+' đã BG</span></span>' +
                        '</div>'
                    ).join('') : '<div style="color:var(--text-dim);font-style:italic;font-size:11px;">Không có hàng hóa</div>') +
                '</div>';
            document.getElementById('modal-overlay').style.display = 'block';
            document.getElementById('modal-box').style.display = 'block';
        }

        function suaPhieu(id) {
            var p = phieuData.find(x => (x.id ?? x.Id) === id); if (!p) return;
          
            var hangHoas = p.hangHoas ?? p.HangHoas ?? [];
            var curDiaDiem = p.diaDiemGiao ?? p.DiaDiemGiao ?? '';
            document.getElementById('modal-title').textContent = 'SỬA PHIẾU #' + id;
            document.getElementById('modal-body').innerHTML =
                '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px;">' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;margin-bottom:4px;">CỬA XUẤT</div>' +
                    '<div style="color:var(--gold);font-weight:700;padding:8px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:4px;">'+(p.tenCua??p.TenCua??'--')+'</div></div>' +
                    '<div><div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;margin-bottom:4px;">XE / TÀI XẾ</div>' +
                    '<div style="color:var(--text-bright);font-weight:700;padding:8px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:4px;">'+(p.bienSoXe??p.BienSoXe??'--')+'</div></div>' +
                '</div>' +
                '<div style="margin-bottom:10px;">' +
                    '<div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;margin-bottom:4px;">THỜI GIAN PHÂN CÔNG</div>' +
                    '<input type="datetime-local" id="sua-tgpc" class="form-control" value="'+(p.thoiGianPhanCong ?? p.ThoiGianPhanCong ?? '')+'" />' +
                '</div>' +
                '<div style="margin-bottom:10px;">' +
                    '<div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;margin-bottom:4px;">ĐỊA ĐIỂM GIAO HÀNG</div>' +
                    '<input type="hidden" id="sua-diadiem-val" value="'+curDiaDiem+'" />' +
                    '<div style="position:relative;user-select:none;" id="suaDiaDiemSelect">' +
                        '<div style="display:flex;align-items:center;justify-content:space-between;height:38px;padding:0 10px;border:1px solid var(--border);border-radius:4px;background:var(--surface2);cursor:pointer;font-size:12px;transition:border-color .2s;" id="suaDiaDiemTrigger" onclick="toggleSuaDiaDiem()">' +
                            '<span id="suaDiaDiemLabel" style="color:'+(curDiaDiem?'var(--text-bright)':'var(--text-dim)')+';">'+(curDiaDiem||'— Chọn điểm giao —')+'</span>' +
                            '<div style="display:flex;align-items:center;gap:4px;">' +
                                '<span id="suaDiaDiemClearBtn" onclick="clearSuaDiaDiem(event)" style="display:'+(curDiaDiem?'inline':'none')+';color:var(--text-dim);font-size:16px;cursor:pointer;">×</span>' +
                                '<span style="font-size:12px;color:var(--text-dim);">▾</span>' +
                            '</div>' +
                        '</div>' +
                        '<div id="suaDiaDiemDropdown" style="display:none;position:absolute;top:100%;left:0;right:0;border:1px solid var(--gold);border-top:none;border-radius:0 0 4px 4px;background:var(--surface);box-shadow:0 6px 16px rgba(0,0,0,.3);z-index:9999;">' +
                            '<div style="padding:8px;border-bottom:1px solid var(--border);">' +
                                '<input type="text" id="suaDiaDiemSearch" placeholder="Tìm bưu cục..." oninput="filterSuaDiaDiem(this.value)" style="width:100%;padding:6px 10px;border:1px solid var(--border);border-radius:4px;font-size:12px;background:var(--surface2);color:var(--text-bright);outline:none;box-sizing:border-box;font-family:inherit;" />' +
                            '</div>' +
                            '<div id="suaDiaDiemList" style="max-height:180px;overflow-y:auto;scrollbar-width:thin;">' +
                                buildDiaDiemOptions(curDiaDiem) +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div style="margin-bottom:12px;">' +
                    '<div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;margin-bottom:4px;">GHI CHÚ</div>' +
                    '<input type="text" id="sua-ghichu" class="form-control" value="'+(p.ghiChu??p.GhiChu??'')+'" placeholder="Ghi chú..." />' +
                '</div>' +
                '<div style="border-top:1px solid var(--border);padding-top:10px;margin-bottom:12px;">' +
                    '<div style="font-size:9px;color:var(--text-dim);letter-spacing:1px;margin-bottom:8px;">HÀNG HÓA</div>' +
                    '<div id="sua-hang-list">' +
                    hangHoas.map(h =>
                        '<div style="display:grid;grid-template-columns:1fr 100px 30px;gap:6px;margin-bottom:6px;" class="sua-hang-row" data-id="'+(h.id??h.Id??0)+'">' +
                        '<input class="hang-input" value="'+(h.donVi??h.DonVi??'')+'" placeholder="Đơn vị..." />' +
                        '<input class="hang-input" type="number" value="'+(h.chuaBG??h.ChuaBG??0)+'" min="0" />' +
                        '<button class="btn-remove" onclick="this.parentElement.remove()" type="button">×</button>' +
                        '</div>'
                    ).join('') +
                    '</div>' +
                    '<button class="btn-add-hang" onclick="addSuaHang()" type="button">+ Thêm hàng</button>' +
                '</div>' +
                '<div style="display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--border);padding-top:12px;">' +
                    '<button class="btn-reset" onclick="closeModal()">Hủy bỏ</button>' +
                    '<button class="btn-submit" onclick="luuSuaPhieu('+id+', this)"><i class="bi bi-floppy" style="font-size:12px;"></i> Lưu thay đổi</button>' +
                '</div>';
            document.getElementById('modal-overlay').style.display = 'block';
            document.getElementById('modal-box').style.display = 'block';

            // Gán sự kiện click cho các option
            document.querySelectorAll('#suaDiaDiemList .dd-opt').forEach(function(el) {
                el.addEventListener('click', function(e) { e.stopPropagation(); selectSuaDiaDiem(this); });
            });
            // Đóng dropdown khi click ngoài
            setTimeout(function() {
                document.addEventListener('click', closeSuaDiaDiemOutside);
            }, 0);
        }

        function buildDiaDiemOptions(selected) {
            var groups = [
                { label: 'Hà Nội', items: ['Bưu cục Hoàn Kiếm','Bưu cục Cầu Giấy','Bưu cục Đống Đa','Bưu cục Hai Bà Trưng','Bưu cục Thanh Xuân','Bưu cục Long Biên','Bưu cục Hà Đông','Bưu cục Gia Lâm','Bưu cục Hoàng Mai','Bưu cục Tây Hồ','Bưu cục Bắc Từ Liêm','Bưu cục Nam Từ Liêm','Trung tâm khai thác Hà Nội'] },
                { label: 'Hải Phòng', items: ['Bưu cục Hồng Bàng','Bưu cục Ngô Quyền','Bưu cục Lê Chân','Bưu cục Kiến An','Bưu cục An Dương','Bưu cục Thủy Nguyên','Trung tâm khai thác Hải Phòng'] },
                { label: 'TP. Hồ Chí Minh', items: ['Bưu cục Quận 1','Bưu cục Quận 3','Bưu cục Quận 5','Bưu cục Quận 7','Bưu cục Bình Thạnh','Bưu cục Tân Bình','Bưu cục Gò Vấp','Bưu cục Thủ Đức','Trung tâm khai thác HCM'] },
                { label: 'Đà Nẵng', items: ['Bưu cục Hải Châu','Bưu cục Thanh Khê','Bưu cục Sơn Trà','Bưu cục Liên Chiểu','Trung tâm khai thác Đà Nẵng'] },
                { label: 'Cần Thơ', items: ['Bưu cục Ninh Kiều','Bưu cục Bình Thủy','Trung tâm khai thác Cần Thơ'] }
            ];
            return groups.map(g =>
                '<div class="dd-group">'+g.label+'</div>' +
                g.items.map(item =>
                    '<div class="dd-opt'+(item===selected?' selected':'')+'" data-value="'+item+'">'+item+'</div>'
                ).join('')
            ).join('');
        }

        function toggleSuaDiaDiem() {
            var dd = document.getElementById('suaDiaDiemDropdown');
            var isOpen = dd.style.display === 'block';
            if (isOpen) { closeSuaDiaDiem(); }
            else {
                dd.style.display = 'block';
                document.getElementById('suaDiaDiemTrigger').style.borderColor = 'var(--gold)';
                document.getElementById('suaDiaDiemSearch').focus();
            }
        }
        function closeSuaDiaDiem() {
            var dd = document.getElementById('suaDiaDiemDropdown');
            if (!dd) return;
            dd.style.display = 'none';
            document.getElementById('suaDiaDiemTrigger').style.borderColor = 'var(--border)';
            document.getElementById('suaDiaDiemSearch').value = '';
            filterSuaDiaDiem('');
        }
        function closeSuaDiaDiemOutside(e) {
            var sel = document.getElementById('suaDiaDiemSelect');
            if (sel && !sel.contains(e.target)) {
                closeSuaDiaDiem();
                document.removeEventListener('click', closeSuaDiaDiemOutside);
            }
        }
        function selectSuaDiaDiem(el) {
            var value = el.dataset.value;
            document.getElementById('sua-diadiem-val').value = value;
            document.getElementById('suaDiaDiemLabel').textContent = value;
            document.getElementById('suaDiaDiemLabel').style.color = 'var(--text-bright)';
            document.getElementById('suaDiaDiemClearBtn').style.display = 'inline';
            document.querySelectorAll('#suaDiaDiemList .dd-opt').forEach(o => o.classList.toggle('selected', o.dataset.value === value));
            closeSuaDiaDiem();
        }
        function clearSuaDiaDiem(e) {
            e.stopPropagation();
            document.getElementById('sua-diadiem-val').value = '';
            document.getElementById('suaDiaDiemLabel').textContent = '— Chọn điểm giao —';
            document.getElementById('suaDiaDiemLabel').style.color = 'var(--text-dim)';
            document.getElementById('suaDiaDiemClearBtn').style.display = 'none';
            document.querySelectorAll('#suaDiaDiemList .dd-opt').forEach(o => o.classList.remove('selected'));
        }
        function filterSuaDiaDiem(kw) {
            kw = kw.toLowerCase();
            var opts = document.querySelectorAll('#suaDiaDiemList .dd-opt');
            var groups = document.querySelectorAll('#suaDiaDiemList .dd-group');
            opts.forEach(o => { o.style.display = o.dataset.value.toLowerCase().includes(kw) ? '' : 'none'; });
            groups.forEach(g => {
                var next = g.nextElementSibling; var hasVisible = false;
                while (next && !next.classList.contains('dd-group')) {
                    if (next.style.display !== 'none') hasVisible = true;
                    next = next.nextElementSibling;
                }
                g.style.display = hasVisible ? '' : 'none';
            });
        }

        function addSuaHang() {
            var list = document.getElementById('sua-hang-list');
            var row = document.createElement('div');
            row.className = 'sua-hang-row';
            row.dataset.id = '0';
            row.style.cssText = 'display:grid;grid-template-columns:1fr 100px 30px;gap:6px;margin-bottom:6px;';
            row.innerHTML = '<input class="hang-input" placeholder="Đơn vị..."/><input class="hang-input" type="number" placeholder="Số lượng" min="0"/><button class="btn-remove" onclick="this.parentElement.remove()" type="button">×</button>';
            list.appendChild(row);
        }

        async function luuSuaPhieu(id,btn) {
            var hangs = [];
            document.querySelectorAll('.sua-hang-row').forEach(r => {
                var inputs = r.querySelectorAll('input');
                var dv = inputs[0].value.trim();
                var sl = parseInt(inputs[1].value) || 0;
                if (dv && sl > 0) hangs.push({ id: parseInt(r.dataset.id) || 0, donVi: dv, soLuong: sl });
            });
            var payload = {
                xuatId: id,
                thoiGianPhanCong: document.getElementById('sua-tgpc').value || null,
                diaDiemGiao: document.getElementById('sua-diadiem-val').value || null,
                ghiChu: document.getElementById('sua-ghichu').value || null,
                hangHoas: hangs
            };
           
             btn.disabled = true;
             btn.innerHTML = '⏳ Đang lưu...';
            try {
                var res = await fetch('@Url.Action("SuaPhanCong", "DieuDoXuat")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                var data = await res.json();
                if (res.ok) { closeModal(); await reloadAll(); }
                else { alert('❌ ' + (data.message || 'Lỗi lưu!')); }
            } catch(e) { alert('❌ Lỗi kết nối'); }
            finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-floppy" style="font-size:12px;"></i> Lưu thay đổi';
            }
        }

        async function huyPhieu(id){
            if(!confirm('Xác nhận hủy phiếu này? Xe sẽ trở về Trong bãi.'))return;
            try{
                var res=await fetch('@Url.Action("HuyPhanCong", "DieuDoXuat")',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({xuatId:id})});
                var data=await res.json();
                if(res.ok){await reloadAll();}else{alert('❌ '+(data.message||'Lỗi hủy!'));}
            }catch(e){alert('❌ Lỗi kết nối');}
        }
        function filterCua(btn, val) {
            document.querySelectorAll('#panel-cua .xf-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('#cua-list .cua-card').forEach(card => {
                var isActive = card.dataset.active === 'true';
                if (val === 'all') {
                    card.style.display = '';
                } else if (val === 'active') {
                    card.style.display = isActive ? '' : 'none';
                } else if (val === 'locked') {
                    card.style.display = !isActive ? '' : 'none';
                }
            });
        }
        reloadAll();
        setInterval(reloadAll,30000);
    </script>
}
