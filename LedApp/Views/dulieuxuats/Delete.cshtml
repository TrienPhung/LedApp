@model LedApp.Models.dulieuxuat

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Xóa dữ liệu</h1>

<h3>Bạn có chắc chắn muốn xóa không?</h3>
<div>
    <h4>dữ liệu xóa</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BienSoXe)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BienSoXe)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NgayXuat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayXuat)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.GioXuat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GioXuat)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhutXuat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhutXuat)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CongRa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CongRa)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CuaXuat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CuaXuat.Id)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Trở về</a>
    </form>
</div>
