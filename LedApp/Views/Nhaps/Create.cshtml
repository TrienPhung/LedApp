@model LedApp.Models.Nhap
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Thêm dữ liệu mới cho cửa nhập</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CuaNhapId" class="control-label"></label>
                <select asp-for="CuaNhapId" class="form-control" asp-items="ViewBag.CuaNhapId"></select>
                <span asp-validation-for="CuaNhapId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BienSoXe" class="control-label"></label>
                <input asp-for="BienSoXe" class="form-control" />
                <span asp-validation-for="BienSoXe" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianPhanCong" class="control-label"></label>
                <input asp-for="ThoiGianPhanCong" class="form-control flatpickr" />
                <span asp-validation-for="ThoiGianPhanCong" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianVaoBai" class="control-label"></label>
                <input asp-for="ThoiGianVaoBai" class="form-control flatpickr" />
                <span asp-validation-for="ThoiGianVaoBai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianVaoCua" class="control-label"></label>
                <input asp-for="ThoiGianVaoCua" class="form-control flatpickr" />
                <span asp-validation-for="ThoiGianVaoCua" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianGioiHan" class="control-label"></label>
                <input asp-for="ThoiGianGioiHan" class="form-control flatpickr" />
                <span asp-validation-for="ThoiGianGioiHan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TrangThai" class="control-label"></label>
                <select asp-for="TrangThai" class="form-control" asp-items="ViewBag.TrangThai"></select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GhiChu" class="control-label"></label>
                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu thông tin" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Trở về</a>
</div>
@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>

    <style>
        .flatpickr-buttons {
            display: flex;
            gap: 6px;
            padding: 6px 8px;
            border-top: 1px solid #e2e2e2;
        }

            .flatpickr-buttons button {
                flex: 1;
                padding: 4px 0;
                border: 1px solid #ccc;
                border-radius: 4px;
                background: #f8f8f8;
                cursor: pointer;
                font-size: 13px;
            }

                .flatpickr-buttons button:hover {
                    background: #e9e9e9;
                }
    </style>

    <script>
        flatpickr(".flatpickr", {
            enableTime: true,
            time_24hr: true,
            dateFormat: "Y-m-d H:i",
            locale: "vn",
            allowInput: true,
            onReady: function(selectedDates, dateStr, instance) {
                var btnWrapper = document.createElement("div");
                btnWrapper.className = "flatpickr-buttons";

                var btnToday = document.createElement("button");
                btnToday.type = "button";
                btnToday.textContent = "Hôm nay";
                btnToday.addEventListener("click", function() {
                    instance.setDate(new Date());
                    instance.close();
                });

                var btnClear = document.createElement("button");
                btnClear.type = "button";
                btnClear.textContent = "Xóa";
                btnClear.addEventListener("click", function() {
                    instance.clear();
                    instance.close();
                });

                btnWrapper.appendChild(btnToday);
                btnWrapper.appendChild(btnClear);
                instance.calendarContainer.appendChild(btnWrapper);
            }
        });
    </script>
}