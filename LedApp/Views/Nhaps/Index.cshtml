@model IEnumerable<LedApp.Models.Nhap>
@{
    ViewData["Title"] = "Quản lý phiếu nhập";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    .page-wrapper > .container-fluid {
        padding: 0 !important;
    }

    .px-page {
        padding: 24px 24px 80px;
    }

    /* ── Breadcrumb ── */
    .px-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 12px;
        line-height: 1;
    }

        .px-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
            line-height: 1;
        }

            .px-breadcrumb a:hover {
                color: #111827;
            }

        .px-breadcrumb .sep {
            display: inline-flex;
            align-items: center;
            color: #9ca3af;
            line-height: 1;
        }

            .px-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
                display: block;
            }

        .px-breadcrumb .cur {
            color: #111827;
            font-weight: 600;
            line-height: 1;
        }

    /* ── Header ── */
    .px-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .px-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 3px;
            line-height: 1.2;
        }

        .px-header p {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #16a34a;
        color: #fff;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #15803d;
            color: #fff;
            text-decoration: none;
        }

        .btn-add svg {
            width: 15px;
            height: 15px;
        }

    /* ── Toolbar ── */
    .px-toolbar-top {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        gap: 6px;
        flex-wrap: wrap;
    }

    .px-toolbar-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        gap: 10px;
    }

    .filter-tabs {
        display: inline-flex;
        gap: 2px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 3px;
    }

    .filter-tab {
        padding: 5px 14px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 500;
        color: #6b7280;
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        transition: all .15s;
        line-height: 1.4;
        white-space: nowrap;
    }

        .filter-tab:hover {
            color: #374151;
            background: rgba(255,255,255,0.5);
        }

        .filter-tab.active {
            background: #fff;
            color: #111827;
            border-color: #e5e7eb;
            font-weight: 600;
            box-shadow: 0 1px 3px rgba(0,0,0,.1), 0 1px 2px rgba(0,0,0,.06);
        }

    /* ── Search ── */
    .px-search {
        position: relative;
        flex: 1;
        max-width: 480px;
    }

        .px-search svg {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            width: 15px;
            height: 15px;
            pointer-events: none;
        }

        .px-search input {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            color: #111827;
            font-size: 0.875rem;
            padding: 9px 14px 9px 34px;
            width: 100%;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .px-search input::placeholder {
                color: #9ca3af;
            }

            .px-search input:focus {
                border-color: #16a34a;
                box-shadow: 0 0 0 3px rgba(22,163,74,.1);
            }

    .px-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tb-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s;
        white-space: nowrap;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .tb-btn:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
        }

        .tb-btn svg {
            width: 14px;
            height: 14px;
            color: #6b7280;
        }

    /* ── Columns dropdown ── */
    .columns-wrap {
        position: relative;
    }

    .col-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        z-index: 200;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
        min-width: 190px;
        overflow: hidden;
    }

        .col-dropdown.open {
            display: block;
        }

    .col-dropdown-title {
        padding: 10px 14px 6px;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #9ca3af;
    }

    .col-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 14px;
        cursor: pointer;
        transition: background .1s;
    }

        .col-item:hover {
            background: #f9fafb;
        }

        .col-item span {
            font-size: 0.82rem;
            color: #374151;
            font-weight: 500;
        }

    .col-check {
        width: 16px;
        height: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #16a34a;
        opacity: 0;
        transition: opacity .12s;
    }

        .col-check svg {
            width: 14px;
            height: 14px;
        }

    .col-item.col-visible .col-check {
        opacity: 1;
    }

    .col-hidden {
        display: none !important;
    }

    /* ── Category dropdown ── */
    .category-wrap {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-category {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .btn-category:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
        }

        .btn-category.has-filter {
            border-color: #16a34a;
            color: #16a34a;
        }

        .btn-category svg {
            width: 14px;
            height: 14px;
        }

    .cat-badge {
        display: none;
        align-items: center;
        justify-content: center;
        background: #111827;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        border-radius: 999px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
    }

        .cat-badge.show {
            display: inline-flex;
        }

    .btn-reset {
        display: none;
        align-items: center;
        gap: 5px;
        padding: 8px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .btn-reset.show {
            display: inline-flex;
        }

        .btn-reset:hover {
            background: #fef2f2;
            border-color: #fecaca;
            color: #ef4444;
        }

        .btn-reset svg {
            width: 13px;
            height: 13px;
        }

    .category-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        z-index: 200;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
        min-width: 220px;
    }

        .category-dropdown.open {
            display: block;
        }

    .cat-search-wrap {
        padding: 8px 10px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .cat-search-wrap svg {
            width: 14px;
            height: 14px;
            color: #9ca3af;
            flex-shrink: 0;
        }

        .cat-search-wrap input {
            border: none;
            outline: none;
            font-size: 0.82rem;
            color: #111827;
            background: transparent;
            width: 100%;
        }

            .cat-search-wrap input::placeholder {
                color: #9ca3af;
            }

    .cat-list {
        padding: 4px 0;
        max-height: 220px;
        overflow-y: auto;
    }

    .cat-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        cursor: pointer;
        transition: background .1s;
        gap: 8px;
    }

        .cat-item:hover {
            background: #f9fafb;
        }

    .cat-item-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cat-radio {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid #d1d5db;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all .15s;
        background: #fff;
        cursor: pointer;
    }

        .cat-radio.checked {
            border-color: #16a34a;
            background: #16a34a;
        }

            .cat-radio.checked::after {
                content: '';
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #fff;
            }

    .cat-item span {
        font-size: 0.82rem;
        color: #374151;
        font-weight: 500;
    }

    .cat-count {
        font-size: 0.75rem;
        color: #9ca3af;
        background: #f3f4f6;
        border-radius: 999px;
        padding: 1px 7px;
        font-weight: 500;
        flex-shrink: 0;
    }

    .cat-clear {
        display: none;
        padding: 8px 12px;
        border-top: 1px solid #f3f4f6;
        font-size: 0.82rem;
        color: #6b7280;
        text-align: center;
        cursor: pointer;
        transition: all .15s;
        font-weight: 500;
    }

        .cat-clear:hover {
            color: #ef4444;
            background: #fef2f2;
        }

    /* ── Table card ── */
    .px-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .px-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .px-table thead th {
            background: #f9fafb;
            color: #374151;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
            white-space: normal;
            line-height: 1.3;
            min-width: 70px;
            user-select: none;
        }

            .px-table thead th:first-child {
                width: 40px;
            }

    .th-inner {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
    }

        .th-inner:hover {
            color: #111827;
        }

    .sort-icon {
        display: inline-flex;
        opacity: 0.35;
        flex-shrink: 0;
        transition: opacity .15s;
    }

        .sort-icon svg {
            width: 12px;
            height: 12px;
            display: block;
        }

    .th-inner:hover .sort-icon {
        opacity: 0.65;
    }

    .sort-icon.active {
        opacity: 1;
        color: #16a34a;
    }

    .px-table tbody tr {
        border-bottom: 1px solid #f3f4f6;
        transition: background .1s;
    }

        .px-table tbody tr:last-child {
            border-bottom: none;
        }

        .px-table tbody tr:hover {
            background: #f9fafb;
        }

    .px-table td {
        padding: 12px 12px;
        color: #111827;
        vertical-align: middle;
        white-space: nowrap;
    }

    .td-bienso {
        font-weight: 600;
        color: #111827;
    }

    .td-time {
        color: #6b7280;
        font-size: 0.81rem;
    }

    .px-table input[type=checkbox] {
        width: 16px;
        height: 16px;
        accent-color: #16a34a;
        cursor: pointer;
    }

    /* ── Badges ── */
    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 600;
    }

        .badge-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

    .bp-phan-cong {
        background: #f1f5f9;
        color: #64748b;
    }

        .bp-phan-cong::before {
            background: #94a3b8;
        }

    .bp-ban-giao {
        background: #eff6ff;
        color: #3b82f6;
    }

        .bp-ban-giao::before {
            background: #3b82f6;
        }

    .bp-qua-tg {
        background: #fef2f2;
        color: #ef4444;
    }

        .bp-qua-tg::before {
            background: #ef4444;
        }

    .bp-hoan-thanh {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-hoan-thanh::before {
            background: #16a34a;
        }

    .th-action {
        width: 48px;
        text-align: right !important;
    }

    .px-table td:last-child {
        text-align: right;
    }

    /* ── Bulk bar ── */
    .bulk-bar-info {
        font-size: 0.875rem;
        color: #374151;
        font-weight: 500;
        white-space: nowrap;
    }

        .bulk-bar-info span {
            color: #111827;
            font-weight: 700;
        }

    .btn-bulk-delete {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ef4444;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
        white-space: nowrap;
    }

        .btn-bulk-delete:hover {
            background: #dc2626;
        }

        .btn-bulk-delete svg {
            width: 14px;
            height: 14px;
        }

    .btn-bulk-clear {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: transparent;
        border: none;
        color: #6b7280;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        padding: 6px 8px;
        border-radius: 6px;
        transition: all .15s;
    }

        .btn-bulk-clear:hover {
            color: #111827;
            background: #f3f4f6;
        }

        .btn-bulk-clear svg {
            width: 14px;
            height: 14px;
        }

    .px-table tbody tr.row-selected {
        background: #f0fdf4 !important;
    }

    /* ── Kebab ── */
    .row-action-wrap {
        position: relative;
        display: inline-flex;
    }

    .kebab-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 7px;
        border: 1px solid transparent;
        background: transparent;
        color: #9ca3af;
        cursor: pointer;
        transition: all .15s;
    }

        .kebab-btn:hover {
            background: #f3f4f6;
            color: #374151;
            border-color: #e5e7eb;
        }

    .row-action-menu {
        display: none;
        position: absolute;
        right: 0;
        z-index: 300;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
        min-width: 140px;
        overflow: hidden;
    }

        .row-action-menu.open {
            display: block;
        }

        .row-action-menu.drop-up {
            bottom: calc(100% + 4px);
            top: auto;
        }

        .row-action-menu.drop-down {
            top: calc(100% + 4px);
            bottom: auto;
        }

    .ram-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 14px;
        font-size: 0.82rem;
        color: #374151;
        font-weight: 500;
        text-decoration: none;
        transition: background .1s;
        cursor: pointer;
        white-space: nowrap;
    }

        .ram-item:hover {
            background: #f9fafb;
            color: #111827;
            text-decoration: none;
        }

        .ram-item svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

    .ram-delete {
        color: #ef4444;
    }

        .ram-delete:hover {
            background: #fef2f2;
            color: #dc2626;
        }

    /* ── Pagination ── */
    .px-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 16px;
        border-top: 1px solid #e5e7eb;
        font-size: 0.82rem;
        color: #6b7280;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pg-controls {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pg-rows {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .pg-rows select {
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 0.82rem;
            color: #374151;
            outline: none;
            cursor: pointer;
        }

    .pg-btn {
        padding: 5px 12px;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .12s;
    }

        .pg-btn:hover:not(:disabled) {
            background: #f3f4f6;
        }

        .pg-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .pg-num {
        min-width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .12s;
    }

        .pg-num:hover {
            background: #f3f4f6;
        }

        .pg-num.active {
            background: #16a34a;
            border-color: #16a34a;
            color: #fff;
            font-weight: 600;
        }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

        .empty-state svg {
            width: 40px;
            height: 40px;
            margin-bottom: 12px;
            opacity: .4;
        }

        .empty-state p {
            font-size: 0.875rem;
            margin: 0;
        }

    /* ── Alert ── */
    .px-alert {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ── No results ── */
    .no-results-row td {
        padding: 48px 20px;
        text-align: center !important;
        color: #6b7280;
        font-size: 0.875rem;
    }

    /* ── Delete modal ── */
    .del-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .del-modal-overlay.open {
            display: flex;
        }

    .del-modal {
        background: #fff;
        border-radius: 12px;
        padding: 24px 24px 20px;
        max-width: 380px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        position: relative;
    }

    .del-modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 1.1rem;
        line-height: 1;
        padding: 4px;
        border-radius: 6px;
        transition: all .15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .del-modal-close:hover {
            background: #f3f4f6;
            color: #374151;
        }

    .del-modal-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 8px;
        padding-right: 24px;
    }

    .del-modal-body {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 20px;
        line-height: 1.55;
    }

    .del-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-modal-cancel {
        padding: 8px 18px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-modal-cancel:hover {
            background: #f9fafb;
            border-color: #d1d5db;
        }

    .btn-modal-confirm {
        padding: 8px 18px;
        border-radius: 8px;
        border: none;
        background: #ef4444;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-modal-confirm:hover {
            background: #dc2626;
        }

    body.modal-open {
        overflow: hidden;
    }

    /* ── Dark mode ── */
    body.dark-mode .px-header h1 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .px-header p {
