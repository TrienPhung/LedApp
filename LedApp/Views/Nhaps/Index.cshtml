@model IEnumerable<LedApp.Models.Nhap>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Quản lý thông tin tổng hợp nhập</h1>
<p>
    <a asp-action="Create">Thêm mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>STT</th>
            <th>@Html.DisplayNameFor(model => model.CuaNhapId)</th>
            <th>@Html.DisplayNameFor(model => model.BienSoXe)</th>
            <th>@Html.DisplayNameFor(model => model.ThoiGianPhanCong)</th>
            <th>@Html.DisplayNameFor(model => model.ThoiGianVaoBai)</th>
            <th>@Html.DisplayNameFor(model => model.ThoiGianVaoCua)</th>
            <th>@Html.DisplayNameFor(model => model.ThoiGianGioiHan)</th>
            <th>@Html.DisplayNameFor(model => model.ThoiGianHoanThanh)</th>
            <th>@Html.DisplayNameFor(model => model.NhanVienXacNhanId)</th>
            <th>@Html.DisplayNameFor(model => model.TrangThai)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            int stt = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@stt</td>
                <td>@(item.CuaNhap?.Ten ?? "N/A")</td>
                <td>@item.BienSoXe</td>
                <td>@item.ThoiGianPhanCong.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.ThoiGianVaoBai?.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.ThoiGianVaoCua?.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.ThoiGianGioiHan?.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.ThoiGianHoanThanh?.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(item.NhanVienXacNhan?.Name ?? "Chưa xác nhận")</td>
                <td>
                    <span class="badge @TrangThaiHelper.GetBadgeClassNhap(item.TrangThai)">
                        @TrangThaiHelper.GetTenTrangThaiNhap(item.TrangThai)
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
            stt++;
        }
    </tbody>
</table>