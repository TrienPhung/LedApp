</style>

<div class="px-page">

    @if (TempData["Error"] != null)
    {
        <div class="px-alert">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
            @TempData["Error"]
        </div>
    }

    <!-- Breadcrumb -->
    <div class="px-breadcrumb">
        <a href="/">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">Phiếu nhập</span>
    </div>

    <!-- Header -->
    <div class="px-header">
        <div>
            <h1>Quản lý phiếu nhập</h1>
            <p>Theo dõi và quản lý toàn bộ phiếu nhập kho.</p>
        </div>
        <a asp-action="Create" class="btn-add" perm="Nhap.Create">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Thêm phiếu mới
        </a>
    </div>

    <!-- Toolbar row 1: filter tabs -->
    <div class="px-toolbar-top">
        <div class="filter-tabs">
            <button class="filter-tab active" data-filter="all">Tất cả</button>
            <button class="filter-tab" data-filter="phan-cong">Đã phân công</button>
            <button class="filter-tab" data-filter="ban-giao">Đang bàn giao</button>
            <button class="filter-tab" data-filter="hoan-thanh">Hoàn thành</button>
            <button class="filter-tab" data-filter="qua-tg">Quá thời gian</button>
        </div>
    </div>

    <!-- Toolbar row 2 -->
    <div class="px-toolbar-bottom" id="toolbarBottom">

        <!-- LEFT: Normal mode -->
        <div id="normalBar" style="display:flex;align-items:center;gap:8px;flex:1;">
            <div class="px-search">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                <input type="text" id="searchInput" placeholder="Tìm biển số, cửa nhập..." />
            </div>
            <div style="display:flex;align-items:center;gap:8px;" id="catResetGroup">
                <div class="category-wrap" id="categoryWrap">
                    <button class="btn-category" id="categoryBtn" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                        Trạng thái
                        <span class="cat-badge" id="catBadge"></span>
                    </button>
                    <div class="category-dropdown" id="categoryDropdown">
                        <div class="cat-search-wrap">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                            <input type="text" id="catSearchInput" placeholder="Trạng thái" />
                        </div>
                        <div class="cat-list" id="catList">
                            <div class="cat-item" data-filter="phan-cong">
                                <div class="cat-item-left"><div class="cat-radio" id="radio-phan-cong"></div><span>Đã phân công</span></div>
                                <span class="cat-count" id="count-phan-cong">0</span>
                            </div>
                            <div class="cat-item" data-filter="ban-giao">
                                <div class="cat-item-left"><div class="cat-radio" id="radio-ban-giao"></div><span>Đang bàn giao</span></div>
                                <span class="cat-count" id="count-ban-giao">0</span>
                            </div>
                            <div class="cat-item" data-filter="hoan-thanh">
                                <div class="cat-item-left"><div class="cat-radio" id="radio-hoan-thanh"></div><span>Hoàn thành</span></div>
                                <span class="cat-count" id="count-hoan-thanh">0</span>
                            </div>
                            <div class="cat-item" data-filter="qua-tg">
                                <div class="cat-item-left"><div class="cat-radio" id="radio-qua-tg"></div><span>Quá thời gian</span></div>
                                <span class="cat-count" id="count-qua-tg">0</span>
                            </div>
                        </div>
                        <div class="cat-clear" id="catClear">Xóa bộ lọc</div>
                    </div>
                </div>
                <button class="btn-reset" id="btnReset" type="button">
                    Reset
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                </button>
            </div>
        </div>

        <!-- LEFT: Bulk mode -->
        <div id="bulkBar" style="display:none;align-items:center;gap:10px;flex:1;">
            <span class="bulk-bar-info"><span id="bulkCount">0</span> selected</span>
            <button class="btn-bulk-delete" id="btnBulkDelete" type="button" perm="Nhap.Delete">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                Delete (<span id="bulkDeleteCount">0</span>)
            </button>
            <button class="btn-bulk-clear" id="btnBulkClear" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                Clear
            </button>
        </div>

        <!-- RIGHT -->
        <div class="px-toolbar-actions">
            <div class="columns-wrap" id="columnsWrap">
                <button class="tb-btn" id="columnsBtn" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125Z" /></svg>
                    Columns
                </button>
                <div class="col-dropdown" id="colDropdown">
                    <div class="col-dropdown-title">Toggle columns</div>
                    <div class="col-item col-visible" data-col="cua-nhap"><span>Cửa nhập</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="bien-so"><span>Biển số xe</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="phan-cong-time"><span>TG phân công</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="vao-bai-time"><span>TG vào bãi</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="vao-cua-time"><span>TG vào cửa</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="gioi-han-time"><span>TG giới hạn</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="hoan-thanh-time"><span>TG hoàn thành</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="trang-thai"><span>Trạng thái</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                </div>
            </div>
            <button class="tb-btn" id="exportBtn" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                Export
            </button>
            <div id="exportToast" style="display:none;position:fixed;bottom:24px;right:24px;z-index:9999;background:#111827;color:#fff;border-radius:10px;padding:12px 18px;font-size:0.875rem;font-weight:500;align-items:center;gap:10px;box-shadow:0 8px 24px rgba(0,0,0,.2);">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#16a34a" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                <span id="exportToastMsg"></span>
                <button onclick="document.getElementById('exportToast').style.display='none'" style="background:none;border:none;color:#9ca3af;cursor:pointer;margin-left:8px;font-size:1rem;line-height:1;">×</button>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="px-card">
        <table class="px-table">
            <thead>
                <tr>
                    <th><input type="checkbox" id="checkAll" /></th>
                    <th data-col-th="cua-nhap"><span class="th-inner">Cửa nhập <span class="sort-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5" /><path d="m7 9 5-5 5 5" /></svg></span></span></th>
                    <th data-col-th="bien-so"><span class="th-inner">Biển số xe <span class="sort-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5" /><path d="m7 9 5-5 5 5" /></svg></span></span></th>
                    <th data-col-th="phan-cong-time"><span class="th-inner">Thời gian<br />phân công <span class="sort-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5" /><path d="m7 9 5-5 5 5" /></svg></span></span></th>
                    <th data-col-th="vao-bai-time"><span class="th-inner">Thời gian<br />vào bãi <span class="sort-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5" /><path d="m7 9 5-5 5 5" /></svg></span></span></th>
                    <th data-col-th="vao-cua-time"><span class="th-inner">Thời gian<br />vào cửa <span class="sort-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5" /><path d="m7 9 5-5 5 5" /></svg></span></span></th>
                    <th data-col-th="gioi-han-time"><span class="th-inner">Thời gian<br />giới hạn <span class="sort-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5" /><path d="m7 9 5-5 5 5" /></svg></span></span></th>
                    <th data-col-th="hoan-thanh-time"><span class="th-inner">Thời gian<br />hoàn thành <span class="sort-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5" /><path d="m7 9 5-5 5 5" /></svg></span></span></th>
                    <th data-col-th="trang-thai"><span class="th-inner">Trạng thái <span class="sort-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5" /><path d="m7 9 5-5 5 5" /></svg></span></span></th>
                    <th class="th-action"></th>
                </tr>
            </thead>
            <tbody id="nhapBody">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10">
                            <div class="empty-state">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z" /></svg>
                                <p>Chưa có phiếu nhập nào.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    string badgeClass = item.TrangThai switch
                    {
                        (int)LedApp.Models.TrangThaiNhap.DaPhanCong => "bp-phan-cong",
                        (int)LedApp.Models.TrangThaiNhap.DangBanGiao => "bp-ban-giao",
                        (int)LedApp.Models.TrangThaiNhap.QuaThoiGian => "bp-qua-tg",
                        (int)LedApp.Models.TrangThaiNhap.HoanThanh => "bp-hoan-thanh",
                        _ => "bp-phan-cong"
                    };
                    string badgeLabel = item.TrangThai switch
                    {
                        (int)LedApp.Models.TrangThaiNhap.DaPhanCong => "Đã phân công",
                        (int)LedApp.Models.TrangThaiNhap.DangBanGiao => "Đang bàn giao",
                        (int)LedApp.Models.TrangThaiNhap.QuaThoiGian => "Quá thời gian",
                        (int)LedApp.Models.TrangThaiNhap.HoanThanh => "Hoàn thành",
                        _ => "—"
                    };
                    string filterKey = item.TrangThai switch
                    {
                        (int)LedApp.Models.TrangThaiNhap.DaPhanCong => "phan-cong",
                        (int)LedApp.Models.TrangThaiNhap.DangBanGiao => "ban-giao",
                        (int)LedApp.Models.TrangThaiNhap.QuaThoiGian => "qua-tg",
                        (int)LedApp.Models.TrangThaiNhap.HoanThanh => "hoan-thanh",
                        _ => ""
                    };

                    <tr data-filter="@filterKey"
                        data-id="@item.Id"
                        data-search="@((item.BienSoXe ?? "") + " " + (item.CuaNhap?.Ten ?? $"N-{item.CuaNhapId:D2}"))">
                        <td><input type="checkbox" class="row-check" /></td>
                        <td data-col-td="cua-nhap" style="color:#374151;">@(item.CuaNhap?.Ten ?? $"N-{item.CuaNhapId:D2}")</td>
                        <td data-col-td="bien-so" class="td-bienso">@(item.BienSoXe ?? "—")</td>
                        <td data-col-td="phan-cong-time" class="td-time">@item.ThoiGianPhanCong.ToString("dd/MM HH:mm")</td>
                        <td data-col-td="vao-bai-time" class="td-time">@(item.ThoiGianVaoBai?.ToString("dd/MM HH:mm") ?? "—")</td>
                        <td data-col-td="vao-cua-time" class="td-time">@(item.ThoiGianVaoCua?.ToString("dd/MM HH:mm") ?? "—")</td>
                        <td data-col-td="gioi-han-time" class="td-time">@(item.ThoiGianGioiHan?.ToString("dd/MM HH:mm") ?? "—")</td>
                        <td data-col-td="hoan-thanh-time" class="td-time">@(item.ThoiGianHoanThanh?.ToString("dd/MM HH:mm") ?? "—")</td>
                        <td data-col-td="trang-thai"><span class="badge-pill @badgeClass">@badgeLabel</span></td>
                        <td>
                            <div class="row-action-wrap">
                                <button class="kebab-btn" type="button" title="Actions">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="16" height="16"><circle cx="5" cy="12" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="19" cy="12" r="1.5" /></svg>
                                </button>
                                <div class="row-action-menu">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="ram-item" perm="Nhap.View">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                                        View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="ram-item" perm="Nhap.Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="ram-item ram-delete" perm="Nhap.Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                                        Delete
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <div class="px-pagination">
            <div class="pg-info" id="pgInfo">Showing 0 results</div>
            <div style="display:flex;align-items:center;gap:16px;">
                <div class="pg-rows">
                    Rows
                    <select id="rowsPerPage">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div class="pg-controls" id="pgControls"></div>
            </div>
        </div>
    </div>

    <!-- Modal xóa đơn -->
    <div class="del-modal-overlay" id="delModalOverlay">
        <div class="del-modal">
            <button class="del-modal-close" id="delModalClose">×</button>
            <div class="del-modal-title">Xóa phiếu nhập</div>
            <div class="del-modal-body">Bạn có chắc chắn muốn xóa phiếu này không? Hành động này không thể hoàn tác.</div>
            <div class="del-modal-footer">
                <button class="btn-modal-cancel" id="delModalCancel">Cancel</button>
                <form id="delConfirmForm" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-modal-confirm">Delete</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal xóa nhiều -->
    <div class="del-modal-overlay" id="bulkDelModalOverlay">
        <div class="del-modal">
            <button class="del-modal-close" id="bulkDelModalClose">×</button>
            <div class="del-modal-title">Xóa phiếu nhập đã chọn</div>
            <div class="del-modal-body">Bạn có chắc chắn muốn xóa <strong id="bulkDelCount">0</strong> phiếu nhập đã chọn? Hành động này không thể hoàn tác.</div>
            <div class="del-modal-footer">
                <button class="btn-modal-cancel" id="bulkDelModalCancel">Cancel</button>
                <button class="btn-modal-confirm" id="bulkDelModalConfirm">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const allRows = Array.from(document.querySelectorAll('#nhapBody tr[data-filter]'));
        const searchInput = document.getElementById('searchInput');
        const rowsPerPageSel = document.getElementById('rowsPerPage');
        const pgInfo = document.getElementById('pgInfo');
        const pgControls = document.getElementById('pgControls');
        const categoryBtn = document.getElementById('categoryBtn');
        const categoryDropdown = document.getElementById('categoryDropdown');
        const catSearchInput = document.getElementById('catSearchInput');
        const catBadge = document.getElementById('catBadge');
        const btnReset = document.getElementById('btnReset');
        const catClear = document.getElementById('catClear');
        const columnsBtn = document.getElementById('columnsBtn');
        const colDropdown = document.getElementById('colDropdown');
        const nhapBody = document.getElementById('nhapBody');

        let currentPage = 1;
        let activeTabFilter = 'all';
        let activeCatFilters = new Set();
        let sortCol = null;
        let sortDir = 'asc';

        // Count records
        const filterCounts = {};
        allRows.forEach(r => { const k = r.dataset.filter; filterCounts[k] = (filterCounts[k] || 0) + 1; });
        ['phan-cong','ban-giao','hoan-thanh','qua-tg'].forEach(k => {
            const el = document.getElementById('count-' + k);
            if (el) el.textContent = filterCounts[k] || 0;
        });

        // Filter tabs
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                activeTabFilter = tab.dataset.filter;
                currentPage = 1; render();
            });
        });

        // Category dropdown
        categoryBtn.addEventListener('click', (e) => { e.stopPropagation(); colDropdown.classList.remove('open'); categoryDropdown.classList.toggle('open'); });
        document.querySelectorAll('#catList .cat-item').forEach(item => {
            item.addEventListener('click', () => {
                const f = item.dataset.filter;
                const radio = document.getElementById('radio-' + f);
                if (activeCatFilters.has(f)) { activeCatFilters.delete(f); radio.classList.remove('checked'); }
                else { activeCatFilters.add(f); radio.classList.add('checked'); }
                updateCategoryUI(); currentPage = 1; render();
            });
        });
        catSearchInput.addEventListener('input', () => {
            const q = catSearchInput.value.toLowerCase();
            document.querySelectorAll('#catList .cat-item').forEach(item => {
                item.style.display = item.querySelector('span').textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
        catClear.addEventListener('click', (e) => {
            e.stopPropagation();
            activeCatFilters.clear();
            document.querySelectorAll('#catList .cat-radio').forEach(r => r.classList.remove('checked'));
            updateCategoryUI(); currentPage = 1; render();
        });
        btnReset.addEventListener('click', () => {
            activeCatFilters.clear();
            document.querySelectorAll('#catList .cat-radio').forEach(r => r.classList.remove('checked'));
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            document.querySelector('.filter-tab[data-filter="all"]').classList.add('active');
            activeTabFilter = 'all'; searchInput.value = '';
            updateCategoryUI(); categoryDropdown.classList.remove('open'); currentPage = 1; render();
        });

        function updateCategoryUI() {
            const hasCat = activeCatFilters.size > 0;
            const hasSearch = searchInput.value.trim().length > 0;
            catBadge.textContent = activeCatFilters.size;
            catBadge.classList.toggle('show', hasCat);
            categoryBtn.classList.toggle('has-filter', hasCat);
            catClear.style.display = hasCat ? 'block' : 'none';
            btnReset.classList.toggle('show', hasSearch || hasCat);
        }

        searchInput.addEventListener('input', () => { updateCategoryUI(); currentPage = 1; render(); });
        rowsPerPageSel.addEventListener('change', () => { currentPage = 1; render(); });

        // Bulk selection
        const bulkBar = document.getElementById('bulkBar');
        const normalBar = document.getElementById('normalBar');
        const checkAll = document.getElementById('checkAll');

        function updateBulkUI() {
            const checked = Array.from(document.querySelectorAll('.row-check:checked'));
            const count = checked.length;
            document.querySelectorAll('#nhapBody tr[data-filter]').forEach(row => {
                const cb = row.querySelector('.row-check');
                row.classList.toggle('row-selected', cb && cb.checked);
            });
            document.getElementById('bulkCount').textContent = count;
            document.getElementById('bulkDeleteCount').textContent = count;
            if (count > 0) {
                normalBar.style.display = 'none'; bulkBar.style.display = 'flex';
                const total = document.querySelectorAll('.row-check').length;
                checkAll.indeterminate = count > 0 && count < total;
                checkAll.checked = count === total && total > 0;
            } else {
                normalBar.style.display = 'flex'; bulkBar.style.display = 'none';
                checkAll.indeterminate = false; checkAll.checked = false;
            }
        }

        checkAll.addEventListener('change', function () { getFiltered().forEach(row => { const cb = row.querySelector('.row-check'); if (cb) cb.checked = this.checked; }); updateBulkUI(); });
        document.getElementById('nhapBody').addEventListener('change', (e) => { if (e.target.classList.contains('row-check')) updateBulkUI(); });
        document.getElementById('btnBulkClear').addEventListener('click', () => { document.querySelectorAll('.row-check').forEach(c => c.checked = false); updateBulkUI(); });

        // Columns dropdown
        columnsBtn.addEventListener('click', (e) => { e.stopPropagation(); categoryDropdown.classList.remove('open'); colDropdown.classList.toggle('open'); });
        document.querySelectorAll('#colDropdown .col-item').forEach(item => {
            item.addEventListener('click', (e) => {
                e.stopPropagation();
                const col = item.dataset.col;
                const isVisible = item.classList.contains('col-visible');
                item.classList.toggle('col-visible', !isVisible);
                document.querySelectorAll(`[data-col-th="${col}"]`).forEach(el => el.classList.toggle('col-hidden', isVisible));
                document.querySelectorAll(`[data-col-td="${col}"]`).forEach(el => el.classList.toggle('col-hidden', isVisible));
            });
        });
        document.addEventListener('click', (e) => {
            if (!document.getElementById('categoryWrap').contains(e.target)) categoryDropdown.classList.remove('open');
            if (!document.getElementById('columnsWrap').contains(e.target)) colDropdown.classList.remove('open');
        });

        // Sort
        document.querySelectorAll('.th-inner').forEach(inner => {
            inner.addEventListener('click', () => {
                const th = inner.closest('th'); const col = th.dataset.colTh; if (!col) return;
                sortDir = sortCol === col ? (sortDir === 'asc' ? 'desc' : 'asc') : 'asc';
                sortCol = col;
                document.querySelectorAll('.th-inner').forEach(i => { i.querySelector('.sort-icon').classList.remove('active'); i.querySelector('.sort-icon').innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>`; });
                const activeIcon = inner.querySelector('.sort-icon'); activeIcon.classList.add('active');
                activeIcon.innerHTML = sortDir === 'asc' ? `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7 9 5-5 5 5"/></svg>` : `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/></svg>`;
                allRows.sort((a, b) => { const aVal = (a.querySelector(`[data-col-td="${col}"]`)?.textContent.trim() || ''); const bVal = (b.querySelector(`[data-col-td="${col}"]`)?.textContent.trim() || ''); return sortDir === 'asc' ? aVal.localeCompare(bVal, 'vi', {numeric:true}) : bVal.localeCompare(aVal, 'vi', {numeric:true}); });
                allRows.forEach(r => nhapBody.appendChild(r)); currentPage = 1; render();
            });
        });

        let noResultsRow = null;
        function ensureNoResultsRow() {
            if (!noResultsRow) { noResultsRow = document.createElement('tr'); noResultsRow.className = 'no-results-row'; noResultsRow.innerHTML = '<td colspan="10" style="text-align:center;padding:48px 20px;color:#6b7280;font-size:0.875rem;">Không tìm thấy kết quả nào.</td>';}
            return noResultsRow;
        }

        function getFiltered() {
            const q = searchInput.value.toLowerCase();
            return allRows.filter(row => {
                const tabMatch = activeTabFilter === 'all' || row.dataset.filter === activeTabFilter;
                const catMatch = activeCatFilters.size === 0 || activeCatFilters.has(row.dataset.filter);
                const searchMatch = !q || row.dataset.search.toLowerCase().includes(q);
                return tabMatch && catMatch && searchMatch;
            });
        }

        function render() {
            const visibleRows = getFiltered();
            const rpp = parseInt(rowsPerPageSel.value);
            const totalPages = Math.max(1, Math.ceil(visibleRows.length / rpp));
            currentPage = Math.min(currentPage, totalPages);
            const start = (currentPage - 1) * rpp; const end = start + rpp;
            allRows.forEach(r => r.style.display = 'none');
            const existing = nhapBody.querySelector('.no-results-row'); if (existing) existing.remove();
            if (visibleRows.length === 0) { nhapBody.appendChild(ensureNoResultsRow()); pgInfo.textContent = 'Showing 0 results'; }
            else { visibleRows.slice(start, end).forEach(r => r.style.display = ''); pgInfo.textContent = 'Showing ' + (start+1) + '–' + Math.min(end, visibleRows.length) + ' of ' + visibleRows.length + ' results'; }
            pgControls.innerHTML = '';
            const prev = document.createElement('button'); prev.className = 'pg-btn'; prev.textContent = 'Previous'; prev.disabled = currentPage === 1; prev.onclick = () => { currentPage--; render(); }; pgControls.appendChild(prev);
            pageRange(currentPage, totalPages).forEach(p => {
                if (p === '...') { const dot = document.createElement('span'); dot.textContent = '…'; dot.style.cssText = 'padding:0 4px;color:#9ca3af;'; pgControls.appendChild(dot); }
                else { const btn = document.createElement('button'); btn.className = 'pg-num' + (p === currentPage ? ' active' : ''); btn.textContent = p; btn.onclick = () => { currentPage = p; render(); }; pgControls.appendChild(btn); }
            });
            const next = document.createElement('button'); next.className = 'pg-btn'; next.textContent = 'Next'; next.disabled = currentPage === totalPages; next.onclick = () => { currentPage++; render(); }; pgControls.appendChild(next);
        }

        function pageRange(cur, total) {
            if (total <= 7) return Array.from({length: total}, (_, i) => i + 1);
            if (cur <= 4) return [1, 2, 3, 4, 5, '...', total];
            if (cur >= total - 3) return [1, '...', total-4, total-3, total-2, total-1, total];
            return [1, '...', cur-1, cur, cur+1, '...', total];
        }

        render();

        // Kebab
        document.addEventListener('click', (e) => { if (!e.target.closest('.row-action-wrap')) document.querySelectorAll('.row-action-menu.open').forEach(m => m.classList.remove('open')); });
        document.querySelectorAll('.kebab-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const menu = btn.nextElementSibling; const isOpen = menu.classList.contains('open');
                document.querySelectorAll('.row-action-menu.open').forEach(m => m.classList.remove('open'));
                if (!isOpen) {
                    const rect = btn.getBoundingClientRect(); const spaceBelow = window.innerHeight - rect.bottom;
                    const visibleRows = Array.from(document.querySelectorAll('#nhapBody tr[data-filter]')).filter(r => r.style.display !== 'none');
                    const isLastRow = visibleRows.length > 0 && visibleRows[visibleRows.length - 1] === btn.closest('tr');
                    menu.classList.remove('drop-up', 'drop-down');
                    menu.classList.add((isLastRow || spaceBelow < 160) ? 'drop-up' : 'drop-down');
                    menu.classList.add('open');
                }
            });
        });

        // Delete single modal
        const delModalOverlay = document.getElementById('delModalOverlay');
        function openDelModal(url) { document.getElementById('delConfirmForm').action = url; delModalOverlay.classList.add('open'); document.body.classList.add('modal-open'); }
        function closeDelModal() { delModalOverlay.classList.remove('open'); document.body.classList.remove('modal-open'); }
        document.getElementById('delModalClose').addEventListener('click', closeDelModal);
        document.getElementById('delModalCancel').addEventListener('click', closeDelModal);
        delModalOverlay.addEventListener('click', (e) => { if (e.target === delModalOverlay) closeDelModal(); });
        document.querySelectorAll('.ram-delete').forEach(link => {
            link.addEventListener('click', (e) => { e.preventDefault(); document.querySelectorAll('.row-action-menu.open').forEach(m => m.classList.remove('open')); openDelModal(link.href); });
        });

        // Bulk delete modal
        const bulkDelModalOverlay = document.getElementById('bulkDelModalOverlay');
        function openBulkDelModal() { document.getElementById('bulkDelCount').textContent = document.querySelectorAll('.row-check:checked').length; bulkDelModalOverlay.classList.add('open'); document.body.classList.add('modal-open'); }
        function closeBulkDelModal() { bulkDelModalOverlay.classList.remove('open'); document.body.classList.remove('modal-open'); }
        document.getElementById('bulkDelModalClose').addEventListener('click', closeBulkDelModal);
        document.getElementById('bulkDelModalCancel').addEventListener('click', closeBulkDelModal);
        bulkDelModalOverlay.addEventListener('click', (e) => { if (e.target === bulkDelModalOverlay) closeBulkDelModal(); });
        document.getElementById('btnBulkDelete').addEventListener('click', openBulkDelModal);
        document.getElementById('bulkDelModalConfirm').addEventListener('click', async () => {
            const checkedRows = Array.from(document.querySelectorAll('.row-check:checked'));
            const ids = checkedRows.map(cb => parseInt(cb.closest('tr').dataset.id)).filter(id => !isNaN(id));
            if (ids.length === 0) { closeBulkDelModal(); return; }
            const btn = document.getElementById('bulkDelModalConfirm');
            btn.disabled = true; btn.textContent = 'Đang xóa...';
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const res = await fetch('/Nhaps/BulkDelete', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify({ ids }) });
                if (res.ok) {
                    checkedRows.forEach(cb => { const row = cb.closest('tr'); const idx = allRows.indexOf(row); if (idx > -1) allRows.splice(idx, 1); row.remove(); });
                    closeBulkDelModal(); updateBulkUI(); render();
                } else { alert('Xóa thất bại.'); closeBulkDelModal(); }
            } catch { alert('Lỗi kết nối server.'); closeBulkDelModal(); }
            finally { btn.disabled = false; btn.textContent = 'Delete'; }
        });

        // Export CSV
        document.getElementById('exportBtn').addEventListener('click', () => {
            const visibleRows = getFiltered();
            const visibleColKeys = Array.from(document.querySelectorAll('#colDropdown .col-item.col-visible')).map(item => item.dataset.col);
            const colLabels = { 'cua-nhap': 'Cửa nhập', 'bien-so': 'Biển số xe', 'phan-cong-time': 'TG phân công', 'vao-bai-time': 'TG vào bãi', 'vao-cua-time': 'TG vào cửa', 'gioi-han-time': 'TG giới hạn', 'hoan-thanh-time': 'TG hoàn thành', 'trang-thai': 'Trạng thái' };
            const headers = visibleColKeys.map(k => colLabels[k] || k);
            const rows = visibleRows.map(row => visibleColKeys.map(key => { const td = row.querySelector(`[data-col-td="${key}"]`); return `"${(td ? td.textContent.trim() : '').replace(/"/g, '""')}"`; }).join(','));
            const csv = [headers.map(h => `"${h}"`).join(','), ...rows].join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = 'phieu-nhap.csv'; a.click(); URL.revokeObjectURL(url);
            const toast = document.getElementById('exportToast'); document.getElementById('exportToastMsg').textContent = `Exported ${visibleRows.length} rows to CSV`; toast.style.display = 'flex'; setTimeout(() => { toast.style.display = 'none'; }, 3500);
        });
    })();
</script>
