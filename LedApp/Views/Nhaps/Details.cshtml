@model LedApp.Models.Nhap
@{
    ViewData["Title"] = "Chi tiết";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Chi tiết nhập</h1>
<div>
    <h4>Thông tin phiếu nhập</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CuaNhapId)</dt>
        <dd class="col-sm-10">@(Model.CuaNhap?.Ten ?? "N/A")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.BienSoXe)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.BienSoXe)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ThoiGianPhanCong)</dt>
        <dd class="col-sm-10">@Model.ThoiGianPhanCong.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ThoiGianVaoBai)</dt>
        <dd class="col-sm-10">@Model.ThoiGianVaoBai?.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ThoiGianVaoCua)</dt>
        <dd class="col-sm-10">@Model.ThoiGianVaoCua?.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ThoiGianGioiHan)</dt>
        <dd class="col-sm-10">@Model.ThoiGianGioiHan?.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ThoiGianHoanThanh)</dt>
        <dd class="col-sm-10">@Model.ThoiGianHoanThanh?.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TrangThai)</dt>
        <dd class="col-sm-10">
            <span class="badge @TrangThaiHelper.GetBadgeClassNhap(Model.TrangThai)">
                @TrangThaiHelper.GetTenTrangThaiNhap(Model.TrangThai)
            </span>
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.NhanVienXacNhanId)</dt>
        <dd class="col-sm-10">@(Model.NhanVienXacNhan?.FullName ?? "Chưa xác nhận")</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.GhiChu)</dt>
        <dd class="col-sm-10">@(Model.GhiChu ?? "—")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Sửa</a> |
    <a asp-action="Index">Trở về</a>
</div>