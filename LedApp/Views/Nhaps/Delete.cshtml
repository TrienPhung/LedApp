@model LedApp.Models.Nhap

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Xóa thông tin</h1>

<h3>Bạn có chắc chắn muốn xóa thông tin nhập không?</h3>
<div>
    <h4>Thông tin muốn xóa</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BienSoXe)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BienSoXe)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NgayNhap)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayNhap)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.GioNhap)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GioNhap)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhutNhap)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhutNhap)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CongVao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CongVao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CuaNhap)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CuaNhap.Id)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Trở về</a>
    </form>
</div>
