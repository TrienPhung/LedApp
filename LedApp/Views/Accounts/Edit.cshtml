@model LedApp.Controllers.AccountEditViewModel
@{
    ViewData["Title"] = "Sửa tài khoản";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Sửa tài khoản</h1>
<hr />
<div class="row">
    <div class="col-md-5">

        @if (Model.NguoiDung != null)
        {
            <div class="d-flex align-items-center gap-3 mb-4 p-3"
                 style="background:#f8f9fa;border-radius:8px;border:1px solid #dee2e6;">
                <img src="@(Model.NguoiDung.Image ?? "/uploads/avatars/default.png")"
                     style="width:56px;height:56px;object-fit:cover;border-radius:50%;border:1px solid #ddd;" />
                <div>
                    <div class="fw-semibold">@Model.NguoiDung.FullName</div>
                    <div class="text-muted" style="font-size:13px;">Nhân viên liên kết</div>
                </div>
            </div>
        }

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="UserId" />

            <div class="form-group mb-3">
                <label asp-for="UserName" class="control-label">Username</label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewPassword" class="control-label">
                    Mật khẩu mới <small class="text-muted">(để trống nếu không đổi)</small>
                </label>
                <div style="position:relative;">
                    <input asp-for="NewPassword" class="form-control" type="password"
                           id="newPasswordInput" placeholder="Nhập mật khẩu mới..."
                           style="padding-right:40px;" />
                    <i class="mdi mdi-eye" onclick="togglePass('newPasswordInput', this)"
                       style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                  cursor:pointer;color:#6c757d;font-size:18px;"></i>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Role" class="control-label">Role</label>
                <select asp-for="Role" class="form-control">
                    <option value="">-- Không gán role --</option>
                    @foreach (var r in Model.AvailableRoles)
                    {
                        <option value="@r" selected="@(r == Model.Role ? "selected" : null)">@r</option>
                    }
                </select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Trở về</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function togglePass(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('mdi-eye', 'mdi-eye-off');
            } else {
                input.type = 'password';
                icon.classList.replace('mdi-eye-off', 'mdi-eye');
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
