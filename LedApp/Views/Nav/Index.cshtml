            transition: all .2s ease;
            position: relative;
            overflow: hidden;
            color: var(--text);
        }

            .card::before {
                content: '';
                position: absolute;
                inset: 0;
                opacity: 0;
                transition: opacity .2s;
                border-radius: 10px;
            }

            .card:hover {
                transform: translateY(-2px);
                border-color: var(--card-color,var(--border));
                background: var(--card-bg-hover);
                box-shadow: var(--shadow);
            }

                .card:hover::before {
                    opacity: 1;
                }

            .card:active {
                transform: translateY(0);
            }

        .card-green {
            --card-color: var(--green);
        }

            .card-green::before {
                background: radial-gradient(ellipse at top left,rgba(34,197,94,.07),transparent 60%);
            }

            .card-green:hover .card-icon {
                color: var(--green);
            }

            .card-green:hover .card-name {
                color: var(--green);
            }

            .card-green:hover {
                box-shadow: 0 4px 20px rgba(34,197,94,.12);
            }

        .card-gold {
            --card-color: var(--gold);
        }

            .card-gold::before {
                background: radial-gradient(ellipse at top left,rgba(245,158,11,.07),transparent 60%);
            }

            .card-gold:hover .card-icon {
                color: var(--gold);
            }

            .card-gold:hover .card-name {
                color: var(--gold);
            }

            .card-gold:hover {
                box-shadow: 0 4px 20px rgba(245,158,11,.12);
            }

        .card-blue {
            --card-color: var(--blue);
        }

            .card-blue::before {
                background: radial-gradient(ellipse at top left,rgba(56,189,248,.07),transparent 60%);
            }

            .card-blue:hover .card-icon {
                color: var(--blue);
            }

            .card-blue:hover .card-name {
                color: var(--blue);
            }

            .card-blue:hover {
                box-shadow: 0 4px 20px rgba(56,189,248,.12);
            }

        .card-red {
            --card-color: var(--red);
        }

            .card-red::before {
                background: radial-gradient(ellipse at top left,rgba(239,68,68,.07),transparent 60%);
            }

            .card-red:hover .card-icon {
                color: var(--red);
            }

            .card-red:hover .card-name {
                color: var(--red);
            }

            .card-red:hover {
                box-shadow: 0 4px 20px rgba(239,68,68,.12);
            }

        .card-purple {
            --card-color: var(--purple);
        }

            .card-purple::before {
                background: radial-gradient(ellipse at top left,rgba(167,139,250,.07),transparent 60%);
            }

            .card-purple:hover .card-icon {
                color: var(--purple);
            }

            .card-purple:hover .card-name {
                color: var(--purple);
            }

            .card-purple:hover {
                box-shadow: 0 4px 20px rgba(167,139,250,.12);
            }

        .card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
        }

        .card-icon {
            font-size: 26px;
            transition: color .2s;
            line-height: 1;
        }

        .card-badge {
            font-family: 'Space Grotesk',sans-serif;
            font-size: 9px;
            letter-spacing: 1.5px;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: 600;
            background: var(--badge-bg);
            color: var(--text-dim);
            border: 1px solid var(--border);
            transition: background .3s, color .3s, border-color .3s;
        }

        .card-name {
            font-family: 'Space Grotesk',sans-serif;
            font-size: 15px;
            font-weight: 600;
            color: var(--text);
            letter-spacing: 1px;
            transition: color .2s;
            line-height: 1.2;
        }

        .card-desc {
            font-family: 'DM Sans',sans-serif;
            font-size: 11px;
            color: var(--text-dim);
            letter-spacing: .3px;
            line-height: 1.6;
            font-weight: 400;
            transition: color .3s;
        }

        .card-url {
            font-family: 'JetBrains Mono',monospace;
            font-size: 9px;
            color: var(--text-muted);
            letter-spacing: .5px;
            margin-top: 2px;
            transition: color .3s;
        }

        .card-arrow {
            position: absolute;
            right: 16px;
            bottom: 16px;
            font-size: 14px;
            color: var(--text-dim);
            transition: all .2s;
            opacity: 0;
        }

        .card:hover .card-arrow {
            opacity: 1;
            right: 12px;
            color: var(--card-color,var(--text-dim));
        }

        .card-big {
            grid-column: span 2;
            flex-direction: row;
            align-items: center;
            gap: 20px;
            padding: 22px 26px;
        }

            .card-big .card-icon {
                font-size: 44px;
            }

            .card-big .card-name {
                font-size: 20px;
            }

            .card-big .card-desc {
                font-size: 12px;
            }

        .cua-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .cua-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .cua-group-label {
            font-family: 'Space Grotesk',sans-serif;
            font-size: 9px;
            letter-spacing: 2px;
            color: var(--text-dim);
            font-weight: 600;
            padding: 6px 10px;
            background: var(--surface2);
            border-radius: 6px;
            border: 1px solid var(--border);
            text-align: center;
            transition: background .3s, color .3s, border-color .3s;
        }

        .cua-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .card-sm {
            flex: 1;
            min-width: 80px;
            padding: 12px 12px;
            gap: 5px;
        }

            .card-sm .card-icon {
                font-size: 16px;
            }

            .card-sm .card-name {
                font-size: 13px;
                letter-spacing: .5px;
                font-family: 'Space Grotesk',sans-serif;
            }

            .card-sm .card-desc {
                font-size: 9px;
            }

        .divider {
            height: 1px;
            background: var(--border);
            margin: 4px 0 28px;
            opacity: .5;
            transition: background .3s;
        }

        .footer {
            position: relative;
            z-index: 1;
            border-top: 1px solid var(--border);
            background: var(--footer-bg);
            padding: 12px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: 'DM Sans',sans-serif;
            font-size: 10px;
            color: var(--text-dim);
            letter-spacing: .5px;
            transition: background .3s, border-color .3s, color .3s;
        }

        .footer-clock {
            font-family: 'JetBrains Mono',monospace;
            font-size: 10px;
        }

        .footer-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--green);
            display: inline-block;
            margin-right: 6px;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: .3
            }
        }

        @@media(max-width:1200px) {
            .grid-4 {
                grid-template-columns: repeat(2,1fr);
            }

            .grid-5 {
                grid-template-columns: repeat(3,1fr);
            }
        }

        @@media(max-width:768px) {
            .hdr {
                padding: 0 16px;
                height: 60px;
            }

            .hdr-title {
                font-size: 14px;
                letter-spacing: 2px;
            }

            .hdr-clock {
                font-size: 20px;
            }

            .main {
                padding: 20px 16px 40px;
            }

            .grid-4, .grid-3, .grid-2, .grid-5 {
                grid-template-columns: 1fr;
            }

            .cua-grid {
                grid-template-columns: 1fr;
            }

            .card-big {
                flex-direction: column;
                grid-column: span 1;
            }

            .footer {
                padding: 10px 16px;
                font-size: 9px;
            }
        }

        .card-locked {
            opacity: .45;
            filter: grayscale(.7);
            cursor: not-allowed !important;
        }

            .card-locked:hover {
                transform: none !important;
                box-shadow: none !important;
                border-color: var(--border) !important;
                background: var(--card-bg) !important;
            }

            .card-locked::before {
                display: none !important;
            }

            .card-locked .card-arrow {
                display: none !important;
            }

        .lock-badge {
            font-size: 9px;
            color: var(--red);
            letter-spacing: 1px;
            opacity: .8;
        }
    </style>
</head>
<body>

    <div class="hdr">
        <div class="hdr-left">
            <div class="hdr-icon">🏭</div>
            <div>
                <div class="hdr-title">VIETTEL POST WMS</div>
                <div class="hdr-sub">WAREHOUSE MANAGEMENT SYSTEM — NAVIGATION</div>
            </div>
        </div>
        <div class="hdr-right">
            <button class="theme-toggle" id="themeToggle" title="Chuyển giao diện sáng/tối" onclick="toggleTheme()">
                <i class="bi bi-moon-stars-fill"></i>
                <i class="bi bi-sun-fill"></i>
            </button>
            <div>
                <div class="hdr-clock" id="clk">--:--:--</div>
                <div class="hdr-date" id="dt"></div>
            </div>
            <div class="user-menu" id="userMenu">
                <div class="user-avatar" id="userAvatarBtn" onclick="toggleUserMenu()" title="Tài khoản">@initials</div>
                <div class="user-dropdown" id="userDropdown">
                    <div class="ud-profile">
                        <div class="ud-avatar-big">@initials</div>
                        <div style="overflow:hidden;">
                            <div class="ud-name">@userName</div>
                            <div class="ud-email">@email</div>
                            <span class="ud-role">NHÂN VIÊN KHO</span>
                        </div>
                    </div>
                    <div class="ud-menu">
                        <a class="ud-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                            <i class="bi bi-person-circle"></i> Hồ sơ cá nhân
                        </a>
                        <a class="ud-item" href="/Dashboard">
                            <i class="bi bi-speedometer2"></i> Trang quản trị
                        </a>
                        <div class="ud-divider"></div>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                            <button type="submit" class="ud-item ud-item-logout">
                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="main">

        <!-- TỔNG QUAN HỆ THỐNG -->
        <div class="section-label">
            <span class="sl-dot" style="background:var(--blue)"></span>
            TỔNG QUAN HỆ THỐNG
        </div>
        <div class="grid grid-2" style="margin-bottom:36px;">
            <a class="card card-blue card-big @(!HasPerm("TongTrungTam.View") ? "card-locked" : "")" href="/TongTrungTam" target="_blank">
                <div class="card-icon">🖥️</div>
                <div>
                    <div class="card-name">TRUNG TÂM ĐIỀU HÀNH</div>
                    <div class="card-desc">Tổng quan toàn bộ hoạt động kho — nhập xuất, cảnh báo, trạng thái cửa realtime</div>
                    <div class="card-url">/TongTrungTam</div>
                </div>
                <div class="card-arrow">→</div>
            </a>
            <div class="grid grid-2" style="margin-bottom:0;">
                <a class="card card-green @(!HasPerm("TongHopNhap.View") ? "card-locked" : "")" href="/Home/tonghopnhap" target="_blank">
                    <div class="card-top"><div class="card-icon">📥</div><div class="card-badge">TỔNG HỢP</div></div>
                    <div class="card-name">TỔNG HỢP NHẬP</div>
                    <div class="card-desc">Thống kê xe, hàng hóa khu vực nhập</div>
                    <div class="card-url">/Home/tonghopnhap</div>
                    <div class="card-arrow">→</div>
                </a>
                <a class="card card-gold @(!HasPerm("TongHopXuat.View") ? "card-locked" : "")" href="/Home/tonghopxuat" target="_blank">
                    <div class="card-top"><div class="card-icon">📤</div><div class="card-badge">TỔNG HỢP</div></div>
                    <div class="card-name">TỔNG HỢP XUẤT</div>
                    <div class="card-desc">Thống kê xe, hàng hóa khu vực xuất</div>
                    <div class="card-url">/Home/tonghopxuat</div>
                    <div class="card-arrow">→</div>
                </a>
            </div>
        </div>

        <div class="divider"></div>

        <!-- LED BOARDS -->
        <div class="section-label">
            <span class="sl-dot" style="background:var(--green)"></span>
            BẢNG LED — MÀN HÌNH BÃI XE
        </div>
        <div class="grid grid-2" style="margin-bottom:36px;">
            <a class="card card-green @(!HasPerm("LedBoard.View") ? "card-locked" : "")" href="/LedBoard/Nhap" target="_blank">
                <div class="card-top"><div class="card-icon">🚚</div><div class="card-badge">LED BOARD</div></div>
                <div class="card-name">CỔNG NHẬP KHO</div>
                <div class="card-desc">Bảng LED điều hướng tài xế — biển số, cửa vào, trạng thái realtime</div>
                <div class="card-url">/LedBoard/Nhap</div>
                <div class="card-arrow">→</div>
            </a>
            <a class="card card-gold @(!HasPerm("LedBoard.View") ? "card-locked" : "")" href="/LedBoard/Xuat" target="_blank">
                <div class="card-top"><div class="card-icon">🚛</div><div class="card-badge">LED BOARD</div></div>
                <div class="card-name">CỔNG XUẤT KHO</div>
                <div class="card-desc">Bảng LED điều hướng tài xế — biển số, cửa xuất, địa điểm giao</div>
                <div class="card-url">/LedBoard/Xuat</div>
                <div class="card-arrow">→</div>
            </a>
        </div>

        <div class="divider"></div>

        <!-- ĐIỀU ĐỘ -->
        <div class="section-label">
            <span class="sl-dot" style="background:var(--gold)"></span>
            ĐIỀU ĐỘ PHÂN CÔNG
        </div>
        <div class="grid grid-2" style="margin-bottom:36px;">
            <a class="card card-green @(!HasPerm("DieuDoNhap.View") ? "card-locked" : "")" href="/DieuDoNhap" target="_blank">
                <div class="card-top">
                    <div class="card-icon">⚡</div>
                    <div class="card-badge">ĐIỀU ĐỘ</div>
                </div>
                <div class="card-name">ĐIỀU ĐỘ NHẬP</div>
                <div class="card-desc">Phân công cửa nhập, quản lý hàng đợi xe vào kho</div>
                <div class="card-url">/DieuDoNhap</div>
                @if (!HasPerm("DieuDoNhap.View"))
                {
                    <span class="lock-badge">🔒 Không có quyền</span>
                }
                <div class="card-arrow">→</div>
            </a>
            <a class="card card-gold @(!HasPerm("DieuDoXuat.View") ? "card-locked" : "")" href="/DieuDoXuat" target="_blank">
                <div class="card-top">
                    <div class="card-icon">⚡</div>
                    <div class="card-badge">ĐIỀU ĐỘ</div>
                </div>
                <div class="card-name">ĐIỀU ĐỘ XUẤT</div>
                <div class="card-desc">Tạo phiếu xuất, phân công cửa xuất, quản lý hàng hóa</div>
                <div class="card-url">/DieuDoXuat</div>
                @if (!HasPerm("DieuDoXuat.View"))
                {
                    <span class="lock-badge">🔒 Không có quyền</span>
                }
                <div class="card-arrow">→</div>
            </a>
        </div>

        <div class="divider"></div>

        <!-- BẢO VỆ CAMERA -->
        <div class="section-label">
            <span class="sl-dot" style="background:var(--blue)"></span>
            TRẠM BẢO VỆ — CAMERA AI
        </div>
        <div class="grid grid-2" style="margin-bottom:36px;">
            <a class="card card-green @(!HasPerm("BaoVeNhap.View") ? "card-locked" : "")" href="/BaoVeNhap" target="_blank">
                <div class="card-top">
                    <div class="card-icon">📷</div>
                    <div class="card-badge">CAMERA AI</div>
                </div>
                <div class="card-name">BẢO VỆ CỔNG NHẬP</div>
                <div class="card-desc">Nhận diện biển số AI, xác nhận xe vào bãi, lịch sử nhận diện</div>
                <div class="card-url">/BaoVeNhap</div>
                @if (!HasPerm("BaoVeNhap.View"))
                {
                    <span class="lock-badge">🔒 Không có quyền</span>
                }
                <div class="card-arrow">→</div>
            </a>
            <a class="card card-gold @(!HasPerm("BaoVeXuat.View") ? "card-locked" : "")" href="/BaoVeXuat" target="_blank">
                <div class="card-top">
                    <div class="card-icon">📷</div>
                    <div class="card-badge">CAMERA AI</div>
                </div>
                <div class="card-name">BẢO VỆ CỔNG XUẤT</div>
                <div class="card-desc">Xác nhận xe ra cổng, kiểm tra biển số, camera realtime</div>
                <div class="card-url">/BaoVeXuat</div>
                @if (!HasPerm("BaoVeXuat.View"))
                {
                    <span class="lock-badge">🔒 Không có quyền</span>
                }
                <div class="card-arrow">→</div>
            </a>
        </div>

        <div class="divider"></div>

        <!-- NHÂN VIÊN TẠI CỬA -->
        <div class="section-label">
            <span class="sl-dot" style="background:var(--purple)"></span>
            NHÂN VIÊN TẠI CỬA — BOOTH
        </div>
        <div class="cua-grid" style="margin-bottom:36px;">
            <div class="cua-group">
                <div class="cua-group-label">🔽 CỬA NHẬP</div>
                <div class="cua-row">
                    @foreach (var cua in ViewBag.CuaNhaps as List<LedApp.Models.CuaNhap> ?? new())
                    {
                        bool locked = !cua.IsActive || !HasCuaNhap(cua.Id);
                        <a class="card card-green card-sm @(locked ? "card-locked" : "")"
                           href="/NhanVienNhap/CuaNhap?cuaNhapId=@cua.Id" target="_blank">
                            <div class="card-icon">🚪</div>
                            <div class="card-name">@cua.Ten</div>
                            <div class="card-desc">
                                @if (!cua.IsActive)
                                {
                                    <span style="color:var(--red);font-size:9px;letter-spacing:1px;">🔒 ĐÃ KHÓA</span>
                                }
                                else if (!HasCuaNhap(cua.Id))
                                {
                                    <span class="lock-badge">🔒 Không có quyền</span>
                                }
                                else
                                {
                                    <span>Cửa nhập</span>
                                }
                            </div>
                        </a>
                    }
                </div>
            </div>
            <div class="cua-group">
                <div class="cua-group-label">🔼 CỬA XUẤT</div>
                <div class="cua-row">
                    @foreach (var cua in ViewBag.CuaXuats as List<LedApp.Models.CuaXuat> ?? new())
                    {
                        bool locked = !cua.IsActive || !HasCuaXuat(cua.Id);
                        <a class="card card-gold card-sm @(locked ? "card-locked" : "")"
                           href="/NhanVienXuat/CuaXuat?cuaXuatId=@cua.Id" target="_blank">
                            <div class="card-icon">🚪</div>
                            <div class="card-name">@cua.Ten</div>
                            <div class="card-desc">
                                @if (!cua.IsActive)
                                {
                                    <span style="color:var(--red);font-size:9px;letter-spacing:1px;">🔒 ĐÃ KHÓA</span>
                                }
                                else if (!HasCuaXuat(cua.Id))
                                {
                                    <span class="lock-badge">🔒 Không có quyền</span>
                                }
                                else
                                {
                                    <span>Cửa xuất</span>
                                }
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="divider"></div>

        <!-- MÀN HÌNH TẠI CỬA NHẬP -->
        <div class="section-label">
            <span class="sl-dot" style="background:var(--red)"></span>
            MÀN HÌNH TẠI CỬA NHẬP
        </div>
        <div class="grid grid-5" style="margin-bottom:36px;">
            @foreach (var cua in ViewBag.CuaNhaps as List<LedApp.Models.CuaNhap> ?? new())
            {
                <a class="card card-purple @(!cua.IsActive ? "card-locked" : "")"
                   href="/Home/cuanhap/@cua.Id" target="_blank">
                    <div class="card-top">
                        <div class="card-icon">📺</div>
                        <div class="card-badge" style="@(!cua.IsActive ? "color:var(--red);border-color:var(--red);opacity:.7;" : "")">
                            @(!cua.IsActive ? "KHÓA" : "MÀN HÌNH")
                        </div>
                    </div>
                    <div class="card-name">CỬA @cua.Ten</div>
                    <div class="card-desc">
                        @if (!cua.IsActive)
                        {
                            <span style="color:var(--red);opacity:.6;">Cửa đang khóa</span>
                        }
                        else
                        {
                            <span>Màn hình tại cửa nhập @cua.Ten</span>
                        }
                    </div>
                    <div class="card-arrow">→</div>
                </a>
            }
        </div>

        <!-- MÀN HÌNH TẠI CỬA XUẤT -->
        <div class="section-label">
            <span class="sl-dot" style="background:var(--red)"></span>
            MÀN HÌNH TẠI CỬA XUẤT
        </div>
        <div class="grid grid-5" style="margin-bottom:36px;">
            @foreach (var cua in ViewBag.CuaXuats as List<LedApp.Models.CuaXuat> ?? new())
            {
                <a class="card card-purple @(!cua.IsActive ? "card-locked" : "")"
                   href="/Home/cuaxuat/@cua.Id" target="_blank">
                    <div class="card-top">
                        <div class="card-icon">📺</div>
                        <div class="card-badge" style="@(!cua.IsActive ? "color:var(--red);border-color:var(--red);opacity:.7;" : "")">
                            @(!cua.IsActive ? "KHÓA" : "MÀN HÌNH")
                        </div>
                    </div>
                    <div class="card-name">CỬA @cua.Ten</div>
                    <div class="card-desc">
                        @if (!cua.IsActive)
                        {
                            <span style="color:var(--red);opacity:.6;">Cửa đang khóa</span>
                        }
                        else
                        {
                            <span>Màn hình tại cửa xuất @cua.Ten</span>
                        }
                    </div>
                    <div class="card-arrow">→</div>
                </a>
            }
        </div>

    </div>

    <div class="footer">
        <span><span class="footer-dot"></span>VIETTEL POST — HỆ THỐNG QUẢN LÝ KHO REALTIME</span>
        <span class="footer-clock" id="footer-time">--:--:--</span>
    </div>

    <script>
        function tick(){
            var n=new Date();
            document.getElementById('clk').textContent=n.toLocaleTimeString('vi-VN',{hour12:false});
            document.getElementById('dt').textContent=n.toLocaleDateString('vi-VN',{weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'});
            document.getElementById('footer-time').textContent=n.toLocaleTimeString('vi-VN',{hour12:false});
        }
        setInterval(tick,1000);tick();

        function toggleTheme(){
            var html=document.documentElement;
            var next=html.getAttribute('data-theme')==='dark'?'light':'dark';
            html.setAttribute('data-theme',next);
            try{localStorage.setItem('wms-theme',next);}catch(e){}
        }
        (function(){
            try{var s=localStorage.getItem('wms-theme');if(s)document.documentElement.setAttribute('data-theme',s);}catch(e){}
        })();

        function toggleUserMenu(){
            var btn=document.getElementById('userAvatarBtn');
            var dd=document.getElementById('userDropdown');
            var open=dd.classList.toggle('open');
            btn.classList.toggle('open',open);
        }
        document.addEventListener('click',function(e){
            var menu=document.getElementById('userMenu');
            if(menu&&!menu.contains(e.target)){
                document.getElementById('userDropdown').classList.remove('open');
                document.getElementById('userAvatarBtn').classList.remove('open');
            }
        });
        document.querySelectorAll('.card-locked').forEach(function(el){
            el.addEventListener('click',function(e){ e.preventDefault(); e.stopPropagation(); });
        });
    </script>
</body>
</html>
