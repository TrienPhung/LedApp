@{
    Layout = null;
}
@using Microsoft.AspNetCore.Identity
@inject SignInManager<LedApp.Models.AppUser> SignInManager
@inject UserManager<LedApp.Models.AppUser> UserManager
@{
    var userName = UserManager.GetUserName(User) ?? "User";
    var user = await UserManager.GetUserAsync(User);
    var email = user?.Email ?? "";
    var initials = string.IsNullOrEmpty(userName) ? "?" :
        new string(userName.Where(char.IsLetter).Take(2).ToArray()).ToUpper();

    var perms = ViewBag.UserPerms as HashSet<string> ?? new HashSet<string>();
    bool isAdmin = perms.Contains("*");
    bool HasPerm(string p) => isAdmin || perms.Contains(p);

    var cuaNhapClaims = User.Claims
        .Where(c => c.Type == "CuaNhap")
        .Select(c => c.Value)
        .ToHashSet();
    var cuaXuatClaims = User.Claims
        .Where(c => c.Type == "CuaXuat")
        .Select(c => c.Value)
        .ToHashSet();

    bool HasCuaNhap(int id) => isAdmin || cuaNhapClaims.Contains(id.ToString());
    bool HasCuaXuat(int id) => isAdmin || cuaXuatClaims.Contains(id.ToString());
}

<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="UTF-8" />
