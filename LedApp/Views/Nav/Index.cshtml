            --text: #c8dce8;
            --text-dim: #4a6a8a;
            --text-muted: #2a4a6a;
            --header-bg: #071018;
            --footer-bg: #060a0f;
            --card-bg: #0a1520;
            --card-bg-hover: #0d1c2e;
            --badge-bg: #0d1a2a;
            --shadow: 0 4px 24px rgba(0,0,0,.4);
            --toggle-bg: #1a3a5c;
            --toggle-icon-color: #38bdf8;
