            font-size: 10px;
            color: var(--text-dim);
            letter-spacing: 1.5px;
            margin-top: 2px;
            font-weight: 400;
        }

        .theme-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: var(--toggle-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            transition: all .25s;
            outline: none;
            position: relative;
            overflow: hidden;
        }

            .theme-toggle:hover {
                border-color: var(--border-hover);
                transform: scale(1.05);
                box-shadow: 0 0 12px rgba(56,189,248,.15);
            }

            .theme-toggle .bi {
                font-size: 18px;
                color: var(--toggle-icon-color);
                transition: all .3s;
                position: absolute;
            }

            .theme-toggle .bi-sun-fill {
                opacity: 0;
                transform: rotate(-90deg) scale(.5);
            }

            .theme-toggle .bi-moon-stars-fill {
                opacity: 1;
                transform: rotate(0deg) scale(1);
            }

        [data-theme="light"] .theme-toggle .bi-sun-fill {
            opacity: 1;
            transform: rotate(0deg) scale(1);
        }

        [data-theme="light"] .theme-toggle .bi-moon-stars-fill {
            opacity: 0;
            transform: rotate(90deg) scale(.5);
        }

        .user-menu {
