@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Camera — Nhận diện biển số</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;600;700&display=swap');

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #020509;
            --surface: #050c14;
            --surface2: #081018;
            --border: #0a1e30;
            --border2: #0f2d47;
            --green: #00e676;
            --green2: #00ff8a;
            --gold: #f5a623;
            --red: #ff3d3d;
            --blue: #00b4ff;
            --cyan: #00e5ff;
            --purple: #b388ff;
            --text: #90a8be;
            --text2: #2a4a60;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Rajdhani',sans-serif;
            height: 100vh;
            overflow: hidden;
        }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background-image: linear-gradient(rgba(0,180,255,.03) 1px,transparent 1px), linear-gradient(90deg,rgba(0,180,255,.03) 1px,transparent 1px);
                background-size: 50px 50px;
                pointer-events: none;
                z-index: 0;
            }

        .screen {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-rows: 64px 1fr 50px;
            height: 100vh;
            padding: 12px;
            gap: 10px;
        }

        /* TOPBAR */
        .topbar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            background: var(--surface);
            border: 1px solid var(--border2);
            border-top: 2px solid var(--cyan);
            border-radius: 8px;
            padding: 0 20px;
        }

        .tb-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .tb-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg,#001a2e,#003a60);
            border: 1px solid var(--cyan);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            box-shadow: 0 0 14px rgba(0,229,255,.2);
        }

        .tb-title {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 4px;
            color: var(--cyan);
            text-transform: uppercase;
        }

        .tb-sub {
            font-size: 9px;
            color: var(--text2);
            letter-spacing: 2px;
            margin-top: 1px;
        }

        .tb-clock {
            text-align: center;
            font-family: 'Share Tech Mono',monospace;
            font-size: 30px;
            color: var(--cyan);
            letter-spacing: 5px;
            text-shadow: 0 0 20px rgba(0,229,255,.4);
        }

        .tb-date {
            font-size: 9px;
            color: var(--text2);
            text-align: center;
            letter-spacing: 2px;
            margin-top: 2px;
        }

        .tb-right {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
        }

        .conn-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 10px;
            color: var(--text2);
            letter-spacing: 1px;
        }

        .conn-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--text2);
            flex-shrink: 0;
        }

            .conn-dot.on {
                background: var(--green);
                box-shadow: 0 0 8px var(--green);
                animation: pulse 2s infinite;
            }

            .conn-dot.err {
                background: var(--red);
            }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: .3
            }
        }

        /* MAIN */
        .main {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 10px;
            min-height: 0;
        }

        /* LEFT — Feed camera + log */
        .left {
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 0;
        }

        .camera-wrap {
            flex: 1;
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 8px;
            position: relative;
            overflow: hidden;
            min-height: 0;
        }

        .camera-label {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            background: rgba(0,0,0,.7);
            border: 1px solid var(--border2);
            border-radius: 4px;
            padding: 4px 12px;
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--cyan);
        }

        .camera-status {
            position: absolute;
            top: 12px;
            right: 12px;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(0,0,0,.7);
            border: 1px solid var(--border2);
            border-radius: 4px;
            padding: 4px 12px;
            font-size: 10px;
            color: var(--text2);
        }

        .camera-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: var(--text2);
        }

        .camera-placeholder-icon {
            font-size: 48px;
            opacity: .3;
        }

        .camera-placeholder-text {
            font-size: 11px;
            letter-spacing: 2px;
        }

        /* Scanning animation */
        .scan-line {
            position: absolute;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg,transparent,var(--cyan),transparent);
            animation: scan 3s linear infinite;
            opacity: .6;
            z-index: 1;
        }

        @@keyframes scan {
            0% {
                top: 0;
                opacity: .6
            }

            50% {
                opacity: .3
            }

            100% {
                top: 100%;
                opacity: .6
            }
        }

        /* Corner decorations */
        .cam-corner {
            position: absolute;
            width: 20px;
            height: 20px;
            z-index: 2;
        }

            .cam-corner.tl {
                top: 8px;
                left: 8px;
                border-top: 2px solid var(--cyan);
                border-left: 2px solid var(--cyan);
            }

            .cam-corner.tr {
                top: 8px;
                right: 8px;
                border-top: 2px solid var(--cyan);
                border-right: 2px solid var(--cyan);
            }

            .cam-corner.bl {
                bottom: 8px;
                left: 8px;
                border-bottom: 2px solid var(--cyan);
                border-left: 2px solid var(--cyan);
            }

            .cam-corner.br {
                bottom: 8px;
                right: 8px;
                border-bottom: 2px solid var(--cyan);
                border-right: 2px solid var(--cyan);
            }

        /* Log */
        .log-panel {
            height: 130px;
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .log-header {
            padding: 8px 14px;
            border-bottom: 1px solid var(--border2);
            font-size: 9px;
            letter-spacing: 2px;
            color: var(--text2);
            text-transform: uppercase;
            flex-shrink: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .log-body {
            flex: 1;
            overflow-y: auto;
            padding: 6px 0;
        }

            .log-body::-webkit-scrollbar {
                width: 3px;
            }

            .log-body::-webkit-scrollbar-thumb {
                background: var(--border2);
            }

        .log-row {
            display: grid;
            grid-template-columns: 70px 130px 1fr auto;
            gap: 8px;
            align-items: center;
            padding: 4px 14px;
            font-family: 'Share Tech Mono',monospace;
            font-size: 11px;
            border-bottom: 1px solid rgba(10,30,48,.5);
            animation: fadeIn .3s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-4px)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        .log-time {
            color: var(--text2);
        }

        .log-plate {
            color: var(--gold);
            font-weight: 700;
        }

        .log-msg {
            color: var(--text);
            font-size: 10px;
        }

        .log-badge {
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 9px;
            font-weight: 700;
            white-space: nowrap;
        }

        .badge-found {
            background: rgba(0,230,118,.12);
            color: var(--green);
            border: 1px solid rgba(0,230,118,.2);
        }

        .badge-notfound {
            background: rgba(255,61,61,.12);
            color: var(--red);
            border: 1px solid rgba(255,61,61,.2);
        }

        .badge-xe {
            background: rgba(0,180,255,.12);
            color: var(--blue);
            border: 1px solid rgba(0,180,255,.2);
        }

        /* RIGHT — Kết quả nhận diện */
        .right {
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 0;
        }

        /* Kết quả mới nhất */
        .result-card {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 8px;
            padding: 20px;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
            transition: border-color .3s;
        }

            .result-card.found {
                border-color: var(--green);
                box-shadow: 0 0 20px rgba(0,230,118,.1);
            }

            .result-card.notfound {
                border-color: var(--red);
                box-shadow: 0 0 20px rgba(255,61,61,.1);
            }

            .result-card.xe {
                border-color: var(--blue);
                box-shadow: 0 0 20px rgba(0,180,255,.1);
            }

        .result-label {
            font-size: 9px;
            letter-spacing: 3px;
            color: var(--text2);
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .result-bienso {
            font-family: 'Share Tech Mono',monospace;
            font-size: 38px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 6px;
            text-shadow: 0 0 30px rgba(245,166,35,.4);
            text-align: center;
            padding: 10px 0;
        }

            .result-bienso.empty {
                color: var(--text2);
                font-size: 24px;
                letter-spacing: 2px;
            }

        .result-conf {
            text-align: center;
            margin-top: 4px;
            font-size: 11px;
            color: var(--text2);
            font-family: 'Share Tech Mono',monospace;
        }

            .result-conf span {
                color: var(--cyan);
            }

        .result-divider {
            border-top: 1px solid var(--border2);
            margin: 12px 0;
        }

        .result-fields {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .result-field {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
        }

        .rf-label {
            color: var(--text2);
        }

        .rf-value {
            font-family: 'Share Tech Mono',monospace;
            font-size: 13px;
            font-weight: 600;
        }

            .rf-value.green {
                color: var(--green);
            }

            .rf-value.gold {
                color: var(--gold);
            }

            .rf-value.cyan {
                color: var(--cyan);
            }

            .rf-value.red {
                color: var(--red);
            }

        .result-msg {
            margin-top: 12px;
            padding: 10px 14px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            text-align: center;
        }

        .msg-found {
            background: rgba(0,230,118,.1);
            color: var(--green);
            border: 1px solid rgba(0,230,118,.2);
        }

        .msg-notfound {
            background: rgba(255,61,61,.1);
            color: var(--red);
            border: 1px solid rgba(255,61,61,.2);
        }

        .msg-xe {
            background: rgba(0,180,255,.1);
            color: var(--blue);
            border: 1px solid rgba(0,180,255,.2);
        }

        .msg-wait {
            background: var(--surface2);
            color: var(--text2);
            border: 1px solid var(--border2);
        }

        /* Stats */
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            flex-shrink: 0;
        }

        .stat-box {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 6px;
            padding: 12px 14px;
            text-align: center;
        }

        .stat-n {
            font-family: 'Share Tech Mono',monospace;
            font-size: 28px;
            font-weight: 700;
        }

        .stat-l {
            font-size: 9px;
            color: var(--text2);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        /* Python status */
        .py-status {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 8px;
            padding: 14px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .py-title {
            font-size: 9px;
            letter-spacing: 2px;
            color: var(--text2);
            text-transform: uppercase;
        }

        .py-cmd {
            background: var(--bg);
            border: 1px solid var(--border2);
            border-radius: 5px;
            padding: 10px 12px;
            font-family: 'Share Tech Mono',monospace;
            font-size: 11px;
            color: var(--green);
            line-height: 1.8;
        }

        .py-note {
            font-size: 10px;
            color: var(--text2);
            line-height: 1.6;
        }

        /* FOOTER */
        .footer {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 6px;
            padding: 0 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 10px;
            color: var(--text2);
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
    <div class="screen">

        <!-- TOPBAR -->
        <div class="topbar">
            <div class="tb-brand">
                <div class="tb-icon">📷</div>
                <div>
                    <div class="tb-title">Camera nhận diện biển số</div>
                    <div class="tb-sub">License Plate Recognition — AI Powered</div>
                </div>
            </div>
            <div>
                <div class="tb-clock" id="clock">--:--:--</div>
                <div class="tb-date" id="date-str"></div>
            </div>
            <div class="tb-right">
                <div class="conn-badge">
                    <span class="conn-dot" id="conn-dot"></span>
                    <span id="conn-text">SignalR...</span>
                </div>
                <div class="conn-badge" id="py-badge" style="border-color:var(--text2);">
                    <span class="conn-dot" id="py-dot"></span>
                    <span id="py-text">Python...</span>
                </div>
            </div>
        </div>

        <!-- MAIN -->
        <div class="main">

            <!-- LEFT -->
            <div class="left">
                <!-- Camera feed placeholder -->
                <div class="camera-wrap">
                    <div class="cam-corner tl"></div>
                    <div class="cam-corner tr"></div>
                    <div class="cam-corner bl"></div>
                    <div class="cam-corner br"></div>
                    <div class="scan-line"></div>
                    <div class="camera-label">📷 WEBCAM FEED</div>
                    <div class="camera-status">
                        <span class="conn-dot on"></span>
                        <span>Python service xử lý</span>
                    </div>
                    <div class="camera-placeholder">
                        <div class="camera-placeholder-icon">🎥</div>
                        <div class="camera-placeholder-text">Camera đang chạy trong Python</div>
                        <div style="font-size:10px;color:var(--text2);margin-top:4px;">
                            Kết quả nhận diện hiện thị real-time bên phải →
                        </div>
                    </div>
                </div>

                <!-- Log -->
                <div class="log-panel">
                    <div class="log-header">
                        <span>Lịch sử nhận diện</span>
                        <span id="log-count" style="color:var(--cyan);">0 lượt</span>
                    </div>
                    <div class="log-body" id="log-body">
                        <div style="text-align:center;padding:20px;color:var(--text2);font-size:11px;">
                            Chờ nhận diện...
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="right">

                <!-- Kết quả mới nhất -->
                <div class="result-card" id="result-card">
                    <div class="result-label">Kết quả nhận diện mới nhất</div>
                    <div class="result-bienso empty" id="r-bienso">Chờ xe...</div>
                    <div class="result-conf" id="r-conf"></div>
                    <div class="result-divider"></div>
                    <div class="result-fields">
                        <div class="result-field">
                            <span class="rf-label">Loại phiếu</span>
                            <span class="rf-value cyan" id="r-loai">--</span>
                        </div>
                        <div class="result-field">
                            <span class="rf-label">Mã chuyến</span>
                            <span class="rf-value gold" id="r-cua">--</span>
                        </div>
                        <div class="result-field">
                            <span class="rf-label">Trạng thái</span>
                            <span class="rf-value green" id="r-tt">--</span>
                        </div>
                        <div class="result-field">
                            <span class="rf-label">Thời gian</span>
                            <span class="rf-value" id="r-time" style="color:var(--text);">--:--:--</span>
                        </div>
                    </div>
                    <div class="result-msg msg-wait" id="r-msg">Đang chờ nhận diện...</div>
                </div>

                <!-- Stats -->
                <div class="stats-grid">
                    <div class="stat-box">
                        <div class="stat-n" id="s-tong" style="color:var(--cyan);">0</div>
                        <div class="stat-l">Tổng lượt</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-n" id="s-found" style="color:var(--green);">0</div>
                        <div class="stat-l">Tìm thấy</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-n" id="s-notfound" style="color:var(--red);">0</div>
                        <div class="stat-l">Không tìm thấy</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-n" id="s-conf" style="color:var(--gold);">--%</div>
                        <div class="stat-l">Confidence TB</div>
                    </div>
                </div>

                <!-- Hướng dẫn Python -->
                <div class="py-status">
                    <div class="py-title">Khởi động Python service</div>
                    <div class="py-cmd">
                        # Cài đặt (1 lần)<br>
                        pip install easyocr opencv-python requests<br><br>
                        # Chạy service<br>
                        python camera_service.py
                    </div>
                    <div class="py-note">
                        📌 Python service mở webcam laptop, nhận diện biển số và gửi kết quả về đây qua SignalR real-time.
                        Màn hình này tự cập nhật khi có xe qua camera.
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="footer">
            <span>© Hệ thống Camera — Nhận diện biển số AI</span>
            <span id="footer-time"></span>
        </div>
    </div>

    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        var logData   = [];
        var statTong  = 0, statFound = 0, statNotFound = 0;
        var confList  = [];

        // ── ĐỒNG HỒ ──
        function tick() {
            var n = new Date();
            document.getElementById('clock').textContent    = n.toLocaleTimeString('vi-VN',{hour12:false});
            document.getElementById('date-str').textContent = n.toLocaleDateString('vi-VN',{weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'});
            document.getElementById('footer-time').textContent = 'Cập nhật: ' + n.toLocaleTimeString('vi-VN');
        }
        setInterval(tick,1000); tick();

        // ── SIGNALR ──
        var conn = new signalR.HubConnectionBuilder()
            .withUrl('/signalserver')
            .withAutomaticReconnect()
            .build();

        conn.on('CameraNhanDien', function(data) {
            if (!data) return;
            handleNhanDien(data);
        });

        conn.start().then(function() {
            document.getElementById('conn-dot').classList.add('on');
            document.getElementById('conn-text').textContent = 'SignalR';
            checkPythonStatus();
        }).catch(function() {
            document.getElementById('conn-dot').classList.add('err');
            document.getElementById('conn-text').textContent = 'Mất kết nối';
        });

        // ── Kiểm tra Python service ──
        async function checkPythonStatus() {
            try {
                var res = await fetch('/Camera/Status', { signal: AbortSignal.timeout(2000) });
                if (res.ok) {
                    document.getElementById('py-dot').classList.add('on');
                    document.getElementById('py-text').textContent = 'API Online';
                    document.getElementById('py-badge').style.borderColor = 'var(--green)';
                }
            } catch(e) {
                document.getElementById('py-dot').style.background = 'var(--text2)';
                document.getElementById('py-text').textContent = 'Chờ Python...';
            }
        }
        setInterval(checkPythonStatus, 10000);

        // ── XỬ LÝ KẾT QUẢ NHẬN DIỆN ──
        function handleNhanDien(data) {
            var bienSo   = data.bienSo     || '--';
            var timThay  = data.timThay    || false;
            var loai     = data.loaiPhieu  || '--';
            var tenCua   = data.tenCua     || '--';   // lúc này là MaChuyenApi
            var thongBao = data.thongBao   || '--';
            var conf     = data.confidence || 0;
            var thoiGian = data.thoiGian
                ? new Date(data.thoiGian).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit',second:'2-digit'})
                : '--:--:--';

            // Trạng thái — chỉ còn 1 loại "XE" từ controller
            var ttText = '--';
            if (loai === 'XE') {
                var ttMap = {
                    0: 'Chưa về',
                    1: 'Đang về',
                    2: 'Đã đến',
                    3: 'Đang nhập hàng',
                    4: 'Hoàn thành'
                };
                ttText = ttMap[data.trangThai] ?? '--';
            }

            // Card màu: tìm thấy → xanh lá, không thấy → đỏ
            var card = document.getElementById('result-card');
            var cls  = timThay ? 'found' : 'notfound';
            card.className = 'result-card ' + cls;

            document.getElementById('r-bienso').textContent = bienSo;
            document.getElementById('r-bienso').className   = 'result-bienso';
            document.getElementById('r-conf').innerHTML     = 'Confidence: <span>' + (conf*100).toFixed(0) + '%</span>';
            document.getElementById('r-loai').textContent   = loai === '--' ? '--' : 'Xe nhập' + (data.phieuId ? ' #' + data.phieuId : '');
            document.getElementById('r-cua').textContent    = tenCua;   // hiện MaChuyenApi
            document.getElementById('r-tt').textContent     = ttText;
            document.getElementById('r-time').textContent   = thoiGian;

            var msgEl = document.getElementById('r-msg');
            msgEl.textContent = thongBao;
            msgEl.className   = 'result-msg ' + (timThay ? 'msg-found' : 'msg-notfound');

            // Stats
            statTong++;
            confList.push(conf);
            if (timThay) statFound++;
            else         statNotFound++;

            document.getElementById('s-tong').textContent     = statTong;
            document.getElementById('s-found').textContent    = statFound;
            document.getElementById('s-notfound').textContent = statNotFound;
            var avgConf = confList.reduce(function(a,b){return a+b;},0) / confList.length;
            document.getElementById('s-conf').textContent     = (avgConf*100).toFixed(0) + '%';

            addLog(thoiGian, bienSo, thongBao, timThay);
        }

        function addLog(time, plate, msg, timThay) {
            var body  = document.getElementById('log-body');
            var count = document.getElementById('log-count');

            if (body.querySelector('div[style]')) body.innerHTML = '';

            var badgeClass = timThay ? 'badge-found'   : 'badge-notfound';
            var badgeText  = timThay ? 'TÌM THẤY'      : 'KHÔNG CÓ';

            var row = document.createElement('div');
            row.className = 'log-row';
            row.innerHTML =
                '<span class="log-time">'  + time  + '</span>' +
                '<span class="log-plate">' + plate + '</span>' +
                '<span class="log-msg">'   + msg   + '</span>' +
                '<span class="log-badge '  + badgeClass + '">' + badgeText + '</span>';

            body.insertBefore(row, body.firstChild);
            while (body.children.length > 50) body.removeChild(body.lastChild);

            logData.unshift({time, plate, msg, timThay});
            count.textContent = logData.length + ' lượt';
        }
    </script>
</body>
</html>
