<!-- Modal xóa đơn -->
<div class="del-modal-overlay" id="delModalOverlay">
    <div class="del-modal">
        <button class="del-modal-close" id="delModalClose">×</button>
        <div class="del-modal-title">Xóa lịch sử bàn giao</div>
        <div class="del-modal-body">Bạn có chắc chắn muốn xóa bản ghi <strong id="delModalDesc"></strong>? Hành động này không thể hoàn tác.</div>
        <div class="del-modal-footer">
            <button class="btn-modal-cancel" id="delModalCancel">Hủy</button>
            <form id="delConfirmForm" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-modal-confirm">Xóa</button>
            </form>
        </div>
    </div>
</div>

<!-- Modal xóa nhiều -->
<div class="del-modal-overlay" id="bulkDelModalOverlay">
    <div class="del-modal">
        <button class="del-modal-close" id="bulkDelModalClose">×</button>
        <div class="del-modal-title">Xóa nhiều bản ghi</div>
        <div class="del-modal-body">Bạn có chắc chắn muốn xóa <strong id="bulkDelCount">0</strong> bản ghi đã chọn? Hành động này không thể hoàn tác.</div>
        <div class="del-modal-footer">
            <button class="btn-modal-cancel" id="bulkDelModalCancel">Hủy</button>
            <button class="btn-modal-confirm" id="bulkDelModalConfirm">Xóa</button>
        </div>
    </div>
</div>

<script>
    (function () {
        const allRows = Array.from(document.querySelectorAll('#lsBody tr[data-filter]'));
        const searchInput = document.getElementById('searchInput');
        const rowsPerPageSel = document.getElementById('rowsPerPage');
        const pgInfo = document.getElementById('pgInfo');
        const pgControls = document.getElementById('pgControls');
        const btnReset = document.getElementById('btnReset');
        const colDropdown = document.getElementById('colDropdown');
        const lsBody = document.getElementById('lsBody');
        const checkAll = document.getElementById('checkAll');
        const bulkBar = document.getElementById('bulkBar');
        const normalBar = document.getElementById('normalBar');

        let currentPage = 1;
        let activeTabFilter = 'all';
        let sortCol = null;
        let sortDir = 'asc';

        // Filter tabs
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                activeTabFilter = tab.dataset.filter;
                currentPage = 1; render();
            });
        });

        // Search
        searchInput.addEventListener('input', () => {
            btnReset.classList.toggle('show', searchInput.value.trim().length > 0);
            currentPage = 1; render();
        });
        rowsPerPageSel.addEventListener('change', () => { currentPage = 1; render(); });
        btnReset.addEventListener('click', () => {
            searchInput.value = '';
            btnReset.classList.remove('show');
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            document.querySelector('.filter-tab[data-filter="all"]').classList.add('active');
            activeTabFilter = 'all'; currentPage = 1; render();
        });

        // Bulk
        function updateBulkUI() {
            const checked = Array.from(document.querySelectorAll('.row-check:checked'));
            const count = checked.length;
            document.querySelectorAll('#lsBody tr[data-filter]').forEach(row => {
                const cb = row.querySelector('.row-check');
                row.classList.toggle('row-selected', cb && cb.checked);
            });
            if (count > 0) {
                document.getElementById('bulkCount').textContent = count;
                document.getElementById('bulkDeleteCount').textContent = count;
                normalBar.style.display = 'none'; bulkBar.style.display = 'flex';
                const total = document.querySelectorAll('.row-check').length;
                checkAll.indeterminate = count > 0 && count < total;
                checkAll.checked = count === total && total > 0;
            } else {
                normalBar.style.display = 'flex'; bulkBar.style.display = 'none';
                checkAll.indeterminate = false; checkAll.checked = false;
            }
        }
        checkAll.addEventListener('change', function () {
            getFiltered().forEach(row => { const cb = row.querySelector('.row-check'); if (cb) cb.checked = this.checked; });
            updateBulkUI();
        });
        lsBody.addEventListener('change', e => { if (e.target.classList.contains('row-check')) updateBulkUI(); });
        document.getElementById('btnBulkClear').addEventListener('click', () => {
            document.querySelectorAll('.row-check').forEach(c => c.checked = false); updateBulkUI();
        });

        // Columns
        document.getElementById('columnsBtn').addEventListener('click', e => { e.stopPropagation(); colDropdown.classList.toggle('open'); });
        document.querySelectorAll('#colDropdown .col-item').forEach(item => {
            item.addEventListener('click', e => {
                e.stopPropagation();
                const col = item.dataset.col;
                const vis = item.classList.contains('col-visible');
                item.classList.toggle('col-visible', !vis);
                document.querySelectorAll(`[data-col-th="${col}"]`).forEach(el => el.classList.toggle('col-hidden', vis));
                document.querySelectorAll(`[data-col-td="${col}"]`).forEach(el => el.classList.toggle('col-hidden', vis));
            });
        });
        document.addEventListener('click', e => {
            if (!document.getElementById('columnsWrap').contains(e.target)) colDropdown.classList.remove('open');
            if (!e.target.closest('.row-action-wrap')) document.querySelectorAll('.row-action-menu.open').forEach(m => m.classList.remove('open'));
        });

        // Sort
        document.querySelectorAll('.th-inner').forEach(inner => {
            inner.addEventListener('click', () => {
                const col = inner.closest('th').dataset.colTh;
                if (!col) return;
                sortDir = sortCol === col ? (sortDir === 'asc' ? 'desc' : 'asc') : 'asc';
                sortCol = col;
                document.querySelectorAll('.th-inner').forEach(i => {
                    i.querySelector('.sort-icon').classList.remove('active');
                    i.querySelector('.sort-icon').innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>`;
                });
                const activeIcon = inner.querySelector('.sort-icon');
                activeIcon.classList.add('active');
                activeIcon.innerHTML = sortDir === 'asc'
                    ? `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7 9 5-5 5 5"/></svg>`
                    : `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/></svg>`;
                allRows.sort((a, b) => {
                    const aEl = a.querySelector(`[data-col-td="${col}"]`);
                    const bEl = b.querySelector(`[data-col-td="${col}"]`);
                    const cmp = (aEl?.textContent.trim() ?? '').localeCompare(bEl?.textContent.trim() ?? '', 'vi', { numeric: true });
                    return sortDir === 'asc' ? cmp : -cmp;
                });
                allRows.forEach(r => lsBody.appendChild(r));
                currentPage = 1; render();
            });
        });

        // Kebab
        document.querySelectorAll('.kebab-btn').forEach(btn => {
            btn.addEventListener('click', e => {
                e.stopPropagation();
                const menu = btn.nextElementSibling;
                const isOpen = menu.classList.contains('open');
                document.querySelectorAll('.row-action-menu.open').forEach(m => m.classList.remove('open'));
                if (!isOpen) {
                    const spaceBelow = window.innerHeight - btn.getBoundingClientRect().bottom;
                    const visRows = allRows.filter(r => r.style.display !== 'none');
                    const isLast = visRows.length > 0 && visRows[visRows.length - 1] === btn.closest('tr');
                    menu.classList.add((isLast || spaceBelow < 160) ? 'drop-up' : 'drop-down', 'open');
                }
            });
        });

        // Modal xóa đơn
        const delModalOverlay = document.getElementById('delModalOverlay');
        document.querySelectorAll('.ram-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.row-action-menu.open').forEach(m => m.classList.remove('open'));
                document.getElementById('delModalDesc').textContent = `${btn.dataset.loai} – Phiếu #${btn.dataset.phieu}`;
                document.getElementById('delConfirmForm').action = '/LichSuBanGiaos/Delete/' + btn.dataset.id;
                delModalOverlay.classList.add('open'); document.body.classList.add('modal-open');
            });
        });
        function closeDelModal() { delModalOverlay.classList.remove('open'); document.body.classList.remove('modal-open'); }
        document.getElementById('delModalClose').addEventListener('click', closeDelModal);
        document.getElementById('delModalCancel').addEventListener('click', closeDelModal);
        delModalOverlay.addEventListener('click', e => { if (e.target === delModalOverlay) closeDelModal(); });

        // Modal xóa nhiều
        const bulkDelModalOverlay = document.getElementById('bulkDelModalOverlay');
        const bulkDelModalConfirm = document.getElementById('bulkDelModalConfirm');
        document.getElementById('btnBulkDelete').addEventListener('click', () => {
            document.getElementById('bulkDelCount').textContent = document.querySelectorAll('.row-check:checked').length;
            bulkDelModalOverlay.classList.add('open'); document.body.classList.add('modal-open');
        });
        function closeBulkModal() { bulkDelModalOverlay.classList.remove('open'); document.body.classList.remove('modal-open'); }
        document.getElementById('bulkDelModalClose').addEventListener('click', closeBulkModal);
        document.getElementById('bulkDelModalCancel').addEventListener('click', closeBulkModal);
        bulkDelModalOverlay.addEventListener('click', e => { if (e.target === bulkDelModalOverlay) closeBulkModal(); });
        bulkDelModalConfirm.addEventListener('click', async () => {
            const checkedRows = Array.from(document.querySelectorAll('.row-check:checked'));
            const ids = checkedRows.map(cb => parseInt(cb.closest('tr').dataset.id)).filter(id => !isNaN(id));
            if (!ids.length) { closeBulkModal(); return; }
            bulkDelModalConfirm.disabled = true; bulkDelModalConfirm.textContent = 'Đang xóa...';
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const res = await fetch('/LichSuBanGiaos/BulkDelete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ ids })
                });
                if (res.ok) {
                    checkedRows.forEach(cb => { const row = cb.closest('tr'); const idx = allRows.indexOf(row); if (idx > -1) allRows.splice(idx, 1); row.remove(); });
                    closeBulkModal(); updateBulkUI(); render();
                } else { alert('Xóa thất bại.'); closeBulkModal(); }
            } catch { alert('Lỗi kết nối server.'); closeBulkModal(); }
            finally { bulkDelModalConfirm.disabled = false; bulkDelModalConfirm.textContent = 'Xóa'; }
        });

        // Export
        document.getElementById('exportBtn').addEventListener('click', () => {
            const visRows = getFiltered();
            const colKeys = Array.from(document.querySelectorAll('#colDropdown .col-item.col-visible')).map(i => i.dataset.col);
            const labels = { 'col-loai': 'Loại phiếu', 'col-phieu': 'Phiếu ID', 'col-donvi': 'Đơn vị', 'col-sobg': 'Số BG', 'col-nhanvien': 'Nhân viên', 'col-thoigian': 'Thời gian' };
            const csv = [colKeys.map(k => `"${labels[k] ?? k}"`).join(','),
                ...visRows.map(row => colKeys.map(k => { const td = row.querySelector(`[data-col-td="${k}"]`); return `"${(td?.textContent.trim() ?? '').replace(/"/g,'""')}"`; }).join(','))
            ].join('\n');
            const a = document.createElement('a');
            a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
            a.download = 'lich-su-ban-giao.csv'; a.click();
            const toast = document.getElementById('exportToast');
            document.getElementById('exportToastMsg').textContent = `Exported ${visRows.length} rows to CSV`;
            toast.style.display = 'flex'; setTimeout(() => toast.style.display = 'none', 3500);
        });

        function getFiltered() {
            const q = searchInput.value.toLowerCase();
            return allRows.filter(row => {
                const tabOk = activeTabFilter === 'all' || row.dataset.filter === activeTabFilter;
                const searchOk = !q || row.dataset.search.toLowerCase().includes(q);
                return tabOk && searchOk;
            });
        }

        function render() {
            const vis = getFiltered();
            const rpp = parseInt(rowsPerPageSel.value);
            const total = Math.max(1, Math.ceil(vis.length / rpp));
            currentPage = Math.min(currentPage, total);
            const start = (currentPage - 1) * rpp;
            allRows.forEach(r => r.style.display = 'none');
            const ex = lsBody.querySelector('.no-results-row');
            if (ex) ex.remove();
            if (vis.length === 0) {
                const row = document.createElement('tr'); row.className = 'no-results-row';
                row.innerHTML = '<td colspan="8">Không tìm thấy kết quả nào.</td>'; lsBody.appendChild(row);
                pgInfo.textContent = 'Showing 0 results';
            } else {
                vis.slice(start, start + rpp).forEach(r => r.style.display = '');
                pgInfo.textContent = `Showing ${start + 1}–${Math.min(start + rpp, vis.length)} of ${vis.length} results`;
            }
            pgControls.innerHTML = '';
            const prev = document.createElement('button'); prev.className = 'pg-btn'; prev.textContent = 'Previous'; prev.disabled = currentPage === 1;
            prev.onclick = () => { currentPage--; render(); }; pgControls.appendChild(prev);
            pageRange(currentPage, total).forEach(p => {
                if (p === '...') { const d = document.createElement('span'); d.textContent = '…'; d.style.cssText = 'padding:0 4px;color:#9ca3af;'; pgControls.appendChild(d); }
                else { const b = document.createElement('button'); b.className = 'pg-num' + (p === currentPage ? ' active' : ''); b.textContent = p; b.onclick = () => { currentPage = p; render(); }; pgControls.appendChild(b); }
            });
            const next = document.createElement('button'); next.className = 'pg-btn'; next.textContent = 'Next'; next.disabled = currentPage === total;
            next.onclick = () => { currentPage++; render(); }; pgControls.appendChild(next);
        }

        function pageRange(cur, total) {
            if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
            if (cur <= 4) return [1, 2, 3, 4, 5, '...', total];
            if (cur >= total - 3) return [1, '...', total - 4, total - 3, total - 2, total - 1, total];
            return [1, '...', cur - 1, cur, cur + 1, '...', total];
        }

        render();
    })();
</script>
