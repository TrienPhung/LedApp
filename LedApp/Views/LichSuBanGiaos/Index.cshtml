@model IEnumerable<LedApp.Models.LichSuBanGiao>
@{
    ViewData["Title"] = "Lịch sử bàn giao";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    .page-wrapper > .container-fluid {
        padding: 0 !important;
    }

    .px-page {
        padding: 24px 24px 80px;
    }

    .px-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 12px;
        line-height: 1;
    }

        .px-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
            line-height: 1;
        }

            .px-breadcrumb a:hover {
                color: #111827;
            }

        .px-breadcrumb .sep {
            display: inline-flex;
            align-items: center;
            color: #9ca3af;
            line-height: 1;
        }

            .px-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
                display: block;
            }

        .px-breadcrumb .cur {
            color: #111827;
            font-weight: 600;
            line-height: 1;
        }

    .px-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .px-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 3px;
            line-height: 1.2;
        }

        .px-header p {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #7c3aed;
        color: #fff;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #6d28d9;
            color: #fff;
            text-decoration: none;
        }

        .btn-add svg {
            width: 15px;
            height: 15px;
        }

    .px-toolbar-top {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        gap: 6px;
        flex-wrap: wrap;
    }

    .px-toolbar-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        gap: 10px;
    }

    .filter-tabs {
        display: inline-flex;
        gap: 2px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 3px;
    }

    .filter-tab {
        padding: 5px 14px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 500;
        color: #6b7280;
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        transition: all .15s;
        line-height: 1.4;
        white-space: nowrap;
    }

        .filter-tab:hover {
            color: #374151;
            background: rgba(255,255,255,0.5);
        }

        .filter-tab.active {
            background: #fff;
            color: #111827;
            border-color: #e5e7eb;
            font-weight: 600;
            box-shadow: 0 1px 3px rgba(0,0,0,.1), 0 1px 2px rgba(0,0,0,.06);
        }

    .px-search {
        position: relative;
        flex: 1;
        max-width: 480px;
    }

        .px-search svg {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            width: 15px;
            height: 15px;
            pointer-events: none;
        }

        .px-search input {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            color: #111827;
            font-size: 0.875rem;
            padding: 9px 14px 9px 34px;
            width: 100%;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .px-search input::placeholder {
                color: #9ca3af;
            }

            .px-search input:focus {
                border-color: #7c3aed;
                box-shadow: 0 0 0 3px rgba(124,58,237,.1);
            }

    .px-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tb-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s;
        white-space: nowrap;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .tb-btn:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
        }

        .tb-btn svg {
            width: 14px;
            height: 14px;
            color: #6b7280;
        }

    .btn-reset {
        display: none;
        align-items: center;
        gap: 5px;
        padding: 8px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .btn-reset.show {
            display: inline-flex;
        }

        .btn-reset:hover {
            background: #fef2f2;
            border-color: #fecaca;
            color: #ef4444;
        }

        .btn-reset svg {
            width: 13px;
            height: 13px;
        }

    .bulk-bar {
        display: none;
        align-items: center;
        gap: 10px;
        flex: 1;
    }

    .bulk-bar-info {
        font-size: 0.875rem;
        color: #374151;
        font-weight: 500;
        white-space: nowrap;
    }

        .bulk-bar-info span {
            color: #111827;
            font-weight: 700;
        }

    .btn-bulk-delete {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ef4444;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
        white-space: nowrap;
    }

        .btn-bulk-delete:hover {
            background: #dc2626;
        }

        .btn-bulk-delete svg {
            width: 14px;
            height: 14px;
        }

    .btn-bulk-clear {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: transparent;
        border: none;
        color: #6b7280;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        padding: 6px 8px;
        border-radius: 6px;
        transition: all .15s;
    }

        .btn-bulk-clear:hover {
            color: #111827;
            background: #f3f4f6;
        }

        .btn-bulk-clear svg {
            width: 14px;
            height: 14px;
        }

    .columns-wrap {
        position: relative;
    }

    .col-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        z-index: 200;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
        min-width: 200px;
        overflow: hidden;
    }

        .col-dropdown.open {
            display: block;
        }

    .col-dropdown-title {
        padding: 10px 14px 6px;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #9ca3af;
    }

    .col-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 14px;
        cursor: pointer;
        transition: background .1s;
    }

        .col-item:hover {
            background: #f9fafb;
        }

        .col-item span {
            font-size: 0.82rem;
            color: #374151;
            font-weight: 500;
        }

    .col-check {
        width: 16px;
        height: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #7c3aed;
        opacity: 0;
        transition: opacity .12s;
    }

        .col-check svg {
            width: 14px;
            height: 14px;
        }

    .col-item.col-visible .col-check {
        opacity: 1;
    }

    .col-hidden {
        display: none !important;
    }

    .px-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .px-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .px-table thead th {
            background: #f9fafb;
            color: #374151;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
            line-height: 1.3;
            user-select: none;
        }

            .px-table thead th:first-child {
                width: 40px;
            }

    .th-inner {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
    }

        .th-inner:hover {
            color: #111827;
        }

    .sort-icon {
        display: inline-flex;
        opacity: 0.35;
        flex-shrink: 0;
        transition: opacity .15s;
    }

        .sort-icon svg {
            width: 12px;
            height: 12px;
            display: block;
        }

    .th-inner:hover .sort-icon {
        opacity: 0.65;
    }

    .sort-icon.active {
        opacity: 1;
        color: #7c3aed;
    }

    .px-table tbody tr {
        border-bottom: 1px solid #f3f4f6;
        transition: background .1s;
    }

        .px-table tbody tr:last-child {
            border-bottom: none;
        }

        .px-table tbody tr:hover {
            background: #f9fafb;
        }

        .px-table tbody tr.row-selected {
            background: #f5f3ff !important;
        }

    .px-table td {
        padding: 12px 12px;
        color: #111827;
        vertical-align: middle;
        white-space: nowrap;
    }

    .px-table input[type=checkbox] {
        width: 16px;
        height: 16px;
        accent-color: #7c3aed;
        cursor: pointer;
    }

    .td-id {
        color: #6b7280;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .td-main {
        font-weight: 600;
        color: #111827;
    }

    .td-sub {
        color: #6b7280;
        font-size: 0.875rem;
    }

    /* Loại phiếu badges */
    .lp-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 600;
    }

    .lp-xuat {
        background: #fef9c3;
        color: #ca8a04;
    }

    .lp-nhap {
        background: #dbeafe;
        color: #2563eb;
    }

    .lp-other {
        background: #f3f4f6;
        color: #6b7280;
    }

    .row-action-wrap {
        position: relative;
        display: inline-flex;
    }

    .kebab-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 7px;
        border: 1px solid transparent;
        background: transparent;
        color: #9ca3af;
        cursor: pointer;
        transition: all .15s;
    }

        .kebab-btn:hover {
            background: #f3f4f6;
            color: #374151;
            border-color: #e5e7eb;
        }

    .row-action-menu {
        display: none;
        position: absolute;
        right: 0;
        z-index: 300;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
        min-width: 150px;
        overflow: hidden;
    }

        .row-action-menu.open {
            display: block;
        }

        .row-action-menu.drop-up {
            bottom: calc(100% + 4px);
            top: auto;
        }

        .row-action-menu.drop-down {
            top: calc(100% + 4px);
            bottom: auto;
        }

    .ram-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 14px;
        font-size: 0.82rem;
        color: #374151;
        font-weight: 500;
        text-decoration: none;
        transition: background .1s;
        cursor: pointer;
        white-space: nowrap;
        border: none;
        background: transparent;
        width: 100%;
    }

        .ram-item:hover {
            background: #f9fafb;
            color: #111827;
            text-decoration: none;
        }

        .ram-item svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

    .ram-delete {
        color: #ef4444;
    }

        .ram-delete:hover {
            background: #fef2f2;
            color: #dc2626;
        }

    .ram-item:focus, button.ram-item:focus {
        outline: none;
        box-shadow: none;
    }

    .no-results-row td {
        padding: 48px 20px;
        text-align: center;
        color: #6b7280;
        font-size: 0.875rem;
    }

    .px-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 16px;
        border-top: 1px solid #e5e7eb;
        font-size: 0.82rem;
        color: #6b7280;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pg-controls {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pg-rows {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .pg-rows select {
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 0.82rem;
            color: #374151;
            outline: none;
            cursor: pointer;
        }

    .pg-btn {
        padding: 5px 12px;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .12s;
    }

        .pg-btn:hover:not(:disabled) {
            background: #f3f4f6;
        }

        .pg-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .pg-num {
        min-width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .12s;
    }

        .pg-num:hover {
            background: #f3f4f6;
        }

        .pg-num.active {
            background: #7c3aed;
            border-color: #7c3aed;
            color: #fff;
            font-weight: 600;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

        .empty-state svg {
            width: 40px;
            height: 40px;
            margin-bottom: 12px;
            opacity: .4;
        }

        .empty-state p {
            font-size: 0.875rem;
            margin: 0;
        }

    .px-alert {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .del-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .del-modal-overlay.open {
            display: flex;
        }

    .del-modal {
        background: #fff;
        border-radius: 12px;
        padding: 24px 24px 20px;
        max-width: 420px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        position: relative;
    }

    .del-modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 1.1rem;
        line-height: 1;
        padding: 4px;
        border-radius: 6px;
        transition: all .15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .del-modal-close:hover {
            background: #f3f4f6;
            color: #374151;
        }

    .del-modal-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 8px;
        padding-right: 24px;
    }

    .del-modal-body {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 20px;
        line-height: 1.55;
    }

    .del-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-modal-cancel {
        padding: 8px 18px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-modal-cancel:hover {
            background: #f9fafb;
            border-color: #d1d5db;
        }

    .btn-modal-confirm {
        padding: 8px 18px;
        border-radius: 8px;
        border: none;
        background: #ef4444;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-modal-confirm:hover {
            background: #dc2626;
        }

    body.modal-open {
        overflow: hidden;
    }

    #exportToast {
        display: none;
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        background: #111827;
        color: #fff;
        border-radius: 10px;
        padding: 12px 18px;
        font-size: 0.875rem;
        font-weight: 500;
        align-items: center;
        gap: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.2);
    }

    /* Dark mode */
    body.dark-mode .px-header h1 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .px-header p {
        color: #9ca3af !important;
    }

    body.dark-mode .px-breadcrumb, body.dark-mode .px-breadcrumb a {
        color: #9ca3af !important;
    }

    body.dark-mode .filter-tabs {
        background: #22263a !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .filter-tab {
        color: #9ca3af !important;
    }

        body.dark-mode .filter-tab:hover {
            color: #e2e8f0 !important;
            background: rgba(255,255,255,.05) !important;
        }

        body.dark-mode .filter-tab.active {
            background: #2e3248 !important;
            border-color: #3d4460 !important;
            color: #e2e8f0 !important;
            box-shadow: 0 1px 3px rgba(0,0,0,.3) !important;
        }

    body.dark-mode .px-search input {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .tb-btn, body.dark-mode .btn-reset {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #9ca3af !important;
        box-shadow: none !important;
    }

        body.dark-mode .tb-btn:hover {
            background: #22263a !important;
            color: #e2e8f0 !important;
        }

    body.dark-mode .col-dropdown {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .col-item:hover {
        background: #22263a !important;
    }

    body.dark-mode .col-item span {
        color: #d1d5db !important;
    }

    body.dark-mode .col-dropdown-title {
        color: #6b7280 !important;
    }

    body.dark-mode .px-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .px-table thead th {
        background: #22263a !important;
        color: #6b7280 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .px-table tbody tr {
        border-color: #2e3248 !important;
    }

        body.dark-mode .px-table tbody tr:hover {
            background: #22263a !important;
        }

        body.dark-mode .px-table tbody tr.row-selected {
            background: #2d1f5e !important;
        }

    body.dark-mode .px-table td {
        color: #e2e8f0 !important;
    }

    body.dark-mode .td-id {
        color: #9ca3af !important;
    }

    body.dark-mode .td-main {
        color: #f1f5f9 !important;
    }

    body.dark-mode .td-sub {
        color: #9ca3af !important;
    }

    body.dark-mode .px-pagination {
        border-color: #2e3248 !important;
        color: #9ca3af !important;
    }

    body.dark-mode .pg-btn, body.dark-mode .pg-num {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .pg-rows select {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .pg-num.active {
        background: #7c3aed !important;
        border-color: #7c3aed !important;
        color: #fff !important;
    }

    body.dark-mode .row-action-menu {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .ram-item {
        color: #d1d5db !important;
    }

        body.dark-mode .ram-item:hover {
            background: #22263a !important;
            color: #fff !important;
        }

    body.dark-mode .ram-delete {
        color: #f87171 !important;
    }

        body.dark-mode .ram-delete:hover {
            background: #2e0f0f !important;
        }

    body.dark-mode .del-modal {
        background: #1a1d27 !important;
    }

    body.dark-mode .del-modal-title {
        color: #e2e8f0 !important;
    }

    body.dark-mode .del-modal-body {
        color: #9ca3af !important;
    }

    body.dark-mode .btn-modal-cancel {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .bulk-bar-info {
        color: #9ca3af !important;
    }

        body.dark-mode .bulk-bar-info span {
            color: #e2e8f0 !important;
