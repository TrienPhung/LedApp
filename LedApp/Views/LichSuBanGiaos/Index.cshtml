                    string loaiBadgeClass = loaiLower.Contains("xuat") ? "lp-xuat" : (loaiLower.Contains("nhap") ? "lp-nhap" : "lp-other");
                    string nhanVienName = item.NhanVien?.FullName ?? item.NhanVienId.ToString();
                    string thoiGianStr = item.ThoiGian.ToString("dd/MM/yyyy HH:mm");

                    <tr data-filter="@filterKey"
                        data-id="@item.Id"
                        data-search="@item.LoaiPhieu @item.DonVi @nhanVienName @item.SoBG @item.PhieuId">
