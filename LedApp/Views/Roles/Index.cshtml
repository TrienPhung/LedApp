@using LedApp.Controllers
@model List<RoleIndexViewModel>
@{
    ViewData["Title"] = "Quản lý Role";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    .page-wrapper > .container-fluid {
        padding: 0 !important;
    }

    .px-page {
        padding: 24px 24px 80px;
    }

    .px-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 12px;
    }

        .px-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

            .px-breadcrumb a:hover {
                color: #111827;
            }

        .px-breadcrumb .sep svg {
            width: 13px;
            height: 13px;
            stroke-width: 2;
        }

        .px-breadcrumb .cur {
            color: #111827;
            font-weight: 600;
        }

    .px-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

        .px-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 3px;
        }

        .px-header p {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

    /* ── Toolbar ── */
    .px-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .px-search {
        position: relative;
        flex: 1;
        max-width: 360px;
    }

        .px-search svg {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 15px;
            height: 15px;
            color: #9ca3af;
            pointer-events: none;
        }

        .px-search input {
            width: 100%;
            padding: 8px 12px 8px 34px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            color: #111827;
            font-size: 0.875rem;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
            box-sizing: border-box;
        }

            .px-search input::placeholder {
                color: #9ca3af;
            }

            .px-search input:focus {
                border-color: #16a34a;
                box-shadow: 0 0 0 3px rgba(22,163,74,.1);
            }

    .role-count-info {
        font-size: 0.82rem;
        color: #6b7280;
        margin-left: auto;
        white-space: nowrap;
    }

        .role-count-info span {
            font-weight: 700;
            color: #111827;
        }

    /* ── Buttons ── */
    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #16a34a;
        color: #fff;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        transition: background .15s;
        cursor: pointer;
        border: none;
        white-space: nowrap;
    }

        .btn-add:hover {
            background: #15803d;
            color: #fff;
            text-decoration: none;
        }

        .btn-add svg {
            width: 15px;
            height: 15px;
        }

    /* ── Alerts ── */
    .px-alert-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .px-alert-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ── Cards grid ── */
    .roles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }

    .role-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        transition: box-shadow .15s;
    }

        .role-card:hover {
            box-shadow: 0 4px 12px rgba(0,0,0,.08);
        }

    .role-card-head {
        padding: 16px 20px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .role-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #f0fdf4;
        color: #16a34a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 800;
        flex-shrink: 0;
    }

        .role-avatar.admin {
            background: #fef2f2;
            color: #ef4444;
        }

    .role-name {
        font-size: 0.9rem;
        font-weight: 700;
        color: #111827;
    }

    .role-id {
        font-size: 0.72rem;
        color: #9ca3af;
        margin-top: 1px;
        font-family: monospace;
    }

    .role-card-body {
        padding: 14px 20px;
        display: flex;
        gap: 20px;
    }

    .role-stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .role-stat-val {
        font-size: 1.1rem;
        font-weight: 700;
        color: #111827;
    }

    .role-stat-label {
        font-size: 0.72rem;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .role-card-foot {
        padding: 12px 20px;
        border-top: 1px solid #f3f4f6;
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .btn-perm {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all .15s;
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
        cursor: pointer;
    }

        .btn-perm:hover {
            background: #dcfce7;
            text-decoration: none;
            color: #15803d;
        }

        .btn-perm svg {
            width: 13px;
            height: 13px;
        }

    .btn-del-role {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all .15s;
        background: #fff;
        color: #ef4444;
        border: 1px solid #fecaca;
        cursor: pointer;
        margin-left: auto;
    }

        .btn-del-role:hover {
            background: #fef2f2;
        }

        .btn-del-role svg {
            width: 13px;
            height: 13px;
        }

    /* ── Add card ── */
    .add-role-card {
        background: #fff;
        border: 2px dashed #e5e7eb;
        border-radius: 12px;
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 160px;
        cursor: pointer;
        transition: all .15s;
    }

        .add-role-card:hover {
            border-color: #16a34a;
            background: #f0fdf4;
        }

        .add-role-card svg {
            width: 28px;
            height: 28px;
            color: #9ca3af;
        }

        .add-role-card span {
            font-size: 0.875rem;
            color: #6b7280;
            font-weight: 500;
        }

    /* ── Empty search state ── */
    .no-roles-found {
        display: none;
        grid-column: 1 / -1;
        text-align: center;
        padding: 48px 20px;
        color: #6b7280;
        font-size: 0.875rem;
    }

        .no-roles-found svg {
            width: 36px;
            height: 36px;
            color: #d1d5db;
            display: block;
            margin: 0 auto 10px;
        }

    /* ── Modal ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        max-width: 400px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        position: relative;
    }

    .modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 1.2rem;
        padding: 4px;
        border-radius: 6px;
    }

        .modal-close:hover {
            background: #f3f4f6;
            color: #374151;
        }

    .modal-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 16px;
    }

    .modal-body {
        margin-bottom: 20px;
    }

        .modal-body p {
            font-size: 0.875rem;
            color: #6b7280;
            line-height: 1.55;
        }

    .modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-mc {
        padding: 8px 18px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-mc:hover {
            background: #f9fafb;
        }

    .btn-md {
        padding: 8px 18px;
        border-radius: 8px;
        border: none;
        background: #ef4444;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-md:hover {
            background: #dc2626;
        }

    .f-input {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.875rem;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        box-sizing: border-box;
    }

        .f-input:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 3px rgba(22,163,74,.1);
        }

    .f-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .f-error-text {
        font-size: 0.78rem;
        color: #ef4444;
        margin-top: 4px;
    }

    /* ── Dark mode ── */
    body.dark-mode .px-header h1 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .px-header p,
    body.dark-mode .px-breadcrumb,
    body.dark-mode .px-breadcrumb a {
        color: #9ca3af !important;
    }

    body.dark-mode .px-search input {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .role-count-info {
        color: #9ca3af !important;
    }

        body.dark-mode .role-count-info span {
            color: #e2e8f0 !important;
        }

    body.dark-mode .role-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .role-card-head {
        border-color: #2e3248 !important;
    }

    body.dark-mode .role-card-foot {
        border-color: #2e3248 !important;
    }

    body.dark-mode .role-name {
        color: #e2e8f0 !important;
    }

    body.dark-mode .role-stat-val {
        color: #e2e8f0 !important;
    }

    body.dark-mode .add-role-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

        body.dark-mode .add-role-card:hover {
            background: #0a2e1a !important;
            border-color: #16a34a !important;
        }

    body.dark-mode .modal-box {
        background: #1a1d27 !important;
    }

    body.dark-mode .modal-title {
        color: #e2e8f0 !important;
    }

    body.dark-mode .modal-body p {
        color: #9ca3af !important;
    }

    body.dark-mode .f-input {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .btn-mc {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .btn-del-role {
        background: #1a1d27 !important;
    }

    body.dark-mode .no-roles-found {
        color: #9ca3af !important;
    }

    .btn-reset {
        display: none;
        align-items: center;
        gap: 5px;
        padding: 8px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-reset.show {
            display: inline-flex;
        }

        .btn-reset:hover {
            background: #fef2f2;
            border-color: #fecaca;
            color: #ef4444;
        }

    body.dark-mode .btn-reset {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #9ca3af !important;
    }

    body.dark-mode .btn-reset:hover {
            background: #2e0f0f !important;
            border-color: #991b1b !important;
            color: #f87171 !important;
    }
</style>

<div class="px-page">

    @if (TempData["Success"] != null)
    {
        <div class="px-alert-success">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="px-alert-error">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
            @TempData["Error"]
        </div>
    }

    <!-- Breadcrumb -->
    <div class="px-breadcrumb">
        <a href="/">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">Quản lý Role</span>
    </div>

    <!-- Header -->
    <div class="px-header">
        <div>
            <h1>Quản lý Role</h1>
            <p>Tạo và phân quyền chi tiết cho từng role trong hệ thống.</p>
        </div>
        <button class="btn-add" type="button" onclick="openAddRole()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Thêm role
        </button>
    </div>

    <!-- Toolbar: Search + count -->
    <div class="px-toolbar">
        <div class="px-search">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
            <input type="text" id="roleSearchInput" placeholder="Tìm theo tên role..." oninput="filterRoles(this.value)" autocomplete="off" />
        </div>
        <!-- Trong .px-toolbar, sau .px-search -->
        <button class="btn-reset" id="btnReset" type="button"
                onclick="resetSearch()">
            Reset
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" width="13" height="13">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
        </button>
        <span class="role-count-info">Hiển thị <span id="roleVisibleCount">@Model.Count</span> / @Model.Count role</span>
    </div>

    <!-- Role cards -->
    <div class="roles-grid" id="rolesGrid">
        @foreach (var role in Model)
        {
            <div class="role-card" data-rolename="@role.RoleName.ToLower()">
                <div class="role-card-head">
                    <div class="role-avatar @(role.RoleName == "Admin" ? "admin" : "")">
                        @role.RoleName[0].ToString().ToUpper()
                    </div>
                    <div>
                        <div class="role-name">@role.RoleName</div>
                        <div class="role-id">ID: @role.RoleId[..8]...</div>
                    </div>
                </div>
                <div class="role-card-body">
                    <div class="role-stat">
                        <span class="role-stat-val">@role.PermissionCount</span>
                        <span class="role-stat-label">Quyền</span>
                    </div>
                    <div class="role-stat">
                        <span class="role-stat-val">@role.UserCount</span>
                        <span class="role-stat-label">Tài khoản</span>
                    </div>
                </div>
                <div class="role-card-foot">
                    <a asp-action="Permissions" asp-route-roleId="@role.RoleId" class="btn-perm">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
                        Phân quyền
                    </a>
                    @if (role.RoleName != "Admin")
                    {
                        <button class="btn-del-role" type="button"
                                onclick="openDelRole('@role.RoleId', '@role.RoleName', @role.UserCount)">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                            Xóa
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Card thêm role mới — ẩn khi đang search -->
        <div class="add-role-card" id="addRoleCard" onclick="openAddRole()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            <span>Thêm role mới</span>
        </div>

        <!-- Empty search state -->
        <div class="no-roles-found" id="noRolesFound">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
            Không tìm thấy role nào.
        </div>
    </div>
</div>

<!-- Modal thêm role -->
<div class="modal-overlay" id="addRoleModal">
    <div class="modal-box">
        <button class="modal-close" onclick="closeAddRole()">×</button>
        <div class="modal-title">Thêm role mới</div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <label class="f-label">Tên role <span style="color:#ef4444;">*</span></label>
                <input type="text" name="roleName" class="f-input" placeholder="VD: DieuDoXuat, KeToan..." id="roleNameInput" />
                <p class="f-error-text" id="roleNameError" style="display:none;"></p>
                <p style="font-size:0.78rem;color:#9ca3af;margin-top:8px;">
                    Tên role không chứa khoảng trắng, không dấu. VD: DieuDoXuat, KeToan, BaoVe
                </p>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn-mc" onclick="closeAddRole()">Hủy</button>
                <button type="submit" class="btn-add">Tạo role</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal xóa role -->
<div class="modal-overlay" id="delRoleModal">
    <div class="modal-box">
        <button class="modal-close" onclick="closeDelRole()">×</button>
        <div class="modal-title">Xóa role</div>
        <div class="modal-body">
            <p>Bạn có chắc chắn muốn xóa role <strong id="delRoleName"></strong>?</p>
            <p id="delRoleWarning" style="color:#ef4444;display:none;margin-top:8px;"></p>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn-mc" onclick="closeDelRole()">Hủy</button>
            <form id="delRoleForm" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-md" id="delRoleBtn">Xóa</button>
            </form>
        </div>
    </div>
</div>

<script>
    // ── Search ──
    const totalCount = @Model.Count;

    function filterRoles(q) {
        q = q.trim().toLowerCase();
        const cards = document.querySelectorAll('#rolesGrid .role-card');
        let visible = 0;

        cards.forEach(card => {
            const name = card.dataset.rolename || '';
            const show = !q || name.includes(q);
            card.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        document.getElementById('addRoleCard').style.display = q ? 'none' : '';
        document.getElementById('noRolesFound').style.display = visible === 0 ? 'block' : 'none';
        document.getElementById('roleVisibleCount').textContent = visible;

        // Hiện/ẩn nút Reset
        const btnReset = document.getElementById('btnReset');
        if (q) btnReset.classList.add('show');
        else btnReset.classList.remove('show');
    }

    function resetSearch() {
        document.getElementById('roleSearchInput').value = '';
        filterRoles('');
    }

    // ── Modal thêm role ──
    function openAddRole() {
        document.getElementById('addRoleModal').classList.add('open');
        document.body.classList.add('modal-open');
        setTimeout(() => document.getElementById('roleNameInput').focus(), 100);
    }
    function closeAddRole() {
        document.getElementById('addRoleModal').classList.remove('open');
        document.body.classList.remove('modal-open');
    }

    // ── Modal xóa role ──
    function openDelRole(roleId, roleName, userCount) {
        document.getElementById('delRoleName').textContent = roleName;
        document.getElementById('delRoleForm').action = '/Roles/Delete';

        const form = document.getElementById('delRoleForm');
        let input = form.querySelector('input[name="roleId"]');
        if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'roleId';
            form.appendChild(input);
        }
        input.value = roleId;

        const warning = document.getElementById('delRoleWarning');
        const btn = document.getElementById('delRoleBtn');
        if (userCount > 0) {
            warning.textContent = `⚠ Role này đang có ${userCount} tài khoản, không thể xóa.`;
            warning.style.display = 'block';
            btn.disabled = true;
            btn.style.opacity = '0.4';
        } else {
            warning.style.display = 'none';
            btn.disabled = false;
            btn.style.opacity = '1';
        }

        document.getElementById('delRoleModal').classList.add('open');
        document.body.classList.add('modal-open');
    }
    function closeDelRole() {
        document.getElementById('delRoleModal').classList.remove('open');
        document.body.classList.remove('modal-open');
    }

    // Click ngoài modal để đóng
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', e => {
            if (e.target === overlay) {
                overlay.classList.remove('open');
                document.body.classList.remove('modal-open');
            }
        });
    });
</script>
