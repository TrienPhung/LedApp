@model LedApp.Models.DanhSachXe
@{
    ViewData["Title"] = "Chi tiết xe " + Model.BienSoXe;
    Layout = "~/Views/Shared/_Layout1.cshtml";

    string badgeClass = Model.TrangThai switch
    {
        (int)LedApp.Models.TrangThaiXe.TrongBai => "bp-trong-bai",
        (int)LedApp.Models.TrangThaiXe.DangPhanCong => "bp-phan-cong",
        (int)LedApp.Models.TrangThaiXe.DangVanChuyen => "bp-van-chuyen",
        (int)LedApp.Models.TrangThaiXe.BaoTri => "bp-bao-tri",
        _ => "bp-bao-tri"
    };
    string badgeLabel = Model.TrangThai switch
    {
        (int)LedApp.Models.TrangThaiXe.TrongBai => "Trong bãi",
        (int)LedApp.Models.TrangThaiXe.DangPhanCong => "Đang phân công",
        (int)LedApp.Models.TrangThaiXe.DangVanChuyen => "Đang vận chuyển",
        (int)LedApp.Models.TrangThaiXe.BaoTri => "Bảo trì",
        _ => "—"
    };
}

<style>
    :root {
        --ap-surface: #ffffff;
        --ap-border: #e5e7eb;
        --ap-border-lt: #f3f4f6;
        --ap-text-1: #111827;
        --ap-text-2: #6b7280;
        --ap-text-3: #9ca3af;
        --ap-green: #16a34a;
        --ap-red: #dc2626;
        --ap-radius: 12px;
        --ap-shadow: 0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
    }

    body.dark-mode {
        --ap-surface: #1e293b;
        --ap-border: #334155;
        --ap-border-lt: #1e293b;
        --ap-text-1: #f1f5f9;
        --ap-text-2: #94a3b8;
        --ap-text-3: #64748b;
    }

    .dt-wrap {
        padding: 0 0 40px;
    }

    .dt-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--ap-text-2);
        margin-bottom: 14px;
    }

        .dt-breadcrumb a {
            color: var(--ap-text-2);
            text-decoration: none;
        }

            .dt-breadcrumb a:hover {
                color: var(--ap-text-1);
            }

        .dt-breadcrumb .sep {
            color: var(--ap-text-3);
            display: flex;
            align-items: center;
        }

            .dt-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
            }

        .dt-breadcrumb .cur {
            color: var(--ap-text-1);
            font-weight: 600;
        }

    .dt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        gap: 16px;
        flex-wrap: wrap;
    }

        .dt-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--ap-text-1);
            margin: 0;
            letter-spacing: -.3px;
        }

    .dt-header-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .btn-apex {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid var(--ap-border);
        background: var(--ap-surface);
        color: var(--ap-text-2);
        transition: all .15s;
        box-shadow: var(--ap-shadow);
    }

        .btn-apex:hover {
            background: var(--ap-border-lt);
            color: var(--ap-text-1);
            text-decoration: none;
        }

        .btn-apex svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

        .btn-apex.edit {
            color: var(--ap-text-1);
        }

        .btn-apex.danger {
            background: var(--ap-red);
            border-color: var(--ap-red);
            color: #fff;
        }

            .btn-apex.danger:hover {
                background: #b91c1c;
                border-color: #b91c1c;
                color: #fff;
            }

    .dt-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 16px;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .dt-grid {
            grid-template-columns: 1fr;
        }
    }

    .ap-panel {
        background: var(--ap-surface);
        border: 1px solid var(--ap-border);
        border-radius: var(--ap-radius);
        box-shadow: var(--ap-shadow);
        overflow: hidden;
        margin-bottom: 16px;
    }

        .ap-panel:last-child {
            margin-bottom: 0;
        }

    .ap-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--ap-border-lt);
    }

    .ap-panel-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--ap-text-1);
    }

    .detail-row {
        display: grid;
        grid-template-columns: 160px 1fr;
        padding: 14px 20px;
        border-bottom: 1px solid var(--ap-border-lt);
        align-items: start;
        gap: 12px;
        transition: background .1s;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row:hover {
            background: var(--ap-border-lt);
        }

    .detail-key {
        font-size: 12.5px;
        font-weight: 500;
        color: var(--ap-text-2);
        padding-top: 1px;
    }

    .detail-val {
        font-size: 13.5px;
        color: var(--ap-text-1);
        font-weight: 500;
        word-break: break-word;
    }

        .detail-val.muted {
            color: var(--ap-text-3);
            font-weight: 400;
            font-style: italic;
        }

        .detail-val.mono {
            font-family: 'Courier New', monospace;
            font-size: 13px;
            letter-spacing: .5px;
        }

    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

        .badge-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }

    .bp-trong-bai {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-trong-bai::before {
            background: #16a34a;
        }

    .bp-phan-cong {
        background: #fef3c7;
        color: #d97706;
    }

        .bp-phan-cong::before {
            background: #d97706;
        }

    .bp-van-chuyen {
        background: #eff6ff;
        color: #3b82f6;
    }

        .bp-van-chuyen::before {
            background: #3b82f6;
        }

    .bp-bao-tri {
        background: #f1f5f9;
        color: #64748b;
    }

        .bp-bao-tri::before {
            background: #94a3b8;
        }

    .sidebar-meta {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 16px 20px;
    }

    .meta-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--ap-text-3);
        margin-bottom: 5px;
    }

    .meta-value {
        font-size: 13px;
        font-weight: 600;
        color: var(--ap-text-1);
    }

        .meta-value.mono {
            font-family: monospace;
        }

        .meta-value.muted {
            color: var(--ap-text-3);
            font-weight: 400;
            font-style: italic;
        }

    /* Info card với icon */
    .info-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--ap-border-lt);
    }

        .info-card:last-child {
            border-bottom: none;
        }

    .info-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .info-icon svg {
            width: 18px;
            height: 18px;
        }

        .info-icon.green {
            background: #dcfce7;
            color: #16a34a;
        }

        .info-icon.blue {
            background: #dbeafe;
            color: #2563eb;
        }

        .info-icon.orange {
            background: #fef3c7;
            color: #d97706;
        }

        .info-icon.gray {
            background: #f1f5f9;
            color: #64748b;
        }

    .info-body {
        flex: 1;
    }

    .info-label {
        font-size: 11.5px;
        color: var(--ap-text-2);
        font-weight: 500;
    }

    .info-value {
        font-size: 14px;
        font-weight: 700;
        color: var(--ap-text-1);
        margin-top: 1px;
    }

    /* Delete modal */
    .del-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .del-overlay.open {
            display: flex;
        }

    .del-modal {
        background: var(--ap-surface);
        border-radius: 12px;
        padding: 24px;
        max-width: 380px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        position: relative;
    }

    .del-modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        background: none;
        border: none;
        color: var(--ap-text-3);
        cursor: pointer;
        font-size: 18px;
        line-height: 1;
        padding: 4px 6px;
        border-radius: 6px;
        transition: all .15s;
    }

        .del-modal-close:hover {
            background: var(--ap-border-lt);
            color: var(--ap-text-1);
        }

    .del-modal h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--ap-text-1);
        margin: 0 0 8px;
    }

    .del-modal p {
        font-size: 13px;
        color: var(--ap-text-2);
        line-height: 1.55;
        margin: 0 0 20px;
    }

    .del-modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-cancel {
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid var(--ap-border);
        background: var(--ap-surface);
        color: var(--ap-text-1);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-cancel:hover {
            background: var(--ap-border-lt);
        }

    .btn-confirm-del {
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        background: var(--ap-red);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-confirm-del:hover {
            background: #b91c1c;
        }

    body.dark-mode .ap-panel {
        background: var(--ap-surface) !important;
        border-color: var(--ap-border) !important;
    }

    body.dark-mode .detail-row:hover {
        background: rgba(255,255,255,.03);
    }

    body.dark-mode .btn-apex {
        background: var(--ap-surface) !important;
        border-color: var(--ap-border) !important;
        color: var(--ap-text-2) !important;
    }

        body.dark-mode .btn-apex.danger {
            background: var(--ap-red) !important;
            border-color: var(--ap-red) !important;
            color: #fff !important;
        }
</style>

<div class="dt-wrap">
    <div class="dt-breadcrumb">
        <a href="/Dashboard">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <a asp-controller="DanhSachXes" asp-action="Index">Danh sách xe</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">@Model.BienSoXe</span>
    </div>

    <div class="dt-header">
        <h1>@Model.BienSoXe</h1>
        <div class="dt-header-actions">
            <a asp-action="Index" class="btn-apex">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
                Trở về
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-apex edit">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
                Sửa
            </a>
            <button class="btn-apex danger" onclick="openDelModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                Xóa
            </button>
        </div>
    </div>

    <div class="dt-grid">
        <!-- LEFT: Main details -->
        <div>
            <div class="ap-panel">
                <div class="ap-panel-head">
                    <span class="ap-panel-title">Thông tin xe</span>
                    <span class="badge-pill @badgeClass">@badgeLabel</span>
                </div>
                <div>
                    <div class="detail-row">
                        <span class="detail-key">Biển số xe</span>
                        <span class="detail-val mono">@(Model.BienSoXe ?? "—")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Loại xe</span>
                        <span class="detail-val @(Model.LoaiXe == null ? "muted" : "")">@(Model.LoaiXe ?? "—")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Tải trọng</span>
                        <span class="detail-val @(Model.TaiTrong <= 0 ? "muted" : "")">
                            @(Model.TaiTrong > 0 ? Model.TaiTrong + " tấn" : "—")
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Tài xế phụ trách</span>
                        <span class="detail-val @(Model.TaiXe == null ? "muted" : "")">
                            @(Model.TaiXe?.FullName ?? "Chưa phân công")
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Trạng thái</span>
                        <span class="detail-val">
                            <span class="badge-pill @badgeClass">@badgeLabel</span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Ghi chú</span>
                        <span class="detail-val @(Model.GhiChu == null ? "muted" : "")">
                            @(Model.GhiChu ?? "—")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Sidebar -->
        <div>
            <!-- Quick info cards -->
            <div class="ap-panel">
                <div class="ap-panel-head">
                    <span class="ap-panel-title">Tóm tắt</span>
                </div>
                <div>
                    <div class="info-card">
                        <div class="info-icon green">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                        </div>
                        <div class="info-body">
                            <div class="info-label">Biển số xe</div>
                            <div class="info-value" style="font-family:monospace;">@(Model.BienSoXe ?? "—")</div>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="info-icon @(Model.TrangThai == (int)LedApp.Models.TrangThaiXe.TrongBai ? "green" : Model.TrangThai == (int)LedApp.Models.TrangThaiXe.DangPhanCong ? "orange" : Model.TrangThai == (int)LedApp.Models.TrangThaiXe.DangVanChuyen ? "blue" : "gray")">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                        </div>
                        <div class="info-body">
                            <div class="info-label">Trạng thái</div>
                            <div class="info-value"><span class="badge-pill @badgeClass" style="font-size:12px;">@badgeLabel</span></div>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="info-icon blue">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
                        </div>
                        <div class="info-body">
                            <div class="info-label">Tài xế</div>
                            <div class="info-value @(Model.TaiXe == null ? "muted" : "")">@(Model.TaiXe?.FullName ?? "Chưa phân công")</div>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="info-icon orange">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
                        </div>
                        <div class="info-body">
                            <div class="info-label">Tải trọng</div>
                            <div class="info-value @(Model.TaiTrong <= 0 ? "muted" : "")">@(Model.TaiTrong > 0 ? Model.TaiTrong + " tấn" : "—")</div>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="info-icon gray">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                        </div>
                        <div class="info-body">
                            <div class="info-label">Loại xe</div>
                            <div class="info-value @(Model.LoaiXe == null ? "muted" : "")">@(Model.LoaiXe ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="del-overlay" id="delOverlay">
    <div class="del-modal">
        <button class="del-modal-close" onclick="closeDelModal()">×</button>
        <h3>Xóa xe</h3>
        <p>Bạn có chắc chắn muốn xóa xe <strong>@Model.BienSoXe</strong>? Hành động này không thể hoàn tác.</p>
        <div class="del-modal-foot">
            <button class="btn-cancel" onclick="closeDelModal()">Hủy</button>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-confirm-del">Xóa</button>
            </form>
        </div>
    </div>
</div>

<script>
    function openDelModal() { document.getElementById('delOverlay').classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeDelModal() { document.getElementById('delOverlay').classList.remove('open'); document.body.style.overflow = ''; }
    document.getElementById('delOverlay').addEventListener('click', function(e) { if (e.target === this) closeDelModal(); });
</script>
