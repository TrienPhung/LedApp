@model LedApp.Models.Xuat
@{
    ViewData["Title"] = "Chi tiết phiếu xuất";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Chi tiết phiếu xuất #@Model.Id</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">Cửa xuất</dt>
    <dd class="col-sm-9">@(Model.CuaXuat?.Ten ?? $"X-{Model.CuaXuatId:D2}")</dd>
    <dt class="col-sm-3">Biển số xe</dt>
    <dd class="col-sm-9">@(Model.Xe?.BienSoXe ?? "—")</dd>
    <dt class="col-sm-3">Nhân viên xác nhận</dt>
    <dd class="col-sm-9">@(Model.NhanVienXacNhan?.FullName ?? "—")</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">
        @switch (Model.TrangThai)
        {
            case (int)LedApp.Models.TrangThaiXuat.DaPhanCong:
                <span class="badge bg-secondary">Đã phân công</span>
                break;
            case (int)LedApp.Models.TrangThaiXuat.DangBanGiao:
                <span class="badge bg-primary">Đang bàn giao</span>
                break;
            case (int)LedApp.Models.TrangThaiXuat.QuaThoiGian:
                <span class="badge bg-danger">Quá thời gian</span>
                break;
            case (int)LedApp.Models.TrangThaiXuat.HoanThanh:
                <span class="badge bg-success">Hoàn thành</span>
                break;
            case (int)LedApp.Models.TrangThaiXuat.DaXuatPhat:
                <span class="badge bg-dark">Đã xuất phát</span>
                break;
        }
    </dd>
    <dt class="col-sm-3">Thời gian phân công</dt>
    <dd class="col-sm-9">@Model.ThoiGianPhanCong.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Thời gian vào cửa</dt>
    <dd class="col-sm-9">@(Model.ThoiGianVaoCua?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
    <dt class="col-sm-3">Thời gian giới hạn</dt>
    <dd class="col-sm-9">@(Model.ThoiGianGioiHan?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
    <dt class="col-sm-3">Thời gian hoàn thành</dt>
    <dd class="col-sm-9">@(Model.ThoiGianHoanThanh?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
    <dt class="col-sm-3">Thời gian xuất phát</dt>
    <dd class="col-sm-9">@(Model.ThoiGianXuatPhat?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
    <dt class="col-sm-3">Địa điểm giao</dt>
    <dd class="col-sm-9">@(Model.DiaDiemGiao ?? "—")</dd>
    <dt class="col-sm-3">TG dự kiến về bãi</dt>
    <dd class="col-sm-9">@(Model.ThoiGianDuKienVeBai?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
    <dt class="col-sm-3">TG thực tế về bãi</dt>
    <dd class="col-sm-9">@(Model.ThoiGianVeBai?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
    <dt class="col-sm-3">Ghi chú</dt>
    <dd class="col-sm-9">@(Model.GhiChu ?? "—")</dd>
</dl>
<hr />
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Sửa</a>
<a asp-action="Index" class="btn btn-secondary btn-sm ms-2">Trở về</a>
