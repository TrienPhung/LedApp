@model LedApp.Models.Xuat
@{
    ViewData["Title"] = "Thêm phiếu xuất";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Thêm phiếu xuất</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CuaXuatId" class="control-label"></label>
                <select asp-for="CuaXuatId" class="form-control" asp-items="ViewBag.CuaXuatId">
                    <option value="">— Chọn cửa xuất —</option>
                </select>
                <span asp-validation-for="CuaXuatId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="XeId" class="control-label"></label>
                <select asp-for="XeId" class="form-control" asp-items="ViewBag.XeId">
                    <option value="">— Chọn xe —</option>
                </select>
                <small class="text-muted">Chỉ hiển thị xe đang trong bãi.</small>
                <span asp-validation-for="XeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianPhanCong" class="control-label"></label>
                <input asp-for="ThoiGianPhanCong" class="form-control" type="datetime-local" />
                <span asp-validation-for="ThoiGianPhanCong" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GhiChu" class="control-label"></label>
                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Trở về</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
