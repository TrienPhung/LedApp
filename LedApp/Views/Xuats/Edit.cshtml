@section Scripts {
    <script>
        // ── Custom Select DiaDiem ──
        function toggleDiaDiem() {
            const trigger = document.querySelector('#diaDiemSelect .cs-trigger');
            const dropdown = document.getElementById('diaDiemDropdown');
            if (dropdown.classList.contains('open')) {
                closeDiaDiem();
            } else {
                trigger.classList.add('open');
                dropdown.classList.add('open');
                document.getElementById('diaDiemSearch').focus();
            }
        }
        function closeDiaDiem() {
            document.querySelector('#diaDiemSelect .cs-trigger').classList.remove('open');
            document.getElementById('diaDiemDropdown').classList.remove('open');
            document.getElementById('diaDiemSearch').value = '';
            filterDiaDiem('');
        }
        function selectDiaDiem(el) {
            const value = el.dataset.value;
            document.getElementById('hdDiaDiemGiao').value = value;
            const lbl = document.getElementById('diaDiemLabel');
            lbl.textContent = value;
            lbl.classList.remove('cs-placeholder');
            document.getElementById('diaDiemClearBtn').style.display = 'inline';
            document.querySelectorAll('#diaDiemList .cs-opt').forEach(o => o.classList.toggle('selected', o.dataset.value === value));
            closeDiaDiem();
        }
        function clearDiaDiem(e) {
            e.stopPropagation();
            document.getElementById('hdDiaDiemGiao').value = '';
            const lbl = document.getElementById('diaDiemLabel');
            lbl.textContent = '— Chọn điểm giao —';
            lbl.classList.add('cs-placeholder');
            document.getElementById('diaDiemClearBtn').style.display = 'none';
            document.querySelectorAll('#diaDiemList .cs-opt').forEach(o => o.classList.remove('selected'));
        }
        function filterDiaDiem(kw) {
            kw = kw.toLowerCase();
            const opts = document.querySelectorAll('#diaDiemList .cs-opt');
            const groups = document.querySelectorAll('#diaDiemList .cs-group');
            let found = false;
            opts.forEach(o => {
                const match = o.dataset.value && o.dataset.value.toLowerCase().includes(kw);
                o.style.display = match ? '' : 'none';
                if (match) found = true;
            });
            groups.forEach(g => {
                let next = g.nextElementSibling;
                let has = false;
                while (next && !next.classList.contains('cs-group')) {
                    if (next.style.display !== 'none') has = true;
                    next = next.nextElementSibling;
                }
                g.style.display = has ? '' : 'none';
            });
            const nr = document.getElementById('csNoResult');
            if (!found) {
                if (!nr) {
                    const d = document.createElement('div');
                    d.id = 'csNoResult'; d.className = 'cs-opt no-result';
                    d.textContent = 'Không tìm thấy bưu cục';
                    document.getElementById('diaDiemList').appendChild(d);
                }
            } else { if (nr) nr.remove(); }
        }
        document.addEventListener('click', function(e) {
            if (!document.getElementById('diaDiemSelect').contains(e.target)) closeDiaDiem();
        });
        document.addEventListener('DOMContentLoaded', function() {
            const val = document.getElementById('hdDiaDiemGiao').value;
            if (val) {
                const opt = document.querySelector(`#diaDiemList .cs-opt[data-value="${val}"]`);
                if (opt) selectDiaDiem(opt);
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
