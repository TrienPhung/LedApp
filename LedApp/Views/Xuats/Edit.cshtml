@model LedApp.Models.Xuat
@{
    ViewData["Title"] = "Sửa phiếu xuất";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<!-- CSS — thêm vào đầu file hoặc dùng chung nếu đã có trong layout -->
<style>
    .custom-select-wrapper {
        position: relative;
        user-select: none;
    }

    .custom-select-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 38px;
        padding: 0 12px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        background: #fff;
        cursor: pointer;
        font-size: 14px;
        color: #212529;
        transition: border-color .2s, box-shadow .2s;
    }

        .custom-select-trigger:hover {
            border-color: #86b7fe;
        }

        .custom-select-trigger.open {
            border-color: #86b7fe;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.15);
            border-radius: 6px 6px 0 0;
        }

        .custom-select-trigger .placeholder {
            color: #adb5bd;
        }

        .custom-select-trigger .clear-btn {
            color: #adb5bd;
            font-size: 16px;
            margin-right: 6px;
            line-height: 1;
            cursor: pointer;
        }

            .custom-select-trigger .clear-btn:hover {
                color: #e74c3c;
            }

        .custom-select-trigger .arrow {
            font-size: 12px;
            color: #6c757d;
            transition: transform .2s;
        }

        .custom-select-trigger.open .arrow {
            transform: rotate(180deg);
        }

    .custom-select-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        border: 1px solid #86b7fe;
        border-top: none;
        border-radius: 0 0 6px 6px;
        background: #fff;
        box-shadow: 0 6px 16px rgba(0,0,0,0.1);
        z-index: 9999;
    }

        .custom-select-dropdown.open {
            display: block;
        }

    .custom-select-search {
        padding: 8px;
        border-bottom: 1px solid #f0f0f0;
    }

        .custom-select-search input {
            width: 100%;
            padding: 6px 10px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            font-size: 14px;
            box-sizing: border-box;
            outline: none;
        }

            .custom-select-search input:focus {
                border-color: #86b7fe;
                box-shadow: 0 0 0 2px rgba(13,110,253,0.15);
            }

    .custom-select-list {
        max-height: 200px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #ced4da #f8f9fa;
    }

        .custom-select-list::-webkit-scrollbar {
            width: 6px;
        }

        .custom-select-list::-webkit-scrollbar-track {
            background: #f8f9fa;
        }

        .custom-select-list::-webkit-scrollbar-thumb {
            background: #ced4da;
            border-radius: 3px;
        }

            .custom-select-list::-webkit-scrollbar-thumb:hover {
                background: #adb5bd;
            }

    .custom-select-option {
        padding: 8px 14px;
        font-size: 14px;
        cursor: pointer;
        transition: background .15s;
    }

        .custom-select-option:hover {
            background: #e9f0ff;
            color: #0d6efd;
        }

        .custom-select-option.selected {
            background: #e9f0ff;
            color: #0d6efd;
            font-weight: 500;
        }

        .custom-select-option.no-result {
            color: #adb5bd;
            cursor: default;
        }

            .custom-select-option.no-result:hover {
                background: none;
            }

    .custom-select-group-label {
        padding: 6px 14px 4px;
        font-size: 11px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: .5px;
        background: #f8f9fa;
        border-top: 1px solid #f0f0f0;
    }
</style>
<h1>Sửa phiếu xuất #@Model.Id</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="CuaXuatId" class="control-label"></label>
                <select asp-for="CuaXuatId" class="form-control" asp-items="ViewBag.CuaXuatId"></select>
                <span asp-validation-for="CuaXuatId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="XeId" class="control-label"></label>
                <select asp-for="XeId" class="form-control" asp-items="ViewBag.XeId">
                    <option value="">— Không có xe —</option>
                </select>
                <span asp-validation-for="XeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianPhanCong" class="control-label"></label>
                <input asp-for="ThoiGianPhanCong" class="form-control" type="datetime-local" />
                <span asp-validation-for="ThoiGianPhanCong" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianVaoCua" class="control-label"></label>
                <input asp-for="ThoiGianVaoCua" class="form-control" type="datetime-local" />
                <span asp-validation-for="ThoiGianVaoCua" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianGioiHan" class="control-label"></label>
                <input asp-for="ThoiGianGioiHan" class="form-control" type="datetime-local" />
                <span asp-validation-for="ThoiGianGioiHan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianHoanThanh" class="control-label"></label>
                <input asp-for="ThoiGianHoanThanh" class="form-control" type="datetime-local" />
                <span asp-validation-for="ThoiGianHoanThanh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianXuatPhat" class="control-label"></label>
                <input asp-for="ThoiGianXuatPhat" class="form-control" type="datetime-local" />
                <small class="text-muted">Bảo vệ xác nhận xe ra cổng.</small>
                <span asp-validation-for="ThoiGianXuatPhat" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TrangThai" class="control-label"></label>
                <select asp-for="TrangThai" class="form-control">
                    <option value="0">Đã phân công</option>
                    <option value="1">Đang bàn giao</option>
                    <option value="2">Quá thời gian</option>
                    <option value="3">Hoàn thành</option>
                    <option value="4">Đã xuất phát</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NhanVienXacNhanId" class="control-label"></label>
                <select asp-for="NhanVienXacNhanId" class="form-control" asp-items="ViewBag.NhanVienXacNhanId">
                    <option value="">— Chưa có —</option>
                </select>
            </div>
            <!-- Input hidden để bind vào model -->
            <input type="hidden" asp-for="DiaDiemGiao" id="hdDiaDiemGiao" />

            <div class="form-group">
                <label asp-for="DiaDiemGiao" class="control-label"></label>
                <div class="custom-select-wrapper" id="diaDiemSelect">
                    <div class="custom-select-trigger" onclick="toggleDiaDiem()">
                        <span id="diaDiemLabel" class="placeholder">— Chọn điểm giao —</span>
                        <div style="display:flex;align-items:center;gap:4px;">
                            <span class="clear-btn" id="diaDiemClearBtn"
                                  onclick="clearDiaDiem(event)" style="display:none">×</span>
                            <span class="arrow"><i class="mdi mdi-chevron-down"></i></span>
                        </div>
                    </div>
                    <div class="custom-select-dropdown" id="diaDiemDropdown">
                        <div class="custom-select-search">
                            <input type="text" id="diaDiemSearch"
                                   placeholder="Tìm bưu cục..."
                                   oninput="filterDiaDiem(this.value)" />
                        </div>
                        <div class="custom-select-list" id="diaDiemList">
                            <div class="custom-select-group-label">Hà Nội</div>
                            <div class="custom-select-option" data-value="Bưu cục Hoàn Kiếm" onclick="selectDiaDiem(this)">Bưu cục Hoàn Kiếm</div>
                            <div class="custom-select-option" data-value="Bưu cục Cầu Giấy" onclick="selectDiaDiem(this)">Bưu cục Cầu Giấy</div>
                            <div class="custom-select-option" data-value="Bưu cục Đống Đa" onclick="selectDiaDiem(this)">Bưu cục Đống Đa</div>
                            <div class="custom-select-option" data-value="Bưu cục Hai Bà Trưng" onclick="selectDiaDiem(this)">Bưu cục Hai Bà Trưng</div>
                            <div class="custom-select-option" data-value="Bưu cục Thanh Xuân" onclick="selectDiaDiem(this)">Bưu cục Thanh Xuân</div>
                            <div class="custom-select-option" data-value="Bưu cục Long Biên" onclick="selectDiaDiem(this)">Bưu cục Long Biên</div>
                            <div class="custom-select-option" data-value="Bưu cục Hà Đông" onclick="selectDiaDiem(this)">Bưu cục Hà Đông</div>
                            <div class="custom-select-option" data-value="Bưu cục Gia Lâm" onclick="selectDiaDiem(this)">Bưu cục Gia Lâm</div>
                            <div class="custom-select-option" data-value="Bưu cục Hoàng Mai" onclick="selectDiaDiem(this)">Bưu cục Hoàng Mai</div>
                            <div class="custom-select-option" data-value="Bưu cục Tây Hồ" onclick="selectDiaDiem(this)">Bưu cục Tây Hồ</div>
                            <div class="custom-select-option" data-value="Bưu cục Bắc Từ Liêm" onclick="selectDiaDiem(this)">Bưu cục Bắc Từ Liêm</div>
                            <div class="custom-select-option" data-value="Bưu cục Nam Từ Liêm" onclick="selectDiaDiem(this)">Bưu cục Nam Từ Liêm</div>
                            <div class="custom-select-option" data-value="Trung tâm khai thác Hà Nội" onclick="selectDiaDiem(this)">Trung tâm khai thác Hà Nội</div>

                            <div class="custom-select-group-label">Hải Phòng</div>
                            <div class="custom-select-option" data-value="Bưu cục Hồng Bàng" onclick="selectDiaDiem(this)">Bưu cục Hồng Bàng</div>
                            <div class="custom-select-option" data-value="Bưu cục Ngô Quyền" onclick="selectDiaDiem(this)">Bưu cục Ngô Quyền</div>
                            <div class="custom-select-option" data-value="Bưu cục Lê Chân" onclick="selectDiaDiem(this)">Bưu cục Lê Chân</div>
                            <div class="custom-select-option" data-value="Bưu cục Kiến An" onclick="selectDiaDiem(this)">Bưu cục Kiến An</div>
                            <div class="custom-select-option" data-value="Bưu cục An Dương" onclick="selectDiaDiem(this)">Bưu cục An Dương</div>
                            <div class="custom-select-option" data-value="Bưu cục Thủy Nguyên" onclick="selectDiaDiem(this)">Bưu cục Thủy Nguyên</div>
                            <div class="custom-select-option" data-value="Trung tâm khai thác Hải Phòng" onclick="selectDiaDiem(this)">Trung tâm khai thác Hải Phòng</div>

                            <div class="custom-select-group-label">TP. Hồ Chí Minh</div>
                            <div class="custom-select-option" data-value="Bưu cục Quận 1" onclick="selectDiaDiem(this)">Bưu cục Quận 1</div>
                            <div class="custom-select-option" data-value="Bưu cục Quận 3" onclick="selectDiaDiem(this)">Bưu cục Quận 3</div>
                            <div class="custom-select-option" data-value="Bưu cục Quận 5" onclick="selectDiaDiem(this)">Bưu cục Quận 5</div>
                            <div class="custom-select-option" data-value="Bưu cục Quận 7" onclick="selectDiaDiem(this)">Bưu cục Quận 7</div>
                            <div class="custom-select-option" data-value="Bưu cục Bình Thạnh" onclick="selectDiaDiem(this)">Bưu cục Bình Thạnh</div>
                            <div class="custom-select-option" data-value="Bưu cục Tân Bình" onclick="selectDiaDiem(this)">Bưu cục Tân Bình</div>
                            <div class="custom-select-option" data-value="Bưu cục Gò Vấp" onclick="selectDiaDiem(this)">Bưu cục Gò Vấp</div>
                            <div class="custom-select-option" data-value="Bưu cục Thủ Đức" onclick="selectDiaDiem(this)">Bưu cục Thủ Đức</div>
                            <div class="custom-select-option" data-value="Trung tâm khai thác HCM" onclick="selectDiaDiem(this)">Trung tâm khai thác HCM</div>

                            <div class="custom-select-group-label">Đà Nẵng</div>
                            <div class="custom-select-option" data-value="Bưu cục Hải Châu" onclick="selectDiaDiem(this)">Bưu cục Hải Châu</div>
                            <div class="custom-select-option" data-value="Bưu cục Thanh Khê" onclick="selectDiaDiem(this)">Bưu cục Thanh Khê</div>
                            <div class="custom-select-option" data-value="Bưu cục Sơn Trà" onclick="selectDiaDiem(this)">Bưu cục Sơn Trà</div>
                            <div class="custom-select-option" data-value="Bưu cục Liên Chiểu" onclick="selectDiaDiem(this)">Bưu cục Liên Chiểu</div>
                            <div class="custom-select-option" data-value="Trung tâm khai thác Đà Nẵng" onclick="selectDiaDiem(this)">Trung tâm khai thác Đà Nẵng</div>

                            <div class="custom-select-group-label">Cần Thơ</div>
                            <div class="custom-select-option" data-value="Bưu cục Ninh Kiều" onclick="selectDiaDiem(this)">Bưu cục Ninh Kiều</div>
                            <div class="custom-select-option" data-value="Bưu cục Bình Thủy" onclick="selectDiaDiem(this)">Bưu cục Bình Thủy</div>
                            <div class="custom-select-option" data-value="Trung tâm khai thác Cần Thơ" onclick="selectDiaDiem(this)">Trung tâm khai thác Cần Thơ</div>
                        </div>
                    </div>
                </div>
                <span asp-validation-for="DiaDiemGiao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianDuKienVeBai" class="control-label"></label>
                <input asp-for="ThoiGianDuKienVeBai" class="form-control" type="datetime-local" />
                <span asp-validation-for="ThoiGianDuKienVeBai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianVeBai" class="control-label"></label>
                <input asp-for="ThoiGianVeBai" class="form-control" type="datetime-local" />
                <small class="text-muted">Thực tế xe về bãi.</small>
                <span asp-validation-for="ThoiGianVeBai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GhiChu" class="control-label"></label>
                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Trở về</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
                    // ---- DiaDiemGiao dropdown ----
        function toggleDiaDiem() {
            const trigger = document.querySelector('#diaDiemSelect .custom-select-trigger');
            const dropdown = document.getElementById('diaDiemDropdown');
            const isOpen = dropdown.classList.contains('open');
            if (isOpen) {
                closeDiaDiem();
            } else {
                trigger.classList.add('open');
                dropdown.classList.add('open');
                document.getElementById('diaDiemSearch').focus();
            }
        }

        function closeDiaDiem() {
            document.querySelector('#diaDiemSelect .custom-select-trigger').classList.remove('open');
            document.getElementById('diaDiemDropdown').classList.remove('open');
            document.getElementById('diaDiemSearch').value = '';
            filterDiaDiem('');
        }

        function selectDiaDiem(el) {
            const value = el.dataset.value;
            document.getElementById('hdDiaDiemGiao').value = value;
            document.getElementById('diaDiemLabel').textContent = value;
            document.getElementById('diaDiemLabel').classList.remove('placeholder');
            document.getElementById('diaDiemClearBtn').style.display = 'inline';
            document.querySelectorAll('#diaDiemList .custom-select-option')
                .forEach(o => o.classList.toggle('selected', o.dataset.value === value));
            closeDiaDiem();
        }

        function clearDiaDiem(e) {
            e.stopPropagation();
            document.getElementById('hdDiaDiemGiao').value = '';
            document.getElementById('diaDiemLabel').textContent = '— Chọn điểm giao —';
            document.getElementById('diaDiemLabel').classList.add('placeholder');
            document.getElementById('diaDiemClearBtn').style.display = 'none';
            document.querySelectorAll('#diaDiemList .custom-select-option')
                .forEach(o => o.classList.remove('selected'));
        }

        function filterDiaDiem(keyword) {
            const kw = keyword.toLowerCase();
            const options = document.querySelectorAll('#diaDiemList .custom-select-option');
            const groups = document.querySelectorAll('#diaDiemList .custom-select-group-label');
            let found = false;

            options.forEach(o => {
                const match = o.dataset.value.toLowerCase().includes(kw);
                o.style.display = match ? 'block' : 'none';
                if (match) found = true;
            });

            // Ẩn group label nếu không có option nào trong group hiển thị
            groups.forEach(g => {
                let next = g.nextElementSibling;
                let hasVisible = false;
                while (next && !next.classList.contains('custom-select-group-label')) {
                    if (next.style.display !== 'none') hasVisible = true;
                    next = next.nextElementSibling;
                }
                g.style.display = hasVisible ? 'block' : 'none';
            });

            const noResult = document.getElementById('diaDiemNoResult');
            if (!found) {
                if (!noResult) {
                    const div = document.createElement('div');
                    div.id = 'diaDiemNoResult';
                    div.className = 'custom-select-option no-result';
                    div.textContent = 'Không tìm thấy bưu cục';
                    document.getElementById('diaDiemList').appendChild(div);
                }
            } else {
                if (noResult) noResult.remove();
            }
        }

        // Đóng khi click ra ngoài
        document.addEventListener('click', function (e) {
            if (!document.getElementById('diaDiemSelect').contains(e.target)) {
                closeDiaDiem();
            }
        });

        // Preload giá trị khi Edit
        document.addEventListener('DOMContentLoaded', function () {
            const val = document.getElementById('hdDiaDiemGiao').value;
            if (val) {
                const opt = document.querySelector(`#diaDiemList .custom-select-option[data-value="${val}"]`);
                if (opt) selectDiaDiem(opt);
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
