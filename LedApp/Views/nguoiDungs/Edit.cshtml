@model LedApp.Models.nguoiDungs
@{
    ViewData["Title"] = "Sửa người dùng";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Sửa người dùng</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Image" />
            <div class="form-group mb-3">
                <label class="control-label">Ảnh đại diện</label>
                <div class="mb-2">
                    <img id="previewImage"
                         src="@(string.IsNullOrEmpty(Model.Image) ? "/uploads/avatars/default.png" : Model.Image)"
                         style="width:100px;height:100px;object-fit:cover;border:1px solid #ddd;" />
                </div>
                <input type="file" name="avatarFile" class="form-control" accept="image/*"
                       onchange="previewImg(this)" />
                <small class="text-muted">Để trống nếu không muốn đổi ảnh</small>
            </div>

            <div class="form-group">
                <label asp-for="Username" class="control-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <!-- Mật khẩu hiện tại -->
            <div class="form-group mt-2">
                <label class="control-label">Mật khẩu hiện tại</label>
                <div style="position:relative;">
                    <input type="password" id="currentPassword" class="form-control"
                           value="@Model.Password" readonly
                           style="background:#f8f9fa; padding-right:40px;" />
                    <i id="eyeCurrent" class="bi bi-eye-slash"
                       onclick="togglePwd('currentPassword', 'eyeCurrent')"
                       style="position:absolute; right:10px; top:50%; transform:translateY(-50%);
                  cursor:pointer; color:#6c757d; font-size:1.1rem;"></i>
                </div>
                <small class="text-muted">Mật khẩu hiện tại đang lưu trong hệ thống</small>
            </div>

            <!-- Mật khẩu mới -->
            <div class="form-group mt-2">
                <label asp-for="Password" class="control-label">Mật khẩu mới</label>
                <div style="position:relative;">
                    <input asp-for="Password" id="newPassword" class="form-control" type="password"
                           placeholder="Nhập mật khẩu mới nếu muốn đổi..."
                           style="padding-right:40px;" />
                    <i id="eyeNew" class="bi bi-eye-slash"
                       onclick="togglePwd('newPassword', 'eyeNew')"
                       style="position:absolute; right:10px; top:50%; transform:translateY(-50%);
                  cursor:pointer; color:#6c757d; font-size:1.1rem;"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
                <small class="text-muted">Để trống nếu không muốn đổi mật khẩu</small>
            </div>

            <div class="form-group mt-2">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tels" class="control-label"></label>
                <input asp-for="Tels" class="form-control" />
                <span asp-validation-for="Tels" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quyen" class="control-label"></label>
                <select asp-for="Quyen" class="form-control">
                    <option value="0">0 - Nhân viên</option>
                    <option value="1">1 - Quản lý</option>
                    <option value="2">2 - Admin</option>
                    <option value="3">3 - Tài xế</option>
                    <option value="4">4 - Bảo vệ</option>
                </select>
                <span asp-validation-for="Quyen" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu sửa" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Trở về</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewImg(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => document.getElementById('previewImage').src = e.target.result;
                reader.readAsDataURL(input.files[0]);
            }
        }

        function togglePwd(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}