@model LedApp.Models.nguoiDungs
@{
    ViewData["Title"] = "Sửa nhân viên";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Sửa nhân viên</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Image" />
            <input type="hidden" asp-for="UserId" />

            <div class="form-group mb-3">
                <label class="control-label">Ảnh đại diện</label>
                <div class="mb-1">
                    <div id="avatarPreviewWrapper"
                         style="width:150px;height:180px;border:2px dashed #dee2e6;border-radius:8px;
                                display:flex;align-items:center;justify-content:center;
                                background:#f8f9fa;overflow:hidden;cursor:pointer;"
                         onclick="document.querySelector('input[name=avatarFile]').click()">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img id="previewImage" src="@Model.Image" alt="Avatar"
                                 style="width:100%;height:100%;object-fit:cover;" />
                            <i id="defaultIcon" class="mdi mdi-account-circle"
                               style="font-size:80px;color:#adb5bd;display:none;"></i>
                        }
                        else
                        {
                            <img id="previewImage" src="" alt=""
                                 style="width:100%;height:100%;object-fit:cover;display:none;" />
                            <i id="defaultIcon" class="mdi mdi-account-circle"
                               style="font-size:80px;color:#adb5bd;"></i>
                        }
                    </div>
                    <small class="text-muted d-block mt-1">Click để đổi ảnh</small>
                </div>
                <input type="file" name="avatarFile" class="form-control d-none"
                       accept="image/*" onchange="previewImg(this)" />
            </div>

            <div class="row">
                <div class="col form-group mb-2">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col form-group mb-2">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-2">
                <label asp-for="NgaySinh" class="control-label"></label>
                <input asp-for="NgaySinh" class="form-control" type="date" />
                <span asp-validation-for="NgaySinh" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="SoDienThoai" class="control-label"></label>
                <input asp-for="SoDienThoai" class="form-control" placeholder="VD: 0912345678" />
                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="GioiTinh" class="control-label"></label>
                <select asp-for="GioiTinh" class="form-control"
                        asp-items="Html.GetEnumSelectList<LedApp.Models.GioiTinhEnum>()">
                    <option value="">-- Chọn giới tính --</option>
                </select>
                <span asp-validation-for="GioiTinh" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="DiaChi" class="control-label"></label>
                <input asp-for="DiaChi" class="form-control" />
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Trở về</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewImg(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('previewImage').src = e.target.result;
                    document.getElementById('previewImage').style.display = 'block';
                    document.getElementById('defaultIcon').style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}