@model LedApp.Models.nguoiDungs
@{
    ViewData["Title"] = "Sửa nhân viên";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    .page-wrapper > .container-fluid {
        padding: 0 !important;
    }

    .px-page {
        padding: 24px 24px 80px;
    }

    .px-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 12px;
        line-height: 1;
    }

        .px-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

            .px-breadcrumb a:hover {
                color: #111827;
            }

        .px-breadcrumb .sep {
            display: inline-flex;
            align-items: center;
            color: #9ca3af;
        }

            .px-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
                display: block;
            }

        .px-breadcrumb .cur {
            color: #111827;
            font-weight: 600;
        }

    .px-header {
        margin-bottom: 28px;
    }

        .px-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 4px;
            line-height: 1.2;
        }

        .px-header p {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

    .id-badge {
        display: inline-flex;
        align-items: center;
        background: #f3f4f6;
        color: #6b7280;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 999px;
        margin-left: 10px;
        vertical-align: middle;
    }

    .form-layout {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 20px;
        max-width: 820px;
        align-items: start;
    }

    @@media (max-width: 640px) {
        .form-layout {
            grid-template-columns: 1fr;
        }
    }

    .form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 28px 28px 24px;
    }

    .form-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 4px;
    }

    .form-card-sub {
        font-size: 0.82rem;
        color: #6b7280;
        margin: 0 0 24px;
    }

    .form-divider {
        border: none;
        border-top: 1px solid #f3f4f6;
        margin: 20px 0;
    }

    .avatar-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
    }

    .avatar-card-title {
        font-size: 0.82rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .avatar-card-sub {
        font-size: 0.75rem;
        color: #9ca3af;
        text-align: center;
        margin: 0;
    }

    .avatar-drop-zone {
        width: 130px;
        height: 155px;
        border: 2px dashed #e5e7eb;
        border-radius: 10px;
        background: #f9fafb;
        overflow: hidden;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color .15s, background .15s;
        position: relative;
    }

        .avatar-drop-zone:hover {
            border-color: #16a34a;
            background: #f0fdf4;
        }

        .avatar-drop-zone img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .avatar-drop-zone .av-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: #9ca3af;
            font-size: 0.75rem;
            text-align: center;
            padding: 12px;
        }

            .avatar-drop-zone .av-placeholder svg {
                width: 48px;
                height: 48px;
                opacity: .3;
            }

    .btn-pick-avatar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        color: #374151;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 7px 16px;
        border-radius: 7px;
        cursor: pointer;
        transition: all .15s;
        white-space: nowrap;
    }

        .btn-pick-avatar:hover {
            background: #e5e7eb;
            border-color: #d1d5db;
        }

        .btn-pick-avatar svg {
            width: 13px;
            height: 13px;
        }

    .field-group {
        margin-bottom: 20px;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    @@media (max-width: 500px) {
        .field-row {
            grid-template-columns: 1fr;
        }
    }

    .field-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .field-input {
        width: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #111827;
        font-size: 0.875rem;
        padding: 10px 14px;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        box-sizing: border-box;
    }

        .field-input::placeholder {
            color: #9ca3af;
        }

        .field-input:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 3px rgba(22,163,74,.1);
        }

    select.field-input {
        appearance: auto;
    }

    .field-error {
        font-size: 0.78rem;
        color: #ef4444;
        margin-top: 4px;
    }

    .val-summary {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 0.82rem;
        color: #dc2626;
        display: none;
    }

        .val-summary ul {
            margin: 0;
            padding-left: 16px;
        }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #16a34a;
        color: #fff;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 10px 22px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: background .15s;
        white-space: nowrap;
    }

        .btn-submit:hover {
            background: #15803d;
        }

        .btn-submit svg {
            width: 15px;
            height: 15px;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        background: #fff;
        color: #374151;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 10px 20px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s;
        white-space: nowrap;
    }

        .btn-cancel:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
            text-decoration: none;
        }

    /* Dark mode */
    body.dark-mode .px-header h1 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .px-header p {
        color: #9ca3af !important;
    }

    body.dark-mode .px-breadcrumb, body.dark-mode .px-breadcrumb a {
        color: #9ca3af !important;
    }

    body.dark-mode .id-badge {
        background: #2e3248 !important;
        color: #9ca3af !important;
    }

    body.dark-mode .form-card, body.dark-mode .avatar-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .form-card-title, body.dark-mode .avatar-card-title {
        color: #e2e8f0 !important;
    }

    body.dark-mode .form-card-sub, body.dark-mode .avatar-card-sub {
        color: #9ca3af !important;
    }

    body.dark-mode .form-divider {
        border-color: #2e3248 !important;
    }

    body.dark-mode .field-label {
        color: #d1d5db !important;
    }

    body.dark-mode .field-input {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .avatar-drop-zone {
        background: #22263a !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .btn-pick-avatar {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #d1d5db !important;
    }

    body.dark-mode .btn-cancel {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #d1d5db !important;
    }

        body.dark-mode .btn-cancel:hover {
            background: #2e3248 !important;
        }
</style>

<div class="px-page">
    <div class="px-breadcrumb">
        <a href="/">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <a asp-action="Index">Nhân viên</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">Sửa</span>
    </div>

    <div class="px-header">
        <h1>
            Sửa nhân viên
            <span class="id-badge">#@Model.Id.ToString("D3")</span>
        </h1>
        <p>Cập nhật thông tin hồ sơ nhân viên.</p>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div class="form-layout">

            <!-- Cột trái: Avatar -->
            <div class="avatar-card">
                <p class="avatar-card-title">Ảnh đại diện</p>
                <div class="avatar-drop-zone" id="avatarDropZone" onclick="document.getElementById('avatarFileInput').click()">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img id="previewImage" src="@Model.Image" alt="Avatar" />
                        <div class="av-placeholder" id="avPlaceholder" style="display:none;">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
                            <span>Click để chọn ảnh</span>
                        </div>
                    }
                    else
                    {
                        <img id="previewImage" src="" alt="" style="display:none;" />
                        <div class="av-placeholder" id="avPlaceholder">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
                            <span>Click để chọn ảnh</span>
                        </div>
                    }
                </div>
                <input type="file" id="avatarFileInput" name="avatarFile" accept="image/*" style="display:none;" />
                <button type="button" class="btn-pick-avatar" onclick="document.getElementById('avatarFileInput').click()">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
                    Đổi ảnh
                </button>
                <p class="avatar-card-sub">JPG, PNG tối đa 5MB.<br />Để trống nếu không đổi ảnh.</p>
            </div>

            <!-- Cột phải: Form -->
            <div class="form-card">
                <p class="form-card-title">Thông tin nhân viên</p>
                <p class="form-card-sub">Chỉnh sửa các trường bên dưới và lưu để cập nhật.</p>

                <div asp-validation-summary="ModelOnly" class="val-summary"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Image" />
                <input type="hidden" asp-for="UserId" />

                <div class="field-row">
                    <div>
                        <label class="field-label" asp-for="LastName">Họ</label>
                        <input asp-for="LastName" class="field-input" />
                        <span asp-validation-for="LastName" class="field-error"></span>
                    </div>
                    <div>
                        <label class="field-label" asp-for="FirstName">Tên</label>
                        <input asp-for="FirstName" class="field-input" />
                        <span asp-validation-for="FirstName" class="field-error"></span>
                    </div>
                </div>

                <div class="field-row">
                    <div>
                        <label class="field-label" asp-for="NgaySinh">Ngày sinh</label>
                        <input asp-for="NgaySinh" class="field-input" type="date" />
                        <span asp-validation-for="NgaySinh" class="field-error"></span>
                    </div>
                    <div>
                        <label class="field-label" asp-for="GioiTinh">Giới tính</label>
                        <select asp-for="GioiTinh" class="field-input"
                                asp-items="Html.GetEnumSelectList<LedApp.Models.GioiTinhEnum>()">
                            <option value="">-- Chọn giới tính --</option>
                        </select>
                        <span asp-validation-for="GioiTinh" class="field-error"></span>
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" asp-for="SoDienThoai">Số điện thoại</label>
                    <input asp-for="SoDienThoai" class="field-input" placeholder="VD: 0912 345 678" />
                    <span asp-validation-for="SoDienThoai" class="field-error"></span>
                </div>

                <div class="field-group" style="margin-bottom:0;">
                    <label class="field-label" asp-for="DiaChi">Địa chỉ</label>
                    <input asp-for="DiaChi" class="field-input" />
                    <span asp-validation-for="DiaChi" class="field-error"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-submit">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" /></svg>
                        Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn-cancel">Hủy</a>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const vs = document.querySelector('.val-summary');
        if (vs && vs.innerText.trim().length > 0) vs.style.display = 'block';

        document.getElementById('avatarFileInput').addEventListener('change', function () {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    const img = document.getElementById('previewImage');
                    const placeholder = document.getElementById('avPlaceholder');
                    img.src = e.target.result;
                    img.style.display = 'block';
                    placeholder.style.display = 'none';
                };
                reader.readAsDataURL(this.files[0]);
            }
        });
    </script>
}
