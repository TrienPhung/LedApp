@model LedApp.Models.nguoiDungs
@{
    ViewData["Title"] = "Chi tiết nhân viên";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Chi tiết nhân viên</h1>
<hr />
<div class="row">
    <div class="col-md-2 text-center mb-3">
        <img src="@(string.IsNullOrEmpty(Model.Image) ? "/uploads/avatars/default.png" : Model.Image)"
             style="width:100px;height:100px;object-fit:cover;border:1px solid #ddd;border-radius:6px;" />
    </div>
    <div class="col-md-10">
        <dl class="row">
            <dt class="col-sm-3">Họ tên</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NgaySinh)</dt>
            <dd class="col-sm-9">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.SoDienThoai)</dt>
            <dd class="col-sm-9">@(Model.SoDienThoai ?? "—")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.GioiTinh)</dt>
            <dd class="col-sm-9">
                @switch (Model.GioiTinh)
                {
                    case LedApp.Models.GioiTinhEnum.Nam:
                        <span class="badge bg-primary">Nam</span>
                        break;
                    case LedApp.Models.GioiTinhEnum.Nu:
                        <span class="badge bg-danger">Nữ</span>
                        break;
                    case LedApp.Models.GioiTinhEnum.Khac:
                        <span class="badge bg-secondary">Khác</span>
                        break;
                    default:
                        <span>—</span>
                        break;
                }
            </dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DiaChi)</dt>
            <dd class="col-sm-9">@(Model.DiaChi ?? "—")</dd>

            <dt class="col-sm-3">Tài khoản</dt>
            <dd class="col-sm-9">
                @if (Model.User != null)
                {
                    <span class="badge bg-success">@Model.User.UserName</span>
                    <small class="text-muted ms-2">@Model.User.Email</small>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Chưa có tài khoản</span>
                }
            </dd>
        </dl>
    </div>
</div>
<hr />
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Sửa</a>
<a asp-action="Index" class="btn btn-secondary btn-sm ms-2">Trở về</a>