@model LedApp.Models.nguoiDungs
@{
    ViewData["Title"] = "Xóa nhân viên";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Xóa nhân viên</h1>
<h3 class="text-danger">Bạn có chắc chắn muốn xóa không?</h3>
<hr />
<div class="row">
    <div class="col-md-2 text-center mb-3">
        <img src="@(string.IsNullOrEmpty(Model.Image) ? "/uploads/avatars/default.png" : Model.Image)"
             style="width:100px;height:100px;object-fit:cover;border:1px solid #ddd;border-radius:6px;" />
    </div>
    <div class="col-md-10">
        <dl class="row">
            <dt class="col-sm-3">Họ tên</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NgaySinh)</dt>
            <dd class="col-sm-9">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.GioiTinh)</dt>
            <dd class="col-sm-9">@Model.GioiTinh</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DiaChi)</dt>
            <dd class="col-sm-9">@(Model.DiaChi ?? "—")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.SoDienThoai)</dt>
            <dd class="col-sm-9">@(Model.SoDienThoai ?? "—")</dd>
            <dt class="col-sm-3">Tài khoản liên kết</dt>
            <dd class="col-sm-9">
                @if (Model.User != null)
                {
                    <span class="badge bg-danger">⚠ Đang có tài khoản: @Model.User.UserName — Hãy xóa tài khoản trước!</span>
                }
                else
                {
                    <span class="text-muted">Không có</span>
                }
            </dd>
        </dl>
    </div>
</div>
<hr />
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Xác nhận xóa" class="btn btn-danger"
    @(Model.User != null ? "disabled" : "") />
    <a asp-action="Index" class="btn btn-secondary ms-2">Trở về</a>
</form>