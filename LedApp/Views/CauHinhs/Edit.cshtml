@model LedApp.Models.CauHinh
@{
    ViewData["Title"] = "Sửa cấu hình #" + Model.Id;
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    :root {
        --ap-bg: #f9fafb;
        --ap-surface: #ffffff;
        --ap-border: #e5e7eb;
        --ap-border-lt: #f3f4f6;
        --ap-text-1: #111827;
        --ap-text-2: #6b7280;
        --ap-text-3: #9ca3af;
        --ap-green: #16a34a;
        --ap-green-dark: #15803d;
        --ap-red: #dc2626;
        --ap-radius: 12px;
        --ap-shadow: 0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
    }

    body.dark-mode {
        --ap-bg: #0f172a;
        --ap-surface: #1e293b;
        --ap-border: #334155;
        --ap-border-lt: #1e293b;
        --ap-text-1: #f1f5f9;
        --ap-text-2: #94a3b8;
        --ap-text-3: #64748b;
    }

    .ed-wrap {
        padding: 0 0 40px;
    }

    .ed-bc {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--ap-text-2);
        margin-bottom: 14px;
    }

        .ed-bc a {
            color: var(--ap-text-2);
            text-decoration: none;
        }

            .ed-bc a:hover {
                color: var(--ap-text-1);
            }

        .ed-bc .sep {
            color: var(--ap-text-3);
            display: flex;
            align-items: center;
        }

            .ed-bc .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
            }

        .ed-bc .cur {
            color: var(--ap-text-1);
            font-weight: 600;
        }

    .ed-header {
        margin-bottom: 24px;
    }

        .ed-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--ap-text-1);
            margin: 0 0 4px;
            letter-spacing: -.3px;
        }

        .ed-header p {
            font-size: 13px;
            color: var(--ap-text-2);
            margin: 0;
        }

    .ed-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 16px;
        align-items: start;
    }

    @@media (max-width: 860px) {
        .ed-grid {
            grid-template-columns: 1fr;
        }
    }

    .ap-panel {
        background: var(--ap-surface);
        border: 1px solid var(--ap-border);
        border-radius: var(--ap-radius);
        box-shadow: var(--ap-shadow);
        overflow: hidden;
        margin-bottom: 16px;
    }

        .ap-panel:last-child {
            margin-bottom: 0;
        }

    .ap-panel-head {
        padding: 16px 20px;
        border-bottom: 1px solid var(--ap-border-lt);
    }

    .ap-panel-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--ap-text-1);
        margin: 0 0 2px;
    }

    .ap-panel-sub {
        font-size: 12px;
        color: var(--ap-text-2);
        margin: 0;
    }

    .ap-panel-body {
        padding: 20px;
    }

    .f-group {
        margin-bottom: 18px;
    }

        .f-group:last-child {
            margin-bottom: 0;
        }

    .f-label {
        display: block;
        font-size: 13px;
        font-weight: 500;
        color: var(--ap-text-1);
        margin-bottom: 6px;
    }

    .f-input {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid var(--ap-border);
        border-radius: 8px;
        background: var(--ap-surface);
        color: var(--ap-text-1);
        font-size: 13.5px;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        box-sizing: border-box;
        font-family: inherit;
    }

        .f-input:focus {
            border-color: var(--ap-green);
            box-shadow: 0 0 0 3px rgba(22,163,74,.12);
        }

        .f-input::placeholder {
            color: var(--ap-text-3);
        }

    .f-hint {
        font-size: 11.5px;
        color: var(--ap-text-3);
        margin-top: 4px;
    }

    .f-error {
        font-size: 12px;
        color: var(--ap-red);
        margin-top: 4px;
    }

    .f-mono {
        font-family: 'Courier New', monospace;
        font-size: 13px;
    }

    .meta-box {
        padding: 14px 16px;
        border-radius: 8px;
        background: var(--ap-border-lt);
        border: 1px solid var(--ap-border);
        margin-bottom: 0;
    }

    .meta-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--ap-text-3);
        margin-bottom: 4px;
    }

    .meta-value {
        font-size: 13px;
        font-weight: 600;
        color: var(--ap-text-1);
        font-family: monospace;
    }

    .btn-save {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: 11px 16px;
        background: var(--ap-green);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
        margin-bottom: 8px;
        font-family: inherit;
    }

        .btn-save:hover {
            background: var(--ap-green-dark);
        }

        .btn-save svg {
            width: 15px;
            height: 15px;
        }

    .btn-cancel-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 10px 16px;
        border: 1px solid var(--ap-border);
        border-radius: 8px;
        background: var(--ap-surface);
        color: var(--ap-text-2);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: all .15s;
        box-sizing: border-box;
    }

        .btn-cancel-link:hover {
            background: var(--ap-border-lt);
            color: var(--ap-text-1);
            text-decoration: none;
        }

    body.dark-mode .ap-panel {
        background: var(--ap-surface) !important;
        border-color: var(--ap-border) !important;
    }

    body.dark-mode .f-input {
        background: var(--ap-surface) !important;
        border-color: var(--ap-border) !important;
        color: var(--ap-text-1) !important;
    }

    body.dark-mode .btn-cancel-link {
        background: var(--ap-surface) !important;
        border-color: var(--ap-border) !important;
        color: var(--ap-text-2) !important;
    }

        body.dark-mode .btn-cancel-link:hover {
            background: rgba(255,255,255,.05) !important;
        }

    body.dark-mode .meta-box {
        background: rgba(255,255,255,.04) !important;
        border-color: var(--ap-border) !important;
    }
</style>

<div class="ed-wrap">

    <!-- Breadcrumb -->
    <div class="ed-bc">
        <a href="/Dashboard">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <a asp-controller="CauHinhs" asp-action="Index">Cấu hình hệ thống</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <a asp-action="Details" asp-route-id="@Model.Id">Cấu hình #@Model.Id</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">Edit</span>
    </div>

    <!-- Header -->
    <div class="ed-header">
        <h1>Sửa cấu hình #@Model.Id</h1>
        <p>Cập nhật thông tin cấu hình bên dưới.</p>
    </div>

    <form asp-action="Edit" id="editForm">
        <div asp-validation-summary="ModelOnly" class="f-error" style="margin-bottom:16px;padding:12px 16px;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;"></div>
        <input type="hidden" asp-for="Id" />

        <div class="ed-grid">
            <!-- LEFT -->
            <div>
                <div class="ap-panel">
                    <div class="ap-panel-head">
                        <div class="ap-panel-title">Thông tin cấu hình</div>
                        <div class="ap-panel-sub">Cập nhật key và value rồi lưu thay đổi.</div>
                    </div>
                    <div class="ap-panel-body">
                        <div class="f-group">
                            <label class="f-label">Key</label>
                            <input asp-for="Key" class="f-input f-mono" placeholder="VD: ThoiGianGioiHanNhap" />
                            <div class="f-hint">Tên định danh duy nhất cho tham số cấu hình.</div>
                            <span asp-validation-for="Key" class="f-error"></span>
                        </div>
                        <div class="f-group" style="margin-bottom:0;">
                            <label class="f-label">Value</label>
                            <input asp-for="Value" class="f-input" placeholder="VD: 40" />
                            <div class="f-hint">Giá trị của tham số cấu hình.</div>
                            <span asp-validation-for="Value" class="f-error"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div>
                <!-- Meta -->
                <div class="ap-panel">
                    <div class="ap-panel-head"><div class="ap-panel-title">Thông tin bản ghi</div></div>
                    <div class="ap-panel-body">
                        <div class="meta-box">
                            <div class="meta-label">Mã cấu hình</div>
                            <div class="meta-value">#@Model.Id</div>
                        </div>
                    </div>
                </div>

                <!-- Save/Cancel -->
                <div class="ap-panel">
                    <div class="ap-panel-body">
                        <button type="submit" class="btn-save">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" /></svg>
                            Save Changes
                        </button>
                        <a asp-action="Index" class="btn-cancel-link">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
