@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Bảo vệ — Cổng xuất kho</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;600;700;900&display=swap');

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #03060d;
            --surface: #070d1a;
            --surface2: #0a1220;
            --surface3: #0d1828;
            --border: #0e2040;
            --border2: #1a3560;
            --green: #00e676;
            --green2: #69ffb0;
            --gold: #f5a623;
            --gold2: #ffd07a;
            --red: #ff3d3d;
            --blue: #00b4ff;
            --cyan: #00e5ff;
            --purple: #b388ff;
            --orange: #ff9800;
            --text: #a0b8d0;
            --text2: #3a5f80;
            --text3: #1e3a55;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Barlow', sans-serif;
            min-height: 100vh;
            overflow: hidden;
        }

            body::after {
                content: '';
                position: fixed;
                inset: 0;
                background: repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,180,255,.008) 3px,rgba(0,180,255,.008) 4px);
                pointer-events: none;
                z-index: 999;
            }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background-image: linear-gradient(rgba(0,180,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(0,180,255,.04) 1px,transparent 1px);
                background-size: 60px 60px;
                pointer-events: none;
                z-index: 0;
            }

        .screen {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-rows: 72px 1fr 56px;
            height: 100vh;
            padding: 14px;
            gap: 12px;
        }

        /* TOPBAR */
        .topbar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            background: var(--surface);
            border: 1px solid var(--border2);
            border-top: 2px solid var(--green);
            border-radius: 8px;
            padding: 0 24px;
        }

        .tb-brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .tb-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg,#003a1a,#006633);
            border: 1px solid var(--green);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 0 16px rgba(0,230,118,.25);
        }

        .tb-title {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 4px;
            color: var(--green);
            text-transform: uppercase;
        }

        .tb-sub {
            font-size: 9px;
            color: var(--text2);
            letter-spacing: 2px;
            margin-top: 2px;
        }

        .tb-clock {
            text-align: center;
            font-family: 'Share Tech Mono',monospace;
            font-size: 32px;
            color: var(--cyan);
            letter-spacing: 6px;
            text-shadow: 0 0 20px rgba(0,229,255,.4);
        }

        .tb-date {
            font-size: 9px;
            color: var(--text2);
            text-align: center;
            letter-spacing: 2px;
            margin-top: 3px;
        }

        .tb-right {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px;
        }

        .conn-badge {
            display: flex;
            align-items: center;
            gap: 7px;
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 10px;
            color: var(--text2);
            letter-spacing: 1px;
        }

        .conn-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--text3);
            flex-shrink: 0;
        }

            .conn-dot.on {
                background: var(--green);
                box-shadow: 0 0 8px var(--green);
                animation: pulse 2s infinite;
            }

            .conn-dot.err {
                background: var(--red);
            }

        .stat-chip {
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: 6px;
            padding: 6px 14px;
            text-align: center;
        }

            .stat-chip .n {
                font-size: 20px;
                font-weight: 700;
                font-family: 'Share Tech Mono',monospace;
            }

            .stat-chip .l {
                font-size: 8px;
                color: var(--text2);
                letter-spacing: 1px;
                text-transform: uppercase;
                margin-top: 1px;
            }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: .3
            }
        }

        /* TABS */
        .main {
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 0;
        }

        .tabs {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }

        .tab-btn {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 6px 6px 0 0;
            padding: 9px 22px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            color: var(--text2);
            transition: all .15s;
            border-bottom: 2px solid transparent;
        }

            .tab-btn:hover {
                color: var(--text);
                background: var(--surface2);
            }

            .tab-btn.active-ra {
                color: var(--green);
                border-color: var(--border2);
                border-bottom-color: var(--green);
                background: var(--surface2);
            }

            .tab-btn.active-ve {
                color: var(--orange);
                border-color: var(--border2);
                border-bottom-color: var(--orange);
                background: var(--surface2);
            }

        .tab-content {
            display: none;
            flex: 1;
            min-height: 0;
        }

            .tab-content.active {
                display: grid;
                grid-template-columns: 420px 1fr;
                gap: 12px;
            }

        /* PANELS */
        .list-panel {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 0 8px 8px 8px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .list-header {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }

        .list-title {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

            .list-title.green {
                color: var(--green);
            }

            .list-title.orange {
                color: var(--orange);
            }

        .list-count {
            font-family: 'Share Tech Mono',monospace;
            font-size: 11px;
            color: var(--text2);
        }

        .list-body {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
        }

            .list-body::-webkit-scrollbar {
                width: 4px;
            }

            .list-body::-webkit-scrollbar-thumb {
                background: var(--border2);
                border-radius: 2px;
            }

        /* XE ITEMS */
        .xe-item {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-left: 3px solid var(--border2);
            border-radius: 7px;
            padding: 14px 16px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all .15s;
            position: relative;
            overflow: hidden;
        }

            .xe-item::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg,rgba(0,230,118,.04),transparent);
                opacity: 0;
                transition: opacity .15s;
            }

            .xe-item.type-ve::before {
                background: linear-gradient(90deg,rgba(255,152,0,.04),transparent);
            }

            .xe-item:hover {
                border-left-color: var(--green);
            }

            .xe-item.type-ve:hover {
                border-left-color: var(--orange);
            }

            .xe-item:hover::before, .xe-item.selected::before {
                opacity: 1;
            }

            .xe-item.selected {
                border-color: var(--green);
                border-left-color: var(--green);
                background: var(--surface3);
                box-shadow: 0 0 20px rgba(0,230,118,.12);
            }

            .xe-item.type-ve.selected {
                border-color: var(--orange);
                border-left-color: var(--orange);
                box-shadow: 0 0 20px rgba(255,152,0,.12);
            }

        .xe-item-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .xe-bienso {
            font-family: 'Share Tech Mono',monospace;
            font-size: 20px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 3px;
        }

        .xe-cua-badge {
            background: rgba(0,230,118,.1);
            border: 1px solid rgba(0,230,118,.3);
            border-radius: 4px;
            padding: 3px 10px;
            font-size: 11px;
            font-weight: 700;
            color: var(--green);
            letter-spacing: 1px;
        }

            .xe-cua-badge.orange {
                background: rgba(255,152,0,.1);
                border-color: rgba(255,152,0,.3);
                color: var(--orange);
            }

        .xe-item-meta {
            font-size: 11px;
            color: var(--text2);
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

            .xe-item-meta span {
                color: var(--text);
            }

        .xe-item-hang {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .hang-chip {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 10px;
            color: var(--gold2);
            font-family: 'Share Tech Mono',monospace;
        }

        .xe-item-time {
            font-size: 10px;
            color: var(--text2);
            margin-top: 8px;
            font-family: 'Share Tech Mono',monospace;
        }

        .xe-empty {
            text-align: center;
            padding: 60px 20px;
            color: var(--text3);
        }

        .xe-empty-icon {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .xe-empty-text {
            font-size: 12px;
            letter-spacing: 2px;
        }

        /* DETAIL PANEL */
        .detail-panel {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .detail-header {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }

        .detail-title {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--text2);
        }

        .detail-body {
            flex: 1;
            padding: 24px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .detail-placeholder {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            color: var(--text3);
        }

        .placeholder-icon {
            font-size: 64px;
            opacity: .4;
        }

        .placeholder-text {
            font-size: 11px;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .placeholder-arrow {
            font-size: 28px;
            color: var(--border2);
            animation: arrow-pulse 2s ease-in-out infinite;
        }

        @@keyframes arrow-pulse {
            0%, 100% {
                transform: translateX(0);
                opacity: .5
            }

            50% {
                transform: translateX(-10px);
                opacity: 1
            }
        }

        .detail-bienso {
            font-family: 'Share Tech Mono',monospace;
            font-size: 52px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 8px;
            text-shadow: 0 0 40px rgba(245,166,35,.4);
            text-align: center;
            padding: 16px 0;
            border-bottom: 1px solid var(--border2);
        }

        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .detail-field {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 12px 16px;
        }

        .detail-field-label {
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text2);
            margin-bottom: 5px;
        }

        .detail-field-value {
            font-size: 15px;
            font-weight: 600;
            color: var(--text);
        }

            .detail-field-value.accent {
                color: var(--cyan);
                font-family: 'Share Tech Mono',monospace;
            }

            .detail-field-value.gold {
                color: var(--gold);
            }

            .detail-field-value.green {
                color: var(--green);
            }

            .detail-field-value.orange {
                color: var(--orange);
            }

        .hang-table-wrap {
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: 6px;
            overflow: hidden;
        }

        .hang-table-title {
            padding: 10px 14px;
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text2);
            border-bottom: 1px solid var(--border);
        }

        .hang-table {
            width: 100%;
            border-collapse: collapse;
        }

            .hang-table th {
                padding: 8px 14px;
                font-size: 9px;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: var(--text2);
                border-bottom: 1px solid var(--border);
                text-align: left;
                font-weight: 400;
            }

            .hang-table td {
                padding: 10px 14px;
                font-size: 14px;
                font-weight: 600;
                border-bottom: 1px solid var(--border);
                font-family: 'Share Tech Mono',monospace;
            }

            .hang-table tr:last-child td {
                border-bottom: none;
            }

            .hang-table td:first-child {
                color: var(--text2);
                font-family: 'Barlow',sans-serif;
                font-size: 12px;
                font-weight: 400;
            }

            .hang-table .da {
                color: var(--green);
            }

            .hang-table .chua {
                color: var(--gold2);
            }

        .dukien-section {
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: 6px;
            padding: 16px 18px;
        }

        .dukien-label {
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text2);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .dukien-label::after {
                content: 'tùy chọn';
                font-size: 8px;
                background: var(--border2);
                color: var(--text2);
                padding: 1px 6px;
                border-radius: 3px;
                letter-spacing: 1px;
            }

        .dukien-input {
            background: var(--bg);
            border: 1px solid var(--border2);
            border-radius: 5px;
            padding: 10px 14px;
            color: var(--gold);
            font-size: 18px;
            font-family: 'Share Tech Mono',monospace;
            letter-spacing: 3px;
            width: 100%;
            outline: none;
            transition: border-color .15s;
        }

            .dukien-input:focus {
                border-color: var(--gold);
                box-shadow: 0 0 12px rgba(245,166,35,.15);
            }

        .dukien-label.required::after {
            content: 'bắt buộc';
            background: rgba(255,152,0,.2);
            color: var(--orange);
        }

        .btn-action {
            border-radius: 8px;
            padding: 18px;
            width: 100%;
            font-family: 'Barlow',sans-serif;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all .2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 1px solid;
        }

        .btn-green {
            background: linear-gradient(135deg,#003a1a,#006633);
            border-color: var(--green);
            color: var(--green);
            box-shadow: 0 0 20px rgba(0,230,118,.15);
        }

            .btn-green:hover:not(:disabled) {
                background: linear-gradient(135deg,#005a28,#009944);
                box-shadow: 0 0 35px rgba(0,230,118,.35);
                transform: translateY(-1px);
            }

        .btn-orange {
            background: linear-gradient(135deg,#3a1f00,#663300);
            border-color: var(--orange);
            color: var(--orange);
            box-shadow: 0 0 20px rgba(255,152,0,.15);
        }

            .btn-orange:hover:not(:disabled) {
                background: linear-gradient(135deg,#5a3000,#995500);
                box-shadow: 0 0 35px rgba(255,152,0,.35);
                transform: translateY(-1px);
            }

        .btn-action:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-action:disabled {
            background: var(--surface2);
            border-color: var(--border2);
            color: var(--text3);
            cursor: not-allowed;
            box-shadow: none;
        }

        .btn-icon {
            font-size: 20px;
        }

        /* FOOTER */
        .footer {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 6px;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 10px;
            color: var(--text2);
            letter-spacing: 1px;
        }

        .footer-log {
            display: flex;
            gap: 16px;
            align-items: center;
            font-family: 'Share Tech Mono',monospace;
        }

        .log-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .log-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--green);
        }
    </style>
</head>
<body>
    <div class="screen">

        <!-- TOPBAR -->
        <div class="topbar">
            <div class="tb-brand">
                <div class="tb-icon">🛡️</div>
                <div>
                    <div class="tb-title">Bảo vệ cổng xuất</div>
                    <div class="tb-sub">Security Gate — Outbound Verification</div>
                </div>
            </div>
            <div>
                <div class="tb-clock" id="clock">--:--:--</div>
                <div class="tb-date" id="date-str"></div>
            </div>
            <div class="tb-right">
                <div class="stat-chip">
                    <div class="n" id="stat-cho" style="color:var(--gold);">0</div>
                    <div class="l">Chờ ra cổng</div>
                </div>
                <div class="stat-chip">
                    <div class="n" id="stat-van" style="color:var(--orange);">0</div>
                    <div class="l">Đang vận chuyển</div>
                </div>
                <div class="stat-chip">
                    <div class="n" id="stat-da" style="color:var(--green);">0</div>
                    <div class="l">Đã về bãi</div>
                </div>
                <div class="conn-badge">
                    <span class="conn-dot" id="conn-dot"></span>
                    <span id="conn-text">Kết nối...</span>
                </div>
            </div>
        </div>

        <!-- MAIN -->
        <div class="main">
            <!-- TABS -->
            <div class="tabs">
                <button class="tab-btn active-ra" id="tab-ra" onclick="switchTab('ra')">
                    ✔ Xe ra cổng
                    <span id="tab-ra-count" style="margin-left:6px;background:rgba(0,230,118,.15);border:1px solid rgba(0,230,118,.3);border-radius:10px;padding:1px 8px;font-size:10px;color:var(--green);">0</span>
                </button>
                <button class="tab-btn" id="tab-ve" onclick="switchTab('ve')">
                    🔄 Xe về bãi
                    <span id="tab-ve-count" style="margin-left:6px;background:rgba(255,152,0,.15);border:1px solid rgba(255,152,0,.3);border-radius:10px;padding:1px 8px;font-size:10px;color:var(--orange);">0</span>
                </button>
            </div>

            <!-- TAB RA CỔNG -->
            <div class="tab-content active" id="content-ra">
                <div class="list-panel">
                    <div class="list-header">
                        <span class="list-title green">Xe chờ ra cổng</span>
                        <span class="list-count" id="list-ra-count">0 xe</span>
                    </div>
                    <div class="list-body" id="list-ra-body">
                        <div class="xe-empty"><div class="xe-empty-icon">🚛</div><div class="xe-empty-text">Đang tải...</div></div>
                    </div>
                </div>
                <div class="detail-panel">
                    <div class="detail-header">
                        <span class="detail-title">Chi tiết xe được chọn</span>
                        <span id="detail-ra-status" style="font-size:10px;color:var(--text2);letter-spacing:1px;">— Chọn xe từ danh sách —</span>
                    </div>
                    <div class="detail-placeholder" id="detail-ra-placeholder">
                        <div class="placeholder-icon">🔍</div>
                        <div class="placeholder-arrow">←</div>
                        <div class="placeholder-text">Chọn xe để xem chi tiết</div>
                    </div>
                    <div class="detail-body" id="detail-ra-body" style="display:none;">
                        <div class="detail-bienso" id="ra-bienso">--</div>
                        <div class="detail-grid">
                            <div class="detail-field"><div class="detail-field-label">Cửa xuất</div><div class="detail-field-value accent" id="ra-cua">--</div></div>
                            <div class="detail-field"><div class="detail-field-label">Loại xe</div><div class="detail-field-value" id="ra-loai">--</div></div>
                            <div class="detail-field"><div class="detail-field-label">Tài xế</div><div class="detail-field-value gold" id="ra-taixe">--</div></div>
                            <div class="detail-field"><div class="detail-field-label">SĐT tài xế</div><div class="detail-field-value accent" id="ra-tel">--</div></div>
                            <div class="detail-field"><div class="detail-field-label">Giờ vào cửa</div><div class="detail-field-value accent" id="ra-giovao">--:--</div></div>
                            <div class="detail-field"><div class="detail-field-label">Giờ hoàn thành BG</div><div class="detail-field-value green" id="ra-hoanthanh">--:--</div></div>
                        </div>
                        <div class="hang-table-wrap">
                            <div class="hang-table-title">Hàng hóa xuất</div>
                            <table class="hang-table">
                                <thead><tr><th>Đơn vị</th><th>Chưa BG</th><th>Đã BG</th></tr></thead>
                                <tbody id="ra-hang"></tbody>
                            </table>
                        </div>
                        <div class="dukien-section">
                            <div class="dukien-label">Thời gian dự kiến xe về bãi</div>
                            <input type="datetime-local" class="dukien-input" id="inp-dukien-ra" />
                        </div>
                        <button class="btn-action btn-green" id="btn-ra" onclick="xacNhanRaCong()">
                            <span class="btn-icon">✔</span> Xác nhận cho xe ra cổng
                        </button>
                    </div>
                </div>
            </div>

            <!-- TAB VỀ BÃI -->
            <div class="tab-content" id="content-ve">
                <div class="list-panel">
                    <div class="list-header">
                        <span class="list-title orange">Xe đang vận chuyển</span>
                        <span class="list-count" id="list-ve-count">0 xe</span>
                    </div>
                    <div class="list-body" id="list-ve-body">
                        <div class="xe-empty"><div class="xe-empty-icon">🚛</div><div class="xe-empty-text">Đang tải...</div></div>
                    </div>
                </div>
                <div class="detail-panel">
                    <div class="detail-header">
                        <span class="detail-title">Chi tiết xe về bãi</span>
                        <span id="detail-ve-status" style="font-size:10px;color:var(--text2);letter-spacing:1px;">— Chọn xe từ danh sách —</span>
                    </div>
                    <div class="detail-placeholder" id="detail-ve-placeholder">
                        <div class="placeholder-icon">🔄</div>
                        <div class="placeholder-arrow">←</div>
                        <div class="placeholder-text">Chọn xe để xác nhận về bãi</div>
                    </div>
                    <div class="detail-body" id="detail-ve-body" style="display:none;">
                        <div class="detail-bienso" id="ve-bienso">--</div>
                        <div class="detail-grid">
                            <div class="detail-field"><div class="detail-field-label">Loại xe</div><div class="detail-field-value" id="ve-loai">--</div></div>
                            <div class="detail-field"><div class="detail-field-label">Tải trọng</div><div class="detail-field-value gold" id="ve-taitrong">--</div></div>
                            <div class="detail-field"><div class="detail-field-label">Tài xế</div><div class="detail-field-value gold" id="ve-taixe">--</div></div>
                            <div class="detail-field"><div class="detail-field-label">SĐT tài xế</div><div class="detail-field-value accent" id="ve-tel">--</div></div>
                            <div class="detail-field" style="grid-column:span 2;">
                                <div class="detail-field-label">Dự kiến về bãi</div>
                                <div class="detail-field-value orange" id="ve-dukien">--</div>
                            </div>
                        </div>
                        <button class="btn-action btn-orange" id="btn-ve" onclick="xacNhanVeBai()">
                            <span class="btn-icon">🔄</span> Xác nhận xe đã vào bãi
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="footer">
            <div class="footer-log" id="footer-log">
                <div class="log-item"><div class="log-dot"></div><span>Hệ thống hoạt động bình thường</span></div>
            </div>
            <span id="footer-time"></span>
        </div>
    </div>

    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        var xeRaData   = [];
        var xeVeData   = [];
        var selectedRa = null;
        var selectedVe = null;
        var daSoRaCong = 0;
        var daSoVeBai  = 0;
        var activeTab  = 'ra';

        // ĐỒNG HỒ
        function tick() {
            var n = new Date();
            document.getElementById('clock').textContent    = n.toLocaleTimeString('vi-VN',{hour12:false});
            document.getElementById('date-str').textContent = n.toLocaleDateString('vi-VN',{weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'});
            document.getElementById('footer-time').textContent = 'Cập nhật: ' + n.toLocaleTimeString('vi-VN');
        }
        setInterval(tick,1000); tick();

        function setDefaultDuKien() {
            var d = new Date(Date.now() + 3*3600000);
            var pad = s => String(s).padStart(2,'0');
            document.getElementById('inp-dukien-ra').value =
                d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
        }

        // TABS
        function switchTab(tab) {
            activeTab = tab;
            document.getElementById('content-ra').classList.toggle('active', tab === 'ra');
            document.getElementById('content-ve').classList.toggle('active', tab === 've');
            var btnRa = document.getElementById('tab-ra');
            var btnVe = document.getElementById('tab-ve');
            btnRa.className = 'tab-btn' + (tab==='ra' ? ' active-ra' : '');
            btnVe.className = 'tab-btn' + (tab==='ve' ? ' active-ve' : '');
        }

        // SIGNALR
        var conn = new signalR.HubConnectionBuilder()
            .withUrl('/signalserver').withAutomaticReconnect().build();

        conn.on('UpdateBangTongHopXuat', function() { loadRaData(); });
        conn.on('XeVeBai', function() { loadVeData(); });

        conn.start().then(function() {
            document.getElementById('conn-dot').classList.add('on');
            document.getElementById('conn-text').textContent = 'Realtime';
            loadRaData(); loadVeData();
        }).catch(function() {
            document.getElementById('conn-dot').classList.add('err');
            document.getElementById('conn-text').textContent = 'Mất kết nối';
            loadRaData(); loadVeData();
        });

        // LOAD DATA
        async function loadRaData() {
            try {
                var res = await fetch('/BaoVeXuat/GetXeChoXacNhan');
                if (!res.ok) return;
                xeRaData = await res.json();
                renderRaList();
                document.getElementById('stat-cho').textContent = xeRaData.length;
                document.getElementById('tab-ra-count').textContent = xeRaData.length;
                if (selectedRa) {
                    var still = xeRaData.find(x => (x.id??x.Id) === selectedRa);
                    if (still) selectRa(selectedRa); else resetRaDetail();
                }
            } catch(e) { console.error(e); }
        }

        async function loadVeData() {
            try {
                var res = await fetch('/BaoVeXuat/GetXeDangVanChuyen');
                if (!res.ok) return;
                xeVeData = await res.json();
                renderVeList();
                document.getElementById('stat-van').textContent = xeVeData.length;
                document.getElementById('tab-ve-count').textContent = xeVeData.length;
                if (selectedVe) {
                    var still = xeVeData.find(x => (x.id??x.Id) === selectedVe);
                    if (still) selectVe(selectedVe); else resetVeDetail();
                }
            } catch(e) { console.error(e); }
        }

        setInterval(function(){ loadRaData(); loadVeData(); }, 15000);

        // RENDER RA
        function renderRaList() {
            var body = document.getElementById('list-ra-body');
            document.getElementById('list-ra-count').textContent = xeRaData.length + ' xe';
            if (!xeRaData.length) {
                body.innerHTML = '<div class="xe-empty"><div class="xe-empty-icon">✅</div><div class="xe-empty-text" style="color:var(--green);">Không có xe chờ xác nhận</div></div>';
                return;
            }
            body.innerHTML = xeRaData.map(function(x) {
                var id       = x.id??x.Id;
                var bienSo   = x.bienSoXe??x.BienSoXe??'--';
                var tenCua   = x.tenCua??x.TenCua??'--';
                var tenTaiXe = x.tenTaiXe??x.TenTaiXe??'--';
                var loaiXe   = x.loaiXe??x.LoaiXe??'--';
                var hangHoas = x.hangHoas??x.HangHoas??[];
                var ht       = x.thoiGianHoanThanh??x.ThoiGianHoanThanh;
                var hangStr  = hangHoas.map(h => '<span class="hang-chip">'+(h.daBG??h.DaBG??0)+' '+(h.donVi??h.DonVi??'--')+'</span>').join('');
                var htStr    = ht ? new Date(ht).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}) : '--:--';
                var sel      = selectedRa===id ? ' selected' : '';
                return '<div class="xe-item'+sel+'" onclick="selectRa('+id+')" id="xe-ra-'+id+'">' +
                    '<div class="xe-item-top"><span class="xe-bienso">'+bienSo+'</span><span class="xe-cua-badge">'+tenCua+'</span></div>' +
                    '<div class="xe-item-meta"><span>🚗 '+loaiXe+'</span><span>👤 <span>'+tenTaiXe+'</span></span></div>' +
                    (hangStr?'<div class="xe-item-hang">'+hangStr+'</div>':'') +
                    '<div class="xe-item-time">⏱ Hoàn thành: '+htStr+'</div></div>';
            }).join('');
        }

        // RENDER VỀ
        function renderVeList() {
            var body = document.getElementById('list-ve-body');
            document.getElementById('list-ve-count').textContent = xeVeData.length + ' xe';
            if (!xeVeData.length) {
                body.innerHTML = '<div class="xe-empty"><div class="xe-empty-icon">🏁</div><div class="xe-empty-text">Không có xe đang vận chuyển</div></div>';
                return;
            }
            body.innerHTML = xeVeData.map(function(x) {
                var id       = x.id??x.Id;
                var bienSo   = x.bienSoXe??x.BienSoXe??'--';
                var loaiXe   = x.loaiXe??x.LoaiXe??'--';
                var tenTaiXe = x.tenTaiXe??x.TenTaiXe??'--';
                var dk       = x.thoiGianDuKienVe??x.ThoiGianDuKienVe;
                var dkStr    = dk ? new Date(dk).toLocaleString('vi-VN',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : 'Chưa xác định';
                var sel      = selectedVe===id ? ' selected' : '';
                return '<div class="xe-item type-ve'+sel+'" onclick="selectVe('+id+')" id="xe-ve-'+id+'">' +
                    '<div class="xe-item-top"><span class="xe-bienso">'+bienSo+'</span><span class="xe-cua-badge orange">Đang vận chuyển</span></div>' +
                    '<div class="xe-item-meta"><span>🚗 '+loaiXe+'</span><span>👤 <span>'+tenTaiXe+'</span></span></div>' +
                    '<div class="xe-item-time">📅 Dự kiến về: '+dkStr+'</div></div>';
            }).join('');
        }

        // SELECT RA
        function selectRa(id) {
            selectedRa = id;
            var x = xeRaData.find(xe => (xe.id??xe.Id)===id);
            if (!x) return;
            document.querySelectorAll('#list-ra-body .xe-item').forEach(el => el.classList.remove('selected'));
            var item = document.getElementById('xe-ra-'+id);
            if (item) item.classList.add('selected');
            document.getElementById('detail-ra-placeholder').style.display = 'none';
            document.getElementById('detail-ra-body').style.display = 'flex';
            document.getElementById('detail-ra-status').textContent = 'Xe được chọn';
            var fmt = dt => { if(!dt) return '--:--'; var d=new Date(dt); return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'); };
            document.getElementById('ra-bienso').textContent    = x.bienSoXe??x.BienSoXe??'--';
            document.getElementById('ra-cua').textContent       = x.tenCua??x.TenCua??'--';
            document.getElementById('ra-loai').textContent      = x.loaiXe??x.LoaiXe??'--';
            document.getElementById('ra-taixe').textContent     = x.tenTaiXe??x.TenTaiXe??'--';
            document.getElementById('ra-tel').textContent       = x.telTaiXe??x.TelTaiXe??'--';
            document.getElementById('ra-giovao').textContent    = fmt(x.thoiGianVaoCua??x.ThoiGianVaoCua);
            document.getElementById('ra-hoanthanh').textContent = fmt(x.thoiGianHoanThanh??x.ThoiGianHoanThanh);
            var hangHoas = x.hangHoas??x.HangHoas??[];
            document.getElementById('ra-hang').innerHTML = hangHoas.length
                ? hangHoas.map(h => '<tr><td>'+(h.donVi??h.DonVi??'--')+'</td><td class="chua">'+(h.chuaBG??h.ChuaBG??0)+'</td><td class="da">'+(h.daBG??h.DaBG??0)+'</td></tr>').join('')
                : '<tr><td colspan="3" style="text-align:center;color:var(--text3);padding:16px;">Không có dữ liệu</td></tr>';
            setDefaultDuKien();
        }

        function resetRaDetail() {
            selectedRa = null;
            document.getElementById('detail-ra-placeholder').style.display = 'flex';
            document.getElementById('detail-ra-body').style.display = 'none';
            document.getElementById('detail-ra-status').textContent = '— Chọn xe từ danh sách —';
            document.querySelectorAll('#list-ra-body .xe-item').forEach(el => el.classList.remove('selected'));
        }

        // SELECT VỀ
        function selectVe(id) {
            selectedVe = id;
            var x = xeVeData.find(xe => (xe.id??xe.Id)===id);
            if (!x) return;
            document.querySelectorAll('#list-ve-body .xe-item').forEach(el => el.classList.remove('selected'));
            var item = document.getElementById('xe-ve-'+id);
            if (item) item.classList.add('selected');
            document.getElementById('detail-ve-placeholder').style.display = 'none';
            document.getElementById('detail-ve-body').style.display = 'flex';
            document.getElementById('detail-ve-status').textContent = 'Xe được chọn';
            var dk = x.thoiGianDuKienVe??x.ThoiGianDuKienVe;
            var dkStr = dk ? new Date(dk).toLocaleString('vi-VN',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : 'Chưa xác định';
            document.getElementById('ve-bienso').textContent  = x.bienSoXe??x.BienSoXe??'--';
            document.getElementById('ve-loai').textContent    = x.loaiXe??x.LoaiXe??'--';
            document.getElementById('ve-taitrong').textContent= (x.taiTrong??x.TaiTrong??0)+' tấn';
            document.getElementById('ve-taixe').textContent   = x.tenTaiXe??x.TenTaiXe??'--';
            document.getElementById('ve-tel').textContent     = x.telTaiXe??x.TelTaiXe??'--';
            document.getElementById('ve-dukien').textContent  = dkStr;
        }

        function resetVeDetail() {
            selectedVe = null;
            document.getElementById('detail-ve-placeholder').style.display = 'flex';
            document.getElementById('detail-ve-body').style.display = 'none';
            document.getElementById('detail-ve-status').textContent = '— Chọn xe từ danh sách —';
            document.querySelectorAll('#list-ve-body .xe-item').forEach(el => el.classList.remove('selected'));
        }

        // XÁC NHẬN RA CỔNG
        async function xacNhanRaCong() {
            if (!selectedRa) return;
            var x = xeRaData.find(xe => (xe.id??xe.Id)===selectedRa);
            var bienSo = x ? (x.bienSoXe??x.BienSoXe??'--') : '--';
            if (!confirm('Xác nhận cho xe '+bienSo+' ra cổng?\nXe sẽ chuyển sang trạng thái Đang vận chuyển.')) return;
            var inp = document.getElementById('inp-dukien-ra').value;
            var thoiGianDuKienVe = inp ? new Date(inp).toISOString() : null;
            var btn = document.getElementById('btn-ra');
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-icon">⏳</span> Đang xử lý...';
            try {
                var res = await fetch('/BaoVeXuat/XacNhanRaCong', {
                    method:'POST', headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({ xuatId: selectedRa, thoiGianDuKienVe: thoiGianDuKienVe })
                });
                var data = await res.json();
                if (res.ok) {
                    var now = new Date().toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'});
                    addLog('✔ '+bienSo+' ra cổng lúc '+now);
                    daSoRaCong++;
                    document.getElementById('stat-da').textContent = daSoRaCong;
                    resetRaDetail();
                    await loadRaData();
                    await loadVeData();
                } else {
                    alert('❌ '+(data.message||'Lỗi xác nhận!'));
                }
            } catch(e) { alert('❌ Lỗi kết nối server'); }
            finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="btn-icon">✔</span> Xác nhận cho xe ra cổng';
            }
        }

        // XÁC NHẬN VỀ BÃI
        async function xacNhanVeBai() {
            if (!selectedVe) return;
            var x = xeVeData.find(xe => (xe.id??xe.Id)===selectedVe);
            var bienSo = x ? (x.bienSoXe??x.BienSoXe??'--') : '--';
            if (!confirm('Xác nhận xe '+bienSo+' đã vào bãi?\nXe sẽ chuyển sang trạng thái Trong bãi.')) return;
            var btn = document.getElementById('btn-ve');
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-icon">⏳</span> Đang xử lý...';
            try {
                var res = await fetch('/BaoVeXuat/XacNhanVeBai', {
                    method:'POST', headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({ xeId: selectedVe })
                });
                var data = await res.json();
                if (res.ok) {
                    var now = new Date().toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'});
                    addLog('🔄 '+bienSo+' về bãi lúc '+now);
                    daSoVeBai++;
                    document.getElementById('stat-da').textContent = daSoRaCong + daSoVeBai;
                    resetVeDetail();
                    await loadVeData();
                } else {
                    alert('❌ '+(data.message||'Lỗi xác nhận về bãi!'));
                }
            } catch(e) { alert('❌ Lỗi kết nối server'); }
            finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="btn-icon">🔄</span> Xác nhận xe đã vào bãi';
            }
        }

        function addLog(msg) {
            var log = document.getElementById('footer-log');
            log.innerHTML = '<div class="log-item"><div class="log-dot"></div><span>'+msg+'</span></div>';
        }
    </script>
</body>
</html>
