@model List<LedApp.DTOs.DanhSachXeDto>
@{
    ViewData["Title"] = "Dashboard vận chuyển";
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var tongXe = Model?.Count ?? 0;
    var dangVe = Model?.Count(x => x.ChuyenHienTai?.TrangThai == 1) ?? 0;
    var hoanThanh = Model?.Count(x => x.ChuyenHienTai?.TrangThai == 4) ?? 0;
    var chuaXuatPhat = Model?.Count(x => x.ChuyenHienTai?.TrangThai == 0) ?? 0;
}

<style>
    .page-wrapper > .container-fluid {
        padding: 0 !important;
    }

    .px-page {
        padding: 24px 24px 80px;
    }

    .px-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 12px;
        line-height: 1;
    }

        .px-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

            .px-breadcrumb a:hover {
                color: #111827;
            }

        .px-breadcrumb .sep {
            display: inline-flex;
            align-items: center;
            color: #9ca3af;
        }

            .px-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
                display: block;
            }

        .px-breadcrumb .cur {
            color: #111827;
            font-weight: 600;
        }

    .px-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .px-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 3px;
            line-height: 1.2;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .px-header p {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

    .signal-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #d1d5db;
        display: inline-block;
        vertical-align: middle;
    }

        .signal-dot.connected {
            background: #16a34a;
        }

        .signal-dot.error {
            background: #ef4444;
        }

    .btn-refresh {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all .15s;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }

        .btn-refresh:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
            text-decoration: none;
        }

        .btn-refresh svg {
            width: 14px;
            height: 14px;
        }

    /* Stat cards */
    .px-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px 22px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 800;
        line-height: 1.1;
        color: #111827;
    }

    .stat-sub {
        font-size: 0.78rem;
        color: #9ca3af;
    }

    .stat-value.yellow {
        color: #f59e0b;
    }

    .stat-value.green {
        color: #16a34a;
    }

    .stat-value.blue {
        color: #3b82f6;
    }

    /* Toolbar */
    .px-toolbar-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        gap: 10px;
    }

    .px-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .filter-tabs {
        display: inline-flex;
        gap: 2px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 3px;
    }

    .filter-tab {
        padding: 5px 14px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 500;
        color: #6b7280;
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        transition: all .15s;
        line-height: 1.4;
        white-space: nowrap;
    }

        .filter-tab:hover {
            color: #374151;
            background: rgba(255,255,255,0.5);
        }

        .filter-tab.active {
            background: #fff;
            color: #111827;
            border-color: #e5e7eb;
            font-weight: 600;
            box-shadow: 0 1px 3px rgba(0,0,0,.1);
        }

    .px-search {
        position: relative;
        flex: 1;
        max-width: 400px;
    }

        .px-search svg {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            width: 15px;
            height: 15px;
            pointer-events: none;
        }

        .px-search input {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            color: #111827;
            font-size: 0.875rem;
            padding: 9px 14px 9px 34px;
            width: 100%;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .px-search input::placeholder {
                color: #9ca3af;
            }

            .px-search input:focus {
                border-color: #16a34a;
                box-shadow: 0 0 0 3px rgba(22,163,74,.1);
            }

    /* Table */
    .px-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .px-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
        table-layout: auto;
    }

        .px-table thead th {
            background: #f9fafb;
            color: #374151;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 10px 14px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
            user-select: none;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .px-table tbody tr {
            border-bottom: 1px solid #f3f4f6;
            transition: background .1s;
        }

            .px-table tbody tr:last-child {
                border-bottom: none;
            }

            .px-table tbody tr:hover {
                background: #f9fafb;
            }

        .px-table td {
            padding: 12px 14px;
            color: #111827;
            vertical-align: middle;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.875rem;
        }

            /* Col widths */
            .px-table th:nth-child(1), .px-table td:nth-child(1) {
                width: 180px;
            }

            .px-table th:nth-child(2), .px-table td:nth-child(2) {
                width: 70px;
                text-align: center;
            }

            .px-table th:nth-child(3), .px-table td:nth-child(3) {
                width: 140px;
            }

            .px-table th:nth-child(4), .px-table td:nth-child(4) {
                width: 110px;
            }

            .px-table th:nth-child(5), .px-table td:nth-child(5) {
                width: auto;
                white-space: normal;
                overflow: visible;
            }

            .px-table th:nth-child(6), .px-table td:nth-child(6) {
                width: 120px;
                text-align: center;
            }

            .px-table th:nth-child(7), .px-table td:nth-child(7) {
                width: 90px;
                text-align: center;
            }

    .td-bienso {
        font-weight: 700;
        color: #111827;
    }

    .td-laixe {
        font-size: 0.78rem;
        color: #6b7280;
        margin-top: 2px;
    }

    /* Badges */
    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 600;
    }

        .badge-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

    .bp-0 {
        background: #f1f5f9;
        color: #64748b;
    }

        .bp-0::before {
            background: #94a3b8;
        }

    .bp-1 {
        background: #eff6ff;
        color: #3b82f6;
    }

        .bp-1::before {
            background: #3b82f6;
        }

    .bp-2 {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-2::before {
            background: #16a34a;
        }

    .bp-3 {
        background: #fff7ed;
        color: #f97316;
    }

        .bp-3::before {
            background: #f97316;
        }

    .bp-4 {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-4::before {
            background: #16a34a;
        }

    .hang-tag {
        display: inline-flex;
        align-items: center;
        background: #f3f4f6;
        color: #374151;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.76rem;
        margin: 2px;
        font-weight: 500;
    }

    .btn-detail {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 500;
        color: #374151;
        background: #fff;
        cursor: pointer;
        text-decoration: none;
        transition: all .12s;
        white-space: nowrap;
    }

        .btn-detail:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
            text-decoration: none;
        }

    .row-flash {
        background: rgba(22,163,74,0.08) !important;
        transition: background 0s;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

        .empty-state svg {
            width: 40px;
            height: 40px;
            margin-bottom: 12px;
            opacity: .4;
        }

        .empty-state p {
            font-size: 0.875rem;
            margin: 0;
        }

    .update-time {
        font-size: 0.78rem;
        color: #9ca3af;
    }

    /* Dark mode */
    body.dark-mode .px-header h1 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .px-header p {
        color: #9ca3af !important;
    }

    body.dark-mode .px-breadcrumb, body.dark-mode .px-breadcrumb a {
        color: #9ca3af !important;
    }

    body.dark-mode .stat-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .stat-label {
        color: #6b7280 !important;
    }

    body.dark-mode .stat-value {
        color: #e2e8f0 !important;
    }

    body.dark-mode .stat-sub {
        color: #6b7280 !important;
    }

    body.dark-mode .filter-tabs {
        background: #22263a !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .filter-tab {
        color: #9ca3af !important;
    }

        body.dark-mode .filter-tab.active {
            background: #2e3248 !important;
            border-color: #3d4460 !important;
            color: #e2e8f0 !important;
        }

    body.dark-mode .px-search input {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .btn-refresh {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #9ca3af !important;
    }

    body.dark-mode .px-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .px-table thead th {
        background: #22263a !important;
        color: #6b7280 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .px-table tbody tr {
        border-color: #2e3248 !important;
    }

        body.dark-mode .px-table tbody tr:hover {
            background: #22263a !important;
        }

    body.dark-mode .px-table td {
        color: #e2e8f0 !important;
    }

    body.dark-mode .td-bienso {
        color: #f1f5f9 !important;
    }

    body.dark-mode .td-laixe {
        color: #9ca3af !important;
    }

    body.dark-mode .hang-tag {
        background: #2e3248 !important;
        color: #d1d5db !important;
    }

    body.dark-mode .btn-detail {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #d1d5db !important;
    }

    body.dark-mode .bp-0 {
        background: #22263a !important;
        color: #9ca3af !important;
    }

    body.dark-mode .bp-1 {
        background: #1e3a5f !important;
        color: #93c5fd !important;
    }

    body.dark-mode .bp-2 {
        background: #052e16 !important;
        color: #4ade80 !important;
    }

    body.dark-mode .bp-3 {
        background: #2e1a0e !important;
        color: #fb923c !important;
    }

    body.dark-mode .bp-4 {
        background: #052e16 !important;
        color: #4ade80 !important;
    }

    body.dark-mode .update-time {
        color: #6b7280 !important;
    }

    .tb-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: all .15s;
        white-space: nowrap;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .tb-btn:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
        }

        .tb-btn svg {
            width: 14px;
            height: 14px;
            color: #6b7280;
        }

    /* Dark mode */
    body.dark-mode .tb-btn {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #9ca3af !important;
    }

    body.dark-mode input[type="date"] {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }
</style>

<div class="px-page">

    <div class="px-breadcrumb">
        <a href="/">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">Vận chuyển</span>
    </div>

    <div class="px-header">
        <div>
            <h1>
                Dashboard vận chuyển
                <span class="signal-dot" id="signal-dot" title="SignalR"></span>
            </h1>
            <p>
                Theo dõi trạng thái xe và chuyến hàng theo thời gian thực. &nbsp;
                <span class="update-time" id="update-time">@DateTime.Now.ToString("HH:mm dd/MM/yyyy")</span>
            </p>
        </div>
        <a href="@Url.Action("Index","ImportFromApi")" class="btn-refresh">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            Refresh
        </a>
    </div>

    <!-- Stat cards -->
    <div class="px-stats">
        <div class="stat-card">
            <span class="stat-label">Tổng xe</span>
            <span class="stat-value" id="stat-total">@tongXe</span>
            <span class="stat-sub">Đang theo dõi</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Đang về</span>
            <span class="stat-value yellow" id="stat-dang">@dangVe</span>
            <span class="stat-sub">Trên đường về</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Hoàn thành</span>
            <span class="stat-value green" id="stat-xong">@hoanThanh</span>
            <span class="stat-sub">Đã nhập xong</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Chưa đi</span>
            <span class="stat-value" id="stat-chua">@chuaXuatPhat</span>
            <span class="stat-sub">Chưa xuất phát</span>
        </div>
    </div>

    <!-- Toolbar -->
    <div style="margin-bottom:16px;">
        <!-- Hàng 1: filter tabs -->
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
            <div class="filter-tabs">
                <button class="filter-tab active" data-tt="">Tất cả</button>
                <button class="filter-tab" data-tt="0">Chưa về</button>
                <button class="filter-tab" data-tt="1">Đang về</button>
                <button class="filter-tab" data-tt="2">Đã đến</button>
                <button class="filter-tab" data-tt="3">Đang nhập</button>
                <button class="filter-tab" data-tt="4">Hoàn thành</button>
            </div>
        </div>
        <!-- Hàng 2: date + sort + search + reset (giống History) -->
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="font-size:0.82rem;color:#6b7280;font-weight:500;white-space:nowrap;">Ngày dự kiến:</span>
            <input type="date" id="dateFrom" onchange="filterTable()"
                   style="border:1px solid #e5e7eb;border-radius:8px;padding:7px 10px;font-size:0.82rem;color:#374151;background:#fff;outline:none;cursor:pointer;">
            <span style="font-size:0.82rem;color:#9ca3af;">→</span>
            <input type="date" id="dateTo" onchange="filterTable()"
                   style="border:1px solid #e5e7eb;border-radius:8px;padding:7px 10px;font-size:0.82rem;color:#374151;background:#fff;outline:none;cursor:pointer;">
            <div style="flex:1;"></div>
            <button class="tb-btn" id="btnSortDesc" onclick="sortTable('desc')">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0-3.75-3.75M17.25 21 21 17.25" /></svg>
                Mới nhất
            </button>
            <button class="tb-btn" id="btnSortAsc" onclick="sortTable('asc')">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h5.25m5.25-.75L17.25 9m0 0L21 12.75M17.25 9v12" /></svg>
                Cũ nhất
            </button>
            <div class="px-search" style="max-width:220px;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                <input type="text" id="searchInput" placeholder="Tìm biển số, lái xe, chi nhánh..." oninput="filterTable()" />
            </div>
            <button class="tb-btn" onclick="resetFilter()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                Reset
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="px-card">
        <table id="main-table" class="px-table">
            <thead>
                <tr>
                    <th>Xe / Lái xe</th>
                    <th>Chi nhánh</th>
                    <th>Mã chuyến</th>
                    <th>Ngày dự kiến</th>
                    <th>Hàng hóa</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                                <p>Không có dữ liệu.</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var xe in Model)
                    {
                        var cx = xe.ChuyenHienTai;
                        var tt = cx?.TrangThai ?? 0;
                        var ttLabels = new[] { "Chưa về", "Đang về", "Đã đến", "Đang nhập", "Hoàn thành" };
                        var ttLabel = tt < ttLabels.Length ? ttLabels[tt] : "--";

                        <tr data-xe-id="@xe.Id"
                            data-bienso="@xe.BienSo?.ToLower()"
                            data-laixe="@xe.TenLaiXe?.ToLower()"
                            data-chinhanh="@xe.MaChiNhanh?.ToLower()"
                            data-tt="@tt"
                            data-ngay="@(cx?.NgayDuKien.Ticks ?? 0)">
                            <td>
                                <div class="td-bienso">@xe.BienSo</div>
                                <div class="td-laixe">@xe.TenLaiXe</div>
                            </td>
                            <td style="text-align:center;">@xe.MaChiNhanh</td>
                            <td>
                                @if (cx != null)
                                {
                                    <div style="font-weight:600;">@cx.MaChuyenApi</div>
                                    <div style="font-size:0.78rem;color:#9ca3af;">Lần @cx.LanThu</div>
                                }
                                else
                                {
                                    <span style="color:#d1d5db;">—</span>
                                }
                            </td>
                            <td style="color:#6b7280;font-size:0.82rem;">
                                @(cx != null ? cx.NgayDuKien.ToString("dd/MM HH:mm") : "—")
                            </td>
                            <td>
                                @if (cx?.HangHoas != null && cx.HangHoas.Any())
                                {
                                    foreach (var h in cx.HangHoas)
                                    {
                                        <span class="hang-tag">@h.SoLuong @h.DonVi</span>
                                    }
                                }
                                else
                                {
                                    <span style="color:#d1d5db;">—</span>
                                }
                            </td>
                            <td class="cell-tt" style="text-align:center;">
                                <span class="badge-pill bp-@tt">@ttLabel</span>
                            </td>
                            <td style="text-align:center;">
                                <a href="@Url.Action("XeHistory","ImportFromApi", new { xeId = xe.Id })" class="btn-detail">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="12" height="12"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        // ===== FILTER TABS =====
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                filterTable();
            });
        });

        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const activeTab = document.querySelector('.filter-tab.active');
            const tt = activeTab ? activeTab.dataset.tt : '';
            const fromVal = document.getElementById('dateFrom')?.value;
            const toVal   = document.getElementById('dateTo')?.value;
            const fromMs  = fromVal ? new Date(fromVal).getTime() : null;
            const toMs    = toVal   ? new Date(toVal + 'T23:59:59').getTime() : null;

            document.querySelectorAll('#main-table tbody tr[data-xe-id]').forEach(r => {
                const matchSearch = !search
                    || (r.dataset.bienso || '').includes(search)
                    || (r.dataset.laixe || '').includes(search)
                    || (r.dataset.chinhanh || '').includes(search);
                const matchTt = !tt || r.dataset.tt === tt;

                // Convert .NET Ticks → JS ms
                const ticks = parseInt(r.dataset.ngay) || 0;
                const ngayMs = ticks > 0 ? (ticks / 10000) - 62135596800000 : null;
                const matchFrom = !fromMs || (ngayMs !== null && ngayMs >= fromMs);
                const matchTo   = !toMs   || (ngayMs !== null && ngayMs <= toMs);

                r.style.display = matchSearch && matchTt && matchFrom && matchTo ? '' : 'none';
            });
        }
                // ===== SORT TABLE =====
        function sortTable(dir) {
            const tbody = document.querySelector('#main-table tbody');
            const rows = Array.from(tbody.querySelectorAll('tr[data-xe-id]'));
            rows.sort((a, b) => {
                const da = a.dataset.ngay ? parseInt(a.dataset.ngay) : 0;
                const db = b.dataset.ngay ? parseInt(b.dataset.ngay) : 0;
                return dir === 'desc' ? db - da : da - db;
            });
            rows.forEach(r => tbody.appendChild(r));
            document.getElementById('btnSortDesc').style.borderColor = dir === 'desc' ? '#16a34a' : '';
            document.getElementById('btnSortDesc').style.color      = dir === 'desc' ? '#16a34a' : '';
            document.getElementById('btnSortAsc').style.borderColor = dir === 'asc'  ? '#16a34a' : '';
            document.getElementById('btnSortAsc').style.color       = dir === 'asc'  ? '#16a34a' : '';
        }
        sortTable('desc');
        // ===== SIGNALR =====
        const ttLabels = ["Chưa về", "Đang về", "Đã đến", "Đang nhập", "Hoàn thành"];

        const dashboardConnection = new signalR.HubConnectionBuilder()
            .withUrl("/SignalServer")
            .withAutomaticReconnect()
            .build();

        dashboardConnection.on("ReloadDashboard", function () {
            fetch('/ImportFromApi/GetLatest')
                .then(res => res.json())
                .then(data => {
                    updateDashboard(data);
                });
        });
         function resetFilter() {
            document.getElementById('searchInput').value = '';
            document.getElementById('dateFrom').value = '';
            document.getElementById('dateTo').value = '';
            // Reset filter tabs về Tất cả
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            document.querySelector('.filter-tab[data-tt=""]').classList.add('active');
            // Reset sort highlight
            document.getElementById('btnSortDesc').style.borderColor = '';
            document.getElementById('btnSortDesc').style.color = '';
            document.getElementById('btnSortAsc').style.borderColor = '';
            document.getElementById('btnSortAsc').style.color = '';
            filterTable();
        }
        function updateDashboard(data) {
            let dangVe = 0, hoanThanh = 0, chuaDi = 0;

            data.forEach(xe => {
                const cx = xe.chuyenHienTai ?? xe.ChuyenHienTai;
                const tt = cx?.trangThai ?? cx?.TrangThai ?? 0;
                const id = xe.id ?? xe.Id;

                if (tt === 1) dangVe++;
                if (tt === 4) hoanThanh++;
                if (tt === 0) chuaDi++;

                const row = document.querySelector(`tr[data-xe-id="${id}"]`);
                if (!row) return;

                const cellTt = row.querySelector('.cell-tt');
                if (cellTt) {
                    cellTt.innerHTML = `<span class="badge-pill bp-${tt}">${ttLabels[tt] ?? '--'}</span>`;
                }
                row.setAttribute('data-tt', tt);
                row.classList.add('row-flash');
                setTimeout(() => row.classList.remove('row-flash'), 1000);
            });

            document.getElementById('stat-total').textContent = data.length;
            document.getElementById('stat-dang').textContent  = dangVe;
            document.getElementById('stat-xong').textContent  = hoanThanh;
            document.getElementById('stat-chua').textContent  = chuaDi;
            document.getElementById('update-time').textContent = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' ' + new Date().toLocaleDateString('vi-VN');
        }

        dashboardConnection.start()
            .then(() => {
                document.getElementById("signal-dot").classList.add("connected");
            })
            .catch(() => {
                document.getElementById("signal-dot").classList.add("error");
            });
    </script>
}
