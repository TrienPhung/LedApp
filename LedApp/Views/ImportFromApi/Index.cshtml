@model List<LedApp.DTOs.DanhSachXeDto>
@{
    ViewData["Title"] = "Dashboard vận chuyển";
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var tongXe = Model?.Count ?? 0;
    var dangVe = Model?.Count(x => x.ChuyenHienTai?.TrangThai == 1) ?? 0;
    var hoanThanh = Model?.Count(x => x.ChuyenHienTai?.TrangThai == 4) ?? 0;
    var chuaXuatPhat = Model?.Count(x => x.ChuyenHienTai == null
                                      || x.ChuyenHienTai.TrangThai == 0) ?? 0;
}

<style>
    /* ===== LIGHT MODE (mặc định) ===== */
    .wrap {
        padding: 16px;
        font-family: Arial;
        min-height: 100vh;
        --bg-page: #f1f5f9;
        --bg-card: #ffffff;
        --bg-table: #ffffff;
        --bg-hover: #f8fafc;
        --bg-tag: #e2e8f0;
        --bg-toolbar: #ffffff;
        --border: #e2e8f0;
        --text: #1e293b;
        --text-muted: #64748b;
        --text-th: #94a3b8;
    }

    /* ===== DARK MODE ===== */
    body.dark-mode .wrap {
        --bg-page: #0f172a;
        --bg-card: #1e293b;
        --bg-table: #1e293b;
        --bg-hover: #334155;
        --bg-tag: #334155;
        --bg-toolbar: #1e293b;
        --border: #334155;
        --text: #e2e8f0;
        --text-muted: #94a3b8;
        --text-th: #94a3b8;
    }

    .wrap {
        background: var(--bg-page);
        color: var(--text);
    }

        .wrap .dash-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .wrap .dash-title {
            font-size: 20px;
            font-weight: bold;
            color: var(--text);
        }

        .wrap .dash-time {
            font-size: 12px;
            color: var(--text-muted);
        }

        .wrap .dash-refresh {
            padding: 6px 12px;
            border: 1px solid #3b82f6;
            border-radius: 6px;
            color: #3b82f6;
            text-decoration: none;
            font-size: 12px;
            background: transparent;
        }

            .wrap .dash-refresh:focus,
            .wrap .dash-refresh:focus-visible {
                outline: none !important;
                box-shadow: none !important;
            }

        .wrap .stat-row {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
        }

        .wrap .stat-card {
            flex: 1;
            background: var(--bg-card);
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            border: 1px solid var(--border);
        }

            .wrap .stat-card .stat-label {
                font-size: 11px;
                color: var(--text-muted);
            }

            .wrap .stat-card .stat-value {
                font-size: 18px;
                font-weight: bold;
                margin-top: 4px;
                color: var(--text);
            }

        .wrap .stat-value.yellow {
            color: #f59e0b;
        }

        .wrap .stat-value.green {
            color: #10b981;
        }

        .wrap .dash-toolbar {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

            .wrap .dash-toolbar input,
            .wrap .dash-toolbar select {
                padding: 6px 10px;
                border-radius: 6px;
                border: 1px solid var(--border);
                background: var(--bg-toolbar);
                color: var(--text);
                font-size: 12px;
            }

                .wrap .dash-toolbar input:focus,
                .wrap .dash-toolbar select:focus {
                    outline: none !important;
                    box-shadow: none !important;
                }

        .wrap .dash-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-table);
            border-radius: 10px;
            overflow: hidden;
            table-layout: fixed;
            border: 1px solid var(--border);
        }

            .wrap .dash-table th:nth-child(1), .wrap .dash-table td:nth-child(1) {
                width: 180px;
            }

            .wrap .dash-table th:nth-child(2), .wrap .dash-table td:nth-child(2) {
                width: 130px;
                text-align: center;
            }

            .wrap .dash-table th:nth-child(3), .wrap .dash-table td:nth-child(3) {
                width: 160px;
            }

            .wrap .dash-table th:nth-child(4), .wrap .dash-table td:nth-child(4) {
                width: 120px;
            }

            .wrap .dash-table th:nth-child(5), .wrap .dash-table td:nth-child(5) {
                width: auto;
                white-space: normal;
                overflow: visible;
            }

            .wrap .dash-table th:nth-child(6), .wrap .dash-table td:nth-child(6) {
                width: 120px;
                text-align: center;
            }

            .wrap .dash-table th:nth-child(7), .wrap .dash-table td:nth-child(7) {
                width: 90px;
                text-align: center;
            }

            .wrap .dash-table td,
            .wrap .dash-table th {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                padding: 10px 12px;
                font-size: 13px;
                color: var(--text);
            }

            .wrap .dash-table th {
                color: var(--text-th);
                border-bottom: 1px solid var(--border);
                font-size: 12px;
                font-weight: 600;
            }

            .wrap .dash-table tr {
                border-bottom: 1px solid var(--border);
                transition: background 0.2s;
            }

                .wrap .dash-table tr:hover {
                    background: var(--bg-hover);
                }

        .wrap .bien-so {
            font-weight: bold;
        }

        .wrap .lai-xe {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .wrap .hang {
            display: inline-block;
            background: var(--bg-tag);
            color: var(--text);
            padding: 3px 7px;
            border-radius: 5px;
            font-size: 11px;
            margin: 2px;
        }

        .wrap .tt-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            color: #fff;
        }

        .wrap .tt-0 {
            background: #64748b;
        }

        .wrap .tt-1 {
            background: #3b82f6;
        }

        .wrap .tt-2 {
            background: #22c55e;
            color: #000;
        }

        .wrap .tt-3 {
            background: #f97316;
        }

        .wrap .tt-4 {
            background: #10b981;
        }

        .wrap .dash-btn {
            border: 1px solid #3b82f6;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            color: #3b82f6;
            text-decoration: none;
            background: transparent;
        }

            .wrap .dash-btn:focus,
            .wrap .dash-btn:focus-visible {
                outline: none !important;
                box-shadow: none !important;
            }

        .wrap .signal-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #94a3b8;
            display: inline-block;
            margin-left: 8px;
            vertical-align: middle;
        }

            .wrap .signal-dot.connected {
                background: #10b981;
            }

            .wrap .signal-dot.error {
                background: #ef4444;
            }

        /* ===== FLASH KHI CÓ UPDATE ===== */
        .wrap .dash-table tr.row-flash {
            background: rgba(59, 130, 246, 0.15) !important;
            transition: background 0s;
        }
</style>

<div class="wrap">
    <div class="dash-header">
        <div>
            <div class="dash-title">
                🚛 Dashboard vận chuyển
                <span class="signal-dot" id="signal-dot" title="SignalR"></span>
            </div>
            <div class="dash-time" id="update-time">@DateTime.Now.ToString("HH:mm dd/MM/yyyy")</div>
        </div>
        <a href="@Url.Action("Index","ImportFromApi")" class="dash-refresh">↻ Refresh</a>
    </div>

    <div class="stat-row">
        <div class="stat-card">
            <div class="stat-label">Tổng xe</div>
            <div class="stat-value" id="stat-total">@tongXe</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Đang về</div>
            <div class="stat-value yellow" id="stat-dang">@dangVe</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Hoàn thành</div>
            <div class="stat-value green" id="stat-xong">@hoanThanh</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Chưa đi</div>
            <div class="stat-value" id="stat-chua">@chuaXuatPhat</div>
        </div>
    </div>

    <div class="dash-toolbar">
        <input type="text" id="search" placeholder="Tìm kiếm..." oninput="filterTable()">
        <select id="filter-tt" onchange="filterTable()">
            <option value="">Tất cả</option>
            <option value="0">Chưa về</option>
            <option value="1">Đang về</option>
            <option value="2">Đã đến</option>
            <option value="3">Đang nhập</option>
            <option value="4">Hoàn thành</option>
        </select>
    </div>

    <table id="main-table" class="dash-table">
        <thead>
            <tr>
                <th>Xe / Lái xe</th>
                <th>Mã chi nhánh</th>
                <th>Mã chuyến</th>
                <th>Ngày dự kiến</th>
                <th>Hàng hóa</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr><td colspan="7" style="text-align:center;padding:2rem;opacity:0.5">Không có dữ liệu</td></tr>
            }
            else
            {
                @foreach (var xe in Model)
                {
                    var cx = xe.ChuyenHienTai;
                    var tt = cx?.TrangThai ?? 0;
                    var ttLabel = new[] { "Chưa về", "Đang về", "Đã đến", "Đang nhập", "Hoàn thành" };
                    <tr data-xe-id="@xe.Id"
                        data-bienso="@xe.BienSo?.ToLower()"
                        data-laixe="@xe.TenLaiXe?.ToLower()"
                        data-chinhanh="@xe.MaChiNhanh?.ToLower()"
                        data-tt="@tt">
                        <td>
                            <div class="bien-so">@xe.BienSo</div>
                            <div class="lai-xe">@xe.TenLaiXe</div>
                        </td>
                        <td>@xe.MaChiNhanh</td>
                        <td>
                            @if (cx != null)
                            {
                                <div>@cx.MaChuyenApi</div>
                                <small style="opacity:0.5">Lần @cx.LanThu</small>
                            }
                            else
                            {
                                <span style="opacity:0.3">--</span>
                            }
                        </td>
                        <td>@(cx != null ? cx.NgayDuKien.ToString("dd/MM HH:mm") : "--")</td>
                        <td>
                            @if (cx?.HangHoas != null && cx.HangHoas.Any())
                            {
                                foreach (var h in cx.HangHoas)
                                {
                                    <span class="hang">@h.SoLuong @h.DonVi</span>
                                }
                            }
                            else
                            {
                                <span style="opacity:0.3">--</span>
                            }
                        </td>
                        <td class="cell-tt">
                            <span class="tt-badge tt-@tt">@(tt < ttLabel.Length ? ttLabel[tt] : "--")</span>
                        </td>
                        <td>
                            <a href="@Url.Action("XeHistory","ImportFromApi", new { xeId = xe.Id })" class="dash-btn">Chi tiết</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        // ===== SIGNALR =====
        const dashboardConnection = new signalR.HubConnectionBuilder()
            .withUrl("/SignalServer")
            .withAutomaticReconnect()
            .build();
        dashboardConnection.on("ReloadDashboard", function () {
            console.log("🔄 Có update từ API");
            fetch('/ImportFromApi/GetLatest')
                .then(res => res.json())
                .then(data => {
                    updateDashboard(data);
                    // update stat cards
                    const dangVe    = data.filter(x => (x.chuyenHienTai?.trangThai ?? x.chuyenHienTai?.TrangThai) === 1).length;
                    const hoanThanh = data.filter(x => (x.chuyenHienTai?.trangThai ?? x.chuyenHienTai?.TrangThai) === 4).length;
                    const chuaDi    = data.filter(x => !x.chuyenHienTai ||
                                     (x.chuyenHienTai?.trangThai ?? x.chuyenHienTai?.TrangThai) === 0).length;
                    document.getElementById('stat-total').textContent = data.length;
                    document.getElementById('stat-dang').textContent  = dangVe;
                    document.getElementById('stat-xong').textContent  = hoanThanh;
                    document.getElementById('stat-chua').textContent  = chuaDi;
                });
        });

        function updateDashboard(data) {
            const ttLabel = ["Chưa về", "Đang về", "Đã đến", "Đang nhập", "Hoàn thành"];
            let dangVe = 0, hoanThanh = 0, chuaDi = 0;

            data.forEach(xe => {
                // ← fix camelCase/PascalCase
                const cx = xe.chuyenHienTai ?? xe.ChuyenHienTai;
                const tt = cx?.trangThai ?? cx?.TrangThai ?? 0;
                const id = xe.id ?? xe.Id;

                if (tt === 1) dangVe++;
                if (tt === 4) hoanThanh++;
                if (tt === 0) chuaDi++;

                const row = document.querySelector(`tr[data-xe-id="${id}"]`);
                if (!row) return;

                const cellTt = row.querySelector('.cell-tt');
                if (cellTt) {
                    cellTt.innerHTML = `<span class="tt-badge tt-${tt}">${ttLabel[tt] ?? '--'}</span>`;
                }
                row.setAttribute('data-tt', tt);

                row.classList.add('row-flash');
                setTimeout(() => row.classList.remove('row-flash'), 1000);
            });

            // ← thêm stat-total
            document.getElementById('stat-total').textContent = data.length;
            document.getElementById('stat-dang').textContent  = dangVe;
            document.getElementById('stat-xong').textContent  = hoanThanh;
            document.getElementById('stat-chua').textContent  = chuaDi;
            document.getElementById('update-time').textContent =
                new Date().toLocaleTimeString('vi-VN');
        }

        dashboardConnection.start()
            .then(() => {
                console.log("✅ SignalR connected");
                document.getElementById("signal-dot").classList.add("connected");
            })
            .catch(err => {
                console.error("❌ SignalR error:", err);
                document.getElementById("signal-dot").classList.add("error");
            });

        // ===== FILTER =====
        function filterTable() {
            const search = document.getElementById('search').value.toLowerCase();
            const tt = document.getElementById('filter-tt').value;
            document.querySelectorAll('#main-table tbody tr').forEach(r => {
                const matchSearch = !search
                    || (r.dataset.bienso || '').includes(search)
                    || (r.dataset.laixe || '').includes(search)
                    || (r.dataset.chinhanh || '').includes(search);
                const matchTt = !tt || r.dataset.tt === tt;
                r.style.display = matchSearch && matchTt ? '' : 'none';
            });
        }
    </script>
}