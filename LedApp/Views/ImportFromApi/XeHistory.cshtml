@model List<LedApp.DTOs.ChuyenXeDto>
@{
    ViewData["Title"] = "Lịch sử chuyến xe";
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var tongChuyen = Model?.Count ?? 0;
    var hoanThanh = Model?.Count(c => c.TrangThai == 4) ?? 0;
    var dangChay = Model?.Count(c => c.TrangThai == 1 || c.TrangThai == 2 || c.TrangThai == 3) ?? 0;
}

<style>
    .page-wrapper > .container-fluid {
        padding: 0 !important;
    }

    .px-page {
        padding: 24px 24px 80px;
    }

    .px-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 12px;
        line-height: 1;
    }

        .px-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

            .px-breadcrumb a:hover {
                color: #111827;
            }

        .px-breadcrumb .sep {
            display: inline-flex;
            align-items: center;
            color: #9ca3af;
        }

            .px-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
                display: block;
            }

        .px-breadcrumb .cur {
            color: #111827;
            font-weight: 600;
        }

    .px-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .px-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 3px;
            line-height: 1.2;
        }

        .px-header p {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all .15s;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }

        .btn-back:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
            text-decoration: none;
        }

        .btn-back svg {
            width: 14px;
            height: 14px;
        }

    /* Stat cards */
    .px-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px 22px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 800;
        line-height: 1.1;
        color: #111827;
    }

    .stat-sub {
        font-size: 0.78rem;
        color: #9ca3af;
    }

    .stat-value.green {
        color: #16a34a;
    }

    .stat-value.blue {
        color: #3b82f6;
    }

    /* Toolbar */
    .px-toolbar-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-tabs {
        display: inline-flex;
        gap: 2px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 3px;
    }

    .filter-tab {
        padding: 5px 14px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 500;
        color: #6b7280;
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        transition: all .15s;
        line-height: 1.4;
        white-space: nowrap;
    }

        .filter-tab:hover {
            color: #374151;
            background: rgba(255,255,255,0.5);
        }

        .filter-tab.active {
            background: #fff;
            color: #111827;
            border-color: #e5e7eb;
            font-weight: 600;
            box-shadow: 0 1px 3px rgba(0,0,0,.1);
        }

    .tb-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: all .15s;
        white-space: nowrap;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .tb-btn:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
        }

        .tb-btn svg {
            width: 14px;
            height: 14px;
            color: #6b7280;
        }

    .count-badge {
        font-size: 0.82rem;
        color: #6b7280;
        font-weight: 500;
    }

        .count-badge span {
            color: #111827;
            font-weight: 700;
        }

    /* Table */
    .px-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .px-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
        table-layout: auto;
    }

        .px-table th:nth-child(2), .px-table td:nth-child(2) {
            width: 120px;
            max-width: 120px;
            overflow: hidden;
        }

        .px-table thead th {
            background: #f9fafb;
            color: #374151;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 10px 14px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
            user-select: none;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .px-table tbody tr.data-row {
            border-bottom: 1px solid #f3f4f6;
            transition: background .1s;
        }

            .px-table tbody tr.data-row:hover {
                background: #f9fafb;
            }

        .px-table td {
            padding: 12px 14px;
            color: #111827;
            vertical-align: middle;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.875rem;
        }

            /* Col widths */
            .px-table th:nth-child(1), .px-table td:nth-child(1) {
                width: 80px;
            }

            .px-table th:nth-child(2), .px-table td:nth-child(2) {
                width: 120px;
            }

            .px-table th:nth-child(3), .px-table td:nth-child(3) {
                width: 110px;
            }

            .px-table th:nth-child(4), .px-table td:nth-child(4) {
                width: 120px;
            }

            .px-table th:nth-child(5), .px-table td:nth-child(5) {
                width: 120px;
            }

            .px-table th:nth-child(6), .px-table td:nth-child(6) {
                width: auto;
                white-space: normal;
                overflow: visible;
            }

            .px-table th:nth-child(7), .px-table td:nth-child(7) {
                width: 120px;
                text-align: center;
            }

            .px-table th:nth-child(8), .px-table td:nth-child(8) {
                width: 90px;
                text-align: center;
            }

    /* Badges */
    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 600;
    }

        .badge-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

    .bp-0 {
        background: #f1f5f9;
        color: #64748b;
    }

        .bp-0::before {
            background: #94a3b8;
        }

    .bp-1 {
        background: #eff6ff;
        color: #3b82f6;
    }

        .bp-1::before {
            background: #3b82f6;
        }

    .bp-2 {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-2::before {
            background: #16a34a;
        }

    .bp-3 {
        background: #fff7ed;
        color: #f97316;
    }

        .bp-3::before {
            background: #f97316;
        }

    .bp-4 {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-4::before {
            background: #16a34a;
        }

    .latest-tag {
        background: #dcfce7;
        color: #16a34a;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 999px;
        margin-left: 6px;
        vertical-align: middle;
    }

    .hang-tag {
        display: inline-flex;
        align-items: center;
        background: #f3f4f6;
        color: #374151;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.76rem;
        margin: 2px;
        font-weight: 500;
    }

    /* Detail row */
    .detail-row {
        display: none;
    }

        .detail-row.open {
            display: table-row;
        }

        .detail-row > td {
            padding: 0 !important;
            border-bottom: 2px solid #e5e7eb !important;
            background: #fafafa;
        }

    .detail-inner {
        padding: 16px 20px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .detail-field label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: .04em;
        display: block;
        margin-bottom: 4px;
    }

    .detail-field div {
        font-size: 0.875rem;
        color: #111827;
        font-weight: 500;
    }

    .btn-toggle {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 10px;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 500;
        color: #374151;
        background: #fff;
        cursor: pointer;
        transition: all .12s;
        white-space: nowrap;
    }

        .btn-toggle:hover {
            background: #f9fafb;
            border-color: #d1d5db;
        }

        .btn-toggle svg {
            width: 12px;
            height: 12px;
            transition: transform .2s;
        }

        .btn-toggle.open svg {
            transform: rotate(90deg);
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

        .empty-state svg {
            width: 40px;
            height: 40px;
            margin-bottom: 12px;
            opacity: .4;
        }

        .empty-state p {
            font-size: 0.875rem;
            margin: 0;
        }

    /* Dark mode */
    body.dark-mode .px-header h1 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .px-header p {
        color: #9ca3af !important;
    }

    body.dark-mode .px-breadcrumb, body.dark-mode .px-breadcrumb a {
        color: #9ca3af !important;
    }

    body.dark-mode .stat-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .stat-label {
        color: #6b7280 !important;
    }

    body.dark-mode .stat-value {
        color: #e2e8f0 !important;
    }

    body.dark-mode .filter-tabs {
        background: #22263a !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .filter-tab {
        color: #9ca3af !important;
    }

        body.dark-mode .filter-tab.active {
            background: #2e3248 !important;
            border-color: #3d4460 !important;
            color: #e2e8f0 !important;
        }

    body.dark-mode .tb-btn {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #9ca3af !important;
    }

    body.dark-mode .btn-back {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .px-card {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .px-table thead th {
        background: #22263a !important;
        color: #6b7280 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .px-table tbody tr.data-row {
        border-color: #2e3248 !important;
    }

        body.dark-mode .px-table tbody tr.data-row:hover {
            background: #22263a !important;
        }

    body.dark-mode .px-table td {
        color: #e2e8f0 !important;
    }

    body.dark-mode .hang-tag {
        background: #2e3248 !important;
        color: #d1d5db !important;
    }

    body.dark-mode .btn-toggle {
        background: #22263a !important;
        border-color: #2e3248 !important;
        color: #d1d5db !important;
    }

    body.dark-mode .detail-row > td {
        background: #141720 !important;
        border-color: #2e3248 !important;
    }

    body.dark-mode .detail-field label {
        color: #6b7280 !important;
    }

    body.dark-mode .detail-field div {
        color: #e2e8f0 !important;
    }

    body.dark-mode .latest-tag {
        background: #052e16 !important;
        color: #4ade80 !important;
    }

    body.dark-mode .bp-0 {
        background: #22263a !important;
        color: #9ca3af !important;
    }

    body.dark-mode .bp-1 {
        background: #1e3a5f !important;
        color: #93c5fd !important;
    }

    body.dark-mode .bp-2 {
        background: #052e16 !important;
        color: #4ade80 !important;
    }

    body.dark-mode .bp-3 {
        background: #2e1a0e !important;
        color: #fb923c !important;
    }

    body.dark-mode .bp-4 {
        background: #052e16 !important;
        color: #4ade80 !important;
    }

    body.dark-mode .count-badge {
        color: #9ca3af !important;
    }

        body.dark-mode .count-badge span {
            color: #e2e8f0 !important;
        }

    .px-search {
        position: relative;
        flex: 1;
        max-width: 280px;
    }

        .px-search svg {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            width: 15px;
            height: 15px;
            pointer-events: none;
        }

        .px-search input {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            color: #111827;
            font-size: 0.875rem;
            padding: 9px 14px 9px 34px;
            width: 100%;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .px-search input::placeholder {
                color: #9ca3af;
            }

            .px-search input:focus {
                border-color: #16a34a;
                box-shadow: 0 0 0 3px rgba(22,163,74,.1);
            }
    /* Dark mode */
    body.dark-mode .px-search input {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode input[type="date"] {
        background: #1a1d27 !important;
        border-color: #2e3248 !important;
        color: #e2e8f0 !important;
    }
</style>

<div class="px-page">

    <div class="px-breadcrumb">
        <a href="/">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <a asp-controller="ImportFromApi" asp-action="Index">Vận chuyển</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">@(ViewBag.BienSo ?? "Lịch sử")</span>
    </div>

    <div class="px-header">
        <div>
            <h1>@(ViewBag.BienSo ?? "Lịch sử chuyến xe")</h1>
            <p>@(ViewBag.TenLaiXe ?? "—") &nbsp;·&nbsp; @(ViewBag.MaChiNhanh ?? "—")</p>
        </div>
        <a href="@Url.Action("Index","ImportFromApi")" class="btn-back">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
            Quay lại
        </a>
    </div>

    <!-- Stat cards -->
    <div class="px-stats">
        <div class="stat-card">
            <span class="stat-label">Tổng chuyến</span>
            <span class="stat-value">@tongChuyen</span>
            <span class="stat-sub">Tất cả chuyến xe</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Hoàn thành</span>
            <span class="stat-value green">@hoanThanh</span>
            <span class="stat-sub">Đã nhập xong</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Đang chạy</span>
            <span class="stat-value blue">@dangChay</span>
            <span class="stat-sub">Đang trên đường</span>
        </div>
    </div>

    <!-- Toolbar -->
    <div style="margin-bottom:16px;">
        <!-- Hàng 1: filter tabs -->
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
            <div class="filter-tabs">
                <button class="filter-tab active" data-tt="">Tất cả</button>
                <button class="filter-tab" data-tt="0">Chưa về</button>
                <button class="filter-tab" data-tt="1">Đang về</button>
                <button class="filter-tab" data-tt="2">Đã đến</button>
                <button class="filter-tab" data-tt="3">Đang nhập</button>
                <button class="filter-tab" data-tt="4">Hoàn thành</button>
            </div>
        </div>
        <!-- Hàng 2: date filter + sort + count + search -->
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="font-size:0.82rem;color:#6b7280;font-weight:500;white-space:nowrap;">Ngày dự kiến:</span>
            <input type="date" id="dateFrom" onchange="filterRows()"
                   style="border:1px solid #e5e7eb;border-radius:8px;padding:7px 10px;font-size:0.82rem;color:#374151;background:#fff;outline:none;cursor:pointer;">
            <span style="font-size:0.82rem;color:#9ca3af;">→</span>
            <input type="date" id="dateTo" onchange="filterRows()"
                   style="border:1px solid #e5e7eb;border-radius:8px;padding:7px 10px;font-size:0.82rem;color:#374151;background:#fff;outline:none;cursor:pointer;">
            <div style="flex:1;"></div>
            <span class="count-badge"><span id="countLabel">@tongChuyen</span> chuyến</span>
            <button class="tb-btn" id="btnSortDesc" onclick="sortRows('desc')">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0-3.75-3.75M17.25 21 21 17.25" /></svg>
                Mới nhất
            </button>
            <button class="tb-btn" id="btnSortAsc" onclick="sortRows('asc')">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h5.25m5.25-.75L17.25 9m0 0L21 12.75M17.25 9v12" /></svg>
                Cũ nhất
            </button>
            <div class="px-search" style="max-width:200px;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <input type="text" id="searchInput" placeholder="Tìm mã chuyến..." oninput="filterRows()" />
            </div>
            <button class="tb-btn" onclick="resetFilter()" title="Reset bộ lọc">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                Reset
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="px-card">
        <table id="table" class="px-table">
            <thead>
                <tr>
                    <th>Lần</th>
                    <th>Mã chuyến</th>
                    <th>Ngày dự kiến</th>
                    <th>Thời gian đến</th>
                    <th>Hoàn thành</th>
                    <th>Hàng hóa</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z" /></svg>
                                <p>Không có dữ liệu.</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cx in Model)
                    {
                        var tt = cx.TrangThai;
                        var ttLabels = new[] { "Chưa về", "Đang về", "Đã đến", "Đang nhập", "Hoàn thành" };
                        var ttLabel = tt < ttLabels.Length ? ttLabels[tt] : "--";

                        <tr class="data-row" data-tt="@tt" data-ngay="@cx.NgayDuKien.Ticks">
                            <td>
                                Lần @cx.LanThu
                                @if (cx.IsLatest)
                                {
                                    <span class="latest-tag">Mới nhất</span>
                                }
                            </td>
                            <td style="font-weight:600;">@cx.MaChuyenApi</td>
                            <td style="color:#6b7280;font-size:0.82rem;">@cx.NgayDuKien.ToString("dd/MM HH:mm")</td>
                            <td style="color:#6b7280;font-size:0.82rem;">@(cx.ThoiGianDen?.ToString("dd/MM HH:mm") ?? "—")</td>
                            <td style="color:#6b7280;font-size:0.82rem;">@(cx.ThoiGianHoanThanh?.ToString("dd/MM HH:mm") ?? "—")</td>
                            <td>
                                @if (cx.HangHoas != null && cx.HangHoas.Any())
                                {
                                    foreach (var h in cx.HangHoas)
                                    {
                                        <span class="hang-tag">@h.SoLuong @h.DonVi</span>
                                    }
                                }
                                else
                                {
                                    <span style="color:#d1d5db;">—</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                <span class="badge-pill bp-@tt">@ttLabel</span>
                            </td>
                            <td style="text-align:center;">
                                <button class="btn-toggle" id="btn-@cx.Id" onclick="toggle(@cx.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                                    Chi tiết
                                </button>
                            </td>
                        </tr>

                        <tr id="d-@cx.Id" class="detail-row">
                            <td colspan="8">
                                <div class="detail-inner">
                                    <div class="detail-field">
                                        <label>Mã chuyến API</label>
                                        <div>@cx.MaChuyenApi</div>
                                    </div>
                                    <div class="detail-field">
                                        <label>Ngày dự kiến</label>
                                        <div>@cx.NgayDuKien.ToString("HH:mm - dd/MM/yyyy")</div>
                                    </div>
                                    <div class="detail-field">
                                        <label>Thời gian đến</label>
                                        <div>@(cx.ThoiGianDen?.ToString("HH:mm - dd/MM/yyyy") ?? "—")</div>
                                    </div>
                                    <div class="detail-field">
                                        <label>Hoàn thành lúc</label>
                                        <div>@(cx.ThoiGianHoanThanh?.ToString("HH:mm - dd/MM/yyyy") ?? "—")</div>
                                    </div>
                                    <div class="detail-field">
                                        <label>Trạng thái</label>
                                        <div>@ttLabel</div>
                                    </div>
                                    <div class="detail-field">
                                        <label>Hàng hóa</label>
                                        <div>
                                            @if (cx.HangHoas != null && cx.HangHoas.Any())
                                            {
                                                @string.Join(", ", cx.HangHoas.Select(h => $"{h.SoLuong} {h.DonVi}"))
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // Filter tabs
    document.querySelectorAll('.filter-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            filterRows();
        });
    });

    function filterRows() {
        const activeTab = document.querySelector('.filter-tab.active');
        const tt = activeTab ? activeTab.dataset.tt : '';
        const search = (document.getElementById('searchInput')?.value || '').toLowerCase();
        const fromVal = document.getElementById('dateFrom')?.value;
        const toVal   = document.getElementById('dateTo')?.value;
        const fromMs  = fromVal ? new Date(fromVal).getTime() : null;
        const toMs    = toVal   ? new Date(toVal + 'T23:59:59').getTime() : null;
        let count = 0;

        document.querySelectorAll('#table tbody .data-row').forEach(r => {
            const matchTt = !tt || r.dataset.tt === tt;
            const text = r.textContent.toLowerCase();
            const matchSearch = !search || text.includes(search);

            // Convert .NET Ticks → JS ms
            const ticks = parseInt(r.dataset.ngay) || 0;
            const ngayMs = ticks > 0 ? (ticks / 10000) - 62135596800000 : null;
            const matchFrom = !fromMs || (ngayMs !== null && ngayMs >= fromMs);
            const matchTo   = !toMs   || (ngayMs !== null && ngayMs <= toMs);

            const show = matchTt && matchSearch && matchFrom && matchTo;
            r.style.display = show ? '' : 'none';
            const dr = r.nextElementSibling;
            if (dr && dr.classList.contains('detail-row')) {
                if (!show) dr.classList.remove('open');
                dr.style.display = show ? '' : 'none';
            }
            if (show) count++;
        });
        document.getElementById('countLabel').textContent = count;
    }
    function resetFilter() {
        document.getElementById('searchInput').value = '';
        document.getElementById('dateFrom').value = '';
        document.getElementById('dateTo').value = '';
        // Reset filter tabs về Tất cả
        document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
        document.querySelector('.filter-tab[data-tt=""]').classList.add('active');
        // Reset sort highlight
        document.getElementById('btnSortDesc').style.borderColor = '';
        document.getElementById('btnSortDesc').style.color = '';
        document.getElementById('btnSortAsc').style.borderColor = '';
        document.getElementById('btnSortAsc').style.color = '';
        filterRows();
    }
    function sortRows(dir) {
        const tbody = document.querySelector('#table tbody');
        const pairs = [];
        document.querySelectorAll('.data-row').forEach(r => {
            pairs.push({ data: r, detail: r.nextElementSibling });
        });
        pairs.sort((a, b) => dir === 'desc'
            ? parseInt(b.data.dataset.ngay) - parseInt(a.data.dataset.ngay)
            : parseInt(a.data.dataset.ngay) - parseInt(b.data.dataset.ngay));
        pairs.forEach(p => { tbody.appendChild(p.data); tbody.appendChild(p.detail); });

        // highlight active sort btn
        document.getElementById('btnSortDesc').style.borderColor = dir === 'desc' ? '#16a34a' : '';
        document.getElementById('btnSortDesc').style.color = dir === 'desc' ? '#16a34a' : '';
        document.getElementById('btnSortAsc').style.borderColor = dir === 'asc' ? '#16a34a' : '';
        document.getElementById('btnSortAsc').style.color = dir === 'asc' ? '#16a34a' : '';
    }

    function toggle(id) {
        const row = document.getElementById('d-' + id);
        const btn = document.getElementById('btn-' + id);
        const open = row.classList.toggle('open');
        btn.classList.toggle('open', open);
        btn.querySelector('span') && (btn.querySelector('span').textContent = open ? 'Thu gọn' : 'Chi tiết');
    }

    // Init sort desc
    sortRows('desc');
</script>
