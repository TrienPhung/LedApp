@model LedApp.Models.CanhBao
@{
    ViewData["Title"] = "Chi tiết cảnh báo #" + Model.Id;
    Layout = "~/Views/Shared/_Layout1.cshtml";

    string trangThaiClass = Model.TrangThai switch
    {
        (int)LedApp.Models.TrangThaiCanhBao.ChuaXuLy => "bp-chua-xu-ly",
        (int)LedApp.Models.TrangThaiCanhBao.DangXuLy => "bp-dang-xu-ly",
        (int)LedApp.Models.TrangThaiCanhBao.DaXuLy => "bp-da-xu-ly",
        _ => "bp-chua-xu-ly"
    };
    string trangThaiLabel = Model.TrangThai switch
    {
        (int)LedApp.Models.TrangThaiCanhBao.ChuaXuLy => "Chưa xử lý",
        (int)LedApp.Models.TrangThaiCanhBao.DangXuLy => "Đang xử lý",
        (int)LedApp.Models.TrangThaiCanhBao.DaXuLy => "Đã xử lý",
        _ => "Chưa xử lý"
    };
    string loaiBadge = (Model.LoaiPhieu ?? "").ToUpper() == "XUAT" ? "lp-xuat"
                     : (Model.LoaiPhieu ?? "").ToUpper() == "NHAP" ? "lp-nhap" : "lp-other";
}

<style>
    :root {
        --ap-bg: #f9fafb;
        --ap-surface: #ffffff;
        --ap-border: #e5e7eb;
        --ap-border-lt: #f3f4f6;
        --ap-text-1: #111827;
        --ap-text-2: #6b7280;
        --ap-text-3: #9ca3af;
        --ap-green: #16a34a;
        --ap-green-bg: #dcfce7;
        --ap-blue: #2563eb;
        --ap-red: #dc2626;
        --ap-orange: #d97706;
        --ap-radius: 12px;
        --ap-shadow: 0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
        --ap-shadow-md: 0 4px 6px -1px rgba(0,0,0,.07),0 2px 4px -1px rgba(0,0,0,.04);
    }

    body.dark-mode {
        --ap-surface: #1e293b;
        --ap-border: #334155;
        --ap-border-lt: #1e293b;
        --ap-text-1: #f1f5f9;
        --ap-text-2: #94a3b8;
        --ap-text-3: #64748b;
    }

    .dt-wrap {
        padding: 0 0 40px;
    }

    .dt-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--ap-text-2);
        margin-bottom: 14px;
    }

        .dt-breadcrumb a {
            color: var(--ap-text-2);
            text-decoration: none;
        }

            .dt-breadcrumb a:hover {
                color: var(--ap-text-1);
            }

        .dt-breadcrumb .sep {
            color: var(--ap-text-3);
            display: flex;
            align-items: center;
        }

            .dt-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
            }

        .dt-breadcrumb .cur {
            color: var(--ap-text-1);
            font-weight: 600;
        }

    .dt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        gap: 16px;
        flex-wrap: wrap;
    }

        .dt-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--ap-text-1);
            margin: 0;
            letter-spacing: -.3px;
        }

    .dt-header-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .btn-apex {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid var(--ap-border);
        background: var(--ap-surface);
        color: var(--ap-text-2);
        transition: all .15s;
        box-shadow: var(--ap-shadow);
    }

        .btn-apex:hover {
            background: var(--ap-border-lt);
            color: var(--ap-text-1);
            text-decoration: none;
        }

        .btn-apex svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

        .btn-apex.edit {
            color: var(--ap-text-1);
        }

            .btn-apex.edit:hover {
                background: var(--ap-border-lt);
                border-color: #d1d5db;
            }

        .btn-apex.danger {
            background: var(--ap-red);
            border-color: var(--ap-red);
            color: #fff;
        }

            .btn-apex.danger:hover {
                background: #b91c1c;
                border-color: #b91c1c;
                color: #fff;
            }

    .dt-grid {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 16px;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .dt-grid {
            grid-template-columns: 1fr;
        }
    }

    .ap-panel {
        background: var(--ap-surface);
        border: 1px solid var(--ap-border);
        border-radius: var(--ap-radius);
        box-shadow: var(--ap-shadow);
        overflow: hidden;
        margin-bottom: 16px;
    }

        .ap-panel:last-child {
            margin-bottom: 0;
        }

    .ap-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--ap-border-lt);
    }

    .ap-panel-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--ap-text-1);
    }

    .ap-panel-body {
        padding: 0;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 180px 1fr;
        padding: 14px 20px;
        border-bottom: 1px solid var(--ap-border-lt);
        align-items: start;
        gap: 12px;
        transition: background .1s;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row:hover {
            background: var(--ap-border-lt);
        }

    .detail-key {
        font-size: 12.5px;
        font-weight: 500;
        color: var(--ap-text-2);
        padding-top: 1px;
    }

    .detail-val {
        font-size: 13.5px;
        color: var(--ap-text-1);
        font-weight: 500;
        word-break: break-word;
    }

        .detail-val.muted {
            color: var(--ap-text-3);
            font-weight: 400;
            font-style: italic;
        }

    /* badges */
    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

        .badge-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }

    .bp-chua-xu-ly {
        background: #fef2f2;
        color: #ef4444;
    }

        .bp-chua-xu-ly::before {
            background: #ef4444;
        }

    .bp-dang-xu-ly {
        background: #fef9c3;
        color: #ca8a04;
    }

        .bp-dang-xu-ly::before {
            background: #ca8a04;
        }

    .bp-da-xu-ly {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-da-xu-ly::before {
            background: #16a34a;
        }

    .lp-xuat {
        background: #fef9c3;
        color: #ca8a04;
    }

    .lp-nhap {
        background: #dbeafe;
        color: #2563eb;
    }

    .lp-other {
        background: #f3f4f6;
        color: #6b7280;
    }

    .lcb-badge {
        display: inline-flex;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: #f5f3ff;
        color: #7c3aed;
    }

    /* sidebar */
    .sidebar-meta {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 16px 20px;
    }

    .meta-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--ap-text-3);
        margin-bottom: 5px;
    }

    .meta-value {
        font-size: 13px;
        font-weight: 600;
        color: var(--ap-text-1);
    }

        .meta-value.muted {
            color: var(--ap-text-3);
            font-weight: 400;
            font-style: italic;
        }

    /* timeline */
    .tl-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 20px;
        border-bottom: 1px solid var(--ap-border-lt);
    }

        .tl-row:last-child {
            border-bottom: none;
        }

    .tl-dot-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        padding-top: 3px;
    }

    .tl-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 2px solid;
        flex-shrink: 0;
        background: var(--ap-surface);
    }

        .tl-dot.filled {
            background: currentColor;
        }

    .tl-body {
        flex: 1;
    }

    .tl-title {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--ap-text-1);
    }

    .tl-time {
        font-size: 11.5px;
        color: var(--ap-text-2);
        margin-top: 2px;
    }

        .tl-time.pending {
            color: var(--ap-text-3);
            font-style: italic;
        }

    /* delete modal */
    .del-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .del-overlay.open {
            display: flex;
        }

    .del-modal {
        background: var(--ap-surface);
        border-radius: 12px;
        padding: 24px;
        max-width: 380px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        position: relative;
    }

    .del-modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        background: none;
        border: none;
        color: var(--ap-text-3);
        cursor: pointer;
        font-size: 18px;
        line-height: 1;
        padding: 4px 6px;
        border-radius: 6px;
        transition: all .15s;
    }

        .del-modal-close:hover {
            background: var(--ap-border-lt);
            color: var(--ap-text-1);
        }

    .del-modal h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--ap-text-1);
        margin: 0 0 8px;
    }

    .del-modal p {
        font-size: 13px;
        color: var(--ap-text-2);
        line-height: 1.55;
        margin: 0 0 20px;
    }

    .del-modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-cancel {
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid var(--ap-border);
        background: var(--ap-surface);
        color: var(--ap-text-1);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-cancel:hover {
            background: var(--ap-border-lt);
        }

    .btn-confirm-del {
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        background: var(--ap-red);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-confirm-del:hover {
            background: #b91c1c;
        }

    body.dark-mode .ap-panel {
        background: var(--ap-surface) !important;
        border-color: var(--ap-border) !important;
    }

    body.dark-mode .detail-row:hover {
        background: rgba(255,255,255,.03);
    }

    body.dark-mode .btn-apex {
        background: var(--ap-surface) !important;
        border-color: var(--ap-border) !important;
        color: var(--ap-text-2) !important;
    }

        body.dark-mode .btn-apex.danger {
            background: var(--ap-red) !important;
            border-color: var(--ap-red) !important;
            color: #fff !important;
        }
</style>

<div class="dt-wrap">

    <div class="dt-breadcrumb">
        <a href="/Dashboard">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <a asp-action="Index">Cảnh báo</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">Cảnh báo #@Model.Id</span>
    </div>

    <div class="dt-header">
        <h1>Cảnh báo #@Model.Id</h1>
        <div class="dt-header-actions">
            <a asp-action="Index" class="btn-apex">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
                Trở về
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-apex edit">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
                Edit
            </a>
            <button class="btn-apex danger" onclick="openDelModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                Delete
            </button>
        </div>
    </div>

    <div class="dt-grid">

        <!-- LEFT: Main details -->
        <div>
            <div class="ap-panel">
                <div class="ap-panel-head">
                    <span class="ap-panel-title">Thông tin cảnh báo</span>
                    <span class="badge-pill @trangThaiClass">@trangThaiLabel</span>
                </div>
                <div class="ap-panel-body">
                    <div class="detail-row">
                        <span class="detail-key">Loại phiếu</span>
                        <span class="detail-val">
                            <span class="badge-pill @loaiBadge" style="font-size:12px;">@Model.LoaiPhieu</span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Phiếu ID</span>
                        <span class="detail-val" style="font-family:monospace;">#@Model.PhieuId</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Loại cảnh báo</span>
                        <span class="detail-val"><span class="lcb-badge">@Model.LoaiCanhBao</span></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Thời gian</span>
                        <span class="detail-val">@Model.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Trạng thái</span>
                        <span class="detail-val">
                            <span class="badge-pill @trangThaiClass">@trangThaiLabel</span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Ghi chú</span>
                        <span class="detail-val @(string.IsNullOrWhiteSpace(Model.GhiChu) ? "muted" : "")">
                            @(string.IsNullOrWhiteSpace(Model.GhiChu) ? "—" : Model.GhiChu)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Sidebar -->
        <div>
            <!-- Meta -->
            <div class="ap-panel">
                <div class="ap-panel-head">
                    <span class="ap-panel-title">Tóm tắt</span>
                </div>
                <div class="sidebar-meta">
                    <div>
                        <div class="meta-label">Trạng thái</div>
                        <span class="badge-pill @trangThaiClass" style="font-size:13px;padding:6px 12px;">@trangThaiLabel</span>
                    </div>
                    <div>
                        <div class="meta-label">Mã cảnh báo</div>
                        <div class="meta-value" style="font-family:monospace;">#@Model.Id</div>
                    </div>
                    <div>
                        <div class="meta-label">Loại phiếu</div>
                        <div class="meta-value">
                            <span class="badge-pill @loaiBadge" style="font-size:12px;">@Model.LoaiPhieu</span>
                        </div>
                    </div>
                    <div>
                        <div class="meta-label">Phiếu ID</div>
                        <div class="meta-value" style="font-family:monospace;">#@Model.PhieuId</div>
                    </div>
                    <div>
                        <div class="meta-label">Loại cảnh báo</div>
                        <div class="meta-value"><span class="lcb-badge">@Model.LoaiCanhBao</span></div>
                    </div>
                </div>
            </div>

            <!-- Timeline trạng thái -->
            <div class="ap-panel">
                <div class="ap-panel-head">
                    <span class="ap-panel-title">🕐 Tiến trình xử lý</span>
                </div>
                <!-- Chưa xử lý -->
                <div class="tl-row">
                    <div class="tl-dot-wrap">
                        <div class="tl-dot filled" style="color:#ef4444;border-color:#ef4444;"></div>
                    </div>
                    <div class="tl-body">
                        <div class="tl-title">Chưa xử lý</div>
                        <div class="tl-time">
                            @if (Model.TrangThai >= (int)LedApp.Models.TrangThaiCanhBao.ChuaXuLy)
                            {
                                <span>@Model.ThoiGian.ToString("HH:mm — dd/MM/yyyy")</span>
                            }
                            else
                            {
                                <span class="pending">—</span>
                            }
                        </div>
                    </div>
                </div>
                <!-- Đang xử lý -->
                <div class="tl-row">
                    <div class="tl-dot-wrap">
                        <div class="tl-dot @(Model.TrangThai >= (int)LedApp.Models.TrangThaiCanhBao.DangXuLy ? "filled" : "")"
                             style="color:#ca8a04;border-color:@(Model.TrangThai >= (int)LedApp.Models.TrangThaiCanhBao.DangXuLy ? "#ca8a04" : "var(--ap-border)");"></div>
                    </div>
                    <div class="tl-body">
                        <div class="tl-title">Đang xử lý</div>
                        <div class="tl-time @(Model.TrangThai >= (int)LedApp.Models.TrangThaiCanhBao.DangXuLy ? "" : "pending")">
                            @(Model.TrangThai >= (int)LedApp.Models.TrangThaiCanhBao.DangXuLy ? "Đang tiến hành" : "Chưa bắt đầu")
                        </div>
                    </div>
                </div>
                <!-- Đã xử lý -->
                <div class="tl-row">
                    <div class="tl-dot-wrap">
                        <div class="tl-dot @(Model.TrangThai == (int)LedApp.Models.TrangThaiCanhBao.DaXuLy ? "filled" : "")"
                             style="color:#16a34a;border-color:@(Model.TrangThai == (int)LedApp.Models.TrangThaiCanhBao.DaXuLy ? "#16a34a" : "var(--ap-border)");"></div>
                    </div>
                    <div class="tl-body">
                        <div class="tl-title">Đã xử lý</div>
                        <div class="tl-time @(Model.TrangThai == (int)LedApp.Models.TrangThaiCanhBao.DaXuLy ? "" : "pending")">
                            @(Model.TrangThai == (int)LedApp.Models.TrangThaiCanhBao.DaXuLy ? "Hoàn tất xử lý" : "Chưa xử lý xong")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="del-overlay" id="delOverlay">
    <div class="del-modal">
        <button class="del-modal-close" onclick="closeDelModal()">×</button>
        <h3>Xóa cảnh báo</h3>
        <p>Bạn có chắc chắn muốn xóa cảnh báo <strong>#@Model.Id — @Model.LoaiCanhBao</strong>? Hành động này không thể hoàn tác.</p>
        <div class="del-modal-foot">
            <button class="btn-cancel" onclick="closeDelModal()">Hủy</button>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-confirm-del">Xóa</button>
            </form>
        </div>
    </div>
</div>

<script>
    function openDelModal()  { document.getElementById('delOverlay').classList.add('open');    document.body.style.overflow = 'hidden'; }
    function closeDelModal() { document.getElementById('delOverlay').classList.remove('open'); document.body.style.overflow = ''; }
    document.getElementById('delOverlay').addEventListener('click', e => { if (e.target === document.getElementById('delOverlay')) closeDelModal(); });
</script>
