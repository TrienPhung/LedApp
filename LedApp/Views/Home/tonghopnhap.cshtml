@{
    ViewData["Title"] = "tonghopnhap";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .led7 td, .led7 th {
        border: none;
    }
</style>
<div class="led7" style="width:@{
    @ViewBag.THNhapW
}px; height:@{
    @ViewBag.THNhapH
}px; background:#0d0d0d; color:#fff; font-family:monospace; padding:10px; border-radius:7px; border:1.5px solid #1a1a1a; position:relative;">

    @* {{-- Hàng trên: giờ bên trái, tên khu vực bên phải --}} *@
    <div style="display:flex; justify-content:space-between; font-size:12px; color:#555; margin-bottom:6px;">
        <span><span class="hour"></span>:<span class="min"></span></span>
        <span>@ViewBag.THNhapTen</span>
    </div>

    @* {{-- Tiêu đề giữa --}} *@
    <h2 style="text-align:center; font-size:18px; letter-spacing:3px; color:#fff; margin-bottom:8px;">NHẬP</h2>

    @* {{-- Đường kẻ --}} *@
    <div style="border-top:1px solid #222; margin-bottom:6px;"></div>

    @* {{-- Bảng dữ liệu --}} *@
    <table style="width:100%; border-collapse:collapse; font-size:12px;">
        <thead>
            <tr style="border-bottom:1px solid #222;">
                <td style="width:33%; text-align:center; color:#555; padding-bottom:4px; border-right:1px solid #222;">Sắp về</td>
                <td style="width:33%; text-align:center; color:#555; padding-bottom:4px; border-right:1px solid #222;">Đã về</td>
                <td style="width:33%; text-align:center; color:#555; padding-bottom:4px;">Chưa vào cửa</td>
            </tr>
        </thead>
        <tbody id="led7">
            @* {{-- JS sẽ đổ dữ liệu vào đây --}} *@
        </tbody>
    </table>

    @* {{-- Đường kẻ --}} *@
    <div style="border-top:1px solid #222; margin-top:8px; margin-bottom:6px;"></div>

    @* {{-- Thanh trạng thái --}} *@
    <div id="tong-strip-nhap" style="background:#0c2a4a; color:#93c5fd; text-align:center; font-size:11px; font-weight:700; letter-spacing:.6px; padding:4px; border-radius:5px;">
        Hoạt động bình thường
    </div>
</div>