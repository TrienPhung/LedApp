@model List<LedApp.DTOs.DanhSachXeDto>
@{
    ViewData["Title"] = "Màn hình bảo vệ";
    Layout = "~/Views/Shared/_LayoutApi.cshtml";
}

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: #0a0f1e;
        color: #e2e8f0;
        font-family: 'Segoe UI', Arial, sans-serif;
        min-height: 100vh;
    }

    .screen {
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 16px;
        gap: 12px;
    }

    /* ===== HEADER ===== */
    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 10px;
        padding: 12px 20px;
        flex-shrink: 0;
    }

    .topbar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .shield-icon {
        font-size: 28px;
    }

    .topbar-title {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #f1f5f9;
    }

    .topbar-sub {
        font-size: 11px;
        color: #64748b;
        margin-top: 2px;
    }

    .topbar-center {
        text-align: center;
    }

    .clock {
        font-size: 32px;
        font-weight: 700;
        color: #facc15;
        letter-spacing: 2px;
        font-variant-numeric: tabular-nums;
    }

    .date-str {
        font-size: 11px;
        color: #64748b;
        margin-top: 2px;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 16px;
        text-align: right;
    }

    .badge-count {
        background: #1e3a5f;
        border: 1px solid #3b82f6;
        border-radius: 8px;
        padding: 6px 14px;
        text-align: center;
    }

        .badge-count .num {
            font-size: 22px;
            font-weight: 700;
            color: #3b82f6;
        }

        .badge-count .lbl {
            font-size: 10px;
            color: #64748b;
        }

    .signal-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: #64748b;
    }

    .signal-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #475569;
    }

        .signal-dot.connected {
            background: #4ade80;
            box-shadow: 0 0 6px #4ade80;
        }

        .signal-dot.error {
            background: #f87171;
        }

    /* ===== BODY ===== */
    .body {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    /* ===== XE CARD ===== */
    .xe-card {
        background: #0f172a;
        border: 1px solid #1e293b;
        border-left: 4px solid #3b82f6;
        border-radius: 10px;
        padding: 14px 20px;
        display: grid;
        grid-template-columns: 2fr 1.2fr 1.2fr auto;
        align-items: center;
        gap: 16px;
        transition: opacity 0.4s, transform 0.4s;
    }

        .xe-card.new-arrived {
            border-left-color: #facc15;
            animation: flashCard 1s ease;
        }

    @@keyframes flashCard {
        0%

    {
        background: #1c1a05;
    }

    100% {
        background: #0f172a;
    }

    }

    .xe-card.removing {
        opacity: 0;
        transform: translateX(60px);
    }

    /* Cột 1 - Xe info */
    .bien-so {
        font-size: 22px;
        font-weight: 700;
        color: #facc15;
        letter-spacing: 1px;
    }

    .lai-xe {
        font-size: 12px;
        color: #64748b;
        margin-top: 3px;
    }

    .hang-hoa {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .hang {
        background: #1e293b;
        border: 1px solid #334155;
        padding: 3px 10px;
        border-radius: 5px;
        font-size: 12px;
        color: #93c5fd;
    }

    /* Cột 2 - Thời gian */
    .meta-block {
        background: #0c1525;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 10px 14px;
        text-align: center;
    }

    .meta-label {
        font-size: 10px;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .meta-value {
        font-size: 18px;
        font-weight: 700;
        color: #93c5fd;
        margin-top: 2px;
    }

    .meta-sub {
        font-size: 10px;
        color: #475569;
        margin-top: 2px;
    }

    /* Cột 3 - Chuyến */
    .chuyen-block {
        background: #0c1525;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 10px 14px;
        text-align: center;
    }

    .chuyen-ma {
        font-size: 13px;
        font-weight: 600;
        color: #e2e8f0;
    }

    .chuyen-lan {
        font-size: 11px;
        color: #475569;
        margin-top: 4px;
    }

    /* Cột 4 - Nút */
    .btn-xacnhan {
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: white;
        border: none;
        padding: 14px 22px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(22,163,74,0.3);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

        .btn-xacnhan .btn-icon {
            font-size: 18px;
        }

        .btn-xacnhan:hover {
            background: linear-gradient(135deg, #15803d, #166534);
            box-shadow: 0 4px 14px rgba(22,163,74,0.5);
            transform: translateY(-1px);
        }

        .btn-xacnhan:active {
            transform: scale(0.97);
        }

        .btn-xacnhan:disabled {
            background: #1e293b;
            color: #475569;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    /* ===== EMPTY ===== */
    .empty-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: #334155;
        font-size: 15px;
    }

    .empty-icon {
        font-size: 48px;
    }

    /* ===== FOOTER ===== */
    .footer {
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 11px;
        color: #334155;
        display: flex;
        justify-content: space-between;
        flex-shrink: 0;
    }
</style>

<div class="screen">

    <!-- TOPBAR -->
    <div class="topbar">
        <div class="topbar-left">
            <div class="shield-icon">🛡️</div>
            <div>
                <div class="topbar-title">TRẠM BẢO VỆ</div>
                <div class="topbar-sub">Xác nhận xe vào bãi</div>
            </div>
        </div>

        <div class="topbar-center">
            <div class="clock" id="clock">--:--:--</div>
            <div class="date-str" id="date-str">--/--/----</div>
        </div>

        <div class="topbar-right">
            <div class="badge-count">
                <div class="num" id="xe-count">@(Model?.Count ?? 0)</div>
                <div class="lbl">Xe đang chờ</div>
            </div>
            <div class="signal-wrap">
                <span class="signal-dot" id="signal-dot"></span>
                <span id="signal-text">Đang kết nối...</span>
            </div>
        </div>
    </div>

    <!-- BODY -->
    <div class="body" id="xe-list">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">✅</div>
                <div>Không có xe nào đang chờ vào bãi</div>
            </div>
        }
        else
        {
            @foreach (var xe in Model)
            {
                var cx = xe.ChuyenHienTai;
                <div class="xe-card" id="card-@cx!.Id" data-chuyen-id="@cx.Id">

                    <!-- Cột 1: Xe info -->
                    <div>
                        <div class="bien-so">@xe.BienSo</div>
                        <div class="lai-xe">👤 @xe.TenLaiXe &nbsp;|&nbsp; 🏢 @xe.MaChiNhanh</div>
                        <div class="hang-hoa">
                            @foreach (var h in cx.HangHoas)
                            {
                                <span class="hang">📦 @h.SoLuong @h.DonVi</span>
                            }
                        </div>
                    </div>

                    <!-- Cột 2: Thời gian dự kiến -->
                    <div class="meta-block">
                        <div class="meta-label">Dự kiến về</div>
                        <div class="meta-value">@cx.NgayDuKien.ToString("HH:mm")</div>
                        <div class="meta-sub">@cx.NgayDuKien.ToString("dd/MM/yyyy")</div>
                    </div>

                    <!-- Cột 3: Thông tin chuyến -->
                    <div class="chuyen-block">
                        <div class="meta-label">Mã chuyến</div>
                        <div class="chuyen-ma">@cx.MaChuyenApi</div>
                        <div class="chuyen-lan">Lần thứ @cx.LanThu</div>
                    </div>

                    <!-- Cột 4: Nút xác nhận -->
                    <button class="btn-xacnhan" onclick="xacNhan(@cx.Id, '@xe.BienSo', this)">
                        <span class="btn-icon">✔</span>
                        <span>Xác nhận vào bãi</span>
                    </button>

                </div>
            }
        }
    </div>

    <!-- FOOTER -->
    <div class="footer">
        <span>© Hệ thống quản lý kho — Trạm bảo vệ</span>
        <span id="update-time">Cập nhật: @DateTime.Now.ToString("HH:mm:ss dd/MM/yyyy")</span>
    </div>

</div>

@section Scripts {
    <script>
        // --- Đồng hồ ---
        function updateClock() {
            const now = new Date();
            document.getElementById('clock').textContent =
                now.toLocaleTimeString('vi-VN', { hour12: false });
            document.getElementById('date-str').textContent =
                now.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
            document.getElementById('update-time').textContent =
                'Cập nhật: ' + now.toLocaleTimeString('vi-VN');
        }
        setInterval(updateClock, 1000);
        updateClock();

        // --- SignalR ---
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/signalserver")
            .build();

        connection.start()
            .then(() => {
                document.getElementById('signal-dot').classList.add('connected');
                document.getElementById('signal-text').textContent = 'Realtime';
            })
            .catch(() => {
                document.getElementById('signal-dot').classList.add('error');
                document.getElementById('signal-text').textContent = 'Mất kết nối';
            });

        connection.on("TrangThaiXeUpdated", (chuyenId, trangThai) => {
            if (trangThai === 2) removeCard(chuyenId);
        });

        // --- Xác nhận ---
        async function xacNhan(chuyenId, bienSo, btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-icon">⏳</span><span>Đang xử lý...</span>';

            try {
                const res = await fetch('@Url.Action("XacNhanVaoBai", "BaoVe")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ chuyenId, bienSo })
                });

                if (res.ok) {
                    removeCard(chuyenId);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<span class="btn-icon">✔</span><span>Xác nhận vào bãi</span>';
                }
            } catch (e) {
                btn.disabled = false;
                btn.innerHTML = '<span class="btn-icon">✔</span><span>Xác nhận vào bãi</span>';
            }
        }

        // --- Xóa card ---
        function removeCard(chuyenId) {
            const card = document.getElementById(`card-${chuyenId}`);
            if (!card) return;
            card.classList.add('removing');
            setTimeout(() => {
                card.remove();
                const count = document.querySelectorAll('.xe-card').length;
                document.getElementById('xe-count').textContent = count;
                if (count === 0) {
                    document.getElementById('xe-list').innerHTML = `
                        <div class="empty-state">
                            <div class="empty-icon">✅</div>
                            <div>Không có xe nào đang chờ vào bãi</div>
                        </div>`;
                }
            }, 400);
        }
    </script>
}