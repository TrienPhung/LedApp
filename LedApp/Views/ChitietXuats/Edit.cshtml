@model LedApp.Models.ChitietXuat
@{
    ViewData["Title"] = "Sửa";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Sửa chi tiết xuất</h1>
<h4>Chi tiết xuất</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="XuatId" class="control-label"></label>
                <select asp-for="XuatId" class="form-control" asp-items="ViewBag.XuatId"></select>
                <span asp-validation-for="XuatId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DonVi" class="control-label"></label>
                <input asp-for="DonVi" class="form-control" />
                <span asp-validation-for="DonVi" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ChuaBG" class="control-label"></label>
                <input asp-for="ChuaBG" class="form-control" />
                <span asp-validation-for="ChuaBG" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DaBG" class="control-label"></label>
                <input asp-for="DaBG" class="form-control" />
                <span asp-validation-for="DaBG" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu sửa" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Trở về</a>
</div>