@model LedApp.Models.ChitietXuat
@{
    ViewData["Title"] = "Thêm chi tiết xuất";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Thêm chi tiết xuất hàng</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="XuatId" class="control-label"></label>
                <select asp-for="XuatId" class="form-control" asp-items="ViewBag.XuatId"></select>
                <span asp-validation-for="XuatId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DonVi" class="control-label"></label>
                <input asp-for="DonVi" class="form-control" placeholder="VD: Tải, Kiện, ĐH..." />
                <span asp-validation-for="DonVi" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ChuaBG" class="control-label"></label>
                <input asp-for="ChuaBG" class="form-control" type="number" min="0" />
                <span asp-validation-for="ChuaBG" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DaBG" class="control-label"></label>
                <input asp-for="DaBG" class="form-control" type="number" min="0" />
                <span asp-validation-for="DaBG" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Lưu dữ liệu" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Trở về</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}