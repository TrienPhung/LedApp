@model LedApp.Models.ChitietXuat

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Thêm mới</h1>

@*<h4>ChitietXuat</h4>*@
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">Chọn xe (cổng)</label>
                <select asp-for="dulieuxuatId" class="form-control" asp-items="ViewBag.dulieuxuatId"></select>
            </div>
            <div class="form-group">
                <label asp-for="SoluongCH" class="control-label"></label>
                <input asp-for="SoluongCH" class="form-control" />
                <span asp-validation-for="SoluongCH" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="donviCH" class="control-label"></label>
                <input asp-for="donviCH" class="form-control" />
                <span asp-validation-for="donviCH" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SoluongD" class="control-label"></label>
                <input asp-for="SoluongD" class="form-control" />
                <span asp-validation-for="SoluongD" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="donviD" class="control-label"></label>
                <input asp-for="donviD" class="form-control" />
                <span asp-validation-for="donviD" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Lưu dữ liệu" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

