@model IEnumerable<LedApp.Models.Xuat>
@{
    ViewData["Title"] = "Chi tiết xuất";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    .page-wrapper > .container-fluid {
        padding: 0 !important;
    }

    .px-page {
        padding: 24px 24px 80px;
    }

    /* ── Breadcrumb ── */
    .px-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 12px;
        line-height: 1;
    }

        .px-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

            .px-breadcrumb a:hover {
                color: #111827;
            }

        .px-breadcrumb .sep {
            display: inline-flex;
            align-items: center;
            color: #9ca3af;
        }

            .px-breadcrumb .sep svg {
                width: 13px;
                height: 13px;
                stroke-width: 2;
                display: block;
            }

        .px-breadcrumb .cur {
            color: #111827;
            font-weight: 600;
        }

    /* ── Header ── */
    .px-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .px-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 3px;
            line-height: 1.2;
        }

        .px-header p {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #16a34a;
        color: #fff;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #15803d;
            color: #fff;
            text-decoration: none;
        }

        .btn-add svg {
            width: 15px;
            height: 15px;
        }

    /* ── Toolbar ── */
    .px-toolbar-top {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        gap: 6px;
        flex-wrap: wrap;
    }

    .px-toolbar-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        gap: 10px;
    }

    .filter-tabs {
        display: inline-flex;
        gap: 2px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 3px;
    }

    .filter-tab {
        padding: 5px 14px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 500;
        color: #6b7280;
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        transition: all .15s;
        line-height: 1.4;
        white-space: nowrap;
    }

        .filter-tab:hover {
            color: #374151;
            background: rgba(255,255,255,0.5);
        }

        .filter-tab.active {
            background: #fff;
            color: #111827;
            border-color: #e5e7eb;
            font-weight: 600;
            box-shadow: 0 1px 3px rgba(0,0,0,.1), 0 1px 2px rgba(0,0,0,.06);
        }

    /* ── Search ── */
    .px-search {
        position: relative;
        flex: 1;
        max-width: 480px;
    }

        .px-search svg {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            width: 15px;
            height: 15px;
            pointer-events: none;
        }

        .px-search input {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            color: #111827;
            font-size: 0.875rem;
            padding: 9px 14px 9px 34px;
            width: 100%;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .px-search input::placeholder {
                color: #9ca3af;
            }

            .px-search input:focus {
                border-color: #16a34a;
                box-shadow: 0 0 0 3px rgba(22,163,74,.1);
            }

    .px-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tb-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s;
        white-space: nowrap;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .tb-btn:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111827;
        }

        .tb-btn svg {
            width: 14px;
            height: 14px;
            color: #6b7280;
        }

    .btn-reset {
        display: none;
        align-items: center;
        gap: 5px;
        padding: 8px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .btn-reset.show {
            display: inline-flex;
        }

        .btn-reset:hover {
            background: #fef2f2;
            border-color: #fecaca;
            color: #ef4444;
        }

        .btn-reset svg {
            width: 13px;
            height: 13px;
        }

    /* ── Columns dropdown ── */
    .columns-wrap {
        position: relative;
    }

    .col-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        z-index: 200;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
        min-width: 190px;
        overflow: hidden;
    }

        .col-dropdown.open {
            display: block;
        }

    .col-dropdown-title {
        padding: 10px 14px 6px;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #9ca3af;
    }

    .col-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 14px;
        cursor: pointer;
        transition: background .1s;
    }

        .col-item:hover {
            background: #f9fafb;
        }

        .col-item span {
            font-size: 0.82rem;
            color: #374151;
            font-weight: 500;
        }

    .col-check {
        width: 16px;
        height: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #16a34a;
        opacity: 0;
        transition: opacity .12s;
    }

        .col-check svg {
            width: 14px;
            height: 14px;
        }

    .col-item.col-visible .col-check {
        opacity: 1;
    }

    .col-hidden {
        display: none !important;
    }

    /* ── Table card ── */
    .px-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .px-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .px-table thead th {
            background: #f9fafb;
            color: #374151;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 10px 14px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
            user-select: none;
        }

    /* ── Parent row ── */
    .row-parent {
        border-bottom: 1px solid #f3f4f6;
        cursor: pointer;
        transition: background .12s;
    }

        .row-parent:hover {
            background: #f9fafb;
        }

        .row-parent.is-open {
            background: #f0fdf4;
            border-bottom: none;
        }

        .row-parent td {
            padding: 13px 14px;
            vertical-align: middle;
            color: #111827;
        }

    .toggle-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: #f3f4f6;
        color: #6b7280;
        transition: all .2s;
        flex-shrink: 0;
    }

        .toggle-icon svg {
            width: 13px;
            height: 13px;
            transition: transform .2s;
        }

    .row-parent.is-open .toggle-icon {
        background: #dcfce7;
        color: #16a34a;
    }

        .row-parent.is-open .toggle-icon svg {
            transform: rotate(90deg);
        }

    .phieu-num {
        font-weight: 700;
        color: #111827;
        font-size: 0.875rem;
    }

    .td-bienso {
        font-weight: 600;
        color: #111827;
    }

    .td-cuaxuat {
        color: #374151;
    }

    .td-time {
        color: #6b7280;
        font-size: 0.81rem;
    }

    /* ── Status badges ── */
    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 600;
    }

        .badge-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

    .bp-phan-cong {
        background: #f1f5f9;
        color: #64748b;
    }

        .bp-phan-cong::before {
            background: #94a3b8;
        }

    .bp-ban-giao {
        background: #eff6ff;
        color: #3b82f6;
    }

        .bp-ban-giao::before {
            background: #3b82f6;
        }

    .bp-qua-tg {
        background: #fef2f2;
        color: #ef4444;
    }

        .bp-qua-tg::before {
            background: #ef4444;
        }

    .bp-hoan-thanh {
        background: #f0fdf4;
        color: #16a34a;
    }

        .bp-hoan-thanh::before {
            background: #16a34a;
        }

    .bp-xuat-phat {
        background: #f5f3ff;
        color: #7c3aed;
    }

        .bp-xuat-phat::before {
            background: #7c3aed;
        }

    /* ── Expand row ── */
    .row-expand {
        display: none;
    }

        .row-expand.open {
            display: table-row;
        }

        .row-expand > td {
            padding: 0 !important;
            border-bottom: 2px solid #e5e7eb;
            background: #fafafa;
        }

    .expand-inner {
        padding: 0 16px 16px 48px;
    }

    /* ── Inner toolbar (bulk + columns for inner) ── */
    .inner-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 10px 0 8px;
    }

    .inner-bulk-bar {
        display: none;
        align-items: center;
        gap: 8px;
    }

        .inner-bulk-bar.show {
            display: flex;
        }

    .inner-bulk-info {
        font-size: 0.82rem;
        color: #374151;
        font-weight: 500;
    }

        .inner-bulk-info span {
            font-weight: 700;
            color: #111827;
        }

    .btn-inner-bulk-del {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #ef4444;
        color: #fff;
        border: none;
        padding: 6px 12px;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-inner-bulk-del:hover {
            background: #dc2626;
        }

        .btn-inner-bulk-del svg {
            width: 13px;
            height: 13px;
        }

    .btn-inner-bulk-clear {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: transparent;
        border: none;
        color: #6b7280;
        font-size: 0.78rem;
        font-weight: 500;
        cursor: pointer;
        padding: 5px 8px;
        border-radius: 6px;
        transition: all .15s;
    }

        .btn-inner-bulk-clear:hover {
            color: #111827;
            background: #f3f4f6;
        }

        .btn-inner-bulk-clear svg {
            width: 13px;
            height: 13px;
        }

    .inner-toolbar-right {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* ── Inner columns dropdown ── */
    .inner-col-wrap {
        position: relative;
    }

    .inner-col-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 4px);
        right: 0;
        z-index: 300;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
        min-width: 170px;
        overflow: hidden;
    }

        .inner-col-dropdown.open {
            display: block;
        }

    /* ── Inner table ── */
    .inner-table-wrap {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }

    .inner-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
    }

        .inner-table thead th {
            background: #f9fafb;
            color: #6b7280;
            font-size: 0.71rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 8px 12px;
            border-bottom: 1px solid #e5e7eb;
            user-select: none;
        }

            .inner-table thead th:first-child {
                width: 36px;
            }

        .inner-table tbody tr {
            border-bottom: 1px solid #f3f4f6;
            transition: background .1s;
        }

            .inner-table tbody tr:last-child {
                border-bottom: none;
            }

            .inner-table tbody tr:hover {
                background: #f9fafb;
            }

            .inner-table tbody tr.row-ct-selected {
                background: #f0fdf4 !important;
            }

        .inner-table td {
            padding: 10px 12px;
            vertical-align: middle;
            color: #111827;
        }

        .inner-table input[type=checkbox] {
            width: 15px;
            height: 15px;
            accent-color: #16a34a;
            cursor: pointer;
        }

    .stt-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #f3f4f6;
        color: #6b7280;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .inner-donvi {
        font-weight: 600;
        color: #111827;
    }

    /* ── Number pills ── */
    .num-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        min-width: 36px;
    }

    .num-chua {
        background: #fff7ed;
        color: #ea580c;
    }

    .num-da {
        background: #f0fdf4;
        color: #16a34a;
    }

    /* ── Progress bar ── */
    .progress-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 100px;
    }

    .progress-bar-bg {
        flex: 1;
        height: 5px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: #16a34a;
        border-radius: 999px;
        transition: width .3s;
    }

    .progress-pct {
        font-size: 0.72rem;
        color: #9ca3af;
        font-weight: 500;
        min-width: 28px;
        text-align: right;
    }

    /* ── Inner actions ── */
    .inner-actions {
        display: flex;
        align-items: center;
        gap: 4px;
        justify-content: flex-end;
    }

    .ia-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 500;
        text-decoration: none;
        transition: all .12s;
        white-space: nowrap;
        border: 1px solid transparent;
        background: transparent;
        cursor: pointer;
    }

        .ia-btn svg {
            width: 12px;
            height: 12px;
        }

    .ia-view {
        color: #374151;
        border-color: #e5e7eb;
        background: #fff;
    }

        .ia-view:hover {
            background: #f9fafb;
            color: #111827;
        }

    .ia-edit {
        color: #2563eb;
        border-color: #dbeafe;
        background: #eff6ff;
    }

        .ia-edit:hover {
            background: #dbeafe;
        }

    .ia-delete {
        color: #ef4444;
        border-color: #fecaca;
        background: #fef2f2;
    }

        .ia-delete:hover {
            background: #fecaca;
        }

    /* ── Empty inner ── */
    .empty-inner {
        padding: 24px;
        text-align: center;
        color: #9ca3af;
        font-size: 0.82rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .empty-inner svg {
            width: 16px;
            height: 16px;
            opacity: .5;
        }

    /* ── Add detail btn ── */
    .btn-add-detail {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 600;
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
        text-decoration: none;
        transition: all .12s;
        margin-top: 10px;
    }

        .btn-add-detail:hover {
            background: #dcfce7;
            border-color: #86efac;
            color: #15803d;
            text-decoration: none;
        }

        .btn-add-detail svg {
            width: 12px;
            height: 12px;
        }

    /* ── Count badge ── */
    .ct-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #e5e7eb;
        color: #6b7280;
        font-size: 0.7rem;
        font-weight: 700;
        border-radius: 999px;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
    }

        .ct-count.has-items {
            background: #dcfce7;
            color: #16a34a;
        }

    /* ── Pagination ── */
    .px-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 16px;
        border-top: 1px solid #e5e7eb;
        font-size: 0.82rem;
        color: #6b7280;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pg-controls {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pg-rows {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .pg-rows select {
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 0.82rem;
            color: #374151;
            outline: none;
            cursor: pointer;
        }

    .pg-btn {
        padding: 5px 12px;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .12s;
    }

        .pg-btn:hover:not(:disabled) {
            background: #f3f4f6;
        }

        .pg-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .pg-num {
        min-width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .12s;
    }

        .pg-num:hover {
            background: #f3f4f6;
        }

        .pg-num.active {
            background: #16a34a;
            border-color: #16a34a;
            color: #fff;
            font-weight: 600;
        }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

        .empty-state svg {
            width: 40px;
            height: 40px;
            margin-bottom: 12px;
            opacity: .4;
        }

        .empty-state p {
            font-size: 0.875rem;
            margin: 0;
        }

    /* ── Delete Modal ── */
    .del-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .del-modal-overlay.open {
            display: flex;
        }

    .del-modal {
        background: #fff;
        border-radius: 12px;
        padding: 24px 24px 20px;
        max-width: 380px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        position: relative;
    }

    .del-modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 1.1rem;
        line-height: 1;
        padding: 4px;
        border-radius: 6px;
        transition: all .15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .del-modal-close:hover {
            background: #f3f4f6;
            color: #374151;
        }

    .del-modal-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 8px;
        padding-right: 24px;
    }

    .del-modal-body {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 20px;
        line-height: 1.55;
    }

    .del-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-modal-cancel {
        padding: 8px 18px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-modal-cancel:hover {
            background: #f9fafb;
            border-color: #d1d5db;
        }

    .btn-modal-confirm {
        padding: 8px 18px;
        border-radius: 8px;
        border: none;
        background: #ef4444;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-modal-confirm:hover {
            background: #dc2626;
        }

    body.modal-open {
        overflow: hidden;
    }

    /* ── No results ── */
    .no-results-row td {
        padding: 48px 20px;
        text-align: center;
        color: #6b7280;
        font-size: 0.875rem;
    }

    /* ── Toast ── */
    #exportToast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        background: #111827;
        color: #fff;
        border-radius: 10px;
        padding: 12px 18px;
        font-size: 0.875rem;
        font-weight: 500;
        display: none;
        align-items: center;
        gap: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.2);
    }

    /* ── Dark mode ── */
    body.dark-mode .px-header h1 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .px-header p {
        color: #9ca3af !important;
