<div class="px-page">

    <!-- Breadcrumb -->
    <div class="px-breadcrumb">
        <a href="/">Dashboard</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <a asp-controller="Xuats" asp-action="Index">Phiếu xuất</a>
        <span class="sep"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></span>
        <span class="cur">Chi tiết xuất</span>
    </div>

    <!-- Header -->
    <div class="px-header">
        <div>
            <h1>Quản lý chi tiết xuất</h1>
            <p>Theo dõi số lượng bàn giao theo từng phiếu xuất và đơn vị.</p>
        </div>
        <a asp-controller="ChitietXuats" asp-action="Create" class="btn-add">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Thêm mới
        </a>
    </div>

    <!-- Toolbar top: filter tabs -->
    <div class="px-toolbar-top">
        <div class="filter-tabs">
            <button class="filter-tab active" data-filter="all">Tất cả</button>
            <button class="filter-tab" data-filter="phan-cong">Đã phân công</button>
            <button class="filter-tab" data-filter="ban-giao">Đang bàn giao</button>
            <button class="filter-tab" data-filter="hoan-thanh">Hoàn thành</button>
            <button class="filter-tab" data-filter="xuat-phat">Đã xuất phát</button>
            <button class="filter-tab" data-filter="qua-tg">Quá thời gian</button>
        </div>
    </div>

    <!-- Toolbar bottom -->
    <div class="px-toolbar-bottom">
        <div style="display:flex;align-items:center;gap:8px;flex:1;">
            <div class="px-search">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                <input type="text" id="searchInput" placeholder="Tìm biển số, cửa xuất..." />
            </div>
            <button class="btn-reset" id="btnReset" type="button">
                Reset
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="px-toolbar-actions">
            <button class="tb-btn" id="btnExpandAll" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>
                Mở tất cả
            </button>
            <!-- Columns dropdown (for outer table) -->
            <div class="columns-wrap" id="columnsWrap">
                <button class="tb-btn" id="columnsBtn" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125Z" /></svg>
                    Columns
                </button>
                <div class="col-dropdown" id="colDropdown">
                    <div class="col-dropdown-title">Cột phiếu xuất</div>
                    <div class="col-item col-visible" data-col="outer-bienso"><span>Biển số xe</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="outer-cuaxuat"><span>Cửa xuất</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="outer-tgpc"><span>TG phân công</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="outer-trangthai"><span>Trạng thái</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                    <div class="col-item col-visible" data-col="outer-chitiet"><span>Chi tiết</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                </div>
            </div>
            <button class="tb-btn" id="exportBtn" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                Export
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="px-card">
        <table class="px-table">
            <thead>
                <tr>
                    <th style="width:40px;"></th>
                    <th>Phiếu xuất</th>
                    <th data-col-th="outer-bienso">Biển số xe</th>
                    <th data-col-th="outer-cuaxuat">Cửa xuất</th>
                    <th data-col-th="outer-tgpc">Thời gian phân công</th>
                    <th data-col-th="outer-trangthai">Trạng thái</th>
                    <th data-col-th="outer-chitiet" style="width:80px;text-align:center;">Chi tiết</th>
                </tr>
            </thead>
            <tbody id="xuatBody">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z" /></svg>
                                <p>Chưa có dữ liệu.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var xuat in Model)
                {
                    string badgeClass = xuat.TrangThai switch
                    {
                        (int)LedApp.Models.TrangThaiXuat.DaPhanCong => "bp-phan-cong",
                        (int)LedApp.Models.TrangThaiXuat.DangBanGiao => "bp-ban-giao",
                        (int)LedApp.Models.TrangThaiXuat.QuaThoiGian => "bp-qua-tg",
                        (int)LedApp.Models.TrangThaiXuat.HoanThanh => "bp-hoan-thanh",
                        (int)LedApp.Models.TrangThaiXuat.DaXuatPhat => "bp-xuat-phat",
                        _ => "bp-phan-cong"
                    };
                    string badgeLabel = xuat.TrangThai switch
                    {
                        (int)LedApp.Models.TrangThaiXuat.DaPhanCong => "Đã phân công",
                        (int)LedApp.Models.TrangThaiXuat.DangBanGiao => "Đang bàn giao",
                        (int)LedApp.Models.TrangThaiXuat.QuaThoiGian => "Quá thời gian",
                        (int)LedApp.Models.TrangThaiXuat.HoanThanh => "Hoàn thành",
                        (int)LedApp.Models.TrangThaiXuat.DaXuatPhat => "Đã xuất phát",
                        _ => "—"
                    };
                    string filterKey = xuat.TrangThai switch
                    {
                        (int)LedApp.Models.TrangThaiXuat.DaPhanCong => "phan-cong",
                        (int)LedApp.Models.TrangThaiXuat.DangBanGiao => "ban-giao",
                        (int)LedApp.Models.TrangThaiXuat.QuaThoiGian => "qua-tg",
                        (int)LedApp.Models.TrangThaiXuat.HoanThanh => "hoan-thanh",
                        (int)LedApp.Models.TrangThaiXuat.DaXuatPhat => "xuat-phat",
                        _ => ""
                    };
                    int ctCount = xuat.ChitietXuats?.Count ?? 0;

                    <!-- Parent row -->
                    <tr class="row-parent"
                        data-id="@xuat.Id"
                        data-filter="@filterKey"
                        data-search="@(xuat.Xe?.BienSoXe ?? "") @(xuat.CuaXuat?.Ten ?? "")"
                        onclick="toggleRow(@xuat.Id)">
                        <td>
                            <span class="toggle-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                            </span>
                        </td>
                        <td><span class="phieu-num">#@xuat.Id</span></td>
                        <td class="td-bienso" data-col-td="outer-bienso">@(xuat.Xe?.BienSoXe ?? "—")</td>
                        <td class="td-cuaxuat" data-col-td="outer-cuaxuat">@(xuat.CuaXuat?.Ten ?? $"X-{xuat.CuaXuatId:D2}")</td>
                        <td class="td-time" data-col-td="outer-tgpc">@xuat.ThoiGianPhanCong.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-col-td="outer-trangthai"><span class="badge-pill @badgeClass">@badgeLabel</span></td>
                        <td style="text-align:center;" data-col-td="outer-chitiet">
                            <span class="ct-count @(ctCount > 0 ? "has-items" : "")">@ctCount</span>
                        </td>
                    </tr>

                    <!-- Expand row -->
                    <tr class="row-expand" id="expand-@xuat.Id">
                        <td colspan="7">
                            <div class="expand-inner">

                                <!-- Inner toolbar -->
                                <div class="inner-toolbar" id="inner-toolbar-@xuat.Id">
                                    <!-- Bulk bar (hidden by default) -->
                                    <div class="inner-bulk-bar" id="inner-bulk-bar-@xuat.Id">
                                        <span class="inner-bulk-info"><span id="inner-bulk-count-@xuat.Id">0</span> đã chọn</span>
                                        <button class="btn-inner-bulk-del" type="button" onclick="openBulkDelModal(@xuat.Id)">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                                            Xóa (<span id="inner-bulk-del-count-@xuat.Id">0</span>)
                                        </button>
                                        <button class="btn-inner-bulk-clear" type="button" onclick="clearInnerBulk(@xuat.Id)">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                                            Bỏ chọn
                                        </button>
                                    </div>
                                    <div id="inner-normal-bar-@xuat.Id" style="flex:1;"></div>

                                    <!-- Inner right tools -->
                                    <div class="inner-toolbar-right">
                                        <!-- Inner columns dropdown -->
                                        <div class="inner-col-wrap" id="inner-col-wrap-@xuat.Id">
                                            <button class="tb-btn" style="font-size:0.78rem;padding:6px 10px;" type="button" onclick="toggleInnerColDropdown(@xuat.Id, event)">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125Z" /></svg>
                                                Columns
                                            </button>
                                            <div class="inner-col-dropdown" id="inner-col-dropdown-@xuat.Id">
                                                <div class="col-dropdown-title">Cột chi tiết</div>
                                                <div class="col-item col-visible" data-inner-col="donvi" data-xuat-id="@xuat.Id"><span>Đơn vị</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                                                <div class="col-item col-visible" data-inner-col="chuabg" data-xuat-id="@xuat.Id"><span>Chưa bàn giao</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                                                <div class="col-item col-visible" data-inner-col="dabg" data-xuat-id="@xuat.Id"><span>Đã bàn giao</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                                                <div class="col-item col-visible" data-inner-col="tiendo" data-xuat-id="@xuat.Id"><span>Tiến độ</span><span class="col-check"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></span></div>
                                            </div>
                                        </div>
                                        <!-- Export inner -->
                                        <button class="tb-btn" style="font-size:0.78rem;padding:6px 10px;" type="button" onclick="exportInner(@xuat.Id, '@(xuat.Xe?.BienSoXe ?? $"phieu-{xuat.Id}")')">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                                            Export
                                        </button>
                                    </div>
                                </div>

                                @if (xuat.ChitietXuats != null && xuat.ChitietXuats.Any())
                                {
                                    <div class="inner-table-wrap">
                                        <table class="inner-table" id="inner-table-@xuat.Id">
                                            <thead>
                                                <tr>
                                                    <th><input type="checkbox" class="inner-check-all" data-xuat-id="@xuat.Id" onclick="toggleInnerAll(@xuat.Id, this)" /></th>
                                                    <th style="width:40px;">STT</th>
                                                    <th data-inner-th="donvi" data-xuat-id="@xuat.Id">Đơn vị</th>
                                                    <th data-inner-th="chuabg" data-xuat-id="@xuat.Id">Chưa bàn giao</th>
                                                    <th data-inner-th="dabg" data-xuat-id="@xuat.Id">Đã bàn giao</th>
                                                    <th data-inner-th="tiendo" data-xuat-id="@xuat.Id">Tiến độ</th>
                                                    <th style="text-align:right;">Thao tác</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    int i = 1;
                                                }
                                                @foreach (var ct in xuat.ChitietXuats)
                                                {
                                                    long total = ct.ChuaBG + ct.DaBG;
                                                    int pct = total > 0 ? (int)Math.Round(ct.DaBG * 100.0 / total) : 0;
                                                    <tr data-ct-id="@ct.Id" data-xuat-id="@xuat.Id"
                                                        data-donvi="@ct.DonVi"
                                                        data-chuabg="@ct.ChuaBG"
                                                        data-dabg="@ct.DaBG"
                                                        data-pct="@pct">
                                                        <td><input type="checkbox" class="inner-row-check" data-xuat-id="@xuat.Id" onchange="updateInnerBulk(@xuat.Id)" onclick="event.stopPropagation()" /></td>
                                                        <td><span class="stt-badge">@i</span></td>
                                                        <td class="inner-donvi" data-inner-td="donvi" data-xuat-id="@xuat.Id">@ct.DonVi</td>
                                                        <td data-inner-td="chuabg" data-xuat-id="@xuat.Id"><span class="num-pill num-chua">@ct.ChuaBG</span></td>
                                                        <td data-inner-td="dabg" data-xuat-id="@xuat.Id"><span class="num-pill num-da">@ct.DaBG</span></td>
                                                        <td data-inner-td="tiendo" data-xuat-id="@xuat.Id">
                                                            <div class="progress-wrap">
                                                                <div class="progress-bar-bg">
                                                                    <div class="progress-bar-fill" style="width:@pct%"></div>
                                                                </div>
                                                                <span class="progress-pct">@pct%</span>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="inner-actions">
                                                                <a asp-controller="ChitietXuats" asp-action="Details" asp-route-id="@ct.Id" class="ia-btn ia-view" onclick="event.stopPropagation()">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                                                                    View
                                                                </a>
                                                                <a asp-controller="ChitietXuats" asp-action="Edit" asp-route-id="@ct.Id" class="ia-btn ia-edit" onclick="event.stopPropagation()">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
                                                                    Edit
                                                                </a>
                                                                <button class="ia-btn ia-delete" type="button" onclick="openDelModal(@ct.Id, event)">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                                                                    Xóa
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="inner-table-wrap">
                                        <div class="empty-inner">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
                                            Chưa có chi tiết nào cho phiếu này.
                                        </div>
                                    </div>
                                }
                                <a asp-controller="ChitietXuats" asp-action="Create" class="btn-add-detail" onclick="event.stopPropagation()">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                    Thêm chi tiết cho phiếu #@xuat.Id
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <div class="px-pagination">
            <div class="pg-info" id="pgInfo">Showing 0 results</div>
            <div style="display:flex;align-items:center;gap:16px;">
                <div class="pg-rows">
                    Rows
                    <select id="rowsPerPage">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div class="pg-controls" id="pgControls"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xóa đơn ChitietXuat -->
<div class="del-modal-overlay" id="delModalOverlay">
    <div class="del-modal">
        <button class="del-modal-close" id="delModalClose">×</button>
        <div class="del-modal-title">Xóa chi tiết xuất</div>
        <div class="del-modal-body">Bạn có chắc chắn muốn xóa chi tiết này không? Hành động này không thể hoàn tác.</div>
        <div class="del-modal-footer">
            <button class="btn-modal-cancel" id="delModalCancel">Cancel</button>
            <form id="delConfirmForm" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-modal-confirm">Delete</button>
            </form>
        </div>
    </div>
</div>

<!-- Modal xóa nhiều ChitietXuat -->
<div class="del-modal-overlay" id="bulkDelModalOverlay">
    <div class="del-modal">
        <button class="del-modal-close" id="bulkDelModalClose">×</button>
        <div class="del-modal-title">Xóa chi tiết đã chọn</div>
        <div class="del-modal-body">
            Bạn có chắc chắn muốn xóa <strong id="bulkDelCount">0</strong> chi tiết đã chọn? Hành động này không thể hoàn tác.
        </div>
        <div class="del-modal-footer">
            <button class="btn-modal-cancel" id="bulkDelModalCancel">Cancel</button>
            <button class="btn-modal-confirm" id="bulkDelModalConfirm">Delete</button>
        </div>
    </div>
</div>

<!-- Export toast -->
<div id="exportToast">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#16a34a" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
    <span id="exportToastMsg"></span>
    <button onclick="document.getElementById('exportToast').style.display='none'" style="background:none;border:none;color:#9ca3af;cursor:pointer;margin-left:8px;font-size:1rem;line-height:1;">×</button>
</div>

<script>
    (function () {
        const allParents = Array.from(document.querySelectorAll('.row-parent'));
        const searchInput = document.getElementById('searchInput');
        const rowsPerPageSel = document.getElementById('rowsPerPage');
        const pgInfo = document.getElementById('pgInfo');
        const pgControls = document.getElementById('pgControls');
        const btnReset = document.getElementById('btnReset');
        const btnExpandAll = document.getElementById('btnExpandAll');

        let currentPage = 1;
        let activeTabFilter = 'all';
        let allExpanded = false;

        // ── Track current bulk xuat id ──
        let currentBulkXuatId = null;

        // ─────────────────────────────────────────
        // ACCORDION
        // ─────────────────────────────────────────
        window.toggleRow = function (id) {
            const parent = document.querySelector(`.row-parent[data-id="${id}"]`);
            const expand = document.getElementById('expand-' + id);
            if (!parent || !expand) return;
            const isOpen = expand.classList.contains('open');
            expand.classList.toggle('open', !isOpen);
            parent.classList.toggle('is-open', !isOpen);
        };

        btnExpandAll.addEventListener('click', () => {
            allExpanded = !allExpanded;
            getFiltered().forEach(row => {
                const id = row.dataset.id;
                const expand = document.getElementById('expand-' + id);
                if (expand) {
                    expand.classList.toggle('open', allExpanded);
                    row.classList.toggle('is-open', allExpanded);
                }
            });
            btnExpandAll.innerHTML = allExpanded
                ? `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25"/></svg> Đóng tất cả`
                : `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/></svg> Mở tất cả`;
        });

        // ─────────────────────────────────────────
        // FILTER TABS
        // ─────────────────────────────────────────
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                activeTabFilter = tab.dataset.filter;
                currentPage = 1;
                render();
            });
        });

        // ─────────────────────────────────────────
        // SEARCH & RESET
        // ─────────────────────────────────────────
        searchInput.addEventListener('input', () => {
            btnReset.classList.toggle('show', searchInput.value.trim().length > 0);
            currentPage = 1;
            render();
        });

        rowsPerPageSel.addEventListener('change', () => { currentPage = 1; render(); });

        btnReset.addEventListener('click', () => {
            searchInput.value = '';
            btnReset.classList.remove('show');
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            document.querySelector('.filter-tab[data-filter="all"]').classList.add('active');
            activeTabFilter = 'all';
            currentPage = 1;
            render();
        });

        // ─────────────────────────────────────────
        // OUTER COLUMNS TOGGLE
        // ─────────────────────────────────────────
        const columnsBtn = document.getElementById('columnsBtn');
        const colDropdown = document.getElementById('colDropdown');

        columnsBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            colDropdown.classList.toggle('open');
        });

        document.querySelectorAll('#colDropdown .col-item').forEach(item => {
            item.addEventListener('click', (e) => {
                e.stopPropagation();
                const col = item.dataset.col;
                const isVisible = item.classList.contains('col-visible');
                if (isVisible) {
                    item.classList.remove('col-visible');
                    document.querySelectorAll(`[data-col-th="${col}"]`).forEach(el => el.classList.add('col-hidden'));
                    document.querySelectorAll(`[data-col-td="${col}"]`).forEach(el => el.classList.add('col-hidden'));
                } else {
                    item.classList.add('col-visible');
                    document.querySelectorAll(`[data-col-th="${col}"]`).forEach(el => el.classList.remove('col-hidden'));
                    document.querySelectorAll(`[data-col-td="${col}"]`).forEach(el => el.classList.remove('col-hidden'));
                }
            });
        });

        document.addEventListener('click', () => {
            colDropdown.classList.remove('open');
            document.querySelectorAll('.inner-col-dropdown.open').forEach(d => d.classList.remove('open'));
        });

        // ─────────────────────────────────────────
        // INNER COLUMNS TOGGLE
        // ─────────────────────────────────────────
        window.toggleInnerColDropdown = function (xuatId, e) {
            e.stopPropagation();
            const dd = document.getElementById('inner-col-dropdown-' + xuatId);
            if (!dd) return;
            const wasOpen = dd.classList.contains('open');
            document.querySelectorAll('.inner-col-dropdown.open').forEach(d => d.classList.remove('open'));
            colDropdown.classList.remove('open');
            if (!wasOpen) dd.classList.add('open');
        };

        document.querySelectorAll('.inner-col-dropdown .col-item').forEach(item => {
            item.addEventListener('click', (e) => {
                e.stopPropagation();
                const col = item.dataset.innerCol;
                const xuatId = item.dataset.xuatId;
                const isVisible = item.classList.contains('col-visible');
                const scope = document.getElementById('inner-table-' + xuatId);
                if (!scope) return;
                if (isVisible) {
                    item.classList.remove('col-visible');
                    scope.querySelectorAll(`[data-inner-th="${col}"][data-xuat-id="${xuatId}"]`).forEach(el => el.classList.add('col-hidden'));
                    scope.querySelectorAll(`[data-inner-td="${col}"][data-xuat-id="${xuatId}"]`).forEach(el => el.classList.add('col-hidden'));
                } else {
                    item.classList.add('col-visible');
                    scope.querySelectorAll(`[data-inner-th="${col}"][data-xuat-id="${xuatId}"]`).forEach(el => el.classList.remove('col-hidden'));
                    scope.querySelectorAll(`[data-inner-td="${col}"][data-xuat-id="${xuatId}"]`).forEach(el => el.classList.remove('col-hidden'));
                }
            });
        });

        // ─────────────────────────────────────────
        // INNER BULK SELECTION
        // ─────────────────────────────────────────
        window.toggleInnerAll = function (xuatId, checkbox) {
            document.querySelectorAll(`.inner-row-check[data-xuat-id="${xuatId}"]`).forEach(cb => {
                cb.checked = checkbox.checked;
            });
            updateInnerBulk(xuatId);
        };

        window.updateInnerBulk = function (xuatId) {
            const checked = Array.from(document.querySelectorAll(`.inner-row-check[data-xuat-id="${xuatId}"]:checked`));
            const total = document.querySelectorAll(`.inner-row-check[data-xuat-id="${xuatId}"]`).length;
            const bulkBar = document.getElementById('inner-bulk-bar-' + xuatId);
            const countEl = document.getElementById('inner-bulk-count-' + xuatId);
            const delCountEl = document.getElementById('inner-bulk-del-count-' + xuatId);
            const checkAll = document.querySelector(`.inner-check-all[data-xuat-id="${xuatId}"]`);

            // highlight rows
            document.querySelectorAll(`tr[data-xuat-id="${xuatId}"]`).forEach(row => {
                const cb = row.querySelector('.inner-row-check');
                row.classList.toggle('row-ct-selected', cb && cb.checked);
            });

            if (checked.length > 0) {
                bulkBar.classList.add('show');
                countEl.textContent = checked.length;
                delCountEl.textContent = checked.length;
                if (checkAll) {
                    checkAll.indeterminate = checked.length > 0 && checked.length < total;
                    checkAll.checked = checked.length === total;
                }
            } else {
                bulkBar.classList.remove('show');
                if (checkAll) { checkAll.indeterminate = false; checkAll.checked = false; }
            }
        };

        window.clearInnerBulk = function (xuatId) {
            document.querySelectorAll(`.inner-row-check[data-xuat-id="${xuatId}"]`).forEach(cb => cb.checked = false);
            updateInnerBulk(xuatId);
        };

        // ─────────────────────────────────────────
        // MODAL XÓA ĐƠN
        // ─────────────────────────────────────────
        const delModalOverlay = document.getElementById('delModalOverlay');

        window.openDelModal = function (ctId, e) {
            if (e) e.stopPropagation();
            const form = document.getElementById('delConfirmForm');
            form.action = '/ChitietXuats/Delete/' + ctId;
            delModalOverlay.classList.add('open');
            document.body.classList.add('modal-open');
        };

        function closeDelModal() {
            delModalOverlay.classList.remove('open');
            document.body.classList.remove('modal-open');
        }

        document.getElementById('delModalClose').addEventListener('click', closeDelModal);
        document.getElementById('delModalCancel').addEventListener('click', closeDelModal);
        delModalOverlay.addEventListener('click', (e) => { if (e.target === delModalOverlay) closeDelModal(); });

        // ─────────────────────────────────────────
        // MODAL XÓA NHIỀU
        // ─────────────────────────────────────────
        const bulkDelModalOverlay = document.getElementById('bulkDelModalOverlay');
        const bulkDelCount = document.getElementById('bulkDelCount');
        const bulkDelModalConfirm = document.getElementById('bulkDelModalConfirm');

        window.openBulkDelModal = function (xuatId) {
            currentBulkXuatId = xuatId;
            const checked = document.querySelectorAll(`.inner-row-check[data-xuat-id="${xuatId}"]:checked`).length;
            bulkDelCount.textContent = checked;
            bulkDelModalOverlay.classList.add('open');
            document.body.classList.add('modal-open');
        };

        function closeBulkDelModal() {
            bulkDelModalOverlay.classList.remove('open');
            document.body.classList.remove('modal-open');
            currentBulkXuatId = null;
        }

        document.getElementById('bulkDelModalClose').addEventListener('click', closeBulkDelModal);
        document.getElementById('bulkDelModalCancel').addEventListener('click', closeBulkDelModal);
        bulkDelModalOverlay.addEventListener('click', (e) => { if (e.target === bulkDelModalOverlay) closeBulkDelModal(); });

        bulkDelModalConfirm.addEventListener('click', async () => {
            if (!currentBulkXuatId) return;
            const xuatId = currentBulkXuatId;
            const checkedCbs = Array.from(document.querySelectorAll(`.inner-row-check[data-xuat-id="${xuatId}"]:checked`));
            const ids = checkedCbs.map(cb => parseInt(cb.closest('tr').dataset.ctId)).filter(id => !isNaN(id));
            if (ids.length === 0) { closeBulkDelModal(); return; }

            bulkDelModalConfirm.disabled = true;
            bulkDelModalConfirm.textContent = 'Đang xóa...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const res = await fetch('/ChitietXuats/BulkDelete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ ids })
                });

                if (res.ok) {
                    checkedCbs.forEach(cb => {
                        const row = cb.closest('tr');
                        if (row) row.remove();
                    });
                    // Update count badge
                    const remaining = document.querySelectorAll(`tr[data-xuat-id="${xuatId}"]`).length;
                    const badge = document.querySelector(`.row-parent[data-id="${xuatId}"] .ct-count`);
                    if (badge) {
                        badge.textContent = remaining;
                        badge.classList.toggle('has-items', remaining > 0);
                    }
                    closeBulkDelModal();
                    updateInnerBulk(xuatId);
                    showToast(`Đã xóa ${ids.length} chi tiết`);
                } else {
                    alert('Xóa thất bại. Vui lòng thử lại.');
                    closeBulkDelModal();
                }
            } catch {
                alert('Lỗi kết nối server.');
                closeBulkDelModal();
            } finally {
                bulkDelModalConfirm.disabled = false;
                bulkDelModalConfirm.textContent = 'Delete';
            }
        });

        // ─────────────────────────────────────────
        // EXPORT OUTER (tất cả phiếu đang hiển thị)
        // ─────────────────────────────────────────
        document.getElementById('exportBtn').addEventListener('click', () => {
            const visible = getFiltered();
            const headers = ['Phiếu xuất', 'Biển số xe', 'Cửa xuất', 'TG phân công', 'Trạng thái', 'Số chi tiết'];
            const rows = visible.map(row => {
                const id = row.dataset.id;
                const bienso = row.querySelector('[data-col-td="outer-bienso"]')?.textContent.trim() ?? '';
                const cua = row.querySelector('[data-col-td="outer-cuaxuat"]')?.textContent.trim() ?? '';
                const tgpc = row.querySelector('[data-col-td="outer-tgpc"]')?.textContent.trim() ?? '';
                const tt = row.querySelector('[data-col-td="outer-trangthai"]')?.textContent.trim() ?? '';
                const ct = row.querySelector('[data-col-td="outer-chitiet"]')?.textContent.trim() ?? '';
                return [id, bienso, cua, tgpc, tt, ct].map(v => `"${v.replace(/"/g, '""')}"`).join(',');
            });
            downloadCsv([headers.map(h => `"${h}"`).join(','), ...rows].join('\n'), 'chitiet-xuat.csv');
            showToast(`Exported ${visible.length} phiếu to CSV`);
        });

        // ─────────────────────────────────────────
        // EXPORT INNER (từng phiếu)
        // ─────────────────────────────────────────
        window.exportInner = function (xuatId, label) {
            const table = document.getElementById('inner-table-' + xuatId);
            if (!table) { showToast('Phiếu này chưa có chi tiết.'); return; }
            const rows = Array.from(table.querySelectorAll('tbody tr'));
            if (rows.length === 0) { showToast('Phiếu này chưa có chi tiết.'); return; }

            const headers = ['STT', 'Đơn vị', 'Chưa bàn giao', 'Đã bàn giao', 'Tiến độ (%)'];
            const data = rows.map((row, idx) => {
                const donvi = row.dataset.donvi ?? '';
                const chua = row.dataset.chuabg ?? '';
                const da = row.dataset.dabg ?? '';
                const pct = row.dataset.pct ?? '';
                return [idx + 1, donvi, chua, da, pct].map(v => `"${String(v).replace(/"/g, '""')}"`).join(',');
            });
            downloadCsv([headers.map(h => `"${h}"`).join(','), ...data].join('\n'), `chitiet-phieu-${label}.csv`);
            showToast(`Exported ${rows.length} dòng cho phiếu #${xuatId}`);
        };

        function downloadCsv(csv, filename) {
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = filename; a.click();
            URL.revokeObjectURL(url);
        }

        function showToast(msg) {
            const toast = document.getElementById('exportToast');
            document.getElementById('exportToastMsg').textContent = msg;
            toast.style.display = 'flex';
            setTimeout(() => { toast.style.display = 'none'; }, 3500);
        }

        // ─────────────────────────────────────────
        // FILTER & PAGINATION
        // ─────────────────────────────────────────
        function getFiltered() {
            const q = searchInput.value.toLowerCase();
            return allParents.filter(row => {
                const tabMatch = activeTabFilter === 'all' || row.dataset.filter === activeTabFilter;
                const searchMatch = !q || row.dataset.search.toLowerCase().includes(q);
                return tabMatch && searchMatch;
            });
        }

        function render() {
            const visible = getFiltered();
            const rpp = parseInt(rowsPerPageSel.value);
            const totalPages = Math.max(1, Math.ceil(visible.length / rpp));
            currentPage = Math.min(currentPage, totalPages);
            const start = (currentPage - 1) * rpp;
            const end = start + rpp;
            const pageIds = new Set(visible.slice(start, end).map(r => r.dataset.id));

            allParents.forEach(row => {
                const id = row.dataset.id;
                const expand = document.getElementById('expand-' + id);
                const show = pageIds.has(id);
                row.style.display = show ? '' : 'none';
                if (expand) expand.style.display = show ? '' : 'none';
            });

            pgInfo.textContent = visible.length === 0
                ? 'Showing 0 results'
                : `Showing ${start + 1}–${Math.min(end, visible.length)} of ${visible.length} phiếu`;

            pgControls.innerHTML = '';
            const prev = document.createElement('button');
            prev.className = 'pg-btn'; prev.textContent = 'Previous'; prev.disabled = currentPage === 1;
            prev.onclick = () => { currentPage--; render(); };
            pgControls.appendChild(prev);

            pageRange(currentPage, totalPages).forEach(p => {
                if (p === '...') {
                    const dot = document.createElement('span');
                    dot.textContent = '…'; dot.style.cssText = 'padding:0 4px;color:#9ca3af;';
                    pgControls.appendChild(dot);
                } else {
                    const btn = document.createElement('button');
                    btn.className = 'pg-num' + (p === currentPage ? ' active' : '');
                    btn.textContent = p; btn.onclick = () => { currentPage = p; render(); };
                    pgControls.appendChild(btn);
                }
            });

            const next = document.createElement('button');
            next.className = 'pg-btn'; next.textContent = 'Next'; next.disabled = currentPage === totalPages;
            next.onclick = () => { currentPage++; render(); };
            pgControls.appendChild(next);
        }

        function pageRange(cur, total) {
            if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
            if (cur <= 4) return [1, 2, 3, 4, 5, '...', total];
            if (cur >= total - 3) return [1, '...', total-4, total-3, total-2, total-1, total];
            return [1, '...', cur-1, cur, cur+1, '...', total];
        }

        render();
    })();
</script>
