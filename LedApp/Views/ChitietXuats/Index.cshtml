@model IEnumerable<LedApp.Models.Xuat>
@{
    ViewData["Title"] = "Chi tiết xuất";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
<h1>Quản lý thông tin chi tiết xuất</h1>
<p><a asp-controller="ChitietXuats" asp-action="Create">+ Thêm mới</a></p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th></th>
            <th>Phiếu</th>
            <th>Biển số xe</th>
            <th>Cửa xuất</th>
            <th>Thời gian phân công</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var xuat in Model)
        {
            <tr onclick="toggleCard(@xuat.Id)" style="cursor:pointer;">
                <td><span id="icon-@xuat.Id">▶</span></td>
                <td>#@xuat.Id</td>
                <td>@(xuat.Xe?.BienSoXe ?? "—")</td>
                <td>@(xuat.CuaXuat?.Ten ?? $"X-{xuat.CuaXuatId:D2}")</td>
                <td>@xuat.ThoiGianPhanCong.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @switch (xuat.TrangThai)
                    {
                        case (int)LedApp.Models.TrangThaiXuat.DaPhanCong:
                            <span class="badge bg-secondary">Đã phân công</span>
                            break;
                        case (int)LedApp.Models.TrangThaiXuat.DangBanGiao:
                            <span class="badge bg-primary">Đang bàn giao</span>
                            break;
                        case (int)LedApp.Models.TrangThaiXuat.QuaThoiGian:
                            <span class="badge bg-danger">Quá thời gian</span>
                            break;
                        case (int)LedApp.Models.TrangThaiXuat.HoanThanh:
                            <span class="badge bg-success">Hoàn thành</span>
                            break;
                        case (int)LedApp.Models.TrangThaiXuat.DaXuatPhat:
                            <span class="badge bg-dark">Đã xuất phát</span>
                            break;
                    }
                </td>
            </tr>
            <tr id="body-@xuat.Id" style="display:none;">
                <td colspan="6">
                    @if (xuat.ChitietXuats != null && xuat.ChitietXuats.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Đơn vị</th>
                                    <th>Chưa bàn giao</th>
                                    <th>Đã bàn giao</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var ct in xuat.ChitietXuats)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@ct.DonVi</td>
                                        <td>@ct.ChuaBG</td>
                                        <td>@ct.DaBG</td>
                                        <td>
                                            <a asp-controller="ChitietXuats" asp-action="Edit" asp-route-id="@ct.Id">Sửa</a> |
                                            <a asp-controller="ChitietXuats" asp-action="Details" asp-route-id="@ct.Id">Chi tiết</a> |
                                            <a asp-controller="ChitietXuats" asp-action="Delete" asp-route-id="@ct.Id">Xóa</a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted ms-2">Chưa có chi tiết nào</p>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function toggleCard(id) {
            var body = document.getElementById('body-' + id);
            var icon = document.getElementById('icon-' + id);
            if (body.style.display === 'none') {
                body.style.display = 'table-row';
                icon.textContent = '▼';
            } else {
                body.style.display = 'none';
                icon.textContent = '▶';
            }
        }
    </script>
}
