@model LedApp.Models.ChitietXuat
@{
    ViewData["Title"] = "Xóa";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h1>Xóa chi tiết xuất</h1>
<h3>Bạn có chắc muốn xóa dữ liệu này không?</h3>

<div>
    <h4>Chi tiết xuất</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.XuatId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.XuatId)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DonVi)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DonVi)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ChuaBG)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ChuaBG)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DaBG)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DaBG)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Trở về</a>
    </form>
</div>