@{
    ViewData["Title"] = "Tổng Trung Tâm";
    Layout = null;
    var cuaNhaps = ViewBag.CuaNhaps as List<LedApp.Models.CuaNhap> ?? new();
    var cuaXuats = ViewBag.CuaXuats as List<LedApp.Models.CuaXuat> ?? new();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TRUNG TÂM ĐIỀU HÀNH KHO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #0b0f1a;
            --s1: #111827;
            --s2: #1a2234;
            --s3: #1e293b;
            --border: #1e3a5f;
            --border2: #243855;
            --cyan: #22d3ee;
            --blue: #3b82f6;
            --blue2: #60a5fa;
            --green: #22c55e;
            --green2: #4ade80;
            --gold: #f59e0b;
            --gold2: #fbbf24;
            --orange: #f97316;
            --orange2: #fb923c;
            --red: #ef4444;
            --red2: #f87171;
            --text: #94a3b8;
            --text2: #475569;
            --bright: #e2e8f0;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 13px;
        }

            /* Subtle grid bg */
            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background-image: linear-gradient(rgba(34,211,238,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(34,211,238,.03) 1px, transparent 1px);
                background-size: 48px 48px;
                pointer-events: none;
                z-index: 0;
            }

        /* ══ LAYOUT ══ */
        .screen {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-rows: 65px 1fr 110px;
            height: 100vh;
            padding: 6px;
            gap: 4px;
        }

        /* ══ TOPBAR ══ */
        .topbar {
            display: grid;
            grid-template-columns: 220px 1fr auto;
            align-items: center;
            background: var(--s1);
            border: 1px solid var(--border2);
           
            border-radius: 8px;
            padding: 0 14px;
            gap: 12px;
        }

        .tb-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tb-logo {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #0c2340, #1e4080);
            border: 1px solid var(--cyan);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

        .tb-title {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            color: var(--cyan);
            text-transform: uppercase;
            line-height: 1.2;
        }

        .tb-sub {
            font-size: 9px;
            color: var(--text2);
            letter-spacing: 1px;
            margin-top: 2px;
        }

        /* KPI row — big pills like mockup */
        .kpi-row {
            display: flex;
            gap: 5px;
            align-items: stretch;
            overflow: hidden;
        }

        .kpi-pill {
            background: var(--s2);
            border: 1px solid var(--border2);
            border-radius: 7px;
            padding: 5px 12px;
            text-align: center;
            min-width: 80px;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

            .kpi-pill .n {
                font-family: 'JetBrains Mono', monospace;
                font-size: 22px;
                font-weight: 700;
                line-height: 1;
                display: block;
            }

            .kpi-pill .l {
                font-size: 9px;
                color: var(--text2);
                letter-spacing: .5px;
                text-transform: uppercase;
                margin-top: 3px;
                white-space: nowrap;
            }

            .kpi-pill.c-blue .n {
                color: var(--blue2);
            }

            .kpi-pill.c-cyan .n {
                color: var(--cyan);
            }

            .kpi-pill.c-green .n {
                color: var(--green);
            }

            .kpi-pill.c-gold .n {
                color: var(--gold);
            }

            .kpi-pill.c-orange .n {
                color: var(--orange2);
            }

            .kpi-pill.c-red .n {
                color: var(--red);
                animation: blink .8s step-start infinite;
            }

        @@keyframes blink {
            50%

        {
            opacity: .2;
        }

        }
        @@keyframes pulse {
            50%

        {
            opacity: .4;
        }

        }

        /* Right topbar */
        .tb-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .clock {
            font-family: 'JetBrains Mono', monospace;
            font-size: 28px;
            font-weight: 700;
            color: var(--gold2);
            letter-spacing: 3px;
        }

        .date {
            font-size: 9px;
            color: var(--text2);
            letter-spacing: 1px;
            margin-top: 2px;
            text-align: right;
        }



        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--text2);
            flex-shrink: 0;
        }

            .dot.on {
                background: var(--green);
                animation: pulse 2s infinite;
            }

            .dot.err {
                background: var(--red);
            }

        .alert-pill {
            display: flex;
            align-items: center;
            gap: 5px;
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.25);
            border-radius: 5px;
            padding: 3px 10px;
            font-size: 10px;
            font-weight: 700;
            color: var(--red2);
        }

            .alert-pill.hidden {
                display: none;
            }

        /* ══ MAIN GRID ══ */
        .main {
            display: grid;
            grid-template-columns: 168px 1px 1fr 1px 1.45fr 1px 168px;
            min-height: 0;
            overflow: hidden;
        }

        .divider-v {
            background: var(--border2);
        }

        /* ── Sidebar ── */
        .col-sidebar {
            display: flex;
            flex-direction: column;
            min-height: 0;
            overflow: hidden;
        }

        .sb-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 10px;
            border-bottom: 1px solid var(--border2);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            flex-shrink: 0;
        }

        .sb-body {
            flex: 1;
            overflow-y: auto;
            padding: 6px 7px;
        }

            .sb-body::-webkit-scrollbar {
                width: 2px;
            }

            .sb-body::-webkit-scrollbar-thumb {
                background: var(--border2);
            }

        .count-badge {
            background: var(--s2);
            border: 1px solid var(--border2);
            border-radius: 10px;
            padding: 1px 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 700;
        }

        /* Xe sắp về card */
        .sapve-card {
            background: var(--s2);
            border: 1px solid var(--border2);
            border-left: 3px solid var(--blue);
            border-radius: 6px;
            padding: 7px 9px;
            margin-bottom: 5px;
        }

            .sapve-card.da-pc {
                border-left-color: var(--gold);
            }

        .sapve-bienso {
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue2);
        }

        .sapve-card.da-pc .sapve-bienso {
            color: var(--gold2);
        }

        .sapve-meta {
            font-size: 10px;
            color: var(--text2);
            margin-top: 2px;
        }

        .sapve-hang {
            display: flex;
            flex-wrap: wrap;
            gap: 3px;
            margin-top: 4px;
        }

        .hang-tag {
            background: var(--s1);
            border: 1px solid var(--border2);
            border-radius: 4px;
            padding: 1px 6px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
        }

            .hang-tag .hn {
                color: var(--gold2);
            }

            .hang-tag .hd {
                color: var(--text2);
            }

        /* Chờ ra cổng */
        .racong-card {
            background: var(--s2);
            border: 1px solid var(--border2);
            border-left: 3px solid var(--green);
            border-radius: 6px;
            padding: 7px 9px;
            margin-bottom: 5px;
        }

        .racong-bienso {
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 700;
            color: var(--green2);
        }

        .racong-meta {
            font-size: 10px;
            color: var(--text2);
            margin-top: 2px;
        }

        .racong-hang {
            font-size: 10px;
            color: var(--green2);
            margin-top: 3px;
        }

        /* ── Col nhập / xuất ── */
        .col-nhap, .col-xuat {
            display: grid;
            grid-template-rows: auto 1fr;
            padding: 6px 8px;
            gap: 5px;
            min-height: 0;
        }

        .sec-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 5px;
            border-bottom: 1px solid var(--border2);
            flex-shrink: 0;
        }

        .sec-title {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

            .sec-title.nhap {
                color: var(--blue2);
            }

            .sec-title.xuat {
                color: var(--orange2);
            }

        .sec-stats {
            display: flex;
            gap: 10px;
            font-size: 10px;
            color: var(--text2);
        }

            .sec-stats span span {
                font-weight: 700;
            }

        /* Cửa grid — nhập 3 cột, xuất 4 cột */
        .cua-grid {
            display: grid;
            gap: 5px;
            align-content: start;
            overflow-y: auto;
            overflow-x: hidden;
            min-height: 0;
        }

            .cua-grid::-webkit-scrollbar {
                width: 3px;
            }

            .cua-grid::-webkit-scrollbar-track {
                background: transparent;
            }

            .cua-grid::-webkit-scrollbar-thumb {
                background: var(--border2);
                border-radius: 2px;
            }

            .cua-grid.nhap {
                grid-template-columns: repeat(3, 1fr);
            }

            .cua-grid.xuat {
                grid-template-columns: repeat(4, 1fr);
            }

        /* Card cửa — to hơn, dễ đọc */
        .cua-card {
            background: var(--s1);
            border: 1px solid var(--border);
            @* border-left: 3px solid var(--border2); *@
            border-radius: 7px;
            padding: 8px 10px;
            cursor: pointer;
            transition: background .12s;
        }

            .cua-card:hover {
                background: var(--s2);
            }

            .cua-card.st-cho {
                @* border-left-color: var(--blue); *@
            }

            .cua-card.st-dang {
                @* border-left-color: var(--gold); *@
            }

            .cua-card.st-quagio {
                border-left-color: var(--red);
                background: rgba(239,68,68,.04);
            }

            .cua-card.st-done {
                border-left-color: var(--green);
            }

        .cua-name {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 4px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .cua-name.nhap {
                color: var(--blue2);
            }

            .cua-name.xuat {
                color: var(--orange2);
            }

        .cua-bienso {
            font-family: 'JetBrains Mono', monospace;
            font-size: 16px;
            font-weight: 700;
            color: var(--gold2);
            letter-spacing: 1px;
            min-height: 22px;
        }

            .cua-bienso.empty {
                color: var(--text2);
                font-size: 11px;
                font-weight: 400;
            }

        .cua-divider {
            border-top: 1px solid var(--border);
            margin: 5px 0;
        }

        .cua-hang-row {
            display: flex;
            justify-content: space-between;
            font-size: 9px;
            margin-bottom: 2px;
        }

        .cua-hang-lbl {
            color: var(--text2);
        }

        .cua-hang-val.chua {
            font-family: 'JetBrains Mono', monospace;
            color: var(--gold2);
            font-size: 10px;
        }

        .cua-hang-val.da {
            font-family: 'JetBrains Mono', monospace;
            color: var(--green2);
            font-size: 10px;
        }

        .cua-strip {
            margin-top: 5px;
            padding: 3px 6px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .3px;
            text-align: center;
        }

            .cua-strip.trong {
                background: rgba(30,58,95,.3);
                color: var(--text2);
            }

            .cua-strip.wait {
                background: rgba(59,130,246,.12);
                color: var(--blue2);
            }

            .cua-strip.dang {
                background: rgba(245,158,11,.12);
                color: var(--gold);
            }

            .cua-strip.over {
                background: rgba(239,68,68,.15);
                color: var(--red2);
                animation: blink .7s step-start infinite;
            }

            .cua-strip.done {
                background: rgba(34,197,94,.12);
                color: var(--green);
            }

        .cua-timer {
            font-family: 'JetBrains Mono', monospace;
            font-size: 9px;
            color: var(--text2);
            text-align: right;
            margin-top: 2px;
        }

            .cua-timer.warn {
                color: var(--gold);
            }

            .cua-timer.over {
                color: var(--red);
            }

        .empty-note {
            text-align: center;
            padding: 14px 6px;
            font-size: 10px;
            color: var(--text2);
            font-style: italic;
        }

        /* ══ FOOTER ══ */
        .footer {
            display: grid;
            grid-template-columns: 1fr 1px 1fr;
            background: var(--s1);
            border: 1px solid var(--border2);
            border-radius: 7px;
            overflow: hidden;
            min-height: 0;
        }

        .footer-divider {
            background: var(--border2);
        }

        .footer-col {
            display: flex;
            flex-direction: column;
            padding: 4px 10px;
            min-height: 0;
        }

        .footer-col-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding-bottom: 4px;
            border-bottom: 1px solid var(--border2);
            flex-shrink: 0;
            margin-bottom: 4px;
        }

        .footer-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            overflow-y: auto;
            flex: 1;
        }

            .footer-chips::-webkit-scrollbar {
                width: 2px;
            }

            .footer-chips::-webkit-scrollbar-thumb {
                background: var(--border2);
            }

        .xe-chip {
            background: var(--s2);
            border: 1px solid var(--border2);
            border-radius: 5px;
            padding: 3px 8px; /* giảm padding */
            display: flex;
            flex-direction: column;
            gap: 1px;
            width: fit-content; /* ← thêm dòng này */
            height: fit-content; /* ← thêm dòng này */
        }

        .xe-chip-bs {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            font-weight: 700;
        }

            .xe-chip-bs.green {
                color: var(--green2);
            }

            .xe-chip-bs.orange {
                color: var(--orange2);
            }

        .xe-chip-tt {
            font-size: 9px;
            color: var(--text2);
        }

        /* ══ POPUP ══ */
        .popup-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.8);
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
        }

            .popup-overlay.show {
                display: flex;
            }

        .popup {
            background: var(--s2);
            border: 1px solid var(--border2);
            border-top: 2px solid var(--cyan);
            border-radius: 10px;
            width: 480px;
            max-width: 95vw;
            padding: 20px;
        }

        .popup-title {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            color: var(--cyan);
            text-transform: uppercase;
            margin-bottom: 14px;
            display: flex;
            justify-content: space-between;
        }

        .popup-close {
            background: none;
            border: none;
            color: var(--text2);
            font-size: 20px;
            cursor: pointer;
        }

        .popup-bienso {
            font-family: 'JetBrains Mono', monospace;
            font-size: 32px;
            font-weight: 700;
            color: var(--gold2);
            letter-spacing: 4px;
            text-align: center;
            padding: 12px 0;
            border: 1px solid var(--border2);
            border-radius: 6px;
            margin-bottom: 14px;
        }

        .popup-row {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            padding: 6px 0;
            border-bottom: 1px solid var(--border);
        }

        .popup-lbl {
            color: var(--text2);
        }

        .popup-val {
            color: var(--bright);
            font-weight: 600;
        }

        .popup-hang-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 6px;
            margin-top: 12px;
        }

        .popup-hang-cell {
            background: var(--s1);
            border: 1px solid var(--border2);
            border-radius: 5px;
            padding: 8px;
            text-align: center;
        }

        .popup-hang-dv {
            font-size: 10px;
            color: var(--text2);
        }

        .popup-hang-n {
            font-family: 'JetBrains Mono', monospace;
            font-size: 18px;
            font-weight: 700;
            margin-top: 2px;
        }

            .popup-hang-n.chua {
                color: var(--gold2);
            }

            .popup-hang-n.da {
                color: var(--green2);
            }
    </style>
</head>
<body>
    <div class="screen">

        <!-- ══ TOPBAR ══ -->
        <div class="topbar">
            <div class="tb-brand">
                <div class="tb-logo">⚙</div>
                <div>
                    <div class="tb-title">Trung Tâm Điều Hành</div>
                    <div class="tb-sub">Warehouse Operation Center · Real-time</div>
                </div>
            </div>

            <div class="kpi-row">
                <div class="kpi-pill c-blue">
                    <span class="n" id="kpi-nhap-hom">0</span>
                    <span class="l">Nhập hôm nay</span>
                </div>
                <div class="kpi-pill c-cyan">
                    <span class="n" id="kpi-nhap-xong">0</span>
                    <span class="l">Nhập xong</span>
                </div>
                <div class="kpi-pill c-orange">
                    <span class="n" id="kpi-xuat-hom">0</span>
                    <span class="l">Xuất hôm nay</span>
                </div>
                <div class="kpi-pill c-green">
                    <span class="n" id="kpi-xuat-xong">0</span>
                    <span class="l">Đã rời kho</span>
                </div>
                <div class="kpi-pill c-red" id="kpi-quagio-pill">
                    <span class="n" id="kpi-quagio">0</span>
                    <span class="l">Quá giờ</span>
                </div>
                <div class="kpi-pill c-gold">
                    <span class="n" id="kpi-xe-bai">0</span>
                    <span class="l">Xe trong bãi</span>
                </div>
                <div class="kpi-pill c-blue">
                    <span class="n" id="kpi-sap-ve">0</span>
                    <span class="l">Xe sắp về</span>
                </div>
            </div>

            <div class="tb-right">
                <div class="alert-pill hidden" id="footer-alert-pill">
                    <span>⚠</span><span id="footer-alert-txt"></span>
                </div>
                <div>
                    <div class="clock" id="clock">--:--:--</div>
                    <div class="date" id="date-str"></div>
                </div>
            </div>
        </div>

        <!-- ══ MAIN ══ -->
        <div class="main">

            <!-- Sidebar trái: Xe sắp về -->
            <div class="col-sidebar">
                <div class="sb-header" style="color:var(--blue2);">
                    <span>▶ Xe sắp về</span>
                    <span class="count-badge" id="sb-sapve-count" style="color:var(--blue2);">0</span>
                </div>
                <div class="sb-body" id="sb-sapve-list">
                    <div class="empty-note">Chưa có dữ liệu</div>
                </div>
            </div>

            <div class="divider-v"></div>

            <!-- Cột Nhập — 3 cột -->
            <div class="col-nhap">
                <div class="sec-header">
                    <span class="sec-title nhap">▶ Nhập kho</span>
                    <div class="sec-stats">
                        <span>Đã về: <span id="nh-dave" style="color:var(--blue2);">0</span></span>
                        <span>Chưa vào: <span id="nh-chuavao" style="color:var(--red2);">0</span></span>
                        <span>Đang BG: <span id="nh-dangbg" style="color:var(--orange2);">0</span></span>
                        <span style="color:var(--text2);font-size:9px;margin-left:4px;">@cuaNhaps.Count cửa</span>
                    </div>
                </div>
                <div class="cua-grid nhap" id="grid-nhap">
                    @foreach (var c in cuaNhaps)
                    {
                        <div class="cua-card st-trong" id="nc-@c.Id" onclick="showDetail('nhap',@c.Id)">
                            <div class="cua-name nhap"><span>@c.Ten</span></div>
                            <div class="cua-bienso empty" id="nb-@c.Id">— Trống —</div>
                            <div class="cua-divider" id="nc-div-@c.Id" style="display:none;"></div>
                            <div class="cua-hang-row" id="nc-hang-@c.Id" style="display:none;">
                                <span class="cua-hang-lbl">Chưa BG</span>
                                <span class="cua-hang-val chua" id="nc-chua-@c.Id">—</span>
                            </div>
                            <div class="cua-hang-row" id="nc-hang2-@c.Id" style="display:none;">
                                <span class="cua-hang-lbl">Đã BG</span>
                                <span class="cua-hang-val da" id="nc-da-@c.Id">—</span>
                            </div>
                            <div class="cua-strip trong" id="ns-@c.Id">Trống</div>
                            <div class="cua-timer" id="nt-@c.Id"></div>
                        </div>
                    }
                </div>
            </div>

            <div class="divider-v"></div>

            <!-- Cột Xuất — 4 cột -->
            <div class="col-xuat">
                <div class="sec-header">
                    <span class="sec-title xuat">▶ Xuất kho</span>
                    <div class="sec-stats">
                        <span>Chờ xuất: <span id="xc-cho" style="color:var(--text);">0</span></span>
                        <span>Đang BG: <span id="xc-dang" style="color:var(--gold2);">0</span></span>
                        <span>Quá giờ: <span id="xc-qg" style="color:var(--red2);">0</span></span>
                        <span>Đã rời: <span id="xc-roi" style="color:var(--green2);">0</span></span>
                        <span style="color:var(--text2);font-size:9px;margin-left:4px;">@cuaXuats.Count cửa</span>
                    </div>
                </div>
                <div class="cua-grid xuat" id="grid-xuat">
                    @foreach (var c in cuaXuats)
                    {
                        <div class="cua-card st-trong" id="xc-@c.Id" onclick="showDetail('xuat',@c.Id)">
                            <div class="cua-name xuat">
                                <span>@c.Ten</span>
                                @if (!c.IsActive)
                                {
                                    <span style="font-size:7px;color:var(--red2);">KHÓA</span>
                                }
                            </div>
                            <div class="cua-bienso empty" id="xb-@c.Id">— Trống —</div>
                            <div class="cua-divider" id="xc-div-@c.Id" style="display:none;"></div>
                            <div class="cua-hang-row" id="xc-hang-@c.Id" style="display:none;">
                                <span class="cua-hang-lbl">Chưa BG</span>
                                <span class="cua-hang-val chua" id="xc-chua-@c.Id">—</span>
                            </div>
                            <div class="cua-hang-row" id="xc-hang2-@c.Id" style="display:none;">
                                <span class="cua-hang-lbl">Đã BG</span>
                                <span class="cua-hang-val da" id="xc-da-@c.Id">—</span>
                            </div>
                            <div class="cua-strip trong" id="xs-@c.Id">Trống</div>
                            <div class="cua-timer" id="xt-@c.Id"></div>
                        </div>
                    }
                </div>
            </div>

            <div class="divider-v"></div>

            <!-- Sidebar phải: Chờ ra cổng -->
            <div class="col-sidebar">
                <div class="sb-header" style="color:var(--green2);">
                    <span>▶ Chờ ra cổng</span>
                    <span class="count-badge" id="sb-racong-count" style="color:var(--green2);">0</span>
                </div>
                <div class="sb-body" id="sb-racong-list">
                    <div class="empty-note">Không có xe</div>
                </div>
            </div>

        </div><!-- end .main -->
        <!-- ══ FOOTER 2 cột — cao hơn ══ -->
        <div class="footer">
            <div class="footer-col">
                <div class="footer-col-header" style="color:var(--green2);">
                    <span>Xe trong bãi</span>
                    <span class="count-badge" id="ft-xebai-count" style="color:var(--green2);">0</span>
                </div>
                <div class="footer-chips" id="ft-xebai-chips">
                    <span style="font-size:9px;color:var(--text2);">Đang tải...</span>
                </div>
            </div>
            <div class="footer-divider"></div>
            <div class="footer-col">
                <div class="footer-col-header" style="color:var(--orange2);">
                    <span>Đã rời kho hôm nay</span>
                    <span class="count-badge" id="ft-roikho-count" style="color:var(--orange2);">0</span>
                </div>
                <div class="footer-chips" id="ft-roikho-chips">
                    <span style="font-size:9px;color:var(--text2);">Chưa có dữ liệu</span>
                </div>
            </div>
        </div>

    </div><!-- end .screen -->
    <!-- ══ POPUP ══ -->
    <div class="popup-overlay" id="popup-overlay" onclick="closePopup(event)">
        <div class="popup" onclick="event.stopPropagation()">
            <div class="popup-title">
                <span id="popup-title-txt">Chi tiết cửa</span>
                <button class="popup-close" onclick="closePopupDirect()">×</button>
            </div>
            <div class="popup-bienso" id="popup-bienso">—</div>
            <div id="popup-rows"></div>
            <div class="popup-hang-grid" id="popup-hangs"></div>
        </div>
    </div>

    <script>
        var snapshot = null;
        var timerMap = {};

        function tick() {
            var n = new Date();
            document.getElementById('clock').textContent    = n.toLocaleTimeString('vi-VN', {hour12:false});
            document.getElementById('date-str').textContent = n.toLocaleDateString('vi-VN', {weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'}).toUpperCase();
            updateTimers();
        }
        setInterval(tick, 1000); tick();

        function updateTimers() {
            var now = new Date();
            Object.keys(timerMap).forEach(function(key) {
                var info = timerMap[key];
                if (!info.deadline) return;
                var el = document.getElementById(info.elId);
                if (!el) return;
                var diff = Math.floor((info.deadline - now) / 1000);
                if (diff > 0) {
                    var m = Math.floor(diff / 60), s = diff % 60;
                    el.textContent = 'Còn ' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
                    el.className   = 'cua-timer' + (diff < 300 ? ' warn' : '');
                } else {
                    el.textContent = 'QUÁ HẠN';
                    el.className   = 'cua-timer over';
                }
            });
        }

        var conn = new signalR.HubConnectionBuilder()
            .withUrl('/signalserver').withAutomaticReconnect().build();

        conn.on('UpdateBangTongHop',     function() { loadSnapshot(); });
        conn.on('UpdateBangTongHopXuat', function() { loadSnapshot(); });
        conn.on('ReceivedNhap',          function() { loadSnapshot(); });
        conn.on('Receivedxuat',          function() { loadSnapshot(); });
        conn.on('ReloadDashboard',       function() { loadSnapshot(); });
        conn.on('TrangThaiXeUpdated',    function() { loadSnapshot(); });

        conn.start().then(function() {
            document.getElementById('sig-dot').className = 'dot on';
        }).catch(function() {
            document.getElementById('sig-dot').className = 'dot err';
        });

        async function loadSnapshot() {
            try {
                var res = await fetch('/TongTrungTam/GetSnapshot');
                if (!res.ok) return;
                snapshot = await res.json();
                render();
            } catch(e) { console.error('loadSnapshot:', e); }
        }
        loadSnapshot();
        setInterval(loadSnapshot, 30000);

        function render() {
            if (!snapshot) return;
            renderKPI();
            renderSidebarSapVe();
            renderNhap();
            renderXuat();
            renderSidebarRaCong();
            renderFooter();
        }

        function renderKPI() {
            var k = snapshot.kpi; if (!k) return;
            set('kpi-nhap-hom',  k.tongNhapHom   || 0);
            set('kpi-nhap-xong', k.nhapHoanThanh || 0);
            set('kpi-xuat-hom',  k.tongXuatHom   || 0);
            set('kpi-xuat-xong', k.xuatHoanThanh || 0);
            var quaGio = (k.nhapQuaGio || 0) + (k.xuatQuaGio || 0);
            set('kpi-quagio', quaGio);
            document.getElementById('kpi-quagio-pill').style.opacity = quaGio > 0 ? '1' : '0.4';
            var xeBai = 0;
            (k.xeGroups || []).forEach(function(g) { if (g.trangThai === 0) xeBai = g.soLuong; });
            set('kpi-xe-bai',  xeBai);
            set('kpi-sap-ve', (snapshot.nhap && snapshot.nhap.sapVeXe) || 0);
            if (quaGio > 0) {
                document.getElementById('footer-alert-pill').className = 'alert-pill';
                document.getElementById('footer-alert-txt').textContent = quaGio + ' cửa quá giờ — Xử lý ngay!';
            } else {
                document.getElementById('footer-alert-pill').className = 'alert-pill hidden';
            }
        }

        function renderSidebarSapVe() {
            var nh = snapshot.nhap || {};
            var xeSapVe = nh.xeSapVe || [];
            var el = document.getElementById('sb-sapve-list');
            set('sb-sapve-count', xeSapVe.length);
            if (!xeSapVe.length) { el.innerHTML = '<div class="empty-note">Chưa có xe sắp về</div>'; return; }
            el.innerHTML = xeSapVe.map(function(x) {
                var cls   = x.daPhanCong ? 'sapve-card da-pc' : 'sapve-card';
                var hangs = (x.hangHoas || []).map(function(h) {
                    return '<span class="hang-tag"><span class="hn">' + h.soLuong.toLocaleString('vi-VN') + '</span> <span class="hd">' + h.donVi + '</span></span>';
                }).join('');
                var ngay  = x.ngayDuKien ? new Date(x.ngayDuKien).toLocaleString('vi-VN',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : '';
                return '<div class="' + cls + '">'
                    + '<div class="sapve-bienso">' + x.bienSo + '</div>'
                    + '<div class="sapve-meta">' + (x.tenLaiXe && x.tenLaiXe !== '--' ? x.tenLaiXe : '') + (ngay ? ' · ' + ngay : '') + '</div>'
                    + (x.daPhanCong ? '<div class="sapve-meta" style="color:var(--gold2);margin-top:2px;">✔ Đã phân công</div>' : '')
                    + (hangs ? '<div class="sapve-hang">' + hangs + '</div>' : '')
                + '</div>';
            }).join('');
        }

        function renderNhap() {
            var nh = snapshot.nhap; if (!nh) return;
            set('nh-dave',    nh.daVeXe      || 0);
            set('nh-chuavao', nh.chuaVaoXe   || 0);
            set('nh-dangbg',  nh.dangBanGiao || 0);
            (nh.cards || []).forEach(function(c) {
                var id    = c.cuaId;
                var card  = document.getElementById('nc-' + id);
                var bienso= document.getElementById('nb-' + id);
                var strip = document.getElementById('ns-' + id);
                var chua  = document.getElementById('nc-chua-' + id);
                var da    = document.getElementById('nc-da-' + id);
                var timer = document.getElementById('nt-' + id);
                var divEl = document.getElementById('nc-div-' + id);
                var hang1 = document.getElementById('nc-hang-' + id);
                var hang2 = document.getElementById('nc-hang2-' + id);
                if (!card) return;
                if (!c.phieu) {
                    card.className = 'cua-card st-trong';
                    bienso.textContent = '— Trống —'; bienso.className = 'cua-bienso empty';
                    strip.textContent  = 'Trống'; strip.className = 'cua-strip trong';
                    timer.textContent  = '';
                    if (divEl) divEl.style.display = 'none';
                    if (hang1) hang1.style.display = 'none';
                    if (hang2) hang2.style.display = 'none';
                    delete timerMap['n' + id]; return;
                }
                var p = c.phieu, tt = p.trangThai;
                bienso.textContent = p.bienSo; bienso.className = 'cua-bienso';
                var tc = 0, td = 0;
                (p.hangHoas || []).forEach(function(h) { tc += h.chuaBG || 0; td += h.daBG || 0; });
                if (divEl) divEl.style.display = '';
                if (hang1) hang1.style.display = '';
                if (hang2) hang2.style.display = '';
                chua.textContent = tc > 0 ? tc.toLocaleString('vi-VN') : '—';
                da.textContent   = td > 0 ? td.toLocaleString('vi-VN') : '—';
                if (tt === 0) {
                    card.className = 'cua-card st-cho';
                    strip.textContent = 'Đã phân công — chờ xe vào'; strip.className = 'cua-strip wait';
                    delete timerMap['n' + id];
                } else if (tt === 1) {
                    card.className = 'cua-card st-dang';
                    strip.textContent = 'Đang bàn giao'; strip.className = 'cua-strip dang';
                    if (p.thoiGianGioiHan) timerMap['n' + id] = { deadline: new Date(p.thoiGianGioiHan), elId: 'nt-' + id };
                } else if (tt === 2) {
                    card.className = 'cua-card st-quagio';
                    strip.textContent = 'QUÁ GIỜ — XỬ LÝ NGAY'; strip.className = 'cua-strip over';
                    timer.textContent = 'QUÁ HẠN'; timer.className = 'cua-timer over';
                    delete timerMap['n' + id];
                } else if (tt === 3) {
                    card.className = 'cua-card st-done';
                    strip.textContent = 'Hoàn thành BG'; strip.className = 'cua-strip done';
                    delete timerMap['n' + id];
                }
            });
        }

        function renderXuat() {
            var xd = snapshot.xuat; if (!xd) return;
            var st = xd.stats || {};
            set('xc-cho',  st.choPhanCong || 0);
            set('xc-dang', st.dangBanGiao || 0);
            set('xc-qg',   st.quaGio      || 0);
            set('xc-roi',  st.daRoiKho    || 0);
            (xd.cards || []).forEach(function(c) {
                var id    = c.cuaId;
                var card  = document.getElementById('xc-' + id);
                var bienso= document.getElementById('xb-' + id);
                var strip = document.getElementById('xs-' + id);
                var chua  = document.getElementById('xc-chua-' + id);
                var da    = document.getElementById('xc-da-' + id);
                var timer = document.getElementById('xt-' + id);
                var divEl = document.getElementById('xc-div-' + id);
                var hang1 = document.getElementById('xc-hang-' + id);
                var hang2 = document.getElementById('xc-hang2-' + id);
                if (!card) return;
                if (!c.phieu) {
                    card.className = 'cua-card st-trong';
                    bienso.textContent = '— Trống —'; bienso.className = 'cua-bienso empty';
                    strip.textContent  = 'Trống'; strip.className = 'cua-strip trong';
                    timer.textContent  = '';
                    if (divEl) divEl.style.display = 'none';
                    if (hang1) hang1.style.display = 'none';
                    if (hang2) hang2.style.display = 'none';
                    delete timerMap['x' + id]; return;
                }
                var p = c.phieu, tt = p.trangThai;
                bienso.textContent = p.bienSo; bienso.className = 'cua-bienso';
                var tc = 0, td = 0;
                (p.hangHoas || []).forEach(function(h) { tc += h.chuaBG || 0; td += h.daBG || 0; });
                if (divEl) divEl.style.display = '';
                if (hang1) hang1.style.display = '';
                if (hang2) hang2.style.display = '';
                chua.textContent = tc > 0 ? tc.toLocaleString('vi-VN') : '—';
                da.textContent   = td > 0 ? td.toLocaleString('vi-VN') : '—';
                if (tt === 0) {
                    card.className = 'cua-card st-cho';
                    strip.textContent = 'Đã phân công — chờ xe vào'; strip.className = 'cua-strip wait';
                    delete timerMap['x' + id];
                } else if (tt === 1) {
                    card.className = 'cua-card st-dang';
                    strip.textContent = 'Đang xuất hàng'; strip.className = 'cua-strip dang';
                    if (p.thoiGianGioiHan) timerMap['x' + id] = { deadline: new Date(p.thoiGianGioiHan), elId: 'xt-' + id };
                } else if (tt === 2) {
                    card.className = 'cua-card st-quagio';
                    strip.textContent = 'QUÁ GIỜ — XỬ LÝ NGAY'; strip.className = 'cua-strip over';
                    timer.textContent = 'QUÁ HẠN'; timer.className = 'cua-timer over';
                    delete timerMap['x' + id];
                } else if (tt === 3) {
                    card.className = 'cua-card st-done';
                    strip.textContent = 'Chờ BV xác nhận ra cổng'; strip.className = 'cua-strip done';
                    delete timerMap['x' + id];
                }
            });
        }

        function renderSidebarRaCong() {
            var xeRa = snapshot.xeChoRaCong || [];
            var el   = document.getElementById('sb-racong-list');
            set('sb-racong-count', xeRa.length);
            if (!xeRa.length) { el.innerHTML = '<div class="empty-note">Không có xe</div>'; return; }
            el.innerHTML = xeRa.map(function(x) {
                var hangs = (x.hangHoas || []).map(function(h) {
                    return h.daBG.toLocaleString('vi-VN') + ' ' + h.donVi;
                }).join(' · ');
                var tg = x.thoiGianHoanThanh
                    ? new Date(x.thoiGianHoanThanh).toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'})
                    : '--:--';
                return '<div class="racong-card">'
                    + '<div class="racong-bienso">' + x.bienSo + '</div>'
                    + '<div class="racong-meta">' + x.tenCua + ' · ' + tg + '</div>'
                    + (hangs ? '<div class="racong-hang">✔ ' + hangs + '</div>' : '')
                + '</div>';
            }).join('');
        }

        function renderFooter() {
            var xes   = snapshot.xeTrongBai || [];
            var baiEl = document.getElementById('ft-xebai-chips');
            set('ft-xebai-count', xes.length);
            if (!xes.length) {
                baiEl.innerHTML = '<span style="font-size:9px;color:var(--text2);">Không có xe</span>';
            } else {
                var ttLabel = ['Trong bãi','Chờ phân công','Đang vận chuyển','Bảo trì'];
                baiEl.innerHTML = xes.map(function(x) {
                    return '<div class="xe-chip">'
                        + '<span class="xe-chip-bs green">' + x.bienSo + '</span>'
                        + (x.tenTaiXe && x.tenTaiXe !== '--'
                            ? '<span class="xe-chip-tt">' + x.tenTaiXe + '</span>'
                            : '')
                    + '</div>';
                }).join('');
            }
            var xeRoiList = snapshot.xeRoiKho || [];
            var roiEl = document.getElementById('ft-roikho-chips');
            set('ft-roikho-count', xeRoiList.length);
            if (!xeRoiList.length) {
                roiEl.innerHTML = '<span style="font-size:9px;color:var(--text2);">Chưa có xe rời kho</span>';
            } else {
                roiEl.innerHTML = xeRoiList.map(function(x) {
                    var tg = x.thoiGianRoi
                        ? new Date(x.thoiGianRoi).toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'})
                        : '--:--';
                    return '<div class="xe-chip">'
                        + '<span class="xe-chip-bs orange">' + x.bienSo + '</span>'
                        + '<span class="xe-chip-tt">' + (x.tenCua || '--') + ' · ' + tg + '</span>'
                    + '</div>';
                }).join('');
            }
        }

        function showDetail(loai, cuaId) {
            if (!snapshot) return;
            var card = null;
            if (loai === 'nhap' && snapshot.nhap && snapshot.nhap.cards)
                card = snapshot.nhap.cards.find(function(c) { return c.cuaId == cuaId; });
            else if (loai === 'xuat' && snapshot.xuat && snapshot.xuat.cards)
                card = snapshot.xuat.cards.find(function(c) { return c.cuaId == cuaId; });
            if (!card) return;

            var tenCuaMap = loai === 'nhap'
                ? @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cuaNhaps.ToDictionary(c => c.Id, c => c.Ten)))
                : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cuaXuats.ToDictionary(c => c.Id, c => c.Ten)));

            document.getElementById('popup-title-txt').textContent =
                (loai === 'nhap' ? 'CỬA NHẬP — ' : 'CỬA XUẤT — ') + (tenCuaMap[cuaId] || ('Cửa ' + cuaId));

            if (!card.phieu) {
                document.getElementById('popup-bienso').textContent = '— TRỐNG —';
                document.getElementById('popup-rows').innerHTML = '<div style="text-align:center;padding:20px;color:var(--text2);">Cửa đang trống</div>';
                document.getElementById('popup-hangs').innerHTML = '';
            } else {
                var p = card.phieu;
                document.getElementById('popup-bienso').textContent = p.bienSo || '--';
                var ttLabels = ['Đã phân công — chờ xe','Đang bàn giao','Quá thời gian','Hoàn thành','Đã rời kho'];
                var ttColors = ['var(--blue2)','var(--gold)','var(--red)','var(--green)','var(--green2)'];
                var tt = p.trangThai || 0;
                var vaoCua  = p.thoiGianVaoCua  ? new Date(p.thoiGianVaoCua).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'})  : '--:--';
                var gioiHan = p.thoiGianGioiHan ? new Date(p.thoiGianGioiHan).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}) : '--:--';
                var rows = [
                    { lbl: 'Trạng thái',  val: ttLabels[tt] || '--', style: 'color:' + (ttColors[tt] || 'var(--text)') },
                    { lbl: 'Giờ vào cửa', val: vaoCua,  style: 'color:var(--gold2);font-family:JetBrains Mono,monospace;' },
                    { lbl: 'Giờ giới hạn',val: gioiHan, style: 'color:var(--gold2);font-family:JetBrains Mono,monospace;' },
                ];
                if (p.tenTaiXe && p.tenTaiXe !== '--') rows.push({ lbl: 'Tài xế', val: p.tenTaiXe, style: '' });
                document.getElementById('popup-rows').innerHTML = rows.map(function(r) {
                    return '<div class="popup-row"><span class="popup-lbl">' + r.lbl + '</span>'
                         + '<span class="popup-val"' + (r.style ? ' style="' + r.style + '"' : '') + '>' + r.val + '</span></div>';
                }).join('');
                var hangs = p.hangHoas || [];
                document.getElementById('popup-hangs').innerHTML = hangs.length
                    ? hangs.map(function(h) {
                        var chua = h.chuaBG !== undefined ? h.chuaBG : (h.soLuong || 0);
                        var da   = h.daBG   !== undefined ? h.daBG   : 0;
                        return '<div class="popup-hang-cell">'
                            + '<div class="popup-hang-dv">' + (h.donVi || '--') + '</div>'
                            + '<div class="popup-hang-n chua">' + chua.toLocaleString('vi-VN') + '</div>'
                            + '<div style="font-size:9px;color:var(--text2);margin-top:1px;">chưa BG</div>'
                            + '<div class="popup-hang-n da" style="margin-top:6px;">' + da.toLocaleString('vi-VN') + '</div>'
                            + '<div style="font-size:9px;color:var(--text2);margin-top:1px;">đã BG</div>'
                        + '</div>';
                    }).join('')
                    : '';
            }
            document.getElementById('popup-overlay').classList.add('show');
        }

        function closePopup(e) { if (e.target === document.getElementById('popup-overlay')) closePopupDirect(); }
        function closePopupDirect() { document.getElementById('popup-overlay').classList.remove('show'); }

        function set(id, val) { var el = document.getElementById(id); if (el) el.textContent = val; }
    </script>
</body>
</html>
