@model LedApp.Models.CuaXuat
@{
    ViewData["Title"] = "Xóa cửa xuất";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h5 class="mb-4">Xóa cửa xuất</h5>

<div class="row">
    <div class="col-md-5">
        <p class="text-secondary small">Bạn có chắc chắn muốn xóa cửa xuất này không?</p>

        <dl class="row small mb-4">
            <dt class="col-4 text-secondary fw-normal">Tên cửa</dt>
            <dd class="col-8">@Html.DisplayFor(model => model.Ten)</dd>

            <dt class="col-4 text-secondary fw-normal">Mô tả</dt>
            <dd class="col-8">@Html.DisplayFor(model => model.Mota)</dd>

            <dt class="col-4 text-secondary fw-normal">Trạng thái</dt>
            <dd class="col-8">@(Model.IsActive ? "Đang mở" : "Đã đóng")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-danger">Xác nhận xóa</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>