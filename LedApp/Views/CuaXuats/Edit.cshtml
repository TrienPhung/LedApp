@model LedApp.Models.CuaXuat
@{
    ViewData["Title"] = "Sửa cửa xuất";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<h5 class="mb-4">Sửa cửa xuất</h5>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label small text-secondary">Tên cửa</label>
                <input asp-for="Ten" class="form-control form-control-sm" />
                <span asp-validation-for="Ten" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label small text-secondary">Mô tả</label>
                <textarea asp-for="Mota" class="form-control form-control-sm" rows="3"></textarea>
                <span asp-validation-for="Mota" class="text-danger small"></span>
            </div>

            <div class="mb-4 d-flex justify-content-between align-items-center">
                <label class="form-label small text-secondary mb-0">Trạng thái mở</label>
                <div class="form-check form-switch mb-0">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-dark">Lưu sửa</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>