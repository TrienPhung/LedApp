@{
    ViewData["Title"] = "Báo cáo thống kê";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    .bc-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding: 4px 0 24px;
    }

    /* FILTER BAR */
    .filter-bar {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .filter-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
    }

    .filter-input {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 13px;
        color: #1e293b;
        outline: none;
        transition: border-color .2s;
    }

        .filter-input:focus {
            border-color: #3b82f6;
        }

    .btn-loc {
        background: #3b82f6;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-loc:hover {
            background: #2563eb;
        }

    .btn-excel {
        background: #16a34a;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-excel:hover {
            background: #15803d;
            color: #fff;
        }

    .filter-range-btns {
        display: flex;
        gap: 6px;
    }

    .btn-range {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 11px;
        color: #64748b;
        cursor: pointer;
        transition: all .15s;
        font-weight: 600;
    }

        .btn-range:hover, .btn-range.active {
            background: #eff6ff;
            border-color: #3b82f6;
            color: #3b82f6;
        }

    .filter-period {
        font-size: 11px;
        color: #94a3b8;
        margin-left: auto;
    }

    /* STAT CARDS */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 10px;
        padding: 14px 16px;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 10px 10px 0 0;
        }

        .stat-card.blue::before {
            background: #3b82f6;
        }

        .stat-card.green::before {
            background: #22c55e;
        }

        .stat-card.red::before {
            background: #ef4444;
        }

        .stat-card.orange::before {
            background: #f59e0b;
        }

        .stat-card.purple::before {
            background: #8b5cf6;
        }

        .stat-card.cyan::before {
            background: #06b6d4;
        }

    .stat-num {
        font-size: 26px;
        font-weight: 700;
        color: #1e293b;
        line-height: 1;
    }

    .stat-label {
        font-size: 11px;
        color: #64748b;
        margin-top: 5px;
    }

    .stat-sub {
        font-size: 10px;
        color: #94a3b8;
        margin-top: 2px;
    }

    /* KPI */
    .kpi-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .kpi-card {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 12px;
        padding: 16px 20px;
    }

    .kpi-title {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .kpi-nums {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
    }

    .kpi-item {
        text-align: center;
        padding: 10px;
        background: #f8fafc;
        border-radius: 8px;
    }

    .kpi-n {
        font-size: 22px;
        font-weight: 700;
    }

    .kpi-l {
        font-size: 10px;
        color: #94a3b8;
        margin-top: 3px;
    }

    .kpi-n.blue {
        color: #3b82f6;
    }

    .kpi-n.green {
        color: #22c55e;
    }

    .kpi-n.red {
        color: #ef4444;
    }

    /* CHART */
    .chart-panel {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 12px;
        padding: 18px 20px;
    }

    .chart-wrap {
        position: relative;
        height: 220px;
    }

    /* TABLE */
    .table-panel {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 12px;
        padding: 18px 20px;
    }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .panel-title {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
    }

    .bc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        .bc-table th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .3px;
            padding: 8px 12px;
            text-align: left;
            border-bottom: 1px solid #e8edf2;
            white-space: nowrap;
        }

        .bc-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #f1f5f9;
            color: #374151;
        }

        .bc-table tr:last-child td {
            border-bottom: none;
        }

        .bc-table tr:hover td {
            background: #f8fafc;
        }

    .badge-ht {
        background: #f0fdf4;
        color: #16a34a;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 700;
    }

    .badge-qg {
        background: #fef2f2;
        color: #dc2626;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 700;
    }

    .badge-dang {
        background: #eff6ff;
        color: #3b82f6;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 700;
    }

    /* XE QUÁ HẠN */
    .xe-qua-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border-left: 3px solid #ef4444;
        margin-bottom: 6px;
    }

    .xe-qua-plate {
        font-size: 15px;
        font-weight: 700;
        color: #dc2626;
        font-family: monospace;
        letter-spacing: 2px;
    }

    .xe-qua-meta {
        font-size: 11px;
        color: #64748b;
        margin-top: 2px;
    }

    .xe-qua-count {
        font-size: 20px;
        font-weight: 700;
        color: #ef4444;
    }

    .xe-qua-lbl {
        font-size: 10px;
        color: #94a3b8;
    }

    /* LOADING */
    .loading {
        text-align: center;
        padding: 40px;
        color: #94a3b8;
        font-size: 13px;
    }

    /* dark mode */
    body.dark-mode .filter-bar,
    body.dark-mode .stat-card,
    body.dark-mode .kpi-card,
    body.dark-mode .chart-panel,
    body.dark-mode .table-panel {
        background: #1a1a27 !important;
        border-color: #2a2a3d !important;
    }

    body.dark-mode .stat-num, body.dark-mode .panel-title {
        color: #e0e0e0 !important;
    }

    body.dark-mode .bc-table th {
        background: #222235 !important;
    }

    body.dark-mode .bc-table td {
        color: #c9c9c9 !important;
        border-color: #2a2a3d !important;
    }

    body.dark-mode .bc-table tr:hover td {
        background: #222235 !important;
    }

    body.dark-mode .kpi-item {
        background: #222235 !important;
    }

    body.dark-mode .filter-input {
        background: #0f0f14;
        border-color: #2a2a3d;
        color: #c9c9c9;
    }

    body.dark-mode .btn-range {
        background: #222235;
        border-color: #2a2a3d;
        color: #888;
    }

    body.dark-mode .xe-qua-item {
        background: #2a1010 !important;
    }
</style>

<div class="bc-wrap">

    <!-- FILTER BAR -->
    <div class="filter-bar">
        <span class="filter-label">📅 Từ ngày</span>
        <input type="date" class="filter-input" id="tu-ngay" />
        <span class="filter-label">đến ngày</span>
        <input type="date" class="filter-input" id="den-ngay" />

        <div class="filter-range-btns">
            <button class="btn-range" onclick="setRange(0)">Hôm nay</button>
            <button class="btn-range" onclick="setRange(7)">7 ngày</button>
            <button class="btn-range active" onclick="setRange(30)">30 ngày</button>
            <button class="btn-range" onclick="setRange(90)">3 tháng</button>
        </div>

        <button class="btn-loc" onclick="loadBaoCao()">🔍 Lọc</button>

        <a class="btn-excel" id="btn-excel" href="#" onclick="exportExcel()">
            📊 Xuất Excel
        </a>

        <span class="filter-period" id="filter-period"></span>
    </div>

    <!-- STAT CARDS -->
    <div class="stat-row">
        <div class="stat-card blue">
            <div class="stat-num" id="s-nhap-tong">--</div>
            <div class="stat-label">Tổng phiếu nhập</div>
            <div class="stat-sub" id="s-nhap-sub"></div>
        </div>
        <div class="stat-card green">
            <div class="stat-num" id="s-nhap-ht">--</div>
            <div class="stat-label">Nhập hoàn thành</div>
        </div>
        <div class="stat-card red">
            <div class="stat-num" id="s-nhap-qg">--</div>
            <div class="stat-label">Nhập quá giờ</div>
        </div>
        <div class="stat-card cyan">
            <div class="stat-num" id="s-xuat-tong">--</div>
            <div class="stat-label">Tổng phiếu xuất</div>
            <div class="stat-sub" id="s-xuat-sub"></div>
        </div>
        <div class="stat-card green">
            <div class="stat-num" id="s-xuat-ht">--</div>
            <div class="stat-label">Xuất hoàn thành</div>
        </div>
        <div class="stat-card red">
            <div class="stat-num" id="s-xuat-qg">--</div>
            <div class="stat-label">Xuất quá giờ</div>
        </div>
    </div>

    <!-- KPI -->
    <div class="kpi-row">
        <div class="kpi-card">
            <div class="kpi-title">⏱ KPI thời gian bàn giao NHẬP (phút)</div>
            <div class="kpi-nums">
                <div class="kpi-item">
                    <div class="kpi-n blue" id="kpi-nhap-tb">--</div>
                    <div class="kpi-l">Trung bình</div>
                </div>
                <div class="kpi-item">
                    <div class="kpi-n green" id="kpi-nhap-min">--</div>
                    <div class="kpi-l">Nhanh nhất</div>
                </div>
                <div class="kpi-item">
                    <div class="kpi-n red" id="kpi-nhap-max">--</div>
                    <div class="kpi-l">Chậm nhất</div>
                </div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">⏱ KPI thời gian bàn giao XUẤT (phút)</div>
            <div class="kpi-nums">
                <div class="kpi-item">
                    <div class="kpi-n blue" id="kpi-xuat-tb">--</div>
                    <div class="kpi-l">Trung bình</div>
                </div>
                <div class="kpi-item">
                    <div class="kpi-n green" id="kpi-xuat-min">--</div>
                    <div class="kpi-l">Nhanh nhất</div>
                </div>
                <div class="kpi-item">
                    <div class="kpi-n red" id="kpi-xuat-max">--</div>
                    <div class="kpi-l">Chậm nhất</div>
                </div>
            </div>
        </div>
    </div>

    <!-- BIỂU ĐỒ -->
    <div class="chart-panel">
        <div class="panel-head">
            <div class="panel-title">📈 Số lượt bàn giao theo ngày</div>
            <div style="display:flex;gap:14px;font-size:11px;">
                <span style="color:#3b82f6;">● Nhập</span>
                <span style="color:#22c55e;">● Xuất</span>
            </div>
        </div>
        <div class="chart-wrap">
            <canvas id="chart-ngay"></canvas>
        </div>
    </div>

    <!-- BẢNG CHI TIẾT + XE QUÁ HẠN -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">

        <!-- Chi tiết nhập theo ngày -->
        <div class="table-panel">
            <div class="panel-head">
                <div class="panel-title">📥 Chi tiết nhập theo ngày</div>
            </div>
            <div style="max-height:280px;overflow-y:auto;">
                <table class="bc-table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Tổng</th>
                            <th>Hoàn thành</th>
                            <th>Quá giờ</th>
                            <th>Đang nhập</th>
                        </tr>
                    </thead>
                    <tbody id="tb-nhap">
                        <tr><td colspan="5" class="loading">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Chi tiết xuất theo ngày -->
        <div class="table-panel">
            <div class="panel-head">
                <div class="panel-title">📤 Chi tiết xuất theo ngày</div>
            </div>
            <div style="max-height:280px;overflow-y:auto;">
                <table class="bc-table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Tổng</th>
                            <th>Hoàn thành</th>
                            <th>Quá giờ</th>
                            <th>Đang xuất</th>
                        </tr>
                    </thead>
                    <tbody id="tb-xuat">
                        <tr><td colspan="5" class="loading">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- XE HAY QUÁ HẠN -->
    <div class="table-panel">
        <div class="panel-head">
            <div class="panel-title">🚨 Xe hay quá hạn trong kỳ (top 10)</div>
            <span style="font-size:11px;color:#94a3b8;">Dựa trên cảnh báo quá hạn nhập</span>
        </div>
        <div id="xe-qua-list">
            <div class="loading">Đang tải...</div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        var chart = null;

        // ── SET RANGE ──
        function setRange(days) {
            var now = new Date();
            var from = new Date();
            from.setDate(now.getDate() - days);

            document.getElementById('tu-ngay').value  = fmt(from);
            document.getElementById('den-ngay').value = fmt(now);

            document.querySelectorAll('.btn-range').forEach(function(b){ b.classList.remove('active'); });
            event.target.classList.add('active');
        }

        function fmt(d) {
            return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
        }

        // Init: mặc định 30 ngày
        (function(){
            var now = new Date();
            var from = new Date(); from.setDate(now.getDate() - 30);
            document.getElementById('tu-ngay').value  = fmt(from);
            document.getElementById('den-ngay').value = fmt(now);
        })();

        // ── LOAD BÁO CÁO ──
        async function loadBaoCao() {
            var tu  = document.getElementById('tu-ngay').value;
            var den = document.getElementById('den-ngay').value;

            if (!tu || !den) { alert('Vui lòng chọn khoảng thời gian!'); return; }

            document.getElementById('filter-period').textContent = 'Đang tải...';

            try {
                var url = '@Url.Action("GetBaoCao", "BaoCao")?tuNgay=' + tu + '&denNgay=' + den;
                var res = await fetch(url);
                if (!res.ok) return;
                var d = await res.json();
                applyData(d);
            } catch(e) { console.error('loadBaoCao:', e); }
        }

        function applyData(d) {
            document.getElementById('filter-period').textContent =
                'Kỳ: ' + d.tuNgay + ' → ' + d.denNgay;

            var th = d.tongHop;

            // STAT CARDS
            document.getElementById('s-nhap-tong').textContent = th.tongNhap;
            document.getElementById('s-nhap-ht').textContent   = th.nhapHoanThanh;
            document.getElementById('s-nhap-qg').textContent   = th.nhapQuaGio;
            document.getElementById('s-nhap-sub').textContent  =
                Math.round(th.nhapHoanThanh / Math.max(th.tongNhap, 1) * 100) + '% hoàn thành';

            document.getElementById('s-xuat-tong').textContent = th.tongXuat;
            document.getElementById('s-xuat-ht').textContent   = th.xuatHoanThanh;
            document.getElementById('s-xuat-qg').textContent   = th.xuatQuaGio;
            document.getElementById('s-xuat-sub').textContent  =
                Math.round(th.xuatHoanThanh / Math.max(th.tongXuat, 1) * 100) + '% hoàn thành';

            // KPI
            var kpi = th.kpi;
            document.getElementById('kpi-nhap-tb').textContent  = kpi.nhapTb + ' ph';
            document.getElementById('kpi-nhap-min').textContent = kpi.nhapMin + ' ph';
            document.getElementById('kpi-nhap-max').textContent = kpi.nhapMax + ' ph';
            document.getElementById('kpi-xuat-tb').textContent  = kpi.xuatTb + ' ph';
            document.getElementById('kpi-xuat-min').textContent = kpi.xuatMin + ' ph';
            document.getElementById('kpi-xuat-max').textContent = kpi.xuatMax + ' ph';

            // BIỂU ĐỒ
            renderChart(d.chart || []);

            // BẢNG NHẬP
            var tbNhap = document.getElementById('tb-nhap');
            if (!d.chitietNhap || !d.chitietNhap.length) {
                tbNhap.innerHTML = '<tr><td colspan="5" class="loading">Không có dữ liệu</td></tr>';
            } else {
                tbNhap.innerHTML = d.chitietNhap.map(function(r) {
                    return '<tr>' +
                        '<td>' + r.ngay + '</td>' +
                        '<td><strong>' + r.tongSo + '</strong></td>' +
                        '<td><span class="badge-ht">' + r.hoanThanh + '</span></td>' +
                        '<td><span class="badge-qg">' + r.quaGio + '</span></td>' +
                        '<td><span class="badge-dang">' + r.dangNhap + '</span></td>' +
                    '</tr>';
                }).join('');
            }

            // BẢNG XUẤT
            var tbXuat = document.getElementById('tb-xuat');
            if (!d.chitietXuat || !d.chitietXuat.length) {
                tbXuat.innerHTML = '<tr><td colspan="5" class="loading">Không có dữ liệu</td></tr>';
            } else {
                tbXuat.innerHTML = d.chitietXuat.map(function(r) {
                    return '<tr>' +
                        '<td>' + r.ngay + '</td>' +
                        '<td><strong>' + r.tongSo + '</strong></td>' +
                        '<td><span class="badge-ht">' + r.hoanThanh + '</span></td>' +
                        '<td><span class="badge-qg">' + r.quaGio + '</span></td>' +
                        '<td><span class="badge-dang">' + r.dangXuat + '</span></td>' +
                    '</tr>';
                }).join('');
            }

            // XE QUÁ HẠN
            var xeEl = document.getElementById('xe-qua-list');
            if (!d.xeQuaHan || !d.xeQuaHan.length) {
                xeEl.innerHTML = '<div style="text-align:center;color:#94a3b8;padding:20px;font-size:12px;">Không có cảnh báo trong kỳ ✅</div>';
            } else {
                xeEl.innerHTML = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;">' +
                    d.xeQuaHan.map(function(x) {
                        var lc = x.lanCuoi ? new Date(x.lanCuoi).toLocaleDateString('vi-VN') : '--';
                        return '<div class="xe-qua-item">' +
                            '<div>' +
                                '<div class="xe-qua-plate">' + x.bienSo + '</div>' +
                                '<div class="xe-qua-meta">Cửa ' + x.cua + ' · Lần cuối: ' + lc + '</div>' +
                            '</div>' +
                            '<div style="text-align:right;">' +
                                '<div class="xe-qua-count">' + x.soLan + '</div>' +
                                '<div class="xe-qua-lbl">lần quá hạn</div>' +
                            '</div>' +
                        '</div>';
                    }).join('') +
                '</div>';
            }
        }

        // ── BIỂU ĐỒ ──
        function renderChart(data) {
            var labels = data.map(function(d){ return d.ngay; });
            var nhapData = data.map(function(d){ return d.nhap; });
            var xuatData = data.map(function(d){ return d.xuat; });

            var isDark = document.body.classList.contains('dark-mode');
            var gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.05)';
            var tickColor = isDark ? '#666' : '#94a3b8';

            var ctx = document.getElementById('chart-ngay').getContext('2d');
            if (chart) chart.destroy();

            chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Nhập',
                            data: nhapData,
                            backgroundColor: 'rgba(59,130,246,0.75)',
                            borderRadius: 3,
                        },
                        {
                            label: 'Xuất',
                            data: xuatData,
                            backgroundColor: 'rgba(34,197,94,0.75)',
                            borderRadius: 3,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 10 }, maxRotation: 45 } },
                        y: { grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 10 } }, beginAtZero: true }
                    }
                }
            });
        }

        // ── XUẤT EXCEL ──
        function exportExcel() {
            var tu  = document.getElementById('tu-ngay').value;
            var den = document.getElementById('den-ngay').value;
            if (!tu || !den) { alert('Vui lòng chọn khoảng thời gian!'); return; }
            window.location.href = '@Url.Action("ExportExcel", "BaoCao")?tuNgay=' + tu + '&denNgay=' + den;
        }

        // ── INIT ──
        loadBaoCao();
    </script>
}
