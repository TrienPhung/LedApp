@{
    ViewData["Title"] = "Báo cáo thống kê";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    /* ── RESET & BASE ── */
    .bc-wrap {
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 4px 0 32px;
        font-family: 'Segoe UI', sans-serif;
    }

    /* ── FILTER BAR ── */
    .filter-bar {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 12px;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
    }

    .filter-input {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 13px;
        color: #1e293b;
        outline: none;
        transition: border-color .2s;
        background: #f8fafc;
    }

        .filter-input:focus {
            border-color: #3b82f6;
            background: #fff;
        }

    .filter-range-btns {
        display: flex;
        gap: 5px;
    }

    .btn-range {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 11px;
        color: #64748b;
        cursor: pointer;
        transition: all .15s;
        font-weight: 600;
    }

        .btn-range:hover, .btn-range.active {
            background: #eff6ff;
            border-color: #3b82f6;
            color: #3b82f6;
        }

    .btn-loc {
        background: #3b82f6;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-loc:hover {
            background: #2563eb;
        }

    .btn-excel {
        background: #16a34a;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-excel:hover {
            background: #15803d;
            color: #fff;
        }

    .filter-period {
        font-size: 11px;
        color: #94a3b8;
        margin-left: auto;
        white-space: nowrap;
    }

    /* ── STAT CARDS (4 card như Apex Analytics) ── */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        transition: box-shadow .2s;
    }

        .stat-card:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,.07);
        }

    .stat-card-left {
        flex: 1;
    }

    .stat-num {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        line-height: 1;
        letter-spacing: -0.5px;
    }

    .stat-label {
        font-size: 12px;
        color: #64748b;
        margin-top: 6px;
        font-weight: 500;
    }

    .stat-change {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 8px;
        font-size: 11px;
        font-weight: 600;
    }

        .stat-change.up {
            color: #16a34a;
        }

        .stat-change.down {
            color: #dc2626;
        }

        .stat-change.neutral {
            color: #64748b;
        }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            background: #eff6ff;
        }

        .stat-icon.green {
            background: #f0fdf4;
        }

        .stat-icon.red {
            background: #fef2f2;
        }

        .stat-icon.orange {
            background: #fff7ed;
        }

    /* ── TWO COLUMN LAYOUT ── */
    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    /* ── PANEL BASE ── */
    .panel {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 12px;
        padding: 18px 20px;
    }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .panel-title {
        font-size: 13px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .panel-title-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .panel-sub {
        font-size: 11px;
        color: #94a3b8;
    }

    /* ── KPI CARDS ── */
    .kpi-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .kpi-card {
    }

    .kpi-nums {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        margin-top: 4px;
    }

    .kpi-item {
        text-align: center;
        padding: 12px 8px;
        background: #f8fafc;
        border-radius: 10px;
        border: 1px solid #f1f5f9;
    }

    .kpi-n {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.3px;
    }

        .kpi-n.blue {
            color: #3b82f6;
        }

        .kpi-n.green {
            color: #22c55e;
        }

        .kpi-n.red {
            color: #ef4444;
        }

    .kpi-l {
        font-size: 10px;
        color: #94a3b8;
        margin-top: 4px;
        font-weight: 500;
    }

    /* ── CHART PANEL ── */
    .chart-wrap {
        position: relative;
        height: 210px;
    }

    /* ── BAR CHART (Top cửa) ── */
    .bar-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .bar-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .bar-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .bar-name {
        font-size: 12px;
        color: #374151;
        font-weight: 500;
    }

    .bar-value {
        font-size: 12px;
        color: #64748b;
        font-weight: 600;
    }

    .bar-track {
        height: 6px;
        background: #f1f5f9;
        border-radius: 4px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.6s cubic-bezier(.4,0,.2,1);
    }

        .bar-fill.blue {
            background: linear-gradient(90deg, #3b82f6, #60a5fa);
        }

        .bar-fill.green {
            background: linear-gradient(90deg, #22c55e, #4ade80);
        }

    /* ── TABLE ── */
    .bc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        .bc-table th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .3px;
            padding: 9px 12px;
            text-align: left;
            border-bottom: 1px solid #e8edf2;
            white-space: nowrap;
        }

        .bc-table td {
            padding: 9px 12px;
            border-bottom: 1px solid #f1f5f9;
            color: #374151;
        }

        .bc-table tr:last-child td {
            border-bottom: none;
        }

        .bc-table tr:hover td {
            background: #f8fafc;
        }

    .badge {
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 10px;
        font-weight: 700;
        display: inline-block;
    }

    .badge-ht {
        background: #f0fdf4;
        color: #16a34a;
    }

    .badge-qg {
        background: #fef2f2;
        color: #dc2626;
    }

    .badge-dang {
        background: #eff6ff;
        color: #3b82f6;
    }

    /* ── XE QUÁ HẠN ── */
    .xe-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 8px;
    }

    .xe-qua-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border-radius: 10px;
        background: #fff5f5;
        border: 1px solid #fecaca;
        border-left: 3px solid #ef4444;
        transition: box-shadow .15s;
    }

        .xe-qua-item:hover {
            box-shadow: 0 2px 8px rgba(239,68,68,.12);
        }

    .xe-qua-plate {
        font-size: 14px;
        font-weight: 700;
        color: #dc2626;
        font-family: 'Courier New', monospace;
        letter-spacing: 1.5px;
    }

    .xe-qua-meta {
        font-size: 10px;
        color: #9ca3af;
        margin-top: 2px;
    }

    .xe-qua-count {
        font-size: 20px;
        font-weight: 700;
        color: #ef4444;
        text-align: right;
    }

    .xe-qua-lbl {
        font-size: 10px;
        color: #94a3b8;
    }

    .empty-state {
        text-align: center;
        padding: 28px;
        color: #94a3b8;
        font-size: 12px;
    }

    /* ── LEGEND DOTS ── */
    .legend {
        display: flex;
        gap: 16px;
        font-size: 11px;
        color: #64748b;
    }

        .legend span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    /* ── DARK MODE ── */
    body.dark-mode .filter-bar,
    body.dark-mode .stat-card,
    body.dark-mode .panel {
        background: #1a1a27 !important;
        border-color: #2a2a3d !important;
    }

    body.dark-mode .stat-num,
    body.dark-mode .panel-title,
    body.dark-mode .bar-name {
        color: #e0e0e0 !important;
    }

    body.dark-mode .bc-table th {
        background: #222235 !important;
        color: #888 !important;
    }

    body.dark-mode .bc-table td {
        color: #c9c9c9 !important;
        border-color: #2a2a3d !important;
    }

    body.dark-mode .bc-table tr:hover td {
        background: #222235 !important;
    }

    body.dark-mode .kpi-item {
        background: #222235 !important;
        border-color: #2a2a3d !important;
    }

    body.dark-mode .filter-input {
        background: #0f0f14;
        border-color: #2a2a3d;
        color: #c9c9c9;
    }

    body.dark-mode .btn-range {
        background: #222235;
        border-color: #2a2a3d;
        color: #888;
    }

    body.dark-mode .xe-qua-item {
        background: #2a1010 !important;
        border-color: #7f1d1d !important;
    }

    body.dark-mode .bar-track {
        background: #2a2a3d;
    }

    body.dark-mode .stat-icon.blue {
        background: #1e3a5f;
    }

    body.dark-mode .stat-icon.green {
        background: #14532d;
    }

    body.dark-mode .stat-icon.red {
        background: #7f1d1d;
    }

    body.dark-mode .stat-icon.orange {
        background: #431407;
    }
</style>

<div class="bc-wrap">

    <!-- FILTER BAR -->
    <div class="filter-bar">
        <span class="filter-label">📅 Từ ngày</span>
        <input type="date" class="filter-input" id="tu-ngay" />
        <span class="filter-label">đến</span>
        <input type="date" class="filter-input" id="den-ngay" />

        <div class="filter-range-btns">
            <button class="btn-range" onclick="setRange(0,this)">Hôm nay</button>
            <button class="btn-range" onclick="setRange(7,this)">7 ngày</button>
            <button class="btn-range active" onclick="setRange(30,this)">30 ngày</button>
            <button class="btn-range" onclick="setRange(90,this)">3 tháng</button>
        </div>

        <button class="btn-loc" onclick="loadBaoCao()">🔍 Lọc</button>
        <a class="btn-excel" href="#" onclick="exportExcel(); return false;">📊 Xuất Excel</a>
        <span class="filter-period" id="filter-period"></span>
    </div>

    <!-- STAT CARDS — 4 card kiểu Apex Analytics -->
    <div class="stat-row">
        <div class="stat-card">
            <div class="stat-card-left">
                <div class="stat-num" id="s-nhap-tong">--</div>
                <div class="stat-label">Tổng phiếu nhập</div>
                <div class="stat-change up" id="s-nhap-pct"></div>
            </div>
            <div class="stat-icon blue">📥</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-left">
                <div class="stat-num" id="s-nhap-ht">--</div>
                <div class="stat-label">Nhập hoàn thành</div>
                <div class="stat-change up" id="s-nhap-ht-pct"></div>
            </div>
            <div class="stat-icon green">✅</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-left">
                <div class="stat-num" id="s-xuat-tong">--</div>
                <div class="stat-label">Tổng phiếu xuất</div>
                <div class="stat-change up" id="s-xuat-pct"></div>
            </div>
            <div class="stat-icon orange">📤</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-left">
                <div class="stat-num" id="s-xuat-ht">--</div>
                <div class="stat-label">Xuất hoàn thành</div>
                <div class="stat-change up" id="s-xuat-ht-pct"></div>
            </div>
            <div class="stat-icon green">✅</div>
        </div>
    </div>

    <!-- KPI -->
    <div class="kpi-row">
        <div class="panel kpi-card">
            <div class="panel-head">
                <div class="panel-title">
                    <span class="panel-title-dot" style="background:#3b82f6;"></span>
                    KPI bàn giao NHẬP (phút)
                </div>
            </div>
            <div class="kpi-nums">
                <div class="kpi-item">
                    <div class="kpi-n blue" id="kpi-nhap-tb">--</div>
                    <div class="kpi-l">Trung bình</div>
                </div>
                <div class="kpi-item">
                    <div class="kpi-n green" id="kpi-nhap-min">--</div>
                    <div class="kpi-l">Nhanh nhất</div>
                </div>
                <div class="kpi-item">
                    <div class="kpi-n red" id="kpi-nhap-max">--</div>
                    <div class="kpi-l">Chậm nhất</div>
                </div>
            </div>
        </div>
        <div class="panel kpi-card">
            <div class="panel-head">
                <div class="panel-title">
                    <span class="panel-title-dot" style="background:#22c55e;"></span>
                    KPI bàn giao XUẤT (phút)
                </div>
            </div>
            <div class="kpi-nums">
                <div class="kpi-item">
                    <div class="kpi-n blue" id="kpi-xuat-tb">--</div>
                    <div class="kpi-l">Trung bình</div>
                </div>
                <div class="kpi-item">
                    <div class="kpi-n green" id="kpi-xuat-min">--</div>
                    <div class="kpi-l">Nhanh nhất</div>
                </div>
                <div class="kpi-item">
                    <div class="kpi-n red" id="kpi-xuat-max">--</div>
                    <div class="kpi-l">Chậm nhất</div>
                </div>
            </div>
        </div>
    </div>

    <!-- CHART + TOP CỬA (2 cột như Apex) -->
    <div class="two-col">

        <!-- Biểu đồ theo ngày -->
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">
                    <span class="panel-title-dot" style="background:#8b5cf6;"></span>
                    Số lượt bàn giao theo ngày
                </div>
                <div class="legend">
                    <span><span class="dot" style="background:#3b82f6;"></span>Nhập</span>
                    <span><span class="dot" style="background:#22c55e;"></span>Xuất</span>
                </div>
            </div>
            <div class="chart-wrap">
                <canvas id="chart-ngay"></canvas>
            </div>
        </div>

        <!-- Top cửa nhập & xuất kiểu "Revenue by Category" của Apex -->
        <div style="display:flex;flex-direction:column;gap:14px;">
            <div class="panel" style="flex:1;">
                <div class="panel-head">
                    <div class="panel-title">
                        <span class="panel-title-dot" style="background:#3b82f6;"></span>
                        Top cửa nhập
                    </div>
                    <span class="panel-sub">Theo số phiếu</span>
                </div>
                <div class="bar-list" id="top-cua-nhap">
                    <div class="empty-state">Đang tải...</div>
                </div>
            </div>
            <div class="panel" style="flex:1;">
                <div class="panel-head">
                    <div class="panel-title">
                        <span class="panel-title-dot" style="background:#22c55e;"></span>
                        Top cửa xuất
                    </div>
                    <span class="panel-sub">Theo số phiếu</span>
                </div>
                <div class="bar-list" id="top-cua-xuat">
                    <div class="empty-state">Đang tải...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- CHI TIẾT NHẬP / XUẤT -->
    <div class="two-col">
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">
                    <span class="panel-title-dot" style="background:#3b82f6;"></span>
                    Chi tiết nhập theo ngày
                </div>
            </div>
            <div style="max-height:260px;overflow-y:auto;">
                <table class="bc-table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Tổng</th>
                            <th>Hoàn thành</th>
                            <th>Quá giờ</th>
                            <th>Đang nhập</th>
                        </tr>
                    </thead>
                    <tbody id="tb-nhap">
                        <tr><td colspan="5" class="empty-state">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">
                    <span class="panel-title-dot" style="background:#22c55e;"></span>
                    Chi tiết xuất theo ngày
                </div>
            </div>
            <div style="max-height:260px;overflow-y:auto;">
                <table class="bc-table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Tổng</th>
                            <th>Hoàn thành</th>
                            <th>Quá giờ</th>
                            <th>Đang xuất</th>
                        </tr>
                    </thead>
                    <tbody id="tb-xuat">
                        <tr><td colspan="5" class="empty-state">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- XE QUÁ HẠN -->
    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">
                <span class="panel-title-dot" style="background:#ef4444;"></span>
                🚨 Xe hay quá hạn trong kỳ (Top 10)
            </div>
            <span class="panel-sub">Dựa trên cảnh báo quá hạn nhập</span>
        </div>
        <div id="xe-qua-list">
            <div class="empty-state">Đang tải...</div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        var chartInstance = null;

        // ── DATE HELPERS ──
        function fmt(d) {
            return d.getFullYear() + '-'
                + String(d.getMonth() + 1).padStart(2, '0') + '-'
                + String(d.getDate()).padStart(2, '0');
        }

        function setRange(days, btn) {
            var now  = new Date();
            var from = new Date();
            from.setDate(now.getDate() - days);
            document.getElementById('tu-ngay').value  = fmt(from);
            document.getElementById('den-ngay').value = fmt(now);
            document.querySelectorAll('.btn-range').forEach(function(b){ b.classList.remove('active'); });
            btn.classList.add('active');
        }

        // Init 30 ngày
        (function () {
            var now  = new Date();
            var from = new Date();
            from.setDate(now.getDate() - 30);
            document.getElementById('tu-ngay').value  = fmt(from);
            document.getElementById('den-ngay').value = fmt(now);
        })();

        // ── LOAD BÁO CÁO ──
        async function loadBaoCao() {
            var tu  = document.getElementById('tu-ngay').value;
            var den = document.getElementById('den-ngay').value;
            if (!tu || !den) { alert('Vui lòng chọn khoảng thời gian!'); return; }

            document.getElementById('filter-period').textContent = 'Đang tải...';
            try {
                var url = '@Url.Action("GetBaoCao", "BaoCao")?tuNgay=' + tu + '&denNgay=' + den;
                var res = await fetch(url);
                if (!res.ok) { console.error('HTTP', res.status); return; }
                var data = await res.json();
                applyData(data);
            } catch (e) {
                console.error('loadBaoCao:', e);
                document.getElementById('filter-period').textContent = 'Lỗi tải dữ liệu';
            }
        }

        function pct(a, b) {
            return b === 0 ? '0%' : Math.round(a / b * 100) + '%';
        }

        function applyData(d) {
            document.getElementById('filter-period').textContent = 'Kỳ: ' + d.tuNgay + ' → ' + d.denNgay;

            var th = d.tongHop;

            // ── STAT CARDS ──
            document.getElementById('s-nhap-tong').textContent = th.tongNhap;
            document.getElementById('s-nhap-pct').textContent  = pct(th.nhapHoanThanh, th.tongNhap) + ' hoàn thành';
            document.getElementById('s-nhap-ht').textContent   = th.nhapHoanThanh;
            document.getElementById('s-nhap-ht-pct').textContent = th.nhapQuaGio + ' quá giờ';

            document.getElementById('s-xuat-tong').textContent = th.tongXuat;
            document.getElementById('s-xuat-pct').textContent  = pct(th.xuatHoanThanh, th.tongXuat) + ' hoàn thành';
            document.getElementById('s-xuat-ht').textContent   = th.xuatHoanThanh;
            document.getElementById('s-xuat-ht-pct').textContent = th.xuatQuaGio + ' quá giờ';

            // ── KPI ──
            var kpi = th.kpi;
            document.getElementById('kpi-nhap-tb').textContent  = kpi.nhapTb + ' ph';
            document.getElementById('kpi-nhap-min').textContent = kpi.nhapMin + ' ph';
            document.getElementById('kpi-nhap-max').textContent = kpi.nhapMax + ' ph';
            document.getElementById('kpi-xuat-tb').textContent  = kpi.xuatTb + ' ph';
            document.getElementById('kpi-xuat-min').textContent = kpi.xuatMin + ' ph';
            document.getElementById('kpi-xuat-max').textContent = kpi.xuatMax + ' ph';

            // ── BIỂU ĐỒ ──
            renderChart(d.chart || []);

            // ── TOP CỬA NHẬP (bar list kiểu Apex) ──
            var topNhapEl = document.getElementById('top-cua-nhap');
            if (!d.topCuaNhap || !d.topCuaNhap.length) {
                topNhapEl.innerHTML = '<div class="empty-state">Không có dữ liệu</div>';
            } else {
                var maxNhap = Math.max.apply(null, d.topCuaNhap.map(function(x){ return x.soPhieu; }));
                topNhapEl.innerHTML = d.topCuaNhap.map(function(x) {
                    var w = maxNhap > 0 ? Math.round(x.soPhieu / maxNhap * 100) : 0;
                    return '<div class="bar-item">' +
                        '<div class="bar-meta">' +
                            '<span class="bar-name">' + x.ten + '</span>' +
                            '<span class="bar-value">' + x.soPhieu + ' phiếu</span>' +
                        '</div>' +
                        '<div class="bar-track"><div class="bar-fill blue" style="width:' + w + '%"></div></div>' +
                    '</div>';
                }).join('');
            }

            // ── TOP CỬA XUẤT ──
            var topXuatEl = document.getElementById('top-cua-xuat');
            if (!d.topCuaXuat || !d.topCuaXuat.length) {
                topXuatEl.innerHTML = '<div class="empty-state">Không có dữ liệu</div>';
            } else {
                var maxXuat = Math.max.apply(null, d.topCuaXuat.map(function(x){ return x.soPhieu; }));
                topXuatEl.innerHTML = d.topCuaXuat.map(function(x) {
                    var w = maxXuat > 0 ? Math.round(x.soPhieu / maxXuat * 100) : 0;
                    return '<div class="bar-item">' +
                        '<div class="bar-meta">' +
                            '<span class="bar-name">' + x.ten + '</span>' +
                            '<span class="bar-value">' + x.soPhieu + ' phiếu</span>' +
                        '</div>' +
                        '<div class="bar-track"><div class="bar-fill green" style="width:' + w + '%"></div></div>' +
                    '</div>';
                }).join('');
            }

            // ── BẢNG NHẬP ──
            // FIX: dùng đúng camelCase từ JSON (ngay, tongSo, hoanThanh, quaGio, dangNhap)
            var tbNhap = document.getElementById('tb-nhap');
            if (!d.chitietNhap || !d.chitietNhap.length) {
                tbNhap.innerHTML = '<tr><td colspan="5" class="empty-state">Không có dữ liệu</td></tr>';
            } else {
                tbNhap.innerHTML = d.chitietNhap.map(function(r) {
                    return '<tr>' +
                        '<td>' + (r.ngay || '--') + '</td>' +
                        '<td><strong>' + (r.tongSo || 0) + '</strong></td>' +
                        '<td><span class="badge badge-ht">' + (r.hoanThanh || 0) + '</span></td>' +
                        '<td><span class="badge badge-qg">' + (r.quaGio || 0) + '</span></td>' +
                        '<td><span class="badge badge-dang">' + (r.dangNhap || 0) + '</span></td>' +
                    '</tr>';
                }).join('');
            }

            // ── BẢNG XUẤT ──
            var tbXuat = document.getElementById('tb-xuat');
            if (!d.chitietXuat || !d.chitietXuat.length) {
                tbXuat.innerHTML = '<tr><td colspan="5" class="empty-state">Không có dữ liệu</td></tr>';
            } else {
                tbXuat.innerHTML = d.chitietXuat.map(function(r) {
                    return '<tr>' +
                        '<td>' + (r.ngay || '--') + '</td>' +
                        '<td><strong>' + (r.tongSo || 0) + '</strong></td>' +
                        '<td><span class="badge badge-ht">' + (r.hoanThanh || 0) + '</span></td>' +
                        '<td><span class="badge badge-qg">' + (r.quaGio || 0) + '</span></td>' +
                        '<td><span class="badge badge-dang">' + (r.dangXuat || 0) + '</span></td>' +
                    '</tr>';
                }).join('');
            }

            // ── XE QUÁ HẠN ──
            var xeEl = document.getElementById('xe-qua-list');
            if (!d.xeQuaHan || !d.xeQuaHan.length) {
                xeEl.innerHTML = '<div class="empty-state">✅ Không có cảnh báo trong kỳ</div>';
            } else {
                xeEl.innerHTML = '<div class="xe-grid">' +
                    d.xeQuaHan.map(function(x) {
                        var lc = x.lanCuoi ? new Date(x.lanCuoi).toLocaleDateString('vi-VN') : '--';
                        return '<div class="xe-qua-item">' +
                            '<div>' +
                                '<div class="xe-qua-plate">' + (x.bienSo || '--') + '</div>' +
                                '<div class="xe-qua-meta">Cửa ' + (x.cua || '--') + ' · Lần cuối: ' + lc + '</div>' +
                            '</div>' +
                            '<div>' +
                                '<div class="xe-qua-count">' + (x.soLan || 0) + '</div>' +
                                '<div class="xe-qua-lbl">lần quá hạn</div>' +
                            '</div>' +
                        '</div>';
                    }).join('') +
                '</div>';
            }
        }

        // ── BIỂU ĐỒ ──
        function renderChart(data) {
            var isDark     = document.body.classList.contains('dark-mode');
            var gridColor  = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)';
            var tickColor  = isDark ? '#555' : '#94a3b8';

            var ctx = document.getElementById('chart-ngay').getContext('2d');
            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.map(function(d){ return d.ngay; }),
                    datasets: [
                        {
                            label: 'Nhập',
                            data: data.map(function(d){ return d.nhap; }),
                            backgroundColor: 'rgba(59,130,246,0.8)',
                            borderRadius: 4,
                            borderSkipped: false,
                        },
                        {
                            label: 'Xuất',
                            data: data.map(function(d){ return d.xuat; }),
                            backgroundColor: 'rgba(34,197,94,0.8)',
                            borderRadius: 4,
                            borderSkipped: false,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: isDark ? '#1e1e2e' : '#fff',
                            titleColor: isDark ? '#e0e0e0' : '#1e293b',
                            bodyColor: isDark ? '#aaa' : '#64748b',
                            borderColor: isDark ? '#2a2a3d' : '#e2e8f0',
                            borderWidth: 1,
                            padding: 10,
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: gridColor },
                            ticks: { color: tickColor, font: { size: 10 }, maxRotation: 45 }
                        },
                        y: {
                            grid: { color: gridColor },
                            ticks: { color: tickColor, font: { size: 10 } },
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        // ── XUẤT EXCEL ──
        function exportExcel() {
            var tu  = document.getElementById('tu-ngay').value;
            var den = document.getElementById('den-ngay').value;
            if (!tu || !den) { alert('Vui lòng chọn khoảng thời gian!'); return; }
            window.location.href = '@Url.Action("ExportExcel", "BaoCao")?tuNgay=' + tu + '&denNgay=' + den;
        }

        // ── INIT ──
        loadBaoCao();
    </script>
}
